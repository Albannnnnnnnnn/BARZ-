---
// Layout principal : barre latérale + barre du haut sur PC, barre du bas sur mobile
import '../styles/global.css';
import '../styles/barz.css';
import Sidebar from '../components/Sidebar.astro';
import TopBar from '../components/TopBar.astro';
import BottomNav from '../components/BottomNav.astro';
import UpdateBanner from '../components/UpdateBanner.astro';
import PushToast from '../components/PushToast.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
}

const {
  title,
  description = 'BARZ¡ — les sorties du vendredi, l’actu musicale et de quoi sortir de ta bulle.',
  image = 'og-default.png', // relatif à l'adresse du site (…/BARZ-/)
  type = 'website',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const siteName = 'BARZ¡';
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#ffffff" />
    <!-- Projet étudiant : accessible avec l'adresse, mais pas indexé par les moteurs de recherche -->
    <meta name="robots" content="noindex, nofollow" />

    <title>{title} | {siteName}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="fr_FR" />
    <meta name="twitter:card" content="summary_large_image" />

    <slot name="json-ld" />

    <link rel="icon" type="image/png" href="/BARZ-/favicon.png" />
    <link rel="apple-touch-icon" href="/BARZ-/apple-touch-icon.png" />
    <link rel="manifest" href="/BARZ-/manifest.json" />
    <!-- Appli installée sur iPhone : plein écran, nom sous l'icône -->
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="BARZ¡" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <script is:inline>
      // Menus « Écouter » (src/lib/listen.ts) : fermés au clic à côté ou avec Échap
      addEventListener('click', (e) => {
        document.querySelectorAll('details.bz-listen-more[open]').forEach((d) => d.contains(e.target) || d.removeAttribute('open'));
      });
      addEventListener('keydown', (e) => {
        if (e.key === 'Escape') document.querySelectorAll('details.bz-listen-more[open]').forEach((d) => d.removeAttribute('open'));
      });
      // Service worker (public/sw.js) : appli installable, pages déjà vues disponibles hors ligne
      if ('serviceWorker' in navigator) {
        addEventListener('load', () => navigator.serviceWorker.register('/BARZ-/sw.js', { scope: '/BARZ-/' }).catch(() => {}));
      }
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Unbounded:wght@500..900&family=Atkinson+Hyperlegible:ital,wght@0,400;0,700;1,400&display=swap"
    />
    <link rel="preconnect" href="https://i.scdn.co" />
  </head>
  <body>
    <div class="bz-shell">
      <div class="shell-sidebar">
        <Sidebar currentPath={currentPath} />
      </div>
      <div class="shell-main">
        <TopBar />
        <main id="main-content">
          <slot />
        </main>
      </div>
    </div>
    <div class="shell-bottom">
      <BottomNav currentPath={currentPath} />
    </div>
    <!-- Hors de .shell-bottom, masquée sur ordinateur -->
    <UpdateBanner />
    <PushToast />
    <script>
      import '../scripts/listen';
      import { promptGuide } from '../scripts/guide-prompt';
      promptGuide().catch(() => {});
    </script>
  </body>
</html>

<style>
  .bz-shell {
    display: grid;
    grid-template-columns: 300px minmax(0, 1fr);
    min-height: 100vh;
  }

  .shell-main {
    min-width: 0;
  }

  .shell-bottom {
    display: none;
  }

  @media (max-width: 900px) {
    .bz-shell {
      grid-template-columns: minmax(0, 1fr);
    }
    .shell-sidebar {
      display: none;
    }
    .shell-bottom {
      display: block;
    }
  }
</style>
