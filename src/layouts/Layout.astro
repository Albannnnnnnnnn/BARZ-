---
// Layout principal - Design moderne (mobile téléphone + desktop sidebar)
import '../styles/global.css';
import BottomNav from '../components/BottomNav.astro';
import Sidebar from '../components/Sidebar.astro';
import TopBar from '../components/TopBar.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
}

const {
  title,
  description = 'BARZ - Ton calendrier des sorties musicales.',
  image = '/og-default.jpg',
  type = 'website',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const siteName = 'BARZ';
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{title} | {siteName}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="fr_FR" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, Astro.site)} />

    <slot name="json-ld" />

    <link rel="icon" type="image/svg+xml" href="/BARZ-/favicon.svg" />
    <link rel="apple-touch-icon" href="/BARZ-/apple-touch-icon.png" />
    <link rel="manifest" href="/BARZ-/manifest.json" />

    <link rel="preconnect" href="https://coverartarchive.org" />
    <link rel="preconnect" href="https://i.scdn.co" />
  </head>
  <body class="app-body">
    <div class="app-shell">
      {/* ===== DESKTOP TOP BAR ===== */}
      <header class="top-bar desktop-only">
        <TopBar currentPath={Astro.url.pathname} />
      </header>

      {/* ===== DESKTOP SIDEBAR ===== */}
      <aside class="sidebar desktop-only">
        <Sidebar currentPath={Astro.url.pathname} />
      </aside>

      {/* ===== MAIN CONTENT (mobile = phone container, desktop = full width) ===== */}
      <main id="main-content" role="main" class="main-content">
        <slot />
      </main>

      {/* ===== MOBILE BOTTOM NAV ===== */}
      <BottomNav currentPath={Astro.url.pathname} class="mobile-only" />
    </div>

    <style>
      /* ===== Layout shell ===== */
      .app-shell {
        display: block;
        min-height: 100vh;
      }

      .desktop-only {
        display: none;
      }
      .mobile-only {
        display: block;
      }

      /* ===== Mobile: phone container ===== */
      .main-content {
        max-width: 390px;
        margin: 0 auto;
        background: #000;
        border-radius: 48px;
        border: 12px solid #1a1a1a;
        overflow: hidden;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }

      /* ===== Desktop: sidebar + top bar + full width ===== */
      @media (min-width: 1024px) {
        .app-shell {
          display: grid;
          grid-template-rows: 64px 1fr;
          grid-template-columns: 280px 1fr;
          height: 100vh;
          overflow: hidden;
        }

        .desktop-only {
          display: block;
        }
        .mobile-only {
          display: none !important;
        }

        .top-bar {
          grid-row: 1;
          grid-column: 1 / -1;
        }

        .sidebar {
          grid-row: 2;
          grid-column: 1;
          overflow-y: auto;
        }

        .main-content {
          grid-row: 2;
          grid-column: 2;
          overflow-y: auto;
          padding: var(--space-6);
          background: var(--color-bg);
          max-width: none !important;
          margin: 0 !important;
          background: var(--color-bg) !important;
          border: none !important;
          border-radius: 0 !important;
          box-shadow: none !important;
          min-height: auto !important;
        }
      }
    </style>

    <script is:inline>
      document.querySelectorAll('.card-interactive').forEach((el) => {
        el.addEventListener('click', (e) => {
          if (!el.classList.contains('a')) {
            const link = el.querySelector('a');
            if (link) window.location.href = link.href;
          }
        });
      });
    </script>
  </body>
</html>