---
// Tuto « Relier Last.fm à ta musique » : une version Android et une version iPhone (choisie selon l'appareil,
// changeable). Ouvert par tout bouton [data-lastfm-tuto] : Paramètres, Bienvenue, et l'entrée du 06/11 de
// « Quoi de neuf ? » (c'est elle qui le présente à l'ouverture de l'appli).
// Étapes tirées de l'aide officielle de Last.fm (support.last.fm : Spotify, Deezer, YouTube, « More ways to scrobble »).
type Service = { name: string; text: string; href?: string; link?: string };

const SPOTIFY: Service = {
  name: 'Spotify',
  text: 'Sur last.fm, ouvre Paramètres → Applications et touche « Connect » à côté de Spotify Scrobbling. Ensuite, tout ce que tu écoutes sur Spotify compte, sur tous tes appareils. Tu utilisais déjà une autre appli de scrobbling pour Spotify ? Coupe-la, sinon chaque écoute comptera deux fois.',
  href: 'https://www.last.fm/settings/applications',
  link: 'Ouvrir les applications Last.fm',
};
const TIDAL: Service = {
  name: 'Tidal, Qobuz',
  text: 'Le scrobbling est intégré à leur appli : cherche Last.fm dans ses réglages et connecte ton compte.',
};

const ANDROID: Service[] = [
  SPOTIFY,
  {
    name: 'Deezer',
    text: 'Ça ne se règle pas dans l’appli Deezer. Ouvre deezer.com dans Chrome, coche « Version pour ordinateur » dans le menu ⋮, puis : ton avatar → Paramètres du compte → préférences de partage → « Relier » sous Last.fm. Ensuite, toutes les applis Deezer comptent. Les membres d’un abonnement Famille ou Duo ne voient pas cette option.',
    href: 'https://www.deezer.com',
    link: 'Ouvrir deezer.com',
  },
  {
    name: 'Apple Music, YouTube Music, Amazon Music…',
    text: 'Installe une appli de scrobbling depuis le Play Store : l’appli Last.fm ou Pano Scrobbler. Connecte-la à ton compte Last.fm et donne-lui les autorisations qu’elle demande : elle repère ce que joue ton appli de musique, quelle qu’elle soit.',
  },
  TIDAL,
];

const IOS: Service[] = [
  SPOTIFY,
  {
    name: 'Deezer',
    text: 'Ça ne se règle pas dans l’appli Deezer. Ouvre deezer.com dans Safari, touche aA dans la barre d’adresse puis « Site pour ordinateur », et va dans : ton avatar → Paramètres du compte → préférences de partage → « Relier » sous Last.fm. Ensuite, toutes les applis Deezer comptent. Les membres d’un abonnement Famille ou Duo ne voient pas cette option.',
    href: 'https://www.deezer.com',
    link: 'Ouvrir deezer.com',
  },
  {
    name: 'Apple Music',
    text: 'Sur iPhone, aucune appli ne peut suivre tes écoutes en direct. Deux solutions : l’appli Last.fm, qui récupère tes écoutes Apple Music quand tu l’ouvres, ou une appli de scrobbling comme QuietScrob, Marvis Pro ou EaveScrob. Dans les deux cas, ajoute les titres à ta bibliothèque Apple Music, sinon ils ne comptent pas.',
  },
  {
    name: 'YouTube Music',
    text: 'L’appli YouTube Music ne peut pas être reliée sur iPhone. La seule solution : écouter sur music.youtube.com dans Safari, avec l’extension Web Scrobbler.',
  },
  TIDAL,
];

const versions = [
  { id: 'android', label: 'Android', services: ANDROID },
  { id: 'ios', label: 'iPhone', services: IOS },
];
---

<dialog class="lf-tuto" id="lastfm-tuto" aria-labelledby="lf-title">
  <div class="lf-box">
    <span class="lf-eyebrow">Tuto · 3 minutes</span>
    <h2 class="bz-h2" id="lf-title">Relie <em>Last.fm</em> à ta musique</h2>
    <p class="lf-intro">
      Last.fm enregistre tout ce que tu écoutes (on dit « scrobbler »), quelle que soit ton appli. Donne ensuite ton pseudo à BARZ¡ : tes recos se basent sur tes
      vraies écoutes.
    </p>

    <div class="lf-switch" role="tablist" aria-label="Ton téléphone">
      {
        versions.map((v) => (
          <button type="button" class="bz-chip" role="tab" data-lf-os={v.id} aria-selected="false">
            {v.label}
          </button>
        ))
      }
    </div>

    <ol class="lf-steps">
      <li>
        <b>Crée ton compte Last.fm</b>
        <span>C’est gratuit. Note bien ton pseudo : c’est lui que BARZ¡ te demandera.</span>
        <a class="bz-link" href="https://www.last.fm/join" target="_blank" rel="noopener">Créer un compte sur last.fm ↗</a>
      </li>
      <li>
        <b>Relie ton appli de musique</b>
        <span>Choisis celle que tu utilises :</span>
        {
          versions.map((v) => (
            <div class="lf-services" data-lf-panel={v.id} role="tabpanel" hidden>
              {v.services.map((s) => (
                <details class="lf-service">
                  <summary>{s.name}</summary>
                  <p>{s.text}</p>
                  {s.href && (
                    <a class="bz-link" href={s.href} target="_blank" rel="noopener">
                      {s.link} ↗
                    </a>
                  )}
                </details>
              ))}
            </div>
          ))
        }
      </li>
      <li>
        <b>Donne ton pseudo à BARZ¡</b>
        <span>Dans Paramètres → Last.fm. Tes artistes les plus écoutés sont importés le lundi et le vendredi matin.</span>
        <a class="bz-link" id="lf-to-settings" href="/BARZ-/parametres#p-lastfm">Ajouter mon pseudo →</a>
      </li>
    </ol>

    <div class="lf-actions">
      <button type="button" class="bz-btn bz-btn--lime bz-btn--small" data-lf-close>C’est noté</button>
    </div>
  </div>
</dialog>

<script>
    const dialog = document.getElementById('lastfm-tuto') as HTMLDialogElement;

  function pickOs(id: string) {
    dialog.querySelectorAll<HTMLButtonElement>('[data-lf-os]').forEach((b) => {
      b.classList.toggle('is-active', b.dataset.lfOs === id);
      b.setAttribute('aria-selected', String(b.dataset.lfOs === id));
    });
    dialog.querySelectorAll<HTMLElement>('[data-lf-panel]').forEach((p) => (p.hidden = p.dataset.lfPanel !== id));
  }
  // iPhone et iPad (y compris l'iPad qui se présente comme un Mac), sinon Android
  const isApple = /iPhone|iPad|iPod/.test(navigator.userAgent) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1) || /Macintosh/.test(navigator.userAgent);
  pickOs(isApple ? 'ios' : 'android');

  function open() {
    if (dialog.open) return;
    dialog.showModal();
  }

  dialog.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;
    if (target === dialog || target.closest('[data-lf-close]')) return dialog.close();
    const os = target.closest<HTMLButtonElement>('[data-lf-os]');
    if (os) pickOs(os.dataset.lfOs!);
  });
  // Déjà sur les Paramètres : fermer et aller au champ, sans recharger la page
  document.getElementById('lf-to-settings')!.addEventListener('click', (event) => {
    const field = document.getElementById('p-lastfm');
    if (!field) return;
    event.preventDefault();
    dialog.close();
    if (field instanceof HTMLDetailsElement) field.open = true;
    field.scrollIntoView({ block: 'center' });
    document.getElementById('lastfm-input')?.focus();
  });

  // Les boutons « Tuto » (champs Last.fm, Quoi de neuf, Nouveautés) ; data-lastfm-tuto="android" ou "ios" choisit la version.
  // Depuis la fenêtre « Quoi de neuf ? », elle se ferme d'abord : une seule fenêtre à la fois
  document.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest<HTMLElement>('[data-lastfm-tuto]');
    if (!button) return;
    event.preventDefault();
    const os = button.dataset.lastfmTuto;
    if (os === 'android' || os === 'ios') pickOs(os);
    const other = button.closest('dialog');
    if (other instanceof HTMLDialogElement && other !== dialog) other.close();
    open();
  });
</script>

<style>
  .lf-tuto {
    width: min(560px, calc(100vw - 32px));
    max-height: calc(100dvh - 48px);
    overflow-x: hidden;
    margin: auto;
    padding: 0;
    border: var(--line);
    border-radius: 14px;
    background: var(--color-paper);
    color: var(--color-text);
    box-shadow: var(--shadow-hard);
  }

  .lf-tuto::backdrop {
    background: rgba(10, 10, 10, 0.5);
  }

  .lf-box {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 24px;
  }

  .lf-eyebrow {
    font: 600 12px/1 var(--font-sans);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .lf-box .bz-h2 {
    margin: 0;
  }

  .lf-intro {
    margin: 0;
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  .lf-switch {
    display: flex;
    gap: 8px;
  }

  .lf-steps {
    display: flex;
    flex-direction: column;
    gap: 18px;
    margin: 4px 0 0;
    padding: 0;
    list-style: none;
    counter-reset: lf;
  }

  .lf-steps > li {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding-left: 44px;
    counter-increment: lf;
  }

  .lf-steps > li::before {
    content: counter(lf);
    position: absolute;
    left: 0;
    top: -2px;
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border: var(--line);
    border-radius: 50%;
    background: var(--color-accent);
    color: var(--color-on-accent);
    font: 800 15px/1 var(--font-display);
  }

  .lf-steps b {
    font: 800 17px/1.25 var(--font-display);
  }

  .lf-steps > li > span {
    color: var(--color-text-muted);
    font-size: 15px;
    line-height: 1.45;
  }

  .lf-services {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 2px;
  }

  .lf-services[hidden] {
    display: none;
  }

  .lf-service {
    border: var(--line);
    border-radius: 10px;
    background: var(--color-bg-elevated);
  }

  .lf-service summary {
    padding: 11px 14px;
    font: 700 15px/1.25 var(--font-sans);
    cursor: pointer;
  }

  .lf-service p {
    margin: 0;
    padding: 0 14px 10px;
    font-size: 14px;
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  /* Les liens du site ne passent pas à la ligne : ici, si (fenêtre étroite) */
  .lf-steps .bz-link {
    white-space: normal;
    overflow-wrap: anywhere;
  }

  .lf-service .bz-link {
    display: block;
    margin: 0 14px 12px;
    font-size: 14px;
  }

  .lf-actions {
    display: flex;
    justify-content: flex-end;
    margin-top: 4px;
  }
</style>
