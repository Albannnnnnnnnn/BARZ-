---
// Lecteur intégré : un seul, celui de la plateforme d'écoute du membre (bouton « Écouter », src/scripts/listen.ts).
// Simples lecteurs officiels en iframe, sans appel à leurs API ; chargé seulement une fois la plateforme connue.
// Pas de lecteur si la plateforme n'en propose pas pour cette sortie (YouTube Music, SoundCloud, Spotify sans identifiant).
interface Props {
  title: string;
  spotifyId?: string | null;
  appleUrl?: string | null;
  deezerUrl?: string | null;
}

const { title, spotifyId, appleUrl, deezerUrl } = Astro.props;
const deezerId = deezerUrl?.match(/album\/(\d+)/)?.[1];

// Clés = noms des plateformes du bouton « Écouter » (src/lib/listen.ts)
const embeds: Record<string, { src: string; height: number }> = {};
if (spotifyId) embeds['Spotify'] = { src: `https://open.spotify.com/embed/album/${spotifyId}?theme=0`, height: 352 };
if (deezerId) embeds['Deezer'] = { src: `https://widget.deezer.com/widget/auto/album/${deezerId}?tracklist=true`, height: 380 };
if (appleUrl) embeds['Apple Music'] = { src: appleUrl.replace('://music.apple.com', '://embed.music.apple.com'), height: 450 };
---

{Object.keys(embeds).length > 0 && (
  <section class="player" aria-label={`Écouter ${title}`} data-player data-title={title} data-embeds={JSON.stringify(embeds)} hidden>
    <iframe
      class="frame"
      loading="lazy"
      allow="autoplay *; encrypted-media *; clipboard-write; fullscreen *; picture-in-picture"
      sandbox="allow-forms allow-popups allow-same-origin allow-scripts allow-storage-access-by-user-activation allow-top-navigation-by-user-activation allow-popups-to-escape-sandbox"
    ></iframe>
  </section>
)}

<script>
  import { LISTEN_EVENT, listenPlatform } from '../scripts/listen';

  function show() {
    document.querySelectorAll<HTMLElement>('[data-player]').forEach((player) => {
      const embeds = JSON.parse(player.dataset.embeds ?? '{}') as Record<string, { src: string; height: number }>;
      const embed = embeds[listenPlatform()];
      const frame = player.querySelector('iframe')!;
      player.hidden = !embed;
      if (!embed || frame.getAttribute('src') === embed.src) return;
      frame.src = embed.src;
      frame.height = String(embed.height);
      frame.title = `Lecteur ${listenPlatform()} : ${player.dataset.title}`;
    });
  }

  show();
  document.addEventListener(LISTEN_EVENT, show);
</script>

<style>
  .player {
    margin-top: 64px;
  }

  .frame {
    display: block;
    width: 100%;
    max-width: 760px;
    border: 0;
    border-radius: 14px;
    background: var(--color-bg-elevated);
  }
</style>
