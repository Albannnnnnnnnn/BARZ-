---
// Lecteur BARZ¡ : les extraits de 30 secondes de chaque titre, fournis par l'API publique de Deezer.
// Les liens des extraits expirent vite : la liste est demandée dans le navigateur (JSONP, l'API n'autorise
// pas fetch depuis un autre site), et redemandée si un extrait a expiré. Le morceau entier : bouton « Écouter ».
// dynamic : disque connu seulement dans le navigateur (src/pages/album.astro) ; la page pose data-album puis
// envoie l'évènement « barz:previews » sur la section.
// artist : sans lien Deezer (sortie venue d'Apple ou de MusicBrainz), le disque est cherché sur Deezer par artiste et titre.
interface Props {
  title: string;
  deezerUrl?: string | null;
  dynamic?: boolean;
  artist?: string | null;
  artistDeezerId?: number | null;
}

const { title, deezerUrl, dynamic = false, artist, artistDeezerId } = Astro.props;
const deezerId = deezerUrl?.match(/album\/(\d+)/)?.[1];
const findOnDeezer = !deezerId && !dynamic && !!artist;
---

{(deezerId || dynamic || findOnDeezer) && (
  <section class="previews" data-previews data-album={deezerId ?? ''} data-find-artist={findOnDeezer ? artist : undefined} data-find-title={findOnDeezer ? title : undefined} data-find-artist-id={findOnDeezer && artistDeezerId ? artistDeezerId : undefined} aria-labelledby="previews-title" hidden>
    <div class="bz-section-head">
      <h2 id="previews-title" class="bz-h2">Les <em>extraits</em></h2>
      <span class="hint">30 secondes par titre</span>
    </div>
    <ol class="tracks" aria-label={`Extraits de ${title}`}></ol>
  </section>
)}

<script>
  import { BASE, escapeHtml } from '../scripts/social';

  type Track = { id: number; title: string; duration: number; preview: string; readable: boolean; artist?: { id: number }; feats?: string[] };

  // Invités d'un titre : la liste des titres d'un album ne donne que l'artiste principal, et les invités ne sont pas
  // toujours dans le titre (« TYPE SHIT » de La Fève avec Yung L.A.). Ils sont dans la fiche de chaque titre,
  // demandée 4 par 4 (l'API publique limite le nombre de requêtes). Ceux déjà écrits dans le titre sont ignorés.
  const FEATS_MAX = 60;
  const squash = (text: string) => text.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9]/g, '');
  async function loadFeats(tracks: Track[], onDone: () => void) {
    const queue = tracks.slice(0, FEATS_MAX);
    const worker = async () => {
      for (let t = queue.shift(); t; t = queue.shift()) {
        const track = t;
        const detail = await jsonp<{ contributors?: { id: number; name: string }[] }>(`https://api.deezer.com/track/${track.id}`).catch(() => null);
        const title = squash(track.title);
        track.feats = (detail?.contributors ?? []).filter((c) => c.id !== track.artist?.id && !title.includes(squash(c.name))).map((c) => c.name);
      }
    };
    await Promise.all([worker(), worker(), worker(), worker()]);
    if (tracks.some((t) => t.feats?.length)) onDone();
  }

  // JSONP : <script> + fonction de rappel globale
  function jsonp<T>(url: string): Promise<T> {
    return new Promise((resolve, reject) => {
      const name = `barzDeezer${Date.now()}${Math.floor(Math.random() * 1e6)}`;
      const script = document.createElement('script');
      const done = () => {
        clearTimeout(timer);
        delete (window as any)[name];
        script.remove();
      };
      const timer = setTimeout(() => (done(), reject(new Error('Deezer ne répond pas'))), 8000);
      (window as any)[name] = (data: T) => (done(), resolve(data));
      script.onerror = () => (done(), reject(new Error('Deezer injoignable')));
      script.src = `${url}${url.includes('?') ? '&' : '?'}output=jsonp&callback=${name}`;
      document.head.append(script);
    });
  }

  const duration = (s: number) => `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`;

  async function initPreviews(section: HTMLElement) {
    const list = section.querySelector('ol')!;
    const audio = new Audio();
    let tracks: Track[] = [];
    let current = -1;
    let retried = false;

    async function load() {
      const res = await jsonp<{ data?: Track[] }>(`https://api.deezer.com/album/${section.dataset.album}/tracks?limit=100`);
      // Liste redemandée (extrait expiré) : les invités déjà trouvés sont gardés
      const feats = new Map(tracks.map((t) => [t.id, t.feats]));
      tracks = (res.data ?? []).map((t) => ({ ...t, feats: feats.get(t.id) }));
    }

    function render() {
      list.innerHTML = tracks
        .map((t, i) => {
          const playable = t.readable && !!t.preview;
          return `<li class="track" data-i="${i}">
            <button type="button" class="track-button" ${playable ? '' : 'disabled'} aria-label="${escapeHtml(`Écouter l’extrait : ${t.title}`)}">
              <span class="track-num">${i + 1}</span>
              <span class="track-icon" aria-hidden="true">▶</span>
              <span class="track-title">${escapeHtml(t.title)}${t.feats?.length ? ` <small class="track-feat">feat. ${escapeHtml(t.feats.join(', '))}</small>` : ''}</span>
              <span class="track-time">${playable ? duration(t.duration) : 'Pas d’extrait'}</span>
            </button>
            <a class="track-rate" href="${BASE}son?id=${t.id}" aria-label="${escapeHtml(`Noter ${t.title}`)}">Noter</a>
            <span class="track-bar" aria-hidden="true"><i></i></span>
          </li>`;
        })
        .join('');
    }

    // Fiche ouverte depuis une notif « X en feat » sur un titre de l'album (?titre=) : ce titre est mis en évidence
    function highlightAsked() {
      const asked = squash(new URLSearchParams(location.search).get('titre') ?? '');
      if (!asked) return;
      const i = tracks.findIndex((t) => squash(t.title) === asked) >= 0 ? tracks.findIndex((t) => squash(t.title) === asked) : tracks.findIndex((t) => squash(t.title).startsWith(asked));
      const row = list.querySelector<HTMLElement>(`.track[data-i="${i}"]`);
      if (i < 0 || !row) return;
      row.classList.add('is-asked');
      if (!scrolled) section.scrollIntoView({ behavior: 'smooth', block: 'start' });
      scrolled = true;
    }
    let scrolled = false;

    function paint() {
      list.querySelectorAll<HTMLElement>('.track').forEach((row) => {
        const on = Number(row.dataset.i) === current;
        const playing = on && !audio.paused;
        row.classList.toggle('is-current', on);
        row.classList.toggle('is-playing', playing);
        row.querySelector('.track-icon')!.textContent = playing ? '❚❚' : '▶';
        if (!on) row.querySelector<HTMLElement>('.track-bar i')!.style.width = '0';
      });
    }

    function play(i: number) {
      if (i === current) {
        audio.paused ? audio.play().catch(() => {}) : audio.pause();
        return;
      }
      current = i;
      audio.src = tracks[i].preview;
      audio.play().catch(() => {});
      paint();
    }

    function next() {
      const n = tracks.findIndex((t, i) => i > current && t.readable && t.preview);
      if (n >= 0) play(n);
      else paint();
    }

    list.addEventListener('click', (event) => {
      const row = (event.target as HTMLElement).closest<HTMLElement>('.track');
      if (row && !row.querySelector('button')!.disabled) play(Number(row.dataset.i));
    });
    audio.addEventListener('play', paint);
    audio.addEventListener('pause', paint);
    audio.addEventListener('ended', next);
    audio.addEventListener('timeupdate', () => {
      const bar = list.querySelector<HTMLElement>(`.track[data-i="${current}"] .track-bar i`);
      if (bar && audio.duration) bar.style.width = `${(audio.currentTime / audio.duration) * 100}%`;
    });
    // Lien d'extrait expiré (page ouverte depuis longtemps) : nouvelle liste, puis on relance le titre
    audio.addEventListener('error', async () => {
      if (current < 0 || retried) return;
      retried = true;
      const i = current;
      current = -1;
      await load().catch(() => {});
      if (tracks[i]?.preview) play(i);
      retried = false;
    });

    try {
      await load();
      if (!tracks.some((t) => t.readable && t.preview)) return;
      render();
      section.hidden = false;
      highlightAsked();
      // Les invités arrivent ensuite ; on redessine en gardant le titre en cours de lecture
      loadFeats(tracks, () => {
        render();
        paint();
        highlightAsked();
      });
    } catch {
      // Deezer indisponible : pas d'extraits, le bouton « Écouter » reste
    }
  }

  // Disque sans lien Deezer : d'abord la discographie de l'artiste (à jour le jour même, contrairement à la recherche
  // Deezer qui a du retard sur les nouveautés), puis la recherche ; même titre aux accents et à la ponctuation près
  async function findAlbum(artist: string, title: string, artistId?: string): Promise<number | null> {
    if (artistId) {
      const disco = await jsonp<{ data?: { id: number; title: string }[] }>(`https://api.deezer.com/artist/${artistId}/albums?limit=100`).catch(() => null);
      const own = (disco?.data ?? []).find((a) => squash(a.title) === squash(title));
      if (own) return own.id;
    }
    const res = await jsonp<{ data?: { id: number; title: string; artist?: { name: string } }[] }>(
      `https://api.deezer.com/search/album?q=${encodeURIComponent(`artist:"${artist}" album:"${title}"`)}&limit=25`
    ).catch(() => null);
    const hit = (res?.data ?? []).find((a) => squash(a.artist?.name ?? '') === squash(artist) && squash(a.title) === squash(title));
    return hit?.id ?? null;
  }

  document.querySelectorAll<HTMLElement>('[data-previews]').forEach(async (section) => {
    if (section.dataset.album) return initPreviews(section);
    const { findArtist, findTitle, findArtistId } = section.dataset;
    if (!findArtist || !findTitle) return;
    const id = await findAlbum(findArtist, findTitle, findArtistId);
    if (!id) return;
    section.dataset.album = String(id);
    initPreviews(section);
  });
  // Disque connu plus tard (page album) : la section est initialisée à la demande
  document.addEventListener('barz:previews', (event) => initPreviews(event.target as HTMLElement));
</script>

<style>
  .previews {
    margin-top: 64px;
    max-width: 760px;
  }

  @media (max-width: 900px) {
    .previews {
      margin-top: 40px;
    }
  }

  .hint {
    font-size: 14px;
    color: var(--color-text-muted);
  }

  .tracks :global(.track.is-asked) {
    border-radius: 10px;
    outline: 3px solid var(--color-accent);
    outline-offset: 2px;
    background: var(--color-accent-soft);
  }

  .tracks {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .previews :global(.track) {
    position: relative;
    display: flex;
    align-items: center;
    gap: 6px;
    border-bottom: 1px solid var(--color-border);
  }

  .previews :global(.track-button) {
    flex: 1;
    min-width: 0;
  }

  /* Page du titre (src/pages/son.astro) : le noter à part */
  .previews :global(.track-rate) {
    flex-shrink: 0;
    padding: 6px 10px;
    border: 2px solid var(--color-ink);
    border-radius: 8px;
    font: 800 11px/1 var(--font-display);
    text-transform: uppercase;
    color: var(--color-text);
  }

  .previews :global(.track-rate:hover) {
    background: var(--color-accent);
    color: var(--color-on-accent);
  }

  .previews :global(.track-button) {
    display: grid;
    grid-template-columns: 28px 28px minmax(0, 1fr) auto;
    align-items: center;
    gap: 10px;
    width: 100%;
    padding: 14px 8px;
    border: 0;
    border-radius: 10px;
    background: transparent;
    font: 500 16px/1.3 var(--font-sans);
    color: var(--color-text);
    text-align: left;
    cursor: pointer;
  }

  .previews :global(.track-button:hover:not(:disabled)),
  .previews :global(.track-button:focus-visible) {
    background: var(--color-bg-elevated);
  }

  .previews :global(.track-button:disabled) {
    cursor: default;
    opacity: 0.5;
  }

  .previews :global(.track-num),
  .previews :global(.track-time) {
    font-size: 14px;
    color: var(--color-text-muted);
    font-variant-numeric: tabular-nums;
  }

  .previews :global(.track-icon) {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--color-accent-soft);
    color: var(--color-accent);
    font-size: 11px;
  }

  .previews :global(.track-title) {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .previews :global(.track-feat) {
    font-size: 0.85em;
    font-weight: 400;
    color: var(--color-text-muted);
  }

  .previews :global(.is-current .track-title) {
    font-weight: 700;
  }

  .previews :global(.is-playing .track-icon) {
    background: var(--color-accent);
    color: var(--color-on-accent);
  }

  .previews :global(.track-bar) {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 2px;
  }

  .previews :global(.track-bar i) {
    display: block;
    width: 0;
    height: 100%;
    background: var(--color-accent);
    transition: width 0.25s linear;
  }
</style>
