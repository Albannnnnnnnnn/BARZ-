---
// Pochette : l'image Spotify si on l'a, sinon un dégradé façon maquette avec le titre en italique
interface Props {
  title: string;
  src?: string | null;
  palette?: number;
  showTitle?: boolean;
  class?: string;
}

const { title, src, palette, showTitle = true, class: className = '' } = Astro.props;

const PALETTES = [
  ['#d9b56a', '#4f6b3f', '#12382d'],
  ['#f0553a', '#8a2a4f', '#2a1446'],
  ['#2f6bff', '#9be3a0', '#e4ff5c'],
  ['#e7a3c5', '#a4506e', '#5d1a2a'],
  ['#ff3b55', '#a0172e', '#1a0a0e'],
  ['#c9d3dc', '#59677a', '#1c232c'],
  ['#7fd6c4', '#3b6a8a', '#2c2a6b'],
  ['#f6a33a', '#e0533b', '#a0257a'],
];

// Même titre → même dégradé, d'un build à l'autre
let hash = 0;
for (const ch of title) hash = (hash * 31 + ch.charCodeAt(0)) >>> 0;
const [c1, c2, c3] = PALETTES[(palette ?? hash) % PALETTES.length];
---

<div class:list={['cover', className]} style={`--c1:${c1};--c2:${c2};--c3:${c3}`}>
  {src ? (
    <img src={src} alt={`Pochette de ${title}`} loading="lazy" decoding="async" />
  ) : (
    showTitle && <span class="cover-title">{title}</span>
  )}
</div>

<style>
  .cover {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 6px;
    background:
      radial-gradient(circle at 32% 28%, var(--c1) 0%, transparent 55%),
      radial-gradient(circle at 70% 80%, var(--c3) 0%, transparent 70%),
      linear-gradient(140deg, var(--c2), var(--c3));
  }

  .cover::after {
    content: '';
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(115deg, rgba(255, 255, 255, 0.035) 0 2px, transparent 2px 7px);
    pointer-events: none;
  }

  img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .cover-title {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 10%;
    padding: 0 10%;
    text-align: center;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(16px, 1.6vw, 26px);
    line-height: 1;
    color: #fff;
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.35);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
</style>
