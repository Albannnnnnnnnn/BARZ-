---
// Pochette : l'image à la bonne taille si on l'a (fond neutre pendant le chargement),
// sinon, ou si elle ne charge pas, un dégradé façon maquette avec le titre
import { COVER_ONERROR, TILE_SIZES, coverSources } from '../lib/cover';

interface Props {
  title: string;
  src?: string | null;
  palette?: number;
  showTitle?: boolean;
  class?: string;
  sizes?: string; // largeur affichée, pour choisir la taille de l'image
  eager?: boolean; // pochette en haut de page : chargée tout de suite
}

const { title, src, palette, showTitle = true, class: className = '', sizes = TILE_SIZES, eager = false } = Astro.props;
const image = src ? coverSources(src, sizes === TILE_SIZES) : null;

const PALETTES = [
  ['#d9b56a', '#4f6b3f', '#12382d'],
  ['#f0553a', '#8a2a4f', '#2a1446'],
  ['#2f6bff', '#9be3a0', '#e4ff5c'],
  ['#e7a3c5', '#a4506e', '#5d1a2a'],
  ['#ff3b55', '#a0172e', '#1a0a0e'],
  ['#c9d3dc', '#59677a', '#1c232c'],
  ['#7fd6c4', '#3b6a8a', '#2c2a6b'],
  ['#f6a33a', '#e0533b', '#a0257a'],
];

// Même titre → même dégradé, d'un build à l'autre
let hash = 0;
for (const ch of title) hash = (hash * 31 + ch.charCodeAt(0)) >>> 0;
const [c1, c2, c3] = PALETTES[(palette ?? hash) % PALETTES.length];
---

<div class:list={['cover', className, { 'has-img': image }]} style={`--c1:${c1};--c2:${c2};--c3:${c3}`}>
  {image && (
    <img src={image.src} srcset={image.srcset} sizes={image.srcset ? sizes : undefined} alt={`Pochette de ${title}`} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} decoding="async" onerror={COVER_ONERROR} />
  )}
  {showTitle && <span class="cover-title">{title}</span>}
</div>

<style>
  .cover {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    border: var(--line);
    border-radius: 10px;
    background:
      radial-gradient(circle at 32% 28%, var(--c1) 0%, transparent 55%),
      radial-gradient(circle at 70% 80%, var(--c3) 0%, transparent 70%),
      linear-gradient(140deg, var(--c2), var(--c3));
  }

  /* Image en cours de chargement : fond neutre plutôt qu'un faux dégradé */
  .cover.has-img:not(.is-broken) {
    background: var(--color-bg-hover);
  }

  .cover.has-img:not(.is-broken) .cover-title {
    display: none;
  }

  img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .cover-title {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 10%;
    padding: 0 10%;
    text-align: center;
    font-family: var(--font-display);
    font-weight: 900;
    text-transform: uppercase;
    font-size: clamp(14px, 1.4vw, 22px);
    line-height: 1;
    color: #fff;
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.35);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
</style>
