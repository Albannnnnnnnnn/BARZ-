---
// Vignette album des maquettes : pochette, titre + badge, artiste · type
import Cover from './Cover.astro';

interface Props {
  title: string;
  subtitle: string;
  cover?: string | null;
  palette?: number;
  badge?: string;
  href?: string;
  checked?: boolean;
  chips?: string[];
  releaseId?: string; // pour le reclassement personnalisé côté navigateur
  type?: string; // album, ep, single : pour le filtre par type
  date?: string; // date de sortie lisible, sous l'artiste
}

const { title, subtitle, cover, palette, badge, href, checked = false, chips = [], releaseId, type, date } = Astro.props;
const Tag = href ? 'a' : 'div';
---

<Tag class="tile" href={href} data-chips={chips.join(' ')} data-release-id={releaseId} data-type={type}>
  <div class="tile-cover">
    <Cover title={title} src={cover} palette={palette} />
    {type === 'live' && <span class="tile-live" title="Enregistrement live">Live</span>}
    {checked && (
      <span class="tile-check" aria-label="Dans ta spin list">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5L20 7" /></svg>
      </span>
    )}
  </div>
  <div class="tile-row">
    <span class="tile-title">{title}</span>
    {badge && <span class="bz-score">{badge}</span>}
  </div>
  <span class="tile-sub">{subtitle}</span>
  {date && <span class="tile-date">{date}</span>}
</Tag>

<style>
  .tile {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .tile-cover {
    position: relative;
    transition: transform var(--transition-base);
  }

  a.tile:hover .tile-cover {
    transform: translateY(-3px);
  }

  .tile-check {
    position: absolute;
    top: 8%;
    right: 8%;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--color-accent);
    color: var(--color-on-accent);
  }

  /* Enregistrement live : sorti cette semaine en streaming, mais pas un nouveau disque studio */
  .tile-live {
    position: absolute;
    top: 8px;
    left: 8px;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 3px 8px;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.72);
    color: #fff;
    font: 700 11px/1.3 var(--font-sans);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .tile-live::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #ef4444;
  }

  .tile-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-top: 12px;
  }

  .tile-title {
    min-width: 0;
    font: 700 18px/1.2 var(--font-sans);
    color: var(--color-text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .tile-sub {
    margin-top: 3px;
    font-size: 15px;
    color: var(--color-text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .tile-date {
    margin-top: 2px;
    font-size: 13px;
    color: var(--color-text-muted);
  }

  @media (max-width: 900px) {
    .tile-title {
      font-size: 15px;
    }
    .tile-sub {
      font-size: 13px;
    }
  }
</style>
