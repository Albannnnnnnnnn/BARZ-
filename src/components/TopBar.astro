---
// Barre du haut : recherche, date du jour, notifications, compte
import { format } from 'date-fns';
import { fr } from 'date-fns/locale';
import NavIcon from './NavIcon.astro';
import { getToday } from '../lib/releases';

const today = getToday();
// "ven. 23 oct." → "VEN. 23 OCT."
const dateLabel = format(today, 'EEE d MMM', { locale: fr }).toUpperCase().replace(/(\p{L})( |$)/u, '$1.$2');
---

<header class="topbar">
  <!-- Logo : seulement sur mobile (sur ordinateur, il est dans la barre latérale) -->
  <a href="/BARZ-/" class="topbar-logo" aria-label="BARZ¡ — accueil"><img src="/BARZ-/icon-192.png" alt="" width="40" height="40" /></a>
  <!-- Sur mobile, une loupe qui déplie le champ sur toute la largeur -->
  <button type="button" class="search-toggle" id="search-toggle" aria-label="Rechercher" aria-controls="topbar-q" aria-expanded="false"><NavIcon name="search" size={20} /></button>
  <form class="search" method="get" action="/BARZ-/search" role="search">
    <label for="topbar-q" class="sr-only">Rechercher</label>
    <input id="topbar-q" type="search" name="q" placeholder="Rechercher un album, un artiste, un genre, un label…" autocomplete="off" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="suggest" />
    <!-- Suggestions en direct : artistes (même sans sortie récente) puis sorties -->
    <div class="suggest" id="suggest" role="listbox" aria-label="Suggestions" hidden></div>
  </form>
  <div class="right">
    <span class="date">{dateLabel}</span>
    <!-- Cloche : notifications de l'appli (supabase/inbox.sql), visible une fois connecté -->
    <div class="inbox" id="inbox" hidden>
      <button type="button" class="bell" id="bell" aria-label="Notifications" aria-expanded="false" aria-controls="inbox-panel">
        <NavIcon name="bell" size={20} />
        <span class="bell-count" id="bell-count" hidden></span>
      </button>
      <div class="inbox-panel" id="inbox-panel" hidden>
        <p class="inbox-title">Notifications</p>
        <ul class="inbox-list" id="inbox-list"></ul>
      </div>
    </div>
    <!-- Remplacé par l'initiale du membre une fois connecté -->
    <a href="/BARZ-/connexion" class="account is-guest" id="account-link">Connexion</a>
  </div>
</header>

<script>
  import { BASE, avatarUrl, escapeHtml, getMyProfile, getSession, searchArtists, supabase, timeAgo, type ArtistLite } from '../scripts/social';
  import { formatAudience } from '../lib/audience';
  import { normalizeSearch } from '../lib/fuzzy';

  // Sur mobile, le champ déplié prend toute la barre : une invite courte plutôt qu'une phrase coupée
  const topbar = document.querySelector<HTMLElement>('.topbar')!;
  const searchInput = document.getElementById('topbar-q') as HTMLInputElement;
  const searchToggle = document.getElementById('search-toggle') as HTMLButtonElement;
  if (matchMedia('(max-width: 900px)').matches) searchInput.placeholder = 'Album, artiste, genre…';
  const unfold = (open: boolean) => {
    topbar.classList.toggle('is-searching', open);
    searchToggle.setAttribute('aria-expanded', String(open));
  };
  searchToggle.addEventListener('click', () => {
    unfold(true);
    searchInput.focus();
  });
  // Champ vidé puis quitté : on revient à la loupe
  searchInput.addEventListener('blur', () => {
    if (!searchInput.value.trim()) unfold(false);
  });
  searchInput.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      searchInput.value = '';
      searchInput.blur();
    }
  });
  // ============================================================
  // SUGGESTIONS : artistes puis sorties, au fil de la frappe ; Entrée sur un nom d'artiste exact ouvre sa page
  // ============================================================
  type SuggestRelease = { title: string; slug: string; cover_url: string | null; release_type: string; artist: { name: string } | null };
  const suggest = document.getElementById('suggest')!;
  const searchForm = searchInput.form!;
  const compact = (t: string) => normalizeSearch(t).replace(/ /g, '');
  const artistHref = (a: ArtistLite) => `${BASE}artiste?a=${encodeURIComponent(a.slug)}`;
  const resultsHref = (q: string) => `${BASE}search?q=${encodeURIComponent(q)}`;
  let lastQuery = '';
  let lastArtists: ArtistLite[] = [];
  let timer: ReturnType<typeof setTimeout> | undefined;
  let active = -1;

  const options = () => [...suggest.querySelectorAll<HTMLAnchorElement>('.suggest-item')];
  function closeSuggest() {
    suggest.hidden = true;
    searchInput.setAttribute('aria-expanded', 'false');
    active = -1;
  }
  function highlight(index: number) {
    const list = options();
    // -1 : aucune suggestion choisie ; les flèches tournent en boucle
    active = index < 0 || !list.length ? -1 : index % list.length;
    list.forEach((el, i) => el.classList.toggle('is-active', i === active));
    if (active >= 0) searchInput.setAttribute('aria-activedescendant', list[active].id);
    else searchInput.removeAttribute('aria-activedescendant');
  }

  async function fetchSuggest(q: string) {
    const releases = supabase
      ? supabase
          .from('releases')
          .select('title, slug, cover_url, release_type, artist:artists!artist_id(name)')
          .ilike('title', `%${q.replace(/[%_,()]/g, '')}%`)
          .order('release_date', { ascending: false })
          .limit(4)
          .then(({ data }) => (data ?? []) as unknown as SuggestRelease[])
      : Promise.resolve([]);
    return Promise.all([searchArtists(q, { limit: 5 }).catch(() => []), releases]);
  }

  async function updateSuggest() {
    const q = searchInput.value.trim();
    if (q.length < 2) return closeSuggest();
    const [artists, releases] = await fetchSuggest(q);
    if (searchInput.value.trim() !== q) return; // la frappe a continué entre-temps
    lastQuery = q;
    lastArtists = artists;
    let n = 0;
    const item = (href: string, img: string, title: string, sub: string, round = false) =>
      `<a class="suggest-item" id="suggest-${n++}" role="option" href="${escapeHtml(href)}">
        ${img ? `<img class="${round ? 'is-round' : ''}" src="${escapeHtml(img)}" alt="" loading="lazy" />` : `<span class="suggest-ph${round ? ' is-round' : ''}">${escapeHtml(title.slice(0, 1).toUpperCase())}</span>`}
        <span class="suggest-text"><b>${escapeHtml(title)}</b><small>${escapeHtml(sub)}</small></span>
      </a>`;
    suggest.innerHTML =
      (artists.length ? `<p class="suggest-label">Artistes</p>${artists.map((a) => item(artistHref(a), a.image_url ?? '', a.name, formatAudience(a) || 'Artiste', true)).join('')}` : '') +
      (releases.length
        ? `<p class="suggest-label">Sorties</p>${releases.map((r) => item(`${BASE}releases/${r.slug}`, r.cover_url ?? '', r.title, r.artist?.name ?? '')).join('')}`
        : '') +
      `<a class="suggest-item suggest-all" id="suggest-${n++}" role="option" href="${escapeHtml(resultsHref(q))}">Tous les résultats pour « ${escapeHtml(q)} » →</a>`;
    suggest.hidden = false;
    searchInput.setAttribute('aria-expanded', 'true');
    highlight(-1);
  }

  searchInput.addEventListener('input', () => {
    clearTimeout(timer);
    timer = setTimeout(() => updateSuggest().catch(() => {}), 180);
  });
  searchInput.addEventListener('focus', () => {
    if (searchInput.value.trim().length >= 2) updateSuggest().catch(() => {});
  });
  searchInput.addEventListener('keydown', (event) => {
    if (suggest.hidden) return;
    if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
      event.preventDefault();
      const count = options().length;
      highlight(event.key === 'ArrowDown' ? active + 1 : active <= 0 ? count - 1 : active - 1);
    } else if (event.key === 'Escape') closeSuggest();
  });
  // Garder le focus dans le champ pendant le clic sur une suggestion
  suggest.addEventListener('mousedown', (event) => event.preventDefault());
  document.addEventListener('click', (event) => {
    if (!searchForm.contains(event.target as Node)) closeSuggest();
  });

  searchForm.addEventListener('submit', async (event) => {
    event.preventDefault();
    const q = searchInput.value.trim();
    if (!q) return;
    const picked = options()[active];
    if (picked) return void (location.href = picked.href);
    // Le nom tapé est celui d'un artiste : direct sur sa page, qu'il ait sorti quelque chose récemment ou non
    const artists = q === lastQuery ? lastArtists : await searchArtists(q, { limit: 1 }).catch(() => []);
    const exact = artists.find((a) => compact(a.name) === compact(q));
    location.href = exact ? artistHref(exact) : resultsHref(q);
  });

  // Page de résultats : le champ reste déplié avec la recherche en cours
  if (new URLSearchParams(location.search).get('q')?.trim()) unfold(true);

  getMyProfile().then((profile) => {
    const link = document.getElementById('account-link') as HTMLAnchorElement | null;
    if (!link || !profile) return;
    // Photo de profil si elle existe, sinon l'initiale
    link.innerHTML = profile.avatar_path
      ? `<img src="${escapeHtml(avatarUrl(profile.avatar_path))}" alt="" />`
      : escapeHtml(profile.display_name.slice(0, 1).toUpperCase());
    link.href = `${BASE}profil`;
    link.setAttribute('aria-label', `Mon profil (${profile.display_name})`);
    link.classList.remove('is-guest');
  });

  // ============================================================
  // CLOCHE : notifications de l'appli, écrites par la fonction notify
  // ============================================================
  type Item = { id: string; kind: string; title: string; body: string; url: string; read_at: string | null; created_at: string };
  const ICONS: Record<string, string> = { friend: '👋', barz: '💬', release: '🎵', friday: '📅', feedback: '📮', reply: '↩️', like: '♥', announcement: '📣' };
  const inbox = document.getElementById('inbox')!;
  const bell = document.getElementById('bell') as HTMLButtonElement;
  const panel = document.getElementById('inbox-panel')!;
  const list = document.getElementById('inbox-list')!;
  const count = document.getElementById('bell-count')!;
  let items: Item[] = [];
  let userId: string | null = null;

  // Lien interne : même page sur le site en ligne comme en local
  const pathOf = (url: string) => {
    try {
      const u = new URL(url, location.origin);
      return u.pathname.startsWith(BASE) ? u.pathname + u.search : BASE;
    } catch {
      return BASE;
    }
  };

  function paint() {
    const unread = items.filter((i) => !i.read_at).length;
    count.textContent = unread > 9 ? '9+' : String(unread);
    count.hidden = unread === 0;
    bell.setAttribute('aria-label', unread ? `Notifications : ${unread} non lue${unread > 1 ? 's' : ''}` : 'Notifications');
    list.innerHTML = items.length
      ? items
          .map(
            (i) => `<li><a class="inbox-item${i.read_at ? '' : ' is-unread'}" href="${escapeHtml(pathOf(i.url))}">
              <span class="inbox-icon" aria-hidden="true">${ICONS[i.kind] ?? '🔔'}</span>
              <span class="inbox-text"><b>${escapeHtml(i.title)}</b>${i.body ? `<span>${escapeHtml(i.body)}</span>` : ''}<small>${escapeHtml(timeAgo(i.created_at))}</small></span>
            </a></li>`
          )
          .join('')
      : '<li class="inbox-empty">Rien pour l’instant. Les demandes d’ami, les Barz de tes amis et les sorties de tes artistes arriveront ici.</li>';
  }

  async function refresh() {
    if (!supabase || !userId) return;
    const { data, error } = await supabase.from('notifications').select('id, kind, title, body, url, read_at, created_at').order('created_at', { ascending: false }).limit(30);
    if (error) return; // table absente : la cloche reste vide
    items = (data ?? []) as Item[];
    paint();
  }

  // Ouvrir la cloche marque tout comme lu (la pastille disparaît, les nouvelles restent surlignées jusqu'à la fermeture)
  async function open(show: boolean) {
    panel.hidden = !show;
    bell.setAttribute('aria-expanded', String(show));
    if (!show) {
      items = items.map((i) => ({ ...i, read_at: i.read_at ?? new Date().toISOString() }));
      paint();
      return;
    }
    const unread = items.filter((i) => !i.read_at).map((i) => i.id);
    count.hidden = true;
    if (unread.length && supabase) await supabase.from('notifications').update({ read_at: new Date().toISOString() }).in('id', unread);
  }

  bell.addEventListener('click', (event) => {
    event.stopPropagation();
    open(panel.hidden);
  });
  document.addEventListener('click', (event) => {
    if (!panel.hidden && !inbox.contains(event.target as Node)) open(false);
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && !panel.hidden) open(false);
  });

  getSession().then((session) => {
    if (!session) return;
    userId = session.user.id;
    inbox.hidden = false;
    refresh();
    // Retour sur l'appli, ou notification reçue pendant qu'elle est ouverte (le service worker prévient la page)
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible') refresh();
    });
    navigator.serviceWorker?.addEventListener('message', (event) => {
      if ((event.data as { type?: string } | null)?.type === 'barz-push') setTimeout(refresh, 2000);
    });
  });
</script>

<style>
  .topbar {
    position: sticky;
    top: 0;
    z-index: 40;
    display: flex;
    align-items: center;
    gap: 32px;
    padding: 22px 56px;
    border-bottom: var(--line);
    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }

  .topbar-logo,
  .search-toggle {
    display: none;
  }

  .search {
    position: relative;
    flex: 1;
    max-width: 780px;
  }

  .suggest {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    right: 0;
    z-index: 60;
    max-height: min(70vh, 560px);
    overflow-y: auto;
    padding: 8px;
    border: var(--line);
    border-radius: 12px;
    background: var(--color-paper);
    box-shadow: var(--shadow-hard);
  }

  .suggest[hidden] {
    display: none;
  }

  .suggest :global(.suggest-label) {
    margin: 8px 10px 6px;
    font: 700 11px/1 var(--font-sans);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .suggest :global(.suggest-item) {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 8px 10px;
    border-radius: 8px;
    color: var(--color-text);
  }

  .suggest :global(.suggest-item:hover),
  .suggest :global(.suggest-item.is-active) {
    background: var(--color-accent-soft);
  }

  .suggest :global(.suggest-item img),
  .suggest :global(.suggest-ph) {
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    border: var(--line);
    border-radius: 6px;
    object-fit: cover;
  }

  .suggest :global(.suggest-ph) {
    display: grid;
    place-items: center;
    background: var(--color-bg-hover);
    font: 800 16px/1 var(--font-display);
  }

  .suggest :global(.suggest-item .is-round) {
    border-radius: 50%;
  }

  .suggest :global(.suggest-text) {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .suggest :global(.suggest-text b),
  .suggest :global(.suggest-text small) {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .suggest :global(.suggest-text b) {
    font: 700 15px/1.2 var(--font-sans);
  }

  .suggest :global(.suggest-text small) {
    font-size: 13px;
    color: var(--color-text-muted);
  }

  .suggest :global(.suggest-all) {
    margin-top: 4px;
    padding: 12px 10px;
    border-top: 1px solid var(--color-border);
    border-radius: 0 0 8px 8px;
    font: 700 14px/1.2 var(--font-sans);
    color: var(--color-accent);
  }

  .search input {
    width: 100%;
    padding: 14px 18px;
    border: var(--line);
    border-radius: 10px;
    background: var(--color-paper);
    color: var(--color-text);
    font: 600 16px/1 var(--font-sans);
    outline: none;
    transition: border-color var(--transition-fast);
  }

  .search input::placeholder {
    color: var(--color-text-dim);
  }

  .search input:focus {
    border-color: var(--color-accent);
  }

  .right {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 22px;
  }

  .date {
    font: 700 13px/1 var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    letter-spacing: 0.14em;
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  .inbox {
    position: relative;
  }

  .inbox[hidden],
  .inbox-panel[hidden],
  .bell-count[hidden] {
    display: none;
  }

  .bell-count {
    position: absolute;
    top: 2px;
    right: 2px;
    min-width: 20px;
    height: 20px;
    padding: 0 5px;
    border-radius: 10px;
    background: var(--color-orange);
    color: #fff;
    font: 700 12px/20px var(--font-sans);
    text-align: center;
  }

  .inbox-panel {
    position: absolute;
    top: calc(100% + 12px);
    right: 0;
    z-index: 60;
    width: min(400px, calc(100vw - 32px));
    max-height: min(70vh, 560px);
    overflow-y: auto;
    padding: 10px;
    border: var(--line);
    border-radius: 12px;
    background: var(--color-paper);
    box-shadow: var(--shadow-hard);
    box-shadow: 0 16px 40px rgba(20, 24, 60, 0.18);
  }

  .inbox-title {
    margin: 6px 10px 8px;
    font: 700 13px/1 var(--font-sans);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .inbox-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .inbox-list :global(.inbox-item) {
    display: flex;
    gap: 12px;
    padding: 12px 10px;
    border-radius: 12px;
    color: var(--color-text);
  }

  .inbox-list :global(.inbox-item:hover) {
    background: var(--color-bg-hover);
  }

  .inbox-list :global(.inbox-item.is-unread) {
    background: var(--color-bg-elevated);
  }

  .inbox-list :global(.inbox-icon) {
    flex-shrink: 0;
    font-size: 20px;
    line-height: 1.2;
  }

  .inbox-list :global(.inbox-text) {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
    font-size: 14px;
    line-height: 1.35;
  }

  .inbox-list :global(.inbox-text span) {
    color: var(--color-text-muted);
    overflow-wrap: anywhere;
  }

  .inbox-list :global(.inbox-text small) {
    color: var(--color-text-dim);
    font-size: 12px;
  }

  .inbox-list :global(.inbox-empty) {
    padding: 14px 10px 16px;
    color: var(--color-text-muted);
    font-size: 14px;
    line-height: 1.45;
  }

  .bell {
    position: relative;
    width: 48px;
    height: 48px;
    border-radius: 10px;
    border: var(--line);
    display: grid;
    place-items: center;
    background: var(--color-paper);
    color: var(--color-text);
    cursor: pointer;
  }

  .account {
    width: 50px;
    height: 50px;
    border: var(--line);
    border-radius: 10px;
    overflow: hidden;
    display: grid;
    place-items: center;
    background: var(--color-accent);
    color: var(--color-on-accent) !important;
    font: 800 18px/1 var(--font-display);
  }

  .account :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .account.is-guest {
    width: auto;
    height: auto;
    padding: 13px 18px;
    border-radius: 10px;
    font: 700 14px/1 var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  @media (max-width: 900px) {
    .topbar {
      padding: 14px 16px;
      gap: 10px;
    }
    .topbar-logo {
      display: block;
      flex-shrink: 0;
    }
    .topbar-logo img {
      display: block;
      width: 40px;
      height: 40px;
      border: var(--line);
      border-radius: 10px;
    }
    .search {
      display: none;
      min-width: 0;
    }
    .search-toggle {
      display: grid;
      place-items: center;
      width: 42px;
      height: 42px;
      margin-left: auto;
      border: var(--line);
      border-radius: 10px;
      background: var(--color-paper);
      color: var(--color-text);
      cursor: pointer;
    }
    .right {
      margin-left: 0;
    }
    .topbar.is-searching .search {
      display: block;
    }
    .topbar.is-searching .topbar-logo,
    .topbar.is-searching .search-toggle,
    .topbar.is-searching .right {
      display: none;
    }
    .right {
      gap: 10px;
    }
    .date {
      display: none;
    }
    .bell {
      width: 42px;
      height: 42px;
    }
    /* Sur mobile, la liste prend toute la largeur sous la barre */
    .inbox {
      position: static;
    }
    .inbox-panel {
      top: 100%;
      right: 16px;
      left: 16px;
      width: auto;
    }
    .search input {
      padding: 11px 14px;
      font-size: 15px;
    }
    .account {
      width: 42px;
      height: 42px;
      font-size: 22px;
    }
    .account.is-guest {
      padding: 11px 14px;
      font-size: 14px;
    }
  }
</style>
