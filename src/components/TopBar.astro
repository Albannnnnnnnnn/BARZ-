---
// Barre du haut : recherche, date du jour, notifications, compte
import { format } from 'date-fns';
import { fr } from 'date-fns/locale';
import NavIcon from './NavIcon.astro';
import { getToday } from '../lib/releases';

const today = getToday();
// "ven. 23 oct." → "VEN. 23 OCT."
const dateLabel = format(today, 'EEE d MMM', { locale: fr }).toUpperCase().replace(/(\p{L})( |$)/u, '$1.$2');
---

<header class="topbar">
  <form class="search" method="get" action="/BARZ-/search" role="search">
    <label for="topbar-q" class="sr-only">Rechercher</label>
    <input id="topbar-q" type="search" name="q" placeholder="Rechercher un album, un artiste, un genre, un label…" autocomplete="off" />
  </form>
  <div class="right">
    <span class="date">{dateLabel}</span>
    <button type="button" class="bell" aria-label="Notifications">
      <NavIcon name="bell" size={20} />
    </button>
    <!-- Remplacé par l'initiale du membre une fois connecté -->
    <a href="/BARZ-/connexion" class="account is-guest" id="account-link">Connexion</a>
  </div>
</header>

<script>
  import { BASE, avatarUrl, escapeHtml, getMyProfile } from '../scripts/social';

  getMyProfile().then((profile) => {
    const link = document.getElementById('account-link') as HTMLAnchorElement | null;
    if (!link || !profile) return;
    // Photo de profil si elle existe, sinon l'initiale
    link.innerHTML = profile.avatar_path
      ? `<img src="${escapeHtml(avatarUrl(profile.avatar_path))}" alt="" />`
      : escapeHtml(profile.display_name.slice(0, 1).toUpperCase());
    link.href = `${BASE}profil`;
    link.setAttribute('aria-label', `Mon profil (${profile.display_name})`);
    link.classList.remove('is-guest');
  });
</script>

<style>
  .topbar {
    position: sticky;
    top: 0;
    z-index: 40;
    display: flex;
    align-items: center;
    gap: 32px;
    padding: 22px 56px;
    border-bottom: 1px solid var(--color-border);
    background: rgba(243, 236, 220, 0.9);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }

  .search {
    flex: 1;
    max-width: 780px;
  }

  .search input {
    width: 100%;
    padding: 15px 26px;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-paper);
    color: var(--color-text);
    font: 400 16px/1 var(--font-sans);
    outline: none;
    transition: border-color var(--transition-fast);
  }

  .search input::placeholder {
    color: var(--color-text-dim);
  }

  .search input:focus {
    border-color: var(--color-accent);
  }

  .right {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 22px;
  }

  .date {
    font: 700 14px/1 var(--font-sans);
    letter-spacing: 0.14em;
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  .bell {
    position: relative;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 0;
    display: grid;
    place-items: center;
    background: var(--color-bg-elevated);
    color: var(--color-text);
    cursor: pointer;
  }

  .account {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    overflow: hidden;
    display: grid;
    place-items: center;
    background: var(--color-accent);
    color: var(--color-on-accent) !important;
    font: 400 26px/1 var(--font-serif);
  }

  .account :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .account.is-guest {
    width: auto;
    height: auto;
    padding: 13px 20px;
    border-radius: 999px;
    font: 700 15px/1 var(--font-sans);
  }

  @media (max-width: 900px) {
    .topbar {
      padding: 14px 16px;
      gap: 12px;
    }
    .date,
    .bell {
      display: none;
    }
    .search input {
      padding: 12px 18px;
      font-size: 15px;
    }
    .account {
      width: 42px;
      height: 42px;
      font-size: 22px;
    }
    .account.is-guest {
      padding: 11px 14px;
      font-size: 14px;
    }
  }
</style>
