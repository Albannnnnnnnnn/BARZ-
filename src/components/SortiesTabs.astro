---
// Onglets de la rubrique Sorties : cette semaine, à venir (les semaines passées se parcourent depuis l'accueil)
interface Props {
  active?: 'semaine' | 'a-venir'; // aucun onglet actif sur une semaine passée
  weekCount?: number;
  upcomingCount?: number;
}

const { active, weekCount, upcomingCount } = Astro.props;
const tabs = [
  { id: 'semaine', href: '/BARZ-/', label: 'Cette semaine', count: weekCount },
  { id: 'a-venir', href: '/BARZ-/a-venir', label: 'À venir', count: upcomingCount },
];
---

<nav class="sortie-tabs" aria-label="Période">
  {tabs.map((t) => (
    <a href={t.href} class:list={{ 'is-active': t.id === active }} aria-current={t.id === active ? 'page' : undefined}>
      {t.label}{t.count ? <span class="count"> · {t.count}</span> : null}
    </a>
  ))}
  <a class="digest" href="/BARZ-/calendar">Mode digest</a>
</nav>

<style>
  .sortie-tabs {
    display: flex;
    align-items: center;
    gap: 28px;
    margin-top: 28px;
    border-bottom: var(--line);
    overflow-x: auto;
    scrollbar-width: none;
  }

  a {
    flex-shrink: 0;
    padding: 14px 0;
    border-bottom: 4px solid transparent;
    margin-bottom: -2px;
    font: 900 14px/1 var(--font-sans);
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  a:hover {
    color: var(--color-text);
  }

  a.is-active {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .count {
    color: var(--color-text-muted);
  }

  .digest {
    margin-left: auto;
    font-weight: 500;
    font-size: 14px;
  }

  @media (max-width: 900px) {
    .sortie-tabs {
      gap: 22px;
      margin-top: 20px;
    }
    a {
      font-size: 14px;
    }
  }

  /* Sur téléphone, les trois onglets prennent toute la largeur : le digest reste accessible par son URL */
  @media (max-width: 640px) {
    .digest {
      display: none;
    }
  }
</style>
