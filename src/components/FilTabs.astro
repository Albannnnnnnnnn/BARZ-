---
// Onglets de la rubrique Barz : les Barz (amis puis commu), le fil du vendredi et les actus
interface Props {
  active: 'barz' | 'vendredi' | 'actus';
}

const { active } = Astro.props;
const tabs = [
  { id: 'barz', href: '/BARZ-/commu', label: 'Barz' },
  { id: 'vendredi', href: '/BARZ-/vendredi', label: 'Vendredi' },
  { id: 'actus', href: '/BARZ-/actus', label: 'Actus' },
];
---

<nav class="fil-tabs" aria-label="Barz">
  {tabs.map((t) => (
    <a href={t.href} class:list={{ 'is-active': t.id === active }} aria-current={t.id === active ? 'page' : undefined}>
      {t.label}
    </a>
  ))}
</nav>

<style>
  .fil-tabs {
    display: flex;
    gap: 28px;
    margin: 28px 0 8px;
    border-bottom: var(--line);
    overflow-x: auto;
    scrollbar-width: none;
  }

  a {
    flex-shrink: 0;
    padding: 14px 0;
    border-bottom: 4px solid transparent;
    margin-bottom: -2px;
    font: 700 14px/1 var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  a:hover {
    color: var(--color-text);
  }

  a.is-active {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  @media (max-width: 900px) {
    .fil-tabs {
      gap: 22px;
      margin-top: 20px;
    }
    a {
      font-size: 14px;
    }
  }
</style>
