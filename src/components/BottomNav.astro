---
// Barre de navigation du bas (mobile uniquement)
import NavIcon from './NavIcon.astro';
import { NAV_ITEMS, activeNav } from '../lib/nav';

interface Props {
  currentPath: string;
}

const active = activeNav(Astro.props.currentPath);
---

<nav class="bottom-nav" aria-label="Navigation principale">
  {NAV_ITEMS.map((item) => (
    <a href={item.href} class:list={{ 'is-active': item.id === active }} aria-current={item.id === active ? 'page' : undefined}>
      <NavIcon name={item.icon} size={22} />
      <span>{item.id === 'commu' ? 'Commu' : item.label}</span>
    </a>
  ))}
</nav>

<style>
  .bottom-nav {
    position: fixed;
    left: 12px;
    right: 12px;
    bottom: max(12px, env(safe-area-inset-bottom));
    z-index: 60;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 4px;
    padding: 6px;
    border: 1px solid var(--color-border);
    border-radius: 22px;
    background: rgba(232, 226, 210, 0.95);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }

  a {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    padding: 8px 2px;
    border-radius: 16px;
    font: 600 11px/1 var(--font-sans);
    color: var(--color-text-muted) !important;
  }

  a.is-active {
    background: var(--color-accent);
    color: var(--color-on-accent) !important;
  }
</style>
