---
// PAGE D'UNE SEMAINE DE SORTIES (du vendredi au jeudi) : la semaine en cours (src/pages/index.astro), avec
// nouveautés depuis la dernière visite et artistes suivis, ou une semaine passée (src/pages/semaine/[vendredi].astro).
// Sorties triées et filtrables, navigation vers les semaines voisines.
import { addDays, format, getISOWeek, parseISO } from 'date-fns';
import { fr } from 'date-fns/locale';
import Layout from '../layouts/Layout.astro';
import AlbumTile from './AlbumTile.astro';
import SortiesTabs from './SortiesTabs.astro';
import { getSupabaseServerSafe } from '../lib/supabase';
import { GENRE_CHIPS, chipIdsFor, currentFriday, fetchReleasesBetween, firstFriday, getToday, weekHref, type ReleaseRow } from '../lib/releases';
import { getReleaseTypeLabel, releaseSubtitle } from '../lib/utils';
import { audience, releaseScore } from '../lib/audience';

interface Props {
  friday: Date; // premier jour de la semaine affichée
}

const { friday } = Astro.props;
const today = getToday();
const thisFriday = currentFriday();
const current = format(friday, 'yyyy-MM-dd') === format(thisFriday, 'yyyy-MM-dd');
const supabase = getSupabaseServerSafe();
// Une semaine de sorties : du vendredi au jeudi suivant
const releases = await fetchReleasesBetween(supabase, friday, addDays(friday, 6));
const upcomingCount = (await fetchReleasesBetween(supabase, addDays(today, 1), addDays(today, 120))).length;
// Semaines voisines : la précédente si la base remonte jusque-là, la suivante si ce n'est pas la semaine en cours
const first = await firstFriday(supabase);
const prevFriday = addDays(friday, -7);
const nextFriday = addDays(friday, 7);
const weekLabel = (d: Date) => `Semaine ${getISOWeek(d)}`;

// Ordre par défaut (« Populaires ») : les artistes de la sélection d'abord, puis le score de chaque sortie
// (auditeurs Last.fm de l'artiste × fans de l'album, rééditions et compilations en retrait : src/lib/audience.ts)
const sorted = [...releases].sort((a, b) => Number(!!b.metadata?.watched) - Number(!!a.metadata?.watched) || releaseScore(b) - releaseScore(a));
const count = sorted.length;

// Rangée d'artistes affichée sans compte : ceux de la sélection BARZ¡ qui ont sorti quelque chose
const spotlight = new Map<string, { name: string; slug: string; image_url: string | null; releaseSlug: string }>();
for (const r of sorted) {
  if (r.artist && r.metadata?.watched && !spotlight.has(r.artist.id)) spotlight.set(r.artist.id, { ...r.artist, releaseSlug: r.slug });
}

const types = [...new Set(sorted.map((r) => r.release_type))].filter(Boolean);
const genres = GENRE_CHIPS.filter((c) => sorted.some((r) => chipIdsFor(r.genres).includes(c.id)));
const eyebrow = `Semaine ${getISOWeek(friday)} · vendredi ${format(friday, 'd MMMM', { locale: fr })}`;
const subtitleOf = (r: ReleaseRow) => releaseSubtitle(r);
// Données des sorties de la semaine pour le reclassement personnalisé (src/scripts/reco.ts)
// Ordre « Populaires » rangé en sections : « À la une » (les plus attendues), puis albums et EP, singles, le reste
const TOP_SIZE = count > 16 ? 8 : 0;
const groupOf = (r: ReleaseRow, i: number) =>
  i < TOP_SIZE ? 'top' : ['album', 'ep'].includes(r.release_type) ? 'albums' : r.release_type === 'single' ? 'singles' : 'others';
const GROUPS = [
  { id: 'top', title: 'À la une', unit: '' },
  { id: 'albums', title: 'Albums et EP', unit: 'albums et EP' },
  { id: 'singles', title: 'Singles', unit: 'singles' },
  { id: 'others', title: 'Live, compils et BO', unit: 'sorties' },
];
const GROUP_CAP = 12;
const byGroup = Object.fromEntries(GROUPS.map((g) => [g.id, sorted.filter((r, i) => groupOf(r, i) === g.id)]));
const weekData = sorted.map((r, i) => ({
  id: r.id,
  artistId: r.artist?.id ?? null,
  artistName: r.artist?.name ?? '',
  genres: r.genres ?? [],
  fans: audience(r.artist) || (r.metadata?.fans ?? null),
  featuring: r.metadata?.featuring ?? [],
  title: r.title,
  slug: r.slug,
  date: r.release_date,
  group: groupOf(r, i),
}));
// Titres de jour du tri « Plus récentes » (placés et affichés par le script de la page)
const days = [...new Set(sorted.map((r) => r.release_date))].sort().reverse();
---

<Layout
  title={current ? 'Sorties' : `${weekLabel(friday)} · Sorties`}
  description={current ? 'Les sorties musicales de la semaine, triées pour toi.' : `Les sorties musicales de la semaine du ${format(friday, 'd MMMM yyyy', { locale: fr })}.`}
>
  <div class="bz-page" data-current-week={current ? '' : undefined}>
    <header class="week-hero">
      <span class="bz-eyebrow">{eyebrow}</span>
      <h1 class="bz-display">{count} sortie{count > 1 ? 's' : ''}</h1>
      {current && <span class="week-sticker" aria-hidden="true">Ce vendredi</span>}
    </header>
    <SortiesTabs active={current ? 'semaine' : undefined} weekCount={current ? count : undefined} upcomingCount={upcomingCount} />

    <nav class="week-nav" aria-label="Semaines">
      {first && prevFriday >= first ? (
        <a href={weekHref(prevFriday)} rel="prev">← {weekLabel(prevFriday)} <span class="week-date">· {format(prevFriday, 'd MMM', { locale: fr })}</span></a>
      ) : <span />}
      {!current && (
        <a href={weekHref(nextFriday)} rel="next">{nextFriday >= thisFriday ? 'Cette semaine' : weekLabel(nextFriday)} →</a>
      )}
    </nav>

    <section class="visit" id="visit" hidden aria-labelledby="visit-title">
      <h2 class="label" id="visit-title">Depuis ta dernière visite</h2>
      <ul class="visit-items" id="visit-items"></ul>
    </section>



    <section class="artists" aria-labelledby="artists-title" id="artists-section" hidden={spotlight.size === 0}>
      <h2 id="artists-title" class="label">{current ? 'Les artistes de la semaine' : 'Les artistes de cette semaine-là'}</h2>
      <ul class="stories" id="stories">
        {[...spotlight.values()].map((a) => (
          <li>
            <a class="story is-new" href={`/BARZ-/releases/${a.releaseSlug}`}>
              {a.image_url ? <img src={a.image_url} alt="" loading="lazy" /> : <span class="story-fallback">{a.name[0]}</span>}
              <span class="story-name">{a.name}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    {count > 0 ? (
      <section aria-label="Toutes les sorties de la semaine">
        <!-- Tri et filtres sur une seule ligne, qui reste sous la barre du haut en faisant défiler -->
        <div class="toolbar">
          <div class="sorts" role="group" aria-label="Trier">
            <button type="button" class="bz-chip" data-sort="reco" aria-pressed="false" hidden>Pour toi</button>
            <button type="button" class="bz-chip is-active" data-sort="popular" aria-pressed="true">Populaires</button>
            <button type="button" class="bz-chip" data-sort="date" aria-pressed="false">Récentes</button>
            <button type="button" class="bz-chip" data-sort="alpha" aria-pressed="false">A → Z</button>
          </div>
          <!-- Sur mobile, le tri passe dans un menu pour que les filtres tiennent sur la ligne -->
          <label class="sr-only" for="sort-select">Trier</label>
          <select id="sort-select" class="select sort-select">
            <option value="reco" hidden>Pour toi</option>
            <option value="popular" selected>Populaires</option>
            <option value="date">Récentes</option>
            <option value="alpha">A → Z</option>
          </select>
          <span class="tool-sep" aria-hidden="true"></span>
          <label class="sr-only" for="filter-genre">Genre</label>
          <select id="filter-genre" class="select">
            <option value="">Genre</option>
            {genres.map((c) => <option value={c.id}>{c.label}</option>)}
          </select>
          {types.length > 1 && (
            <>
              <label class="sr-only" for="filter-type">Format</label>
              <select id="filter-type" class="select">
                <option value="">Format</option>
                {types.map((t) => <option value={t}>{getReleaseTypeLabel(t)}</option>)}
              </select>
            </>
          )}
        </div>

        <div id="groups">
          {GROUPS.map((g) => (
            <section class="group" data-group={g.id} data-unit={g.unit} hidden={!byGroup[g.id].length} aria-labelledby={`group-${g.id}`}>
              <h2 class="group-title" id={`group-${g.id}`}>{g.title}</h2>
              <div class:list={['bz-tiles', 'bz-rail', 'grid', { 'is-capped': g.id !== 'top' }]}>
                {byGroup[g.id].map((r) => (
                  <AlbumTile
                    title={r.title}
                    subtitle={subtitleOf(r)}
                    cover={r.cover_url}
                    href={`/BARZ-/releases/${r.slug}`}
                    chips={chipIdsFor(r.genres)}
                    releaseId={r.id}
                    type={r.release_type}
                  />
                ))}
              </div>
              {g.id !== 'top' && byGroup[g.id].length > GROUP_CAP && (
                <button type="button" class="bz-btn bz-btn--outline more group-more">Voir les {byGroup[g.id].length} {g.unit}</button>
              )}
            </section>
          ))}
        </div>

        <div id="all-grid" class="bz-tiles grid is-capped" hidden>
          {days.map((d) => (
            <h3 class="day-head" data-day={d} hidden>{format(parseISO(d), 'EEEE d MMMM', { locale: fr })}</h3>
          ))}
        </div>
        <p class="filter-empty" hidden>Aucune sortie ne correspond à ces filtres cette semaine.</p>
        <p class="reco-note" hidden>
          <span id="reco-count"></span>
          <button type="button" class="reco-all">Voir toutes les sorties</button>
        </p>
        {count > 24 && <button type="button" class="bz-btn bz-btn--outline more" id="show-all" hidden>Voir les {count} sorties</button>}
        <script type="application/json" id="week-data" set:html={JSON.stringify(weekData)} />
      </section>
    ) : (
      <p class="bz-empty">
        <strong>Aucune sortie enregistrée pour cette semaine.</strong><br />
        {current ? 'Elles apparaissent au fil de la journée, dès leur mise en ligne.' : 'BARZ¡ n’a pas de sorties enregistrées pour ces dates.'}
      </p>
    )}
  </div>
</Layout>

<script>
  import { BASE, escapeHtml, getSession, myFollows, supabase, timeAgo } from '../scripts/social';
  import { loadTaste, rank, scoreRelease, type RecoRelease, type Scored } from '../scripts/reco';
  import { newsSince, previousVisit } from '../scripts/engage';
  import { normName } from '../lib/feat';

  type WeekRelease = RecoRelease & { title: string; slug: string; date: string; group: string };

  const grid = document.getElementById('all-grid');
  const week: WeekRelease[] = JSON.parse(document.getElementById('week-data')?.textContent || '[]');
  const heads = new Map([...(grid?.querySelectorAll<HTMLElement>('.day-head') ?? [])].map((h) => [h.dataset.day!, h]));
  const dateOfId = new Map(week.map((r) => [r.id, r.date]));
  let currentSort = 'popular';
  const groupsBox = document.getElementById('groups');
  const groupOfId = new Map(week.map((r) => [r.id, r.group]));
  const groupGrid = (id: string) => groupsBox?.querySelector<HTMLElement>(`[data-group="${id}"] .grid`);
  const tiles = new Map([...(groupsBox?.querySelectorAll<HTMLElement>('[data-release-id]') ?? [])].map((t) => [t.dataset.releaseId!, t]));
  const GROUP_CAP = 12;

  // La barre de tri reste juste sous la barre du haut, quelle que soit sa hauteur
  const topbar = document.querySelector<HTMLElement>('.topbar');
  if (topbar) new ResizeObserver(() => document.documentElement.style.setProperty('--topbar-h', `${topbar.offsetHeight}px`)).observe(topbar);
  const orders: Record<string, string[]> = {
    popular: week.map((r) => r.id),
    // Les plus récentes d'abord ; le même jour, dans l'ordre « Populaires » (tri stable)
    date: [...week].sort((a, b) => b.date.localeCompare(a.date)).map((r) => r.id),
    alpha: [...week].sort((a, b) => a.title.localeCompare(b.title, 'fr')).map((r) => r.id),
  };

  function applySort(sort: string) {
    document.querySelectorAll<HTMLButtonElement>('[data-sort]').forEach((b) => {
      b.classList.toggle('is-active', b.dataset.sort === sort);
      b.setAttribute('aria-pressed', String(b.dataset.sort === sort));
    });
    currentSort = sort;
    const sortSelect = document.getElementById('sort-select') as HTMLSelectElement | null;
    if (sortSelect) sortSelect.value = sort;
    // « Pour toi » : seulement la sélection ; les autres sorties sont masquées et rangées après
    const order = orders[sort] ?? [];
    const picked = new Set(order);
    tiles.forEach((tile, id) => tile.classList.toggle('is-out', sort === 'reco' && !picked.has(id)));
    // « Populaires » : les sections ; les autres tris, une seule grille
    const grouped = sort === 'popular';
    if (groupsBox) groupsBox.hidden = !grouped;
    if (grid) grid.hidden = grouped;
    if (grouped) for (const id of order) groupGrid(groupOfId.get(id)!)?.appendChild(tiles.get(id)!);
    // « Récentes » : un titre avant les sorties de chaque jour, comme dans « À venir »
    let day = '';
    for (const id of grouped ? [] : sort === 'reco' ? [...order, ...orders.popular.filter((i) => !picked.has(i))] : order) {
      const tile = tiles.get(id);
      if (!tile) continue;
      const head = sort === 'date' && dateOfId.get(id) !== day ? heads.get((day = dateOfId.get(id)!)) : undefined;
      if (head) grid!.appendChild(head);
      grid!.appendChild(tile);
    }
    const note = document.querySelector<HTMLElement>('.reco-note');
    if (note) note.hidden = sort !== 'reco';
    const showAll = document.getElementById('show-all');
    if (showAll) showAll.hidden = grouped || sort === 'reco' || !grid?.classList.contains('is-capped');
    applyFilters();
  }

  // Un titre de jour n'apparaît que si une sortie de ce jour est visible (filtres, liste limitée à 24)
  function updateHeads() {
    heads.forEach((head) => {
      let visible = false;
      if (currentSort === 'date') {
        for (let el = head.nextElementSibling; el && !el.classList.contains('day-head'); el = el.nextElementSibling) {
          if (getComputedStyle(el).display !== 'none') {
            visible = true;
            break;
          }
        }
      }
      head.hidden = !visible;
    });
  }

  function applyFilters() {
    const genre = (document.getElementById('filter-genre') as HTMLSelectElement | null)?.value ?? '';
    const type = (document.getElementById('filter-type') as HTMLSelectElement | null)?.value ?? '';
    let visible = 0;
    tiles.forEach((tile) => {
      const show = (!genre || tile.dataset.chips!.split(' ').includes(genre)) && (!type || tile.dataset.type === type);
      tile.hidden = !show;
      if (show && !tile.classList.contains('is-out')) visible++;
    });
    const empty = document.querySelector<HTMLElement>('.filter-empty');
    if (empty) empty.hidden = visible > 0;
    updateHeads();
    updateGroups();
  }

  // Une section sans sortie visible disparaît ; son bouton annonce ce qui reste à voir
  function updateGroups() {
    groupsBox?.querySelectorAll<HTMLElement>('.group').forEach((group) => {
      const shown = group.querySelectorAll('.tile:not([hidden])').length;
      group.hidden = shown === 0;
      const more = group.querySelector<HTMLElement>('.group-more');
      if (!more) return;
      more.hidden = shown <= GROUP_CAP || !group.querySelector('.grid.is-capped');
      more.textContent = `Voir les ${shown} ${group.dataset.unit}`;
    });
  }

  document.querySelector('.reco-all')?.addEventListener('click', () => applySort('popular'));
  document.querySelector('.sorts')?.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-sort]');
    if (button) applySort(button.dataset.sort!);
  });
  document.getElementById('sort-select')?.addEventListener('change', (event) => applySort((event.target as HTMLSelectElement).value));
  document.getElementById('filter-genre')?.addEventListener('change', applyFilters);
  document.getElementById('filter-type')?.addEventListener('change', applyFilters);
  groupsBox?.addEventListener('click', (event) => {
    const more = (event.target as HTMLElement).closest<HTMLElement>('.group-more');
    if (!more) return;
    // Toute la section : en grille (sur mobile, la rangée qui défile redevient une grille)
    more.closest('.group')?.querySelector('.grid')?.classList.remove('is-capped', 'bz-rail');
    more.remove();
  });
  document.getElementById('show-all')?.addEventListener('click', (event) => {
    grid?.classList.remove('is-capped');
    (event.currentTarget as HTMLElement).remove();
    updateHeads();
  });

  // Connecté : la rangée devient celle de ses artistes suivis (ceux qui ont sorti quelque chose d'abord)
  async function showFollowed() {
    const follows = await myFollows();
    if (!follows.length) return;
    const released = new Map(week.filter((r) => r.artistId).map((r) => [r.artistId!, r.slug]));
    // Invités : un artiste suivi en feat sur la sortie de quelqu'un d'autre s'allume aussi
    const byName = new Map(follows.map((a) => [normName(a.name), a.id]));
    const featured = new Map<string, string>();
    for (const r of week) {
      for (const name of r.featuring ?? []) {
        const id = byName.get(normName(name));
        if (id && !released.has(id) && !featured.has(id)) featured.set(id, r.slug);
      }
    }
    // Sorties annoncées dans les 60 prochains jours : compte à rebours sous l'avatar
    const upcoming = new Map<string, { slug: string; date: string }>();
    if (supabase) {
      const today = new Date();
      const iso = (d: Date) => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
      const { data } = await supabase
        .from('releases')
        .select('slug, release_date, artist_id')
        .in('artist_id', follows.map((a) => a.id).slice(0, 300))
        .gt('release_date', iso(today))
        .lte('release_date', iso(new Date(today.getTime() + 60 * 86_400_000)))
        .order('release_date');
      for (const r of (data ?? []) as { slug: string; release_date: string; artist_id: string }[]) {
        if (!upcoming.has(r.artist_id)) upcoming.set(r.artist_id, { slug: r.slug, date: r.release_date });
      }
    }
    const isNew = (id: string) => released.has(id) || featured.has(id);
    const rank = (id: string) => (isNew(id) ? 2 : upcoming.has(id) ? 1 : 0);
    const list = [...follows].sort((a, b) => rank(b.id) - rank(a.id)).slice(0, 14);
    const avatar = (a: (typeof follows)[number]) =>
      a.image_url ? `<img src="${escapeHtml(a.image_url)}" alt="" loading="lazy" />` : `<span class="story-fallback">${escapeHtml(a.name[0])}</span>`;
    document.getElementById('stories')!.innerHTML =
      list
        .map((a) => {
          const soon = upcoming.get(a.id);
          const slug = released.get(a.id) ?? featured.get(a.id) ?? soon?.slug;
          const tag = released.has(a.id) ? 'Nouveau' : featured.has(a.id) ? 'En feat' : soon ? `J-${daysUntil(soon.date)}` : '';
          const href = slug ? `${BASE}releases/${encodeURIComponent(slug)}` : `${BASE}artiste?a=${encodeURIComponent(a.slug)}`;
          return `<li><a class="story${slug ? ' is-new' : ''}" href="${href}">${avatar(a)}<span class="story-name">${escapeHtml(a.name)}</span>${tag ? `<span class="story-tag">${tag}</span>` : ''}</a></li>`;
        })
        .join('') + `<li><a class="story" href="${BASE}artistes?genre=followed"><span class="story-fallback">+</span><span class="story-name">Tous</span></a></li>`;
    document.getElementById('artists-title')!.textContent = 'Tes artistes';
    document.getElementById('artists-section')!.hidden = false;
  }

  // Connecté avec des goûts : tri « Pour toi » par défaut, avec la raison sous chaque sortie
  const RECO_SIZE = 20;
  const RECO_OUTSIDE = 3;
  const OUTSIDE_MIN_AUDIENCE = 100_000;
  async function personalize() {
    const taste = await loadTaste();
    if (!taste || taste.empty || !grid) return;
    // Une vraie sélection, pas un reclassement des centaines de sorties de la semaine : les mieux classées qui ont
    // une raison (artiste suivi, aimé, proche, genre aimé), et quelques sorties hors de sa bulle glissées dedans
    const familiar = rank(week, taste, 0.15).filter((s) => s.familiar && s.reason).slice(0, RECO_SIZE - RECO_OUTSIDE);
    const taken = new Set(familiar.map((s) => s.item.id));
    // Hors de sa bulle : des artistes assez écoutés pour être une vraie découverte, un par artiste et par genre
    const outside: Scored<WeekRelease>[] = [];
    const usedArtists = new Set<string>();
    const usedReasons = new Set<string>();
    const candidates = week
      .filter((r) => !taken.has(r.id) && (r.fans ?? 0) >= OUTSIDE_MIN_AUDIENCE)
      .map((r) => scoreRelease(r, taste, 0.6))
      .filter((s) => !s.familiar && s.reason.startsWith('Hors de ta bulle'))
      .sort((a, b) => b.score - a.score);
    for (const s of candidates) {
      if (outside.length >= RECO_OUTSIDE) break;
      if (usedArtists.has(s.item.artistName) || usedReasons.has(s.reason)) continue;
      usedArtists.add(s.item.artistName);
      usedReasons.add(s.reason);
      outside.push(s);
    }
    const picks: Scored<WeekRelease>[] = [...familiar];
    outside.forEach((s, i) => picks.splice(Math.min(picks.length, 3 + i * 5), 0, s));
    if (!picks.length) return;
    orders.reco = picks.map((s) => s.item.id);
    for (const s of picks) {
      const tile = tiles.get(s.item.id);
      if (s.reason && tile && !tile.querySelector('.bz-reason')) tile.insertAdjacentHTML('beforeend', `<span class="bz-reason">${escapeHtml(s.reason)}</span>`);
    }
    document.getElementById('reco-count')!.textContent = `Ta sélection : ${picks.length} sorties sur ${week.length}.`;
    document.querySelector<HTMLElement>('[data-sort="reco"]')!.hidden = false;
    document.querySelector<HTMLOptionElement>('#sort-select option[value="reco"]')!.hidden = false;
    applySort('reco');
  }

  // Depuis ta dernière visite : seulement ce qui est nouveau pour ce membre
  const MONTHS = ['janvier', 'février', 'mars', 'avril', 'mai', 'juin', 'juillet', 'août', 'septembre', 'octobre', 'novembre', 'décembre'];
  const plural = (n: number, word: string) => `${n} ${word}${n > 1 ? 's' : ''}`;
  const dayLabel = (iso: string) => new Date(`${iso}T12:00:00`).toLocaleDateString('fr-FR', { weekday: 'short', day: 'numeric', month: 'short' });
  // Jours avant une date (AAAA-MM-JJ), en jours entiers
  const daysUntil = (iso: string) => Math.round((Date.parse(`${iso}T00:00:00`) - new Date(new Date().toDateString()).getTime()) / 86_400_000);
  const listNames = (names: string[]) => (names.length > 1 ? `${names.slice(0, -1).join(', ')} et ${names[names.length - 1]}` : names[0] ?? '');

  async function showVisit() {
    const since = previousVisit();
    if (!(await getSession())) return;
    const items: string[] = [];
    const news = since ? await newsSince(since) : null;
    if (news?.releases.length) {
      const links = news.releases
        .slice(0, 3)
        .map((r) => `<a href="${BASE}releases/${encodeURIComponent(r.slug)}">${escapeHtml(r.title)}</a> <span>${escapeHtml(r.featWith ? `${r.artistName} feat. ${r.featWith}` : r.artistName)}</span>`)
        .join(' · ');
      items.push(`<li><b>${plural(news.releases.length, 'sortie')} de tes artistes</b> ${links}${news.releases.length > 3 ? ' …' : ''}</li>`);
    }
    if (news?.announced.length) {
      const links = news.announced
        .slice(0, 3)
        .map((r) => `<a href="${BASE}releases/${encodeURIComponent(r.slug)}">${escapeHtml(r.title)}</a> <span>${escapeHtml(r.artistName)} · ${escapeHtml(dayLabel(r.date))}</span>`)
        .join(' · ');
      items.push(`<li><b>${plural(news.announced.length, 'sortie')} annoncée${news.announced.length > 1 ? 's' : ''}</b> ${links}</li>`);
    }
    if (news?.friendBarz) {
      items.push(`<li><a href="${BASE}commu"><b>${plural(news.friendBarz, 'Barz')}</b> de ${escapeHtml(listNames(news.friendNames))} →</a></li>`);
    }
    if (news?.requests) {
      items.push(`<li><a href="${BASE}profil"><b>${plural(news.requests, 'demande')} d’ami</b> en attente →</a></li>`);
    }
    // Les 4 premiers jours du mois, le bilan du mois précédent (ensuite dans l'onglet Bilans du profil)
    const now = new Date();
    if (now.getDate() <= 4) {
      const last = new Date(now.getFullYear(), now.getMonth() - 1, 1);
      const key = `${last.getFullYear()}-${String(last.getMonth() + 1).padStart(2, '0')}`;
      const name = MONTHS[last.getMonth()];
      items.push(`<li><a href="${BASE}bilan?m=${key}"><b>Ton bilan ${/^[aeiou]/.test(name) ? 'd’' : 'de '}${name}</b> est prêt →</a></li>`);
    }
    if (!items.length) return;
    if (since) document.getElementById('visit-title')!.textContent = `Depuis ta dernière visite · ${timeAgo(since.toISOString())}`;
    document.getElementById('visit-items')!.innerHTML = items.join('');
    document.getElementById('visit')!.hidden = false;
  }

  // Nouveautés et artistes suivis : seulement sur la semaine en cours (le défi et les jeux sont dans Découvrir)
  if (document.querySelector('[data-current-week]')) {
    showVisit().catch((err) => console.warn('Nouveautés indisponibles :', err));
    showFollowed().catch(() => {});
  }
  personalize().catch((err) => console.warn('Personnalisation indisponible :', err));
</script>

