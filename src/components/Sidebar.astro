---
// Sidebar gauche desktop - Navigation + artistes suivis + prochain vendredi
interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

const navItems = [
  { href: '/BARZ-/', label: 'Vendredi', icon: 'calendar' },
  { href: '/BARZ-/search', label: 'Explorer', icon: 'search' },
  { href: '/BARZ-/actus', label: 'Actus', icon: 'file' },
  { href: '/BARZ-/commu', label: 'Communauté', icon: 'message' },
  { href: '/BARZ-/profil', label: 'Profil', icon: 'user' },
];

const followedArtists = [
  { name: 'Mira Kale', online: true },
  { name: 'Sacha Rubis', online: false },
  { name: 'Lou Varenne', online: false },
];
---

<aside class="sidebar">
  <nav class="sidebar-nav" aria-label="Navigation principale">
    {navItems.map((item) => {
      const isActive = currentPath === item.href || (item.href === '/BARZ-/' && currentPath === '/BARZ-/');
      return (
        <a href={item.href} class={`sidebar-item ${isActive ? 'sidebar-item-active' : ''}`} aria-current={isActive ? 'page' : undefined}>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
            {item.icon === 'calendar' && (
              <>
                <rect x="3" y="3" width="18" height="18" rx="2" ry="2" />
                <line x1="16" y1="2" x2="16" y2="6" />
                <line x1="8" y1="2" x2="8" y2="6" />
                <line x1="3" y1="10" x2="21" y2="10" />
              </>
            )}
            {item.icon === 'search' && (
              <>
                <circle cx="11" cy="11" r="8" />
                <path d="M21 21l-4.35-4.35" />
              </>
            )}
            {item.icon === 'file' && (
              <path d="M12 8v4l3 3m6-3a9 9 0 01-9 9m0 0a9 9 0 00-9-9m9 9V3m0 0v4m0 0h3" />
            )}
            {item.icon === 'message' && (
              <path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z" />
            )}
            {item.icon === 'user' && (
              <>
                <path d="M19 21v-2a4 4 0 00-4-4H9a4 4 0 00-4 4v2" />
                <circle cx="12" cy="7" r="4" />
              </>
            )}
          </svg>
          <span>{item.label}</span>
        </a>
      );
    })}
  </nav>

  <div class="sidebar-artists">
    <h3 class="sidebar-section-title">Artistes suivis</h3>
    {followedArtists.map((artist) => (
      <div class={`sidebar-artist ${artist.online ? 'sidebar-artist-online' : ''}`}>
        <img src="/BARZ-/placeholder-release.svg" alt={artist.name} class="sidebar-artist-avatar" />
        <span class="sidebar-artist-name">{artist.name}</span>
        {artist.online && <span class="sidebar-artist-dot"></span>}
      </div>
    ))}
  </div>

  <div class="sidebar-next-friday">
    <span class="sidebar-section-title">Prochain vendredi</span>
    <div class="sidebar-next-card">
      <span class="sidebar-next-count">2 sorties attendues</span>
      <span class="sidebar-next-artists">Lagune · Selva Eléctrica</span>
    </div>
  </div>
</aside>

<style>
  .sidebar {
    width: 280px;
    background: var(--color-bg);
    border-right: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow-y: auto;
    padding: var(--space-6) var(--space-4);
    flex-shrink: 0;
  }

  .sidebar-nav {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin-bottom: var(--space-10);
  }

  .sidebar-item {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-lg);
    color: var(--color-text-muted);
    text-decoration: none;
    transition: all var(--transition-fast);
    font-size: var(--text-sm);
    font-weight: 500;
  }

  .sidebar-item:hover {
    background: var(--color-bg-hover);
    color: var(--color-text);
  }

  .sidebar-item-active {
    background: var(--color-accent-lime);
    color: #09090b;
    box-shadow: 0 0 20px rgba(163, 230, 53, 0.35);
  }

  .sidebar-item svg {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
  }

  .sidebar-section-title {
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    margin-bottom: var(--space-3);
  }

  .sidebar-artists {
    margin-bottom: var(--space-8);
  }

  .sidebar-artist {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-2) 0;
  }

  .sidebar-artist-avatar {
    width: 32px;
    height: 32px;
    border-radius: var(--radius-full);
    object-fit: cover;
    border: 1px solid var(--color-border);
    flex-shrink: 0;
  }

  .sidebar-artist-name {
    font-size: var(--text-sm);
    color: var(--color-text);
    flex: 1;
  }

  .sidebar-artist-dot {
    width: 6px;
    height: 6px;
    background: var(--color-accent-lime);
    border-radius: var(--radius-full);
    box-shadow: 0 0 8px var(--color-accent-lime);
  }

  .sidebar-next-friday {
    margin-top: auto;
  }

  .sidebar-next-card {
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-4);
  }

  .sidebar-next-count {
    display: block;
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: var(--space-1);
  }

  .sidebar-next-artists {
    display: block;
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }
</style>