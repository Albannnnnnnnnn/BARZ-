---
// PAGE EXPLORER : curseur d'exploration (données réelles), recherche, Rabbit Hole et humeurs (démo)
import { addDays } from 'date-fns';
import Layout from '../layouts/Layout.astro';
import AlbumTile from '../components/AlbumTile.astro';
import { getSupabaseServerSafe } from '../lib/supabase';
import { fetchReleasesBetween, getToday, type ReleaseRow } from '../lib/releases';
import { getReleaseTypeLabel } from '../lib/utils';
import { DEMO_ALBUMS, DEMO_RABBIT_HOLE, MOODS } from '../data/demo';

const today = getToday();
const supabase = getSupabaseServerSafe();
const recent = await fetchReleasesBetween(supabase, addDays(today, -30), today);
// Tout le catalogue pour la recherche (le site est statique : on filtre dans le navigateur)
const catalog = await fetchReleasesBetween(supabase, new Date('1900-01-01'), addDays(today, 90));

// Le curseur part des habitudes d'Alban (rap) et s'en éloigne genre par genre
const ZONES = [
  { word: 'Casanier', genres: ['rap', 'rnb', 'soul'], why: 'Tu écoutes beaucoup de rap : voici les sorties les plus proches de tes habitudes.' },
  { word: 'Ouvert', genres: ['soul', 'rnb', 'pop', 'electronic'], why: 'Un pas de côté : des disques soul, pop et électro qui partagent des producteurs avec tes artistes.' },
  { word: 'Curieux', genres: ['electronic', 'jazz'], why: 'Tu écoutes beaucoup de rap ; ces disques sont samplés ou produits par des proches de tes artistes.' },
  { word: 'Aventurier', genres: ['jazz', 'world', 'latin', 'rock', 'metal', 'reggae', 'folk', 'classical'], why: 'Loin de ta zone de confort : des scènes que tu n’écoutes jamais.' },
];
const DEFAULT_ZONE = 2;

const pick = (genres: string[]) => {
  const matching = recent.filter((r) => r.genres?.some((g) => genres.includes(g)));
  return matching.slice(0, 4);
};
const fallback = Object.values(DEMO_ALBUMS).slice(4, 8);
const zoneTiles = ZONES.map((z) => pick(z.genres));

const subtitleOf = (r: ReleaseRow) => `${r.artist?.name ?? 'Artiste inconnu'} · ${getReleaseTypeLabel(r.release_type)}`;
const searchText = (r: ReleaseRow) => `${r.title} ${r.artist?.name ?? ''} ${(r.genres ?? []).join(' ')}`.toLowerCase();
---

<Layout title="Explorer" description="Sors de ta bulle : curseur d’exploration, Rabbit Hole et humeurs.">
  <div class="bz-page">
    <div class="head">
      <div>
        <span class="bz-eyebrow">Explorer</span>
        <h1 class="bz-display">Sors de <em>ta bulle.</em></h1>
      </div>
      <nav class="tabs" aria-label="Modes d’exploration">
        <a class="bz-chip is-active" href="/BARZ-/search" aria-current="page">Découverte</a>
        <a class="bz-chip" href="/BARZ-/releases">Charts</a>
        <a class="bz-chip" href="/BARZ-/calendar">Calendrier</a>
      </nav>
    </div>

    <section id="results" class="results" hidden aria-live="polite">
      <div class="bz-section-head">
        <h2 class="bz-h2">Résultats pour « <em id="results-query"></em> »</h2>
        <a class="bz-link" href="/BARZ-/search">Effacer</a>
      </div>
      <div class="bz-tiles" id="results-grid">
        {catalog.map((r) => (
          <div class="result" data-search={searchText(r)} hidden>
            <AlbumTile title={r.title} subtitle={subtitleOf(r)} cover={r.cover_url} href={`/BARZ-/releases/${r.slug}`} />
          </div>
        ))}
      </div>
      <p id="results-empty" class="bz-empty" hidden>Rien trouvé. Essaie un nom d’artiste, un titre ou un genre (rap, jazz, électro…).</p>
    </section>

    <section class="explorer" aria-labelledby="cursor-title">
      <div class="cursor">
        <span id="cursor-title" class="cursor-label">Curseur d’exploration</span>
        <p class="cursor-word" id="cursor-word">{ZONES[DEFAULT_ZONE].word}</p>
        <input id="cursor" type="range" min="0" max="99" value="60" aria-label="Curseur entre tes habitudes et l’inconnu total" />
        <div class="cursor-ends"><span>Mes habitudes</span><span>Inconnu total</span></div>
        <p class="cursor-why"><strong>Pourquoi ces choix ?</strong> <span id="cursor-why">{ZONES[DEFAULT_ZONE].why}</span></p>
      </div>
      {ZONES.map((zone, i) => (
        <div class="picks" data-zone={i} hidden={i !== DEFAULT_ZONE} data-why={zone.why} data-word={zone.word}>
          {zoneTiles[i].length > 0
            ? zoneTiles[i].map((r) => <AlbumTile title={r.title} subtitle={subtitleOf(r)} cover={r.cover_url} href={`/BARZ-/releases/${r.slug}`} />)
            : fallback.map((a) => <AlbumTile title={a.title} subtitle={a.artist} palette={a.palette} />)}
        </div>
      ))}
    </section>

    <section class="block" aria-labelledby="rabbit-title">
      <div class="bz-section-head">
        <h2 id="rabbit-title" class="bz-h2">Rabbit Hole</h2>
        <span class="bz-link">Nouveau trou →</span>
      </div>
      <ol class="rabbit">
        {DEMO_RABBIT_HOLE.map((step, i) => (
          <li class:list={{ 'is-start': i === 0 }}>
            <span class="rabbit-dot" />
            <span class="rabbit-kind">{step.kind}</span>
            <span class:list={['rabbit-title', { 'is-link': step.link }]}>{step.title}</span>
            <span class="rabbit-sub">{step.sub}</span>
          </li>
        ))}
      </ol>
    </section>

    <section class="block" aria-labelledby="moods-title">
      <div class="bz-section-head"><h2 id="moods-title" class="bz-h2">Par humeur</h2></div>
      <div class="moods">
        {MOODS.map((m) => (
          <div class="mood" style={`background:${m.color};color:${m.ink}`}>
            <h3>{m.title}</h3>
            <p>{m.desc}</p>
          </div>
        ))}
      </div>
    </section>
  </div>
</Layout>

<script>
  // Curseur d'exploration : 4 zones, chacune avec ses disques
  const slider = document.getElementById('cursor') as HTMLInputElement | null;
  const word = document.getElementById('cursor-word');
  const why = document.getElementById('cursor-why');
  const zones = document.querySelectorAll<HTMLElement>('.picks');
  const paint = () => {
    if (!slider) return;
    const value = Number(slider.value);
    slider.style.setProperty('--fill', `${value}%`);
    const zone = Math.min(zones.length - 1, Math.floor((value / 100) * zones.length));
    zones.forEach((z) => (z.hidden = Number(z.dataset.zone) !== zone));
    const active = zones[zone];
    if (word && active) word.textContent = active.dataset.word ?? '';
    if (why && active) why.textContent = active.dataset.why ?? '';
  };
  slider?.addEventListener('input', paint);
  paint();

  // Recherche dans le catalogue (paramètre ?q= envoyé par la barre du haut)
  const query = new URLSearchParams(location.search).get('q')?.trim();
  if (query) {
    const results = document.getElementById('results')!;
    const terms = query.toLowerCase().split(/\s+/);
    let found = 0;
    results.querySelectorAll<HTMLElement>('.result').forEach((el) => {
      const match = terms.every((t) => el.dataset.search!.includes(t));
      el.hidden = !match;
      if (match) found++;
    });
    document.getElementById('results-query')!.textContent = query;
    document.getElementById('results-empty')!.hidden = found > 0;
    results.hidden = false;
    const input = document.getElementById('topbar-q') as HTMLInputElement | null;
    if (input) input.value = query;
  }
</script>

<style>
  .head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
  }

  .tabs {
    display: flex;
    gap: 8px;
    padding-bottom: 12px;
  }

  .results {
    margin-top: 56px;
  }

  .explorer {
    display: grid;
    grid-template-columns: minmax(280px, 0.85fr) minmax(0, 1fr);
    gap: 48px;
    margin-top: 64px;
    padding: 48px;
    border: 1px solid var(--color-border);
    border-radius: 28px;
  }

  .cursor-label {
    font: 600 15px/1 var(--font-sans);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #cfcbc2;
  }

  .cursor-word {
    margin: 18px 0 26px;
    font: italic 400 clamp(56px, 5.6vw, 88px) / 1 var(--font-serif);
    color: var(--color-lime);
  }

  input[type='range'] {
    --fill: 60%;
    width: 100%;
    height: 8px;
    border-radius: 999px;
    appearance: none;
    background: linear-gradient(to right, var(--color-lime) var(--fill), #333 var(--fill));
    cursor: pointer;
  }

  input[type='range']::-webkit-slider-thumb {
    appearance: none;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--color-lime);
    border: 3px solid var(--color-bg);
    box-shadow: 0 0 0 1px var(--color-lime);
  }

  input[type='range']::-moz-range-thumb {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--color-lime);
    border: 3px solid var(--color-bg);
  }

  .cursor-ends {
    display: flex;
    justify-content: space-between;
    margin-top: 16px;
    font: 600 12px/1 var(--font-sans);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .cursor-why {
    margin-top: 34px;
    font-size: 16px;
    line-height: 1.6;
    color: #cfcbc2;
  }

  .cursor-why strong {
    color: var(--color-text);
  }

  .picks {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
    align-content: start;
  }

  .picks[hidden] {
    display: none;
  }

  .block {
    margin-top: 72px;
  }

  .rabbit {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 24px;
    position: relative;
  }

  .rabbit::before {
    content: '';
    position: absolute;
    top: 10px;
    left: 10px;
    right: 0;
    border-top: 1px dotted var(--color-lime);
    opacity: 0.7;
  }

  .rabbit li {
    position: relative;
    display: flex;
    flex-direction: column;
  }

  .rabbit-dot {
    width: 21px;
    height: 21px;
    border-radius: 50%;
    border: 2px solid var(--color-lime);
    background: var(--color-bg);
    margin-bottom: 30px;
  }

  .is-start .rabbit-dot {
    background: var(--color-lime);
  }

  .rabbit-kind {
    font: 600 12px/1 var(--font-sans);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .rabbit-title {
    margin: 12px 0 6px;
    font: 400 40px/1 var(--font-serif);
  }

  .rabbit-title.is-link {
    text-decoration: underline;
    text-decoration-color: var(--color-lime);
    text-underline-offset: 6px;
    text-decoration-thickness: 2px;
  }

  .rabbit-sub {
    font-size: 16px;
    color: var(--color-text-muted);
  }

  .moods {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
  }

  .mood {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 210px;
    padding: 26px;
    border-radius: 18px;
  }

  .mood h3 {
    font: 400 46px/1 var(--font-serif);
    color: inherit;
  }

  .mood p {
    font-weight: 600;
    font-size: 15px;
    color: inherit;
  }

  @media (max-width: 1280px) {
    .explorer {
      grid-template-columns: minmax(0, 1fr);
    }
    .rabbit {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      row-gap: 40px;
    }
    .rabbit::before {
      display: none;
    }
  }

  @media (max-width: 900px) {
    .explorer {
      padding: 28px 20px;
      margin-top: 36px;
    }
    .picks {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .rabbit {
      grid-template-columns: 1fr 1fr;
    }
    .rabbit-title {
      font-size: 30px;
    }
    .moods {
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }
    .mood {
      min-height: 150px;
      padding: 18px;
    }
    .mood h3 {
      font-size: 34px;
    }
  }
</style>
