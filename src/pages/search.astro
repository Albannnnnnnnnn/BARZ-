---
// PAGE EXPLORER : curseur d'exploration, recherche et Rabbit Hole (données réelles)
import { addDays } from 'date-fns';
import Layout from '../layouts/Layout.astro';
import AlbumTile from '../components/AlbumTile.astro';
import DailyPlay from '../components/DailyPlay.astro';
import { getSupabaseServerSafe } from '../lib/supabase';
import { fetchReleasesBetween, getToday, type ReleaseRow } from '../lib/releases';
import { releaseSubtitle } from '../lib/utils';
import { audience, recommendable, releaseScore } from '../lib/audience';
import { normalizeSearch } from '../lib/fuzzy';

const today = getToday();
const supabase = getSupabaseServerSafe();
const recent = await fetchReleasesBetween(supabase, addDays(today, -30), today);
// Tout le catalogue pour la recherche (le site est statique : on filtre dans le navigateur)
const catalog = await fetchReleasesBetween(supabase, new Date('1900-01-01'), addDays(today, 90));

// Sans compte, le curseur part du rap et s'en éloigne genre par genre ; connecté, c'est le moteur de reco qui choisit
const LOGIN_HINT = 'Connecte-toi pour que le curseur parte de tes propres goûts.';
const ZONES = [
  { word: 'En terrain connu', genres: ['rap', 'rnb', 'soul'], why: `Les sorties récentes en rap, R&B et soul. ${LOGIN_HINT}` },
  { word: 'Pas de côté', genres: ['soul', 'rnb', 'pop', 'electronic'], why: `Soul, pop et électro. ${LOGIN_HINT}` },
  { word: 'Plus loin', genres: ['electronic', 'jazz'], why: `Électro et jazz. ${LOGIN_HINT}` },
  { word: 'Hors des sentiers', genres: ['jazz', 'world', 'latin', 'rock', 'metal', 'reggae', 'folk', 'classical'], why: `Jazz, musiques du monde, rock, metal, reggae, folk, classique. ${LOGIN_HINT}` },
];
const DEFAULT_ZONE = 2;

// Sans compte : les sorties les plus écoutées de ces genres, sans compilation ni artiste presque inconnu
const pick = (genres: string[]) =>
  recent
    .filter((r) => r.genres?.some((g) => genres.includes(g)))
    .filter((r) => recommendable({ releaseType: r.release_type, artistName: r.artist?.name, featuring: r.metadata?.featuring, fans: audience(r.artist) }))
    .sort((a, b) => releaseScore(b) - releaseScore(a))
    .filter((r, i, list) => list.findIndex((x) => x.artist?.id === r.artist?.id) === i) // une sortie par artiste
    .slice(0, 4);
const zoneTiles = ZONES.map((z) => pick(z.genres));

const subtitleOf = (r: ReleaseRow) => releaseSubtitle(r);
// Sorties récentes pour le curseur personnalisé (src/scripts/reco.ts)
const exploreData = recent.map((r) => ({
  id: r.id,
  artistId: r.artist?.id ?? null,
  artistName: r.artist?.name ?? '',
  genres: r.genres ?? [],
  fans: audience(r.artist) || (r.metadata?.fans ?? null),
  title: r.title,
  slug: r.slug,
  cover_url: r.cover_url,
  release_type: r.release_type,
  releaseType: r.release_type,
  featuring: r.metadata?.featuring ?? [],
}));
// On trouve aussi une sortie en cherchant un artiste invité (feat.)
const searchText = (r: ReleaseRow) => normalizeSearch(`${r.title} ${r.artist?.name ?? ''} ${(r.metadata?.featuring ?? []).join(' ')} ${(r.genres ?? []).join(' ')}`);
---

<Layout title="Découvrir" description="Sors de ta bulle : curseur d’exploration et Rabbit Hole.">
  <div class="bz-page">
    <div class="head">
      <div>
        <span class="bz-eyebrow">Découvrir</span>
        <h1 class="bz-display">Sors de <em>ta bulle.</em></h1>
      </div>
      <a class="bz-link by-genre" href="/BARZ-/artistes">Artistes par genre →</a>
    </div>

    <section id="results" class="results" hidden aria-live="polite">
      <div class="bz-section-head">
        <h2 class="bz-h2">Résultats pour « <em id="results-query"></em> »</h2>
        <a class="bz-link" href="/BARZ-/search">Effacer</a>
      </div>
      <div id="results-artists-block" hidden>
        <h3 class="results-label">Artistes</h3>
        <div class="results-artists" id="results-artists"></div>
      </div>
      <h3 class="results-label" id="results-releases-label" hidden>Sorties</h3>
      <div class="bz-tiles" id="results-grid">
        {catalog.map((r) => (
          <div class="result" data-search={searchText(r)} hidden>
            <AlbumTile title={r.title} subtitle={subtitleOf(r)} cover={r.cover_url} href={`/BARZ-/releases/${r.slug}`} />
          </div>
        ))}
      </div>
      <p id="results-empty" class="bz-empty" hidden>Rien trouvé. Essaie un nom d’artiste, un titre ou un genre (rap, jazz, électro…).</p>
    </section>

    <DailyPlay />


    <section class="explorer" aria-labelledby="cursor-title">
      <div class="cursor">
        <span id="cursor-title" class="cursor-label">Curseur d’exploration</span>
        <p class="cursor-word" id="cursor-word">{ZONES[DEFAULT_ZONE].word}</p>
        <input id="cursor" type="range" min="0" max="99" value="60" aria-label="Curseur entre tes habitudes et l’inconnu total" />
        <div class="cursor-ends"><span>Mes habitudes</span><span>Inconnu total</span></div>
        <p class="cursor-why"><strong>Pourquoi ces choix ?</strong> <span id="cursor-why">{ZONES[DEFAULT_ZONE].why}</span></p>
      </div>
      {ZONES.map((zone, i) => (
        <div class="picks bz-rail" data-zone={i} hidden={i !== DEFAULT_ZONE} data-why={zone.why} data-word={zone.word}>
          {zoneTiles[i].length > 0
            ? zoneTiles[i].map((r) => <AlbumTile title={r.title} subtitle={subtitleOf(r)} cover={r.cover_url} href={`/BARZ-/releases/${r.slug}`} />)
            : <p class="bz-empty">Pas de sortie récente dans ces genres.</p>}
        </div>
      ))}
      <div class="picks bz-rail" id="picks-live" hidden></div>
      <script type="application/json" id="explore-data" set:html={JSON.stringify(exploreData)} />
    </section>

    <section class="block" id="rabbit-block" aria-labelledby="rabbit-title" hidden>
      <div class="bz-section-head">
        <h2 id="rabbit-title" class="bz-h2">Rabbit Hole</h2>
        <button type="button" class="bz-link rabbit-new" id="rabbit-new">Nouveau trou →</button>
      </div>
      <ol class="rabbit" id="rabbit"></ol>
    </section>

  </div>
</Layout>

<script>
  import { ARTIST_LITE, BASE, artistCardHtml, escapeHtml, myFollows, releaseTileHtml, searchArtists, supabase, wireFollowButtons, type ArtistLite } from '../scripts/social';
  import { audience, formatAudience } from '../lib/audience';
  import { dismissButtonHtml, loadTaste, rank, wireDismiss, type RecoRelease, type Taste } from '../scripts/reco';
  import { GENRE_CHIPS } from '../lib/genres';
  import { searchScore } from '../lib/fuzzy';

  // Curseur d'exploration : 4 zones, chacune avec ses disques
  const slider = document.getElementById('cursor') as HTMLInputElement | null;
  const word = document.getElementById('cursor-word');
  const why = document.getElementById('cursor-why');
  const zones = document.querySelectorAll<HTMLElement>('.picks[data-zone]');
  const livePicks = document.getElementById('picks-live')!;
  const exploreData: (RecoRelease & { title: string; slug: string; cover_url: string | null; release_type: string })[] = JSON.parse(
    document.getElementById('explore-data')?.textContent || '[]'
  );
  // Connecté : les disques viennent du moteur de reco, selon la position du curseur
  let taste: Taste | null = null;

  const paint = () => {
    if (!slider) return;
    const value = Number(slider.value);
    slider.style.setProperty('--fill', `${value}%`);
    const zone = Math.min(zones.length - 1, Math.floor((value / 100) * zones.length));
    const active = document.querySelector<HTMLElement>(`.picks[data-zone="${zone}"]`);
    if (word && active) word.textContent = active.dataset.word ?? '';

    if (taste) {
      zones.forEach((z) => (z.hidden = true));
      const explore = value / 99;
      // Plus on explore, plus on écarte ce qu'on connaît déjà
      const ranked = rank(exploreData, taste, explore).filter((s) => explore < 0.5 || !(s.item.artistId && taste!.followed.has(s.item.artistId)));
      const picks = ranked.slice(0, 4);
      livePicks.innerHTML = picks
        .map((s) => {
          const html = releaseTileHtml({ ...s.item, artist: { name: s.item.artistName } }, { reason: s.reason });
          const canDismiss = s.item.artistId && !taste!.followed.has(s.item.artistId);
          return canDismiss ? html.replace('</a>', `${dismissButtonHtml(s.item.artistId!, s.item.artistName)}</a>`) : html;
        })
        .join('');
      livePicks.hidden = false;
      const reason = picks.find((s) => s.reason)?.reason;
      if (why) why.textContent = reason ? `${reason}. Bouge le curseur pour t’éloigner ou te rapprocher de tes habitudes.` : active?.dataset.why ?? '';
      return;
    }
    zones.forEach((z) => (z.hidden = Number(z.dataset.zone) !== zone));
    if (why && active) why.textContent = active.dataset.why ?? '';
  };
  slider?.addEventListener('input', paint);
  // « Pas pour moi » : l'artiste est écarté, le curseur propose autre chose
  wireDismiss(livePicks, () => setTimeout(paint, 0));
  paint();
  loadTaste().then((t) => {
    if (t && !t.empty && exploreData.length) {
      taste = t;
      paint();
    }
  });

  // Rabbit Hole : de proche en proche dans les artistes similaires, en s'éloignant à chaque saut
  const STEPS = ['Point de départ', 'Proche de', 'Un cran plus loin', 'Encore plus loin', 'Destination'];
  const hole = document.getElementById('rabbit')!;

  // Voisins dans les deux sens : seuls les artistes "graines" ont leurs voisins enregistrés,
  // les autres sont reliés par les graines qui les citent
  async function relatedOf(id: string): Promise<ArtistLite[]> {
    const [out, inc] = await Promise.all([
      supabase!.from('artist_relations').select(`rank, other:artists!artist_relations_related_id_fkey(${ARTIST_LITE})`).eq('artist_id', id).order('rank'),
      supabase!.from('artist_relations').select(`rank, other:artists!artist_relations_artist_id_fkey(${ARTIST_LITE})`).eq('related_id', id).order('rank').limit(20),
    ]);
    if (out.error) throw out.error;
    const seen = new Set<string>();
    return [...(out.data ?? []), ...(inc.data ?? [])]
      .sort((a: any, b: any) => a.rank - b.rank)
      .map((r: any) => r.other)
      .filter((a: ArtistLite | null): a is ArtistLite => !!a && !seen.has(a.id) && !!seen.add(a.id));
  }

  async function digHole() {
    if (!supabase) return;
    // Départ : un artiste que le membre aime, sinon un artiste populaire du catalogue
    const t = await loadTaste();
    const liked = t ? [...t.artistWeights.entries()].filter(([, w]) => w > 0).sort((a, b) => b[1] - a[1]).slice(0, 8).map(([id]) => id) : [];
    const startQuery = liked.length
      ? supabase.from('artists').select(ARTIST_LITE).in('id', liked)
      : supabase.from('artists').select(ARTIST_LITE).not('deezer_id', 'is', null).order('popularity', { ascending: false }).limit(80);
    const { data: starts, error } = await startQuery;
    if (error || !starts?.length) return;
    const pickRandom = <T,>(list: T[]) => list[Math.floor(Math.random() * list.length)];
    const chain: ArtistLite[] = [pickRandom(starts as ArtistLite[])];
    const visited = new Set([chain[0].id]);
    for (let hop = 1; hop < STEPS.length; hop++) {
      const candidates = (await relatedOf(chain[hop - 1].id)).filter((a) => !visited.has(a.id));
      if (!candidates.length) break;
      // Un terrier s'enfonce : à chaque saut, on préfère un voisin nettement moins connu que le précédent
      const previousFans = audience(chain[hop - 1]);
      const deeper = candidates.filter((a) => audience(a) < previousFans * 0.6);
      const pool = deeper.length ? deeper : candidates;
      const next = pool[Math.min(pool.length - 1, Math.floor(Math.random() * 3))];
      chain.push(next);
      visited.add(next.id);
    }
    if (chain.length < 3) return; // pas assez de liens : on garde le terrier précédent (ou la section masquée)
    hole.innerHTML = chain
      .map((a, i) => {
        const genre = GENRE_CHIPS.find((c) => c.genres.some((g) => a.genres?.includes(g)))?.label;
        return `<li class="${i === 0 ? 'is-start' : ''}">
          <span class="rabbit-dot"></span>
          <span class="rabbit-kind">${STEPS[i]}</span>
          <a class="rabbit-title is-link" href="${BASE}artiste?a=${encodeURIComponent(a.slug)}">${escapeHtml(a.name)}</a>
          <span class="rabbit-sub">${escapeHtml([genre, formatAudience(a)].filter(Boolean).join(' · '))}</span>
        </li>`;
      })
      .join('');
    document.getElementById('rabbit-block')!.hidden = false;
  }

  document.getElementById('rabbit-new')!.addEventListener('click', () => digHole().catch(() => {}));
  digHole().catch(() => {});

  // Recherche dans le catalogue (paramètre ?q= envoyé par la barre du haut)
  const query = new URLSearchParams(location.search).get('q')?.trim();
  if (query) {
    const results = document.getElementById('results')!;
    // Tolérant aux espaces, accents et fautes de frappe. Les résultats trouvés au milieu d'un mot ou avec des fautes
    // (score ≥ 2) n'apparaissent que si rien ne correspond tel quel, et du plus proche au plus lointain
    const items = [...results.querySelectorAll<HTMLElement>('.result')].map((el) => ({ el, score: searchScore(query, el.dataset.search!) }));
    const limit = items.some((i) => i.score !== null && i.score < 2) ? 1 : Infinity;
    let found = 0;
    for (const { el, score } of items) {
      const match = score !== null && score <= limit;
      el.hidden = !match;
      el.style.order = String(score ?? 0);
      if (match) found++;
    }
    document.getElementById('results-query')!.textContent = query;
    document.getElementById('results-releases-label')!.hidden = found === 0;
    document.getElementById('results-empty')!.hidden = found > 0;
    results.hidden = false;
    // Artistes d'abord : tout le catalogue d'artistes, pas seulement ceux qui ont sorti quelque chose récemment
    Promise.all([searchArtists(query, { limit: 12 }), myFollows().catch(() => [])])
      .then(([artists, follows]) => {
        if (!artists.length) return;
        const followed = new Set(follows.map((a) => a.id));
        const box = document.getElementById('results-artists')!;
        box.innerHTML = artists.map((a) => artistCardHtml(a, followed.has(a.id))).join('');
        wireFollowButtons(box);
        document.getElementById('results-artists-block')!.hidden = false;
        document.getElementById('results-empty')!.hidden = true;
      })
      .catch(() => {});
    const input = document.getElementById('topbar-q') as HTMLInputElement | null;
    if (input) input.value = query;
  }
</script>

<style>
  .head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
  }

  .by-genre {
    padding-bottom: 12px;
  }

  .results-label {
    margin: 28px 0 16px;
    font: 800 16px/1 var(--font-display);
    text-transform: uppercase;
  }

  #results-artists-block[hidden],
  .results-label[hidden] {
    display: none;
  }

  /* Artistes trouvés : une rangée qui défile sur le côté */
  .results-artists {
    display: flex;
    gap: 18px;
    overflow-x: auto;
    padding-bottom: 6px;
    scrollbar-width: none;
  }

  .results-artists :global(.bz-artist) {
    flex: 0 0 132px;
  }

  .results-artists :global(.bz-artist-name) {
    font-size: 15px;
  }

  .results {
    margin-top: 56px;
  }

  .explorer {
    display: grid;
    grid-template-columns: minmax(280px, 0.85fr) minmax(0, 1fr);
    gap: 48px;
    margin-top: 64px;
    padding: 48px;
    border: 1px solid var(--color-border);
    border-radius: 14px;
  }

  .cursor-label {
    font: 600 15px/1 var(--font-sans);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .cursor-word {
    margin: 18px 0 26px;
    font: 800 clamp(36px, 5.6vw, 64px) / 1.05 var(--font-display);
    color: var(--color-accent);
  }

  input[type='range'] {
    --fill: 60%;
    width: 100%;
    height: 8px;
    border-radius: 10px;
    appearance: none;
    background: linear-gradient(to right, var(--color-accent) var(--fill), var(--color-border-hover) var(--fill));
    cursor: pointer;
  }

  input[type='range']::-webkit-slider-thumb {
    appearance: none;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--color-accent);
    border: 3px solid var(--color-bg);
    box-shadow: 0 0 0 1px var(--color-accent);
  }

  input[type='range']::-moz-range-thumb {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--color-accent);
    border: 3px solid var(--color-bg);
  }

  .cursor-ends {
    display: flex;
    justify-content: space-between;
    margin-top: 16px;
    font: 600 12px/1 var(--font-sans);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .cursor-why {
    margin-top: 34px;
    font-size: 16px;
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  .cursor-why strong {
    color: var(--color-text);
  }

  .picks {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
    align-content: start;
  }

  .picks[hidden] {
    display: none;
  }

  .block {
    margin-top: 72px;
  }

  .block[hidden] {
    display: none;
  }

  .rabbit {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 24px;
    position: relative;
  }

  .rabbit::before {
    content: '';
    position: absolute;
    top: 10px;
    left: 10px;
    right: 0;
    border-top: 1px dotted var(--color-accent);
    opacity: 0.7;
  }

  .rabbit-new {
    border: 0;
    background: transparent;
    cursor: pointer;
    font-family: var(--font-sans);
  }

  .rabbit :global(li) {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .rabbit :global(.rabbit-dot) {
    width: 21px;
    height: 21px;
    border-radius: 50%;
    border: 2px solid var(--color-accent);
    background: var(--color-bg);
    margin-bottom: 30px;
  }

  .rabbit :global(.is-start .rabbit-dot) {
    background: var(--color-accent);
  }

  .rabbit :global(.rabbit-kind) {
    font: 600 12px/1 var(--font-sans);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .rabbit :global(.rabbit-title) {
    margin: 12px 0 6px;
    font: 800 33px/1 var(--font-display);
    overflow-wrap: anywhere;
  }

  .rabbit :global(.rabbit-sub) {
    font-size: 16px;
    color: var(--color-text-muted);
  }

  .rabbit :global(.rabbit-title.is-link) {
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-underline-offset: 6px;
    text-decoration-thickness: 2px;
  }

  @media (max-width: 1280px) {
    .explorer {
      grid-template-columns: minmax(0, 1fr);
    }
    .rabbit {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      row-gap: 40px;
    }
    .rabbit::before {
      display: none;
    }
  }

  @media (max-width: 900px) {
    .explorer {
      padding: 28px 20px;
      margin-top: 36px;
    }
    .picks {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .rabbit {
      grid-template-columns: 1fr 1fr;
    }
    .rabbit :global(.rabbit-title) {
      font-size: 30px;
    }
  }
</style>
