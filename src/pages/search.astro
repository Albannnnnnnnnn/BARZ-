---
// PAGE EXPLORER - Version simplifiée qui build
import Layout from '../layouts/Layout.astro';
import { getSupabaseServerSafe } from '../lib/supabase';
import ReleaseGrid from '../components/ReleaseGrid.tsx';
import { format } from 'date-fns';
import { fr } from 'date-fns/locale';

const supabase = getSupabaseServerSafe();
const query = Astro.url.searchParams.get('q') || '';
const genre = Astro.url.searchParams.get('genre') || '';
const type = Astro.url.searchParams.get('type') || '';

let results = [];
let total = 0;

if (supabase && (query || genre || type)) {
  try {
    let dbQuery = supabase
      .from('releases')
      .select(`
        *,
        artist:artists!artist_id(*)
      `, { count: 'exact' })
      .order('release_date', { ascending: false })
      .limit(50);

    if (query) {
      dbQuery = dbQuery.or(`title.ilike.%${query}%,artist.name.ilike.%${query}%`);
    }
    if (genre) {
      dbQuery = dbQuery.contains('genres', [genre]);
    }
    if (type && type !== 'all') {
      dbQuery = dbQuery.eq('release_type', type);
    }

    const { data, count, error } = await dbQuery;
    if (!error) {
      results = data || [];
      total = count || 0;
    }
  } catch (e) {
    console.warn('Supabase query failed:', e);
  }
} else if (!supabase) {
  console.warn('Supabase not configured, using empty data for build');
}

const explorerTabs = [
  { id: 'decouverte', label: 'Découverte', active: true },
  { id: 'charts', label: 'Charts', active: false },
  { id: 'calendrier', label: 'Calendrier', active: false },
];

const discoveries = [
  { title: 'Selva Eléctrica', subtitle: 'Los Cometas · Monde', cover: '/BARZ-/placeholder-release.svg' },
  { title: 'Kintsugi', subtitle: 'Tamo & The Fold', cover: '/BARZ-/placeholder-release.svg' },
  { title: 'Lagune', subtitle: 'Nour · Soul', cover: '/BARZ-/placeholder-release.svg' },
];

const rabbitHole = [
  { type: 'ALBUM', title: 'Kintsugi', subtitle: 'Tamo & The Fold', isNew: true },
  { type: 'PRODUCTEUR', title: 'Idris Mbayé', subtitle: '', isNew: false },
  { type: 'A AUSSI PRODUIT', title: '', subtitle: '', isNew: false },
];

---

<Layout title="Explorer - BARZ" description="Sors de ta bulle : découvre de nouveaux albums, artistes et genres adaptés à tes goûts.">
  <div class="container section-lg">
    <header class="mb-12 text-center">
      <span class="inline-block px-2 py-0.5 rounded text-xs font-semibold uppercase tracking-wider text-[#a3e635] bg-[#a3e635]/10 border border-[#a3e635]/25">
        Explorer
      </span>
      <h1 class="text-5xl md:text-6xl font-bold mt-3 mb-2 text-[var(--color-text)]">
        Sors de ta bulle<span class="gradient-text">.</span>
      </h1>
      <p class="text-lg text-muted max-w-2xl mx-auto">
        Trouve de nouveaux artistes et albums adaptés à tes goûts, avec un curseur entre tes habitudes et l'inconnu total.
      </p>
    </header>

    <!-- Onglets Découverte / Charts / Calendrier -->
    <div class="flex gap-2 mb-10" role="tablist" aria-label="Mode d'exploration">
      {explorerTabs.map((t) => (
        <button
          key={t.id}
          type="button"
          role="tab"
          aria-selected={t.active}
          class={`px-5 py-2.5 rounded-full text-sm font-semibold transition ${t.active ? 'bg-[#a3e635] text-[#09090b] shadow-[0_0_20px_rgba(163,230,53,0.35)]' : 'text-[var(--color-text-muted)] hover:text-[var(--color-text)]'}`}
        >
          {t.label}
        </button>
      ))}
    </div>

    <!-- Curseur d'exploration -->
    <section class="mb-12 card p-8 md:p-10 rounded-[var(--radius-xl2)]">
      <div class="flex items-center justify-between mb-1">
        <span class="text-sm font-medium text-[var(--color-text-muted)]">MES HABITUDES</span>
        <span class="text-sm font-medium text-[var(--color-text-muted)]">INCONNU TOTAL</span>
      </div>
      <div class="relative h-3 mb-2">
        <div class="absolute left-0 top-0 h-full w-[30%] bg-gradient-to-r from-[#a3e635] to-transparent rounded-full opacity-80 shadow-[0_0_20px_rgba(163,230,53,0.4)]" />
        <div class="relative h-full w-full bg-[var(--color-bg-hover)] rounded-full overflow-hidden" />
        <div class="absolute top-1/2 left-[30%] -translate-x-1/2 -translate-y-1/2 w-5 h-5 rounded-full bg-[#a3e635] shadow-[0_0_15px_rgba(163,230,53,0.5)]" />
      </div>
      <div class="flex items-center justify-between">
        <span class="text-xs text-dim">Curieux</span>
        <span class="text-xs font-semibold text-[var(--color-text)]">Curieux</span>
      </div>
    </section>

    <!-- Découvertes -->
    {query || genre || type ? (
      <div>
        <div class="flex items-center justify-between mb-6">
          <h2 class="text-2xl font-bold text-[var(--color-text)]">
            Résultats de la recherche
          </h2>
          <p class="text-sm text-muted">{total} résultat{total > 1 ? 's' : ''}</p>
        </div>
        <ReleaseGrid client:visible releases={results} emptyMessage="Aucune sortie ne correspond à votre recherche" />
      </div>
    ) : (
      <div>
        <div class="mb-10">
          <h2 class="text-2xl font-bold mb-4 text-[var(--color-text)]">
            Pour vous cette semaine
          </h2>
          <p class="text-sm text-muted mb-6 max-w-[60ch]">
            Pourquoi ces disques ? Tu écoutes beaucoup de rap ; ces titres sont samplés par ces artistes ou partagent leurs influences.
          </p>
          <div class="grid gap-4 md:grid-cols-3 lg:grid-cols-4">
            {discoveries.map((d) => (
              <article class="card card-interactive overflow-hidden transition group" key={d.title}>
                <div class="relative aspect-[1/1] overflow-hidden">
                  <img src={d.cover} alt={d.title} class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent" />
                  <span class="absolute top-3 right-3 badge badge-new text-xs">Nouveau</span>
                </div>
                <div class="p-4">
                  <h3 class="font-semibold text-base truncate mb-1 text-[var(--color-text)]">{d.title}</h3>
                  <p class="text-sm text-muted truncate">{d.subtitle}</p>
                </div>
              </article>
            ))}
          </div>
        </div>

        <!-- Rabbit Hole -->
        <section class="mt-16">
          <div class="flex items-center justify-between mb-6">
            <h2 class="text-2xl font-bold text-[var(--color-text)]">
              Rabbit Hole
            </h2>
            <span class="badge badge-new text-xs">Nouveau</span>
          </div>
          <div class="flex gap-3 md:gap-6 overflow-x-auto pb-2 scrollbar-hide">
            {rabbitHole.map((r, i) => {
              const isAlbum = r.type === 'ALBUM';
              const first = i === 0;
              return (
                <article key={r.title || r.type} class={`flex-shrink-0 w-72 card overflow-hidden transition group ${first ? 'border-l-2 border-[#a3e635]' : ''}`}>
                  {isAlbum && (
                    <div class="relative aspect-[1/1] overflow-hidden">
                      <img src={discoveries[1].cover} alt={r.title} class="w-full h-full object-cover" loading="lazy" />
                      <span class="absolute top-3 right-3 badge badge-new text-xs">Nouveau</span>
                    </div>
                  )}
                  <div class="p-4">
                    <p class="text-[0.7rem] uppercase tracking-widest text-[var(--color-text-muted)] font-semibold mb-1">{r.type}</p>
                    <h3 class="text-lg font-bold mb-1 text-[var(--color-text)]">{r.title}</h3>
                    {r.subtitle && <p class="text-sm text-muted truncate">{r.subtitle}</p>}
                    {!r.subtitle && <p class="text-sm text-muted">Suivre ce producteur</p>}
                  </div>
                </article>
              );
            })}
          </div>
        </section>
      </div>
    )}
  </div>
</Layout>

<style>
  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
</style>