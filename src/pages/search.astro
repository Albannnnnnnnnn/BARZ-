---
// PAGE EXPLORER - Maquette PC
import Layout from '../layouts/Layout.astro';
import { getSupabaseServerSafe } from '../lib/supabase';
import ReleaseGrid from '../components/ReleaseGrid.tsx';
import { format } from 'date-fns';
import { fr } from 'date-fns/locale';

const supabase = getSupabaseServerSafe();
const query = Astro.url.searchParams.get('q') || '';
const genre = Astro.url.searchParams.get('genre') || '';
const type = Astro.url.searchParams.get('type') || '';

let results = [];
let total = 0;

if (supabase && (query || genre || type)) {
  try {
    let dbQuery = supabase
      .from('releases')
      .select(`
        *,
        artist:artists!artist_id(*)
      `, { count: 'exact' })
      .order('release_date', { ascending: false })
      .limit(50);

    if (query) {
      dbQuery = dbQuery.or(`title.ilike.%${query}%,artist.name.ilike.%${query}%`);
    }
    if (genre) {
      dbQuery = dbQuery.contains('genres', [genre]);
    }
    if (type && type !== 'all') {
      dbQuery = dbQuery.eq('release_type', type);
    }

    const { data, count, error } = await dbQuery;
    if (!error) {
      results = data || [];
      total = count || 0;
    }
  } catch (e) {
    console.warn('Supabase query failed:', e);
  }
} else if (!supabase) {
  console.warn('Supabase not configured, using empty data for build');
}

const explorerTabs = [
  { id: 'decouverte', label: 'Découverte', active: true },
  { id: 'charts', label: 'Charts', active: false },
  { id: 'calendrier', label: 'Calendrier', active: false },
];

const discoveries = [
  { title: 'Selva Eléctrica', subtitle: 'Los Cometas · Monde', cover: '/BARZ-/placeholder-release.svg' },
  { title: 'Kintsugi', subtitle: 'Tamo & The Fold', cover: '/BARZ-/placeholder-release.svg' },
  { title: 'Lagune', subtitle: 'Nour · Soul', cover: '/BARZ-/placeholder-release.svg' },
];

const rabbitHole = [
  { type: 'ALBUM', title: 'Kintsugi', subtitle: 'Tamo & The Fold', isNew: true },
  { type: 'PRODUCTEUR', title: 'Idris Mbayé', subtitle: '', isNew: false },
  { type: 'A AUSSI PRODUIT', title: '', subtitle: '', isNew: false },
];

const moodCards = [
  { label: 'Travail', desc: 'Concentration, instrumental', color: '#3b82f6' },
  { label: 'Sport', desc: 'BPM élevés, énergie', color: '#f97316' },
  { label: 'Nuit', desc: 'Ambient, deep house', color: '#8b5cf6' },
  { label: 'Dimanche', desc: 'Soul, folk, jazz doux', color: '#eab308' },
];
---

<Layout title="Explorer - BARZ" description="Sors de ta bulle : découvre de nouveaux albums, artistes et genres adaptés à tes goûts.">
  <div class="container section-sm py-4">
    {/* Desktop header */}
    <div class="desktop-only">
      <div class="flex items-center justify-between mb-8">
        <div>
          <span class="inline-block px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-widest text-lime bg-lime/10 border border-lime/25 mb-2 block">Explorer</span>
          <h1 class="font-serif text-5xl font-bold mt-0 mb-3 text-[var(--color-text)] leading-tight">Sors de ta bulle<span class="text-lime">.</span></h1>
          <p class="text-sm text-muted max-w-lg">
            Trouve de nouveaux artistes et albums adaptés à tes goûts, avec un curseur entre tes habitudes et l'inconnu total.
          </p>
        </div>
        <div class="flex gap-2">
          <button class="px-4 py-2 rounded-full bg-[#a3e635] text-[#09090b] text-xs font-bold">Découverte</button>
          <button class="px-4 py-2 rounded-full border border-[var(--color-border)] text-[var(--color-text-muted)] text-xs font-bold hover:text-[var(--color-text)] hover:border-[var(--color-border-hover)] transition">Charts</button>
          <button class="px-4 py-2 rounded-full border border-[var(--color-border)] text-[var(--color-text-muted)] text-xs font-bold hover:text-[var(--color-text)] hover:border-[var(--color-border-hover)] transition">Calendrier</button>
        </div>
      </div>
    </div>

    {/* Mobile header */}
    <div class="mobile-only mb-6">
      <div class="flex items-center justify-between px-4 pt-2 pb-1 text-[10px] text-muted font-mono">
        <span>Explorer</span>
        <span>100%</span>
      </div>
      <div class="text-center mb-6">
        <span class="inline-block px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-widest text-lime bg-lime/10 border border-lime/25 mb-3 block">Explorer</span>
        <h1 class="font-serif text-4xl md:text-5xl font-bold mt-1 mb-3 text-[var(--color-text)] leading-tight">
          Sors de ta bulle<span class="text-lime">.</span>
        </h1>
        <p class="text-sm text-muted mb-6 max-w-[280px] mx-auto">
          Trouve de nouveaux artistes et albums adaptés à tes goûts, avec un curseur entre tes habitudes et l'inconnu total.
        </p>
      </div>
    </div>

    {/* Barre de recherche */}
    <form class="card p-5 mb-6 rounded-[var(--radius-xl2)]" method="GET" action="/BARZ-/search">
      <div class="flex flex-col md:flex-row gap-3 items-end">
        <div class="flex-1">
          <label for="search-q" class="sr-only">Rechercher un album, un artiste, un genre...</label>
          <input
            type="search"
            id="search-q"
            name="q"
            placeholder="Album, artiste, genre..."
            class="input text-lg"
            autocomplete="off"
          />
        </div>
        <button type="submit" class="btn btn-primary btn-sm px-6" aria-label="Chercher">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="8" />
            <path d="M21 21l-4.35-4.35" />
          </svg>
          <span class="hidden sm:inline">Chercher</span>
        </button>
      </div>
    </form>

    {/* Onglets */}
    <div class="flex gap-1 mb-8" role="tablist" aria-label="Mode d'exploration">
      {explorerTabs.map((t) => (
        <button
          key={t.id}
          type="button"
          role="tab"
          aria-selected={t.active ? 'true' : 'false'}
          class={`px-5 py-2 rounded-full text-sm font-bold transition ${t.active ? 'bg-[#a3e635] text-[#09090b] shadow-[0_0_20px_rgba(163,230,53,0.35)]' : 'text-[var(--color-text-muted)] hover:text-[var(--color-text)]'}`}
        >
          {t.label}
        </button>
      ))}
    </div>

    {/* Curseur */}
    <section class="mb-8 card p-5 rounded-[var(--radius-xl2)]">
      <div class="flex items-center justify-between mb-2">
        <span class="text-xs font-medium text-[var(--color-text-muted)]">Mes habitudes</span>
        <span class="text-xs font-medium text-[var(--color-text-muted)]">Inconnu total</span>
      </div>
      <div class="relative h-2 mb-3">
        <div class="absolute left-0 top-0 h-full w-[30%] bg-gradient-to-r from-[#a3e635] to-transparent rounded-full opacity-80 shadow-[0_0_15px_rgba(163,230,53,0.4)]" />
        <div class="relative h-full w-full bg-[var(--color-bg-hover)] rounded-full overflow-hidden" />
        <div class="absolute top-1/2 left-[30%] -translate-x-1/2 -translate-y-1/2 w-4 h-4 rounded-full bg-[#a3e635] shadow-[0_0_10px_rgba(163,230,53,0.5)]" />
      </div>
      <div class="flex items-center justify-between">
        <span class="text-[10px] text-dim">Curieux</span>
        <span class="text-[10px] font-bold text-[var(--color-text)]">Curieux</span>
      </div>
    </section>

    {/* Découvertes / Résultats */}
    {query || genre || type ? (
      <div>
        <div class="flex items-center justify-between mb-4">
          <h2 class="font-serif text-xl font-bold text-[var(--color-text)] leading-tight">Résultats de la recherche</h2>
          <p class="text-xs text-muted">{total} résultat{total > 1 ? 's' : ''}</p>
        </div>
        <ReleaseGrid client:visible releases={results} emptyMessage="Aucune sortie ne correspond à votre recherche" />
      </div>
    ) : (
      <div>
        <div class="mb-6">
          <h2 class="font-serif text-xl font-bold mb-2 text-[var(--color-text)] leading-tight">Pour vous cette semaine</h2>
          <p class="text-xs text-muted mb-5 max-w-[280px]">
            Pourquoi ces disques ? Tu écoutes beaucoup de rap ; ces titres sont samplés par ces artistes ou partagent leurs influences.
          </p>
          <div class="grid gap-4">
            {discoveries.map((d) => (
              <article class="card card-interactive overflow-hidden transition group" key={d.title}>
                <div class="relative aspect-[1/1] overflow-hidden">
                  <img src={d.cover} alt={d.title} class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" />
                  <span class="absolute top-3 right-3 badge bg-[#a3e635] text-[#09090b] text-[10px] font-bold">Nouveau</span>
                </div>
                <div class="p-4">
                  <h3 class="font-bold text-base truncate mb-1 text-[var(--color-text)]">{d.title}</h3>
                  <p class="text-sm text-muted truncate">{d.subtitle}</p>
                </div>
              </article>
            ))}
          </div>
        </div>

        {/* Rabbit Hole */}
        <section class="mt-10">
          <div class="flex items-center justify-between mb-4">
            <h2 class="font-serif text-xl font-bold text-[var(--color-text)] leading-tight">Rabbit Hole</h2>
            <span class="badge bg-[#a3e635] text-[#09090b] text-[10px] font-bold">Nouveau</span>
          </div>
          <div class="flex gap-3 overflow-x-auto pb-2 scrollbar-hide">
            {rabbitHole.map((r, i) => {
              const isAlbum = r.type === 'ALBUM';
              const first = i === 0;
              return (
                <article key={r.title || r.type} class={`flex-shrink-0 w-[200px] card overflow-hidden transition group ${first ? 'border-l-2 border-[#a3e635]' : ''}`}>
                  {isAlbum && (
                    <div class="relative aspect-[1/1] overflow-hidden">
                      <img src={discoveries[1].cover} alt={r.title} class="w-full h-full object-cover" loading="lazy" />
                      <span class="absolute top-3 right-3 badge bg-[#a3e635] text-[#09090b] text-[10px] font-bold">Nouveau</span>
                    </div>
                  )}
                  <div class="p-4">
                    <p class="text-[0.7rem] uppercase tracking-widest text-[var(--color-text-muted)] font-semibold mb-1">{r.type}</p>
                    <h3 class="font-bold text-lg mb-1 text-[var(--color-text)]">{r.title}</h3>
                    {r.subtitle && <p class="text-sm text-muted truncate">{r.subtitle}</p>}
                    {!r.subtitle && <p class="text-sm text-muted">Suivre ce producteur</p>}
                  </div>
                </article>
              );
            })}
          </div>
        </section>

        {/* Par humeur - Desktop */}
        <div class="desktop-only mt-10">
          <h2 class="font-serif text-3xl font-bold mb-6 text-[var(--color-text)] leading-tight">Par humeur</h2>
          <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
            {moodCards.map((m) => (
              <article class="card card-interactive p-6 rounded-[var(--radius-lg)]" key={m.label}>
                <h3 class="font-serif text-2xl font-bold mb-2 text-[var(--color-text)]" style={{ color: m.color }}>{m.label}</h3>
                <p class="text-xs text-muted">{m.desc}</p>
              </article>
            ))}
          </div>
        </div>

        {/* Par humeur - Mobile */}
        <div class="mobile-only mt-10">
          <h2 class="font-serif text-xl font-bold mb-4 text-[var(--color-text)] leading-tight">Par humeur</h2>
          <div class="grid grid-cols-2 gap-3">
            {moodCards.map((m) => (
              <article class="card card-interactive p-4 rounded-[var(--radius-lg)]" key={m.label}>
                <h3 class="font-serif text-lg font-bold mb-1 text-[var(--color-text)]" style={{ color: m.color }}>{m.label}</h3>
                <p class="text-[10px] text-muted">{m.desc}</p>
              </article>
            ))}
          </div>
        </div>
      </div>
    )}
  </div>
</Layout>

<style>
  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
</style>