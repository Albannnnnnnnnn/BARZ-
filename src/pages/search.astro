---
// PAGE RECHERCHE
import Layout from '../layouts/Layout.astro';
import { getSupabaseServerSafe } from '../lib/supabase';
import ReleaseGrid from '../components/ReleaseGrid.tsx';
import { format } from 'date-fns';

const supabase = getSupabaseServerSafe();
const query = Astro.url.searchParams.get('q') || '';
const genre = Astro.url.searchParams.get('genre') || '';
const type = Astro.url.searchParams.get('type') || '';

let results: any[] = [];
let total = 0;
let allGenres: string[] = [];

if (supabase) {
  try {
    // Récupérer tous les genres pour le filtre
    const { data: allReleasesForGenres } = await supabase
      .from('releases')
      .select('genres')
      .not('genres', 'is', null);

    allGenres = [...new Set(
      (allReleasesForGenres || []).flatMap((r: any) => r.genres || [])
    )].sort();

    if (query || genre || type) {
      let dbQuery = supabase
        .from('releases')
        .select(`
          *,
          artist:artists!artist_id(*)
        `, { count: 'exact' })
        .order('release_date', { ascending: false })
        .limit(50);

      if (query) {
        dbQuery = dbQuery.or(`title.ilike.%${query}%,artist.name.ilike.%${query}%`);
      }
      if (genre) {
        dbQuery = dbQuery.contains('genres', [genre]);
      }
      if (type && type !== 'all') {
        dbQuery = dbQuery.eq('release_type', type);
      }

      const { data, count, error } = await dbQuery;
      if (!error) {
        results = data || [];
        total = count || 0;
      }
    }
  } catch (e) {
    console.warn('Supabase query failed:', e);
  }
} else {
  console.warn('Supabase not configured, using empty data for build');
}
---

<Layout title={`Recherche${query ? ` : ${query}` : ''} - BARZ`} description="Recherche des albums, EPs, singles par titre, artiste, genre ou type.">
  <div class="container section">
    <header class="mb-8">
      <h1 class="text-4xl font-bold mb-2" style="letter-spacing: -0.03em; color: var(--color-text);">
        Recherche
      </h1>
      <p class="text-lg" style="color: var(--color-text-muted);">
        Trouve tes sorties par titre, artiste, genre ou type.
      </p>
    </header>

    <!-- Formulaire recherche -->
    <form class="card p-6 mb-8" method="GET" action="/search">
      <div class="flex flex-col md:flex-row gap-4">
        <div class="flex-1">
          <label for="search-q" class="sr-only">Rechercher un album, un artiste...</label>
          <input
            type="search"
            id="search-q"
            name="q"
            value={query}
            placeholder="Titre d'album, nom d'artiste..."
            class="input"
            autocomplete="off"
          />
        </div>
        <div class="flex gap-2">
          <select name="genre" id="search-genre" class="input" style="width: auto; min-width: 180px;">
            <option value="">Tous les genres</option>
            {allGenres.map(g => (
              <option value={g} selected={genre === g}>{g}</option>
            ))}
          </select>
          <select name="type" id="search-type" class="input" style="width: auto; min-width: 140px;">
            <option value="all" selected={type === 'all' || !type}>Tous types</option>
            <option value="album" selected={type === 'album'}>Album</option>
            <option value="ep" selected={type === 'ep'}>EP</option>
            <option value="single" selected={type === 'single'}>Single</option>
            <option value="compilation" selected={type === 'compilation'}>Compilation</option>
          </select>
          <button type="submit" class="btn btn-primary whitespace-nowrap">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" aria-hidden="true">
              <circle cx="11" cy="11" r="8" />
              <path d="M21 21l-4.35-4.35" />
            </svg>
            <span class="hidden sm:inline">Rechercher</span>
          </button>
        </div>
      </div>
    </form>

    {query || genre || type ? (
      <>
        <p class="mb-6" style="color: var(--color-text-muted);">
          {total} résultat{total > 1 ? 's' : ''} trouvé{total > 1 ? 's' : ''}
          {query && <span> pour « {query} »</span>}
          {genre && <span> dans {genre}</span>}
          {type && type !== 'all' && <span> ({type})</span>}
        </p>

        <ReleaseGrid
          client:visible
          releases={results}
          emptyMessage="Aucune sortie ne correspond à votre recherche"
        />
      </>
    ) : (
      <div class="text-center py-16">
        <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.5" class="mx-auto mb-4" style={{ color: 'var(--color-text-dim)' }}>
          <circle cx="11" cy="11" r="8" />
          <path d="M21 21l-4.35-4.35" />
        </svg>
        <h2 class="text-xl font-semibold mb-2" style="color: var(--color-text);">Commence ta recherche</h2>
        <p class="text-muted">Entre un titre, un artiste ou choisis un genre</p>
      </div>
    )}
  </div>
</Layout>