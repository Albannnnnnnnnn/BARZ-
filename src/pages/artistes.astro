---
// CATALOGUE D'ARTISTES : parcourir par genre, chercher, suivre (lu par le navigateur dans Supabase)
import Layout from '../layouts/Layout.astro';
import { GENRE_CHIPS } from '../lib/genres';
---

<Layout title="Artistes" description="Le catalogue d’artistes de BARZ¡ : parcours par genre, cherche, suis tes artistes.">
  <div class="bz-page">
    <div class="head">
      <div>
        <span class="bz-eyebrow">Découvrir</span>
        <h1 class="bz-display">Tous <em>les artistes.</em></h1>
        <p class="count" id="catalog-count">&nbsp;</p>
      </div>
      <a class="bz-link back-discover" href="/BARZ-/search">← Découvrir</a>
    </div>

    <div class="controls">
      <label class="sr-only" for="artist-q">Chercher un artiste</label>
      <input id="artist-q" class="bz-input search" type="search" placeholder="Chercher un artiste…" autocomplete="off" />
      <div class="bz-chips" id="artist-genres" role="group" aria-label="Filtrer par genre">
        <button type="button" class="bz-chip is-active" data-genre="" aria-pressed="true">Tous</button>
        {GENRE_CHIPS.map((c) => (
          <button type="button" class="bz-chip" data-genre={c.id} aria-pressed="false">{c.label}</button>
        ))}
        <button type="button" class="bz-chip" data-genre="followed" aria-pressed="false">Mes artistes</button>
      </div>
      <div class="bz-chips" id="artist-sort" role="group" aria-label="Trier par audience">
        <button type="button" class="bz-chip is-active" data-sort="" aria-pressed="true">Les plus écoutés</button>
        <button type="button" class="bz-chip" data-sort="decouverte" aria-pressed="false">Les moins connus</button>
      </div>
    </div>

    <div class="bz-artists" id="artist-grid" aria-live="polite"></div>
    <p class="bz-empty" id="artist-empty" hidden></p>
    <!-- Recherche : l'artiste n'est peut-être pas encore au catalogue -->
    <p class="deezer-hint" id="artist-deezer" hidden>Pas celui que tu cherches ? <a class="bz-link" id="artist-deezer-link" href="/BARZ-/artiste">Chercher « <span id="artist-deezer-name"></span> » sur Deezer →</a></p>
    <button type="button" class="bz-btn bz-btn--outline more" id="artist-more" hidden>Voir plus d’artistes</button>
  </div>
</Layout>

<script>
  import { ARTIST_LITE, artistCardHtml, authErrorMessage, errorText, myFollows, searchArtists, supabase, wireFollowButtons, type ArtistLite } from '../scripts/social';
  import { GENRE_CHIPS } from '../lib/genres';
  import { audience } from '../lib/audience';

  // Sur mobile, moins d'artistes à la fois : la page reste courte, « Voir plus » charge la suite
  const PAGE = matchMedia('(max-width: 900px)').matches ? 24 : 48;
  // « Les moins connus » : sous MIN_LISTENERS auditeurs, surtout de faux artistes de playlists, sauf ceux que
  // Deezer confirme (artistes réels peu présents sur Last.fm, souvent africains ou francophones)
  const MIN_LISTENERS = 1000;
  const MIN_DEEZER_FANS = 10_000;
  const grid = document.getElementById('artist-grid')!;
  const empty = document.getElementById('artist-empty')!;
  const more = document.getElementById('artist-more') as HTMLButtonElement;
  const input = document.getElementById('artist-q') as HTMLInputElement;
  const params = new URLSearchParams(location.search);
  let genre = params.get('genre') ?? '';
  let sort = params.get('tri') === 'decouverte' ? 'decouverte' : '';
  let query = '';
  let offset = 0;
  let followed = new Set<string>();
  let followedList: ArtistLite[] = [];

  async function fetchPage(): Promise<ArtistLite[]> {
    const ascending = sort === 'decouverte';
    if (genre === 'followed') {
      const sorted = [...followedList].sort((a, b) => (ascending ? audience(a) - audience(b) : audience(b) - audience(a)));
      return sorted.slice(offset, offset + PAGE);
    }
    if (!supabase) return [];
    // Avec une recherche : résultats du plus pertinent au moins pertinent, en une seule page
    if (query) {
      if (offset > 0) return [];
      const chip = GENRE_CHIPS.find((c) => c.id === genre);
      return searchArtists(query, { genres: chip?.genres, limit: PAGE });
    }
    // Audience = moyenne Last.fm / Deezer (colonne calculée, supabase/audience.sql)
    let q = supabase.from('artists').select(ARTIST_LITE).order('audience', { ascending }).range(offset, offset + PAGE - 1);
    if (ascending) q = q.or(`lastfm_listeners.gte.${MIN_LISTENERS},popularity.gte.${MIN_DEEZER_FANS}`);
    const chip = GENRE_CHIPS.find((c) => c.id === genre);
    if (chip) q = q.overlaps('genres', chip.genres);
    const { data, error } = await q;
    if (error) throw error;
    return (data ?? []) as ArtistLite[];
  }

  async function load(reset: boolean) {
    if (reset) {
      offset = 0;
      grid.innerHTML = '';
    }
    try {
      const page = await fetchPage();
      grid.insertAdjacentHTML('beforeend', page.map((a) => artistCardHtml(a, followed.has(a.id))).join(''));
      offset += page.length;
      more.hidden = page.length < PAGE;
      const hint = document.getElementById('artist-deezer')!;
      hint.hidden = !query;
      if (query) {
        document.getElementById('artist-deezer-name')!.textContent = query;
        (document.getElementById('artist-deezer-link') as HTMLAnchorElement).href = `/BARZ-/artiste?nom=${encodeURIComponent(query)}`;
      }
      empty.hidden = grid.children.length > 0;
      empty.textContent = genre === 'followed' ? 'Tu ne suis encore aucun artiste : clique sur « Suivre » sous ceux que tu aimes.' : 'Aucun artiste trouvé.';
    } catch (err) {
      empty.textContent = errorText(err);
      empty.hidden = false;
    }
  }

  async function init() {
    if (supabase) {
      const { count } = await supabase.from('artists').select('*', { count: 'exact', head: true });
      if (count) document.getElementById('catalog-count')!.textContent = `${count.toLocaleString('fr-FR')} artistes dans le catalogue.`;
    }
    followedList = await myFollows().catch(() => []);
    followed = new Set(followedList.map((a) => a.id));
    markActive('[data-genre]', document.querySelector(`[data-genre="${genre}"]`) ?? document.querySelector('[data-genre=""]')!);
    markActive('[data-sort]', document.querySelector(`[data-sort="${sort}"]`)!);
    load(true);
  }

  document.getElementById('artist-genres')!.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-genre]');
    if (!button) return;
    genre = button.dataset.genre ?? '';
    markActive('[data-genre]', button);
    updateUrl();
    load(true);
  });

  document.getElementById('artist-sort')!.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-sort]');
    if (!button) return;
    sort = button.dataset.sort ?? '';
    markActive('[data-sort]', button);
    updateUrl();
    load(true);
  });

  function markActive(selector: string, active: HTMLElement) {
    document.querySelectorAll<HTMLButtonElement>(selector).forEach((b) => {
      b.classList.toggle('is-active', b === active);
      b.setAttribute('aria-pressed', String(b === active));
    });
  }

  function updateUrl() {
    const next = new URLSearchParams();
    if (genre) next.set('genre', genre);
    if (sort) next.set('tri', sort);
    history.replaceState(null, '', next.size ? `?${next}` : location.pathname);
  }

  let timer: number | undefined;
  input.addEventListener('input', () => {
    clearTimeout(timer);
    timer = window.setTimeout(() => {
      query = input.value.trim();
      load(true);
    }, 250);
  });

  more.addEventListener('click', () => load(false));
  wireFollowButtons(grid, (id, on) => (on ? followed.add(id) : followed.delete(id)));
  init();
</script>

<style>
  .head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
  }


  .count {
    margin-top: 18px;
    font-size: 17px;
    color: var(--color-text-muted);
  }

  .controls {
    display: flex;
    flex-direction: column;
    gap: 18px;
    margin: 44px 0 40px;
  }

  .search {
    max-width: 520px;
  }

  .more {
    display: block;
    margin: 44px auto 0;
    padding: 14px 26px;
    font-size: 15px;
  }

  .more[hidden],
  .bz-empty[hidden] {
    display: none;
  }

  .deezer-hint {
    margin-top: 24px;
    color: var(--color-text-muted);
  }

  .deezer-hint[hidden] {
    display: none;
  }

  .back-discover {
    padding-bottom: 12px;
  }

  /* Sur mobile, genres et tri tiennent chacun sur une ligne qui défile sur le côté */
  @media (max-width: 900px) {
    #artist-genres,
    #artist-sort {
      flex-wrap: nowrap;
      margin-inline: -16px;
      padding-inline: 16px;
      overflow-x: auto;
      scrollbar-width: none;
    }
    #artist-genres::-webkit-scrollbar,
    #artist-sort::-webkit-scrollbar {
      display: none;
    }
    #artist-genres .bz-chip,
    #artist-sort .bz-chip {
      flex-shrink: 0;
      white-space: nowrap;
    }
  }
</style>
