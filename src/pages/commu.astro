---
// PAGE COMMU - Communauté (maquette PC)
import Layout from '../layouts/Layout.astro';

const tabs = [
  { id: 'activite', label: 'Activité', active: true },
  { id: 'suivis', label: 'Suivis', active: false },
  { id: 'decouvertes', label: 'Découvertes', active: false },
];

const activityFeed = [
  {
    id: 1,
    user: { name: 'Inès', handle: '@ines.wav', avatar: '/BARZ-/placeholder-release.svg', color: '#f43f5e' },
    action: 'a écrit',
    time: 'il y a 1 h',
    content: '« Je n\'écoutais jamais de jazz. Le défi de la semaine m\'a convertie. »',
    cover: '/BARZ-/placeholder-release.svg',
    coverTitle: 'Kintsugi',
    coverScore: 9.5,
    likes: 214,
    comments: 0,
  },
  {
    id: 2,
    user: { name: 'Malik', handle: '@malikbeats', avatar: '/BARZ-/placeholder-release.svg', color: '#3b82f6' },
    action: 'a écrit',
    time: 'il y a 1 h',
    content: '« Le deuxième couplet de « Verglas »… On en parle ? »',
    cover: '/BARZ-/placeholder-release.svg',
    coverTitle: 'Néon Lents',
    coverScore: 8.0,
    likes: 98,
    comments: 0,
  },
  {
    id: 3,
    user: { name: 'Jade', handle: '@jadesurvinyle', avatar: '/BARZ-/placeholder-release.svg', color: '#eab308' },
    action: 'a écrit',
    time: 'il y a 1 h',
    content: '« Bonne prod, mais ça manque de prises de risque. »',
    cover: '/BARZ-/placeholder-release.svg',
    coverTitle: 'Terre Brûlée',
    coverScore: 7.0,
    likes: 41,
    comments: 0,
  },
];

const topContributeurs = [
  { rank: 1, handle: '@ines.wav' },
  { rank: 2, handle: '@malikbeats' },
  { rank: 3, handle: '@jadesurvinyle' },
];
---

<Layout title="Commu - BARZ" description="Les Barz du jour : posts de la communauté, blend, top contributeurs.">
  <div class="container section-sm py-4">
    {/* Desktop header */}
    <div class="desktop-only mb-8">
      <div class="flex items-center justify-between mb-4">
        <span class="inline-block px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-widest text-lime bg-lime/10 border border-lime/25">Communauté</span>
      </div>
      <h1 class="font-serif text-5xl font-bold mt-0 mb-2 text-[var(--color-text)] leading-tight">
        Les Barz du jour<span class="text-lime">.</span>
      </h1>
    </div>

    {/* Mobile header */}
    <div class="mobile-only mb-6">
      <div class="flex items-center justify-between px-4 pt-2 pb-1 text-[10px] text-muted font-mono">
        <span>Commu</span>
        <span>100%</span>
      </div>
      <div class="mb-6">
        <span class="inline-block px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-widest text-lime bg-lime/10 border border-lime/25 mb-3 block">Commu</span>
        <h1 class="font-serif text-4xl font-bold mt-1 mb-2 text-[var(--color-text)] leading-tight">
          Ta commu<span class="text-lime">.</span>
        </h1>
        <p class="text-sm text-muted">
          Ce que tes potes écoutent, notent, partagent. Et qui tu devrais suivre.
        </p>
      </div>
    </div>

    {/* Publish bar */}
    <div class="card p-0 rounded-[var(--radius-xl2)] overflow-hidden mb-8">
      <div class="flex items-start gap-3 p-5">
        <div class="w-10 h-10 rounded-full bg-[#a3e635] flex items-center justify-center text-[14px] font-bold text-[#09090b] flex-shrink-0">A</div>
        <div class="flex-1 min-w-0">
          <p class="text-sm text-[var(--color-text-muted)]">Qu'as-tu écouté aujourd'hui ? Écris ton Barz...</p>
        </div>
        <button class="bg-[#a3e635] text-[#09090b] px-6 py-2 rounded-full text-xs font-bold hover:bg-[#b5f642] transition">Publier</button>
      </div>
    </div>

    {/* Desktop layout: feed + right sidebar */}
    <div class="desktop-only grid lg:grid-cols-12 gap-8">
      <div class="lg:col-span-8">
        {/* Activity feed */}
        <div class="space-y-4">
          {activityFeed.map((post) => (
            <article key={post.id} class="card p-0 overflow-hidden">
              <div class="p-4">
                <div class="flex items-start gap-3 mb-3">
                  <div class="w-8 h-8 rounded-full border border-[var(--color-border)] overflow-hidden flex-shrink-0">
                    <img src={post.user.avatar} alt={post.user.name} class="w-full h-full object-cover" />
                  </div>
                  <div class="flex-1 min-w-0">
                    <div class="flex items-center gap-2 mb-1">
                      <span class="font-semibold text-sm text-[var(--color-text)]">{post.user.name}</span>
                      <span class="text-xs text-muted">{post.user.handle}</span>
                      <span class="text-xs text-dim ml-auto">{post.time}</span>
                    </div>
                    <p class="text-sm text-[var(--color-text)]">{post.content}</p>
                  </div>
                </div>
                <div class="flex items-center gap-4 pt-3 border-t border-[var(--color-border)]">
                  <div class="flex items-center gap-3">
                    <img src={post.cover} alt={post.coverTitle} class="w-12 h-12 rounded-[var(--radius-md)] object-cover flex-shrink-0" />
                    <div class="min-w-0 flex-1">
                      <span class="text-[10px] font-bold text-[var(--color-text)] truncate">{post.coverTitle}</span>
                      <span class="text-[10px] font-bold bg-[#a3e635] text-[#09090b] px-2 py-0.5 rounded">{post.coverScore}</span>
                    </div>
                  </div>
                  <div class="flex items-center gap-1 text-xs text-muted">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" /></svg>
                    <span>{post.likes}</span>
                  </div>
                  <button class="text-xs text-muted hover:text-[var(--color-accent)] transition">Répondre</button>
                  <button class="text-xs text-muted hover:text-[var(--color-accent)] transition ml-auto">Partager</button>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>

      <div class="lg:col-span-4">
        <div class="space-y-6">
          {/* En direct */}
          <div class="rounded-[var(--radius-xl2)] border border-[var(--color-border)] bg-[var(--color-bg-elevated)] p-4">
            <div class="flex items-center justify-between mb-3">
              <span class="text-[10px] font-bold text-lime uppercase tracking-wider">En direct</span>
              <span class="text-[10px] font-bold text-muted uppercase tracking-wider">Écoute commune</span>
            </div>
            <div class="relative aspect-[16/10] overflow-hidden rounded-[var(--radius-lg)] mb-3">
              <img src="/BARZ-/placeholder-release.svg" alt="Kintsugi en direct" class="w-full h-full object-cover" loading="lazy" />
            </div>
            <h3 class="font-bold text-sm text-[var(--color-text)] mb-2">Kintsugi en entier, ce soir 21 h</h3>
            <button class="w-full bg-[#a3e635] text-[#09090b] px-4 py-2 rounded-lg text-xs font-bold hover:bg-[#b5f642] transition">Rejoindre · 342 inscrits</button>
          </div>

          {/* Blend */}
          <div class="rounded-[var(--radius-xl2)] border border-[var(--color-border)] bg-[var(--color-bg-elevated)] p-4">
            <span class="text-[10px] font-bold text-lime uppercase tracking-wider block mb-3">Blend</span>
            <h3 class="font-serif text-xl font-bold mb-4 text-[var(--color-text)] leading-tight">Toi et Inès avez 72 % de goûts en commun.</h3>
            <button class="w-full bg-[#a3e635] text-[#09090b] px-6 py-2 rounded-full text-xs font-bold hover:bg-[#b5f642] transition">Créer une playlist commune</button>
          </div>

          {/* Top contributeurs */}
          <div>
            <h3 class="font-serif text-2xl font-bold mb-4 text-[var(--color-text)]">Top contributeurs</h3>
            <ol class="space-y-3">
              {topContributeurs.map((c) => (
                <li key={c.handle} class="flex items-center justify-between group">
                  <div class="flex items-center gap-2">
                    <span class="text-[10px] font-bold text-muted w-4 text-center">{c.rank}</span>
                    <span class="text-sm font-medium text-[var(--color-text)]">{c.handle}</span>
                  </div>
                  <button class="text-xs text-muted border border-[var(--color-border)] px-3 py-1 rounded-full hover:bg-[var(--color-bg-hover)] hover:text-[var(--color-text)] transition">Suivre</button>
                </li>
              ))}
            </ol>
          </div>
        </div>
      </div>
    </div>

    {/* Mobile tabs + feed */}
    <div class="mobile-only">
      {/* Onglets */}
      <div class="flex gap-1 mb-6" role="tablist" aria-label="Sections communauté">
        {tabs.map((t) => (
          <button
            key={t.id}
            type="button"
            role="tab"
            aria-selected={t.active ? 'true' : 'false'}
            class={`px-5 py-2 rounded-full text-sm font-bold transition ${t.active ? 'bg-[#a3e635] text-[#09090b] shadow-[0_0_20px_rgba(163,230,53,0.35)]' : 'text-[var(--color-text-muted)] hover:text-[var(--color-text)]'}`}
          >
            {t.label}
          </button>
        ))}
      </div>

      {/* Activité */}
      <section id="activite" role="tabpanel" aria-labelledby="activite" class="space-y-4">
        {activityFeed.map((post) => (
          <article key={post.id} class="card p-4 transition group">
            <div class="flex items-start gap-3">
              <img src={post.user.avatar} alt={post.user.name} class="w-10 h-10 rounded-full object-cover border border-[var(--color-border)]" />
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2">
                  <span class="font-semibold text-sm text-[var(--color-text)]">{post.user.name}</span>
                  <span class="text-xs text-muted">{post.user.handle}</span>
                  <span class="text-xs text-dim ml-auto">{post.time}</span>
                </div>
                <p class="text-sm text-[var(--color-text-muted)] mt-1">
                  <span class="font-medium text-[var(--color-text)]">{post.user.name}</span> {post.action}
                </p>
                <div class="flex items-center gap-3 mt-3 p-3 bg-[var(--color-bg-hover)] rounded-[var(--radius-md)]">
                  <img src={post.cover} alt={post.coverTitle} class="w-10 h-10 rounded-[var(--radius-sm)] object-cover flex-shrink-0" />
                  <div class="min-w-0 flex-1">
                    <p class="font-semibold text-sm truncate text-[var(--color-text)]">{post.coverTitle}</p>
                    <span class="flex items-center gap-1 text-sm font-bold text-[#a3e635]">{post.coverScore} / 10</span>
                  </div>
                </div>
                <p class="mt-3 text-sm text-[var(--color-text)] bg-[var(--color-bg-surface)] p-3 rounded-[var(--radius-sm)]">{post.content}</p>
                <div class="flex items-center gap-4 mt-3 text-xs text-dim">
                  <button class="flex items-center gap-1 hover:text-[var(--color-accent)] transition" aria-label="J'aime">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" /></svg>
                    <span>{post.likes}</span>
                  </button>
                  <button class="flex items-center gap-1 hover:text-[var(--color-accent)] transition ml-auto" aria-label="Commentaires">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z" /></svg>
                    <span>{post.comments}</span>
                  </button>
                </div>
              </div>
            </div>
          </article>
        ))}
      </section>
    </div>
  </div>
</Layout>