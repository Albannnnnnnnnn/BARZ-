---
// PAGE COMMU - Communauté / Social (inspiré des maquettes)
import Layout from '../layouts/Layout.astro';

const tabs = [
  { id: 'activite', label: 'Activité', active: true },
  { id: 'suivis', label: 'Suivis', active: false },
  { id: 'decouvertes', label: 'Découvertes', active: false },
];

const activityFeed = [
  {
    id: 1,
    user: { name: 'Alban', handle: '@alban.mmi', avatar: '/BARZ-/placeholder-release.svg' },
    action: 'a noté',
    target: { type: 'album', title: 'GNX', artist: 'Kendrick Lamar', cover: '/BARZ-/placeholder-release.svg' },
    rating: 9.2,
    comment: 'Un retour aux sources brut, sans concession. La prod de Sounwave est chirurgicale.',
    time: 'Il y a 2h',
    likes: 12,
    comments: 3,
  },
  {
    id: 2,
    user: { name: 'Mira', handle: '@mira.k', avatar: '/BARZ-/placeholder-release.svg' },
    action: 'a ajouté à sa spin list',
    target: { type: 'album', title: 'Lagune', artist: 'Nour', cover: '/BARZ-/placeholder-release.svg' },
    rating: null,
    comment: 'La douceur de Nour fait du bien après une semaine chargée. Soul moderne parfait.',
    time: 'Il y a 5h',
    likes: 8,
    comments: 1,
  },
  {
    id: 3,
    user: { name: 'Sacha', handle: '@sacha.rubis', avatar: '/BARZ-/placeholder-release.svg' },
    action: 'écoute en boucle',
    target: { type: 'album', title: 'Hiver 04', artist: 'Sacha Rubis', cover: '/BARZ-/placeholder-release.svg' },
    rating: 8.5,
    comment: '',
    time: 'Hier',
    likes: 24,
    comments: 5,
  },
  {
    id: 4,
    user: { name: 'Lou', handle: '@lou.valentin', avatar: '/BARZ-/placeholder-release.svg' },
    action: 'a découvert via Rabbit Hole',
    target: { type: 'artist', title: 'Idris Mbayé', cover: '/BARZ-/placeholder-release.svg' },
    rating: null,
    comment: 'Producteur incroyable, merci l\'algo BARZ 🙏',
    time: 'Hier',
    likes: 7,
    comments: 0,
  },
];

const followedUsers = [
  { name: 'Mira Kale', handle: '@mira.k', avatar: '/BARZ-/placeholder-release.svg', mutual: 12, lastSpin: 'Lagune — Nour' },
  { name: 'Sacha Rubis', handle: '@sacha.rubis', avatar: '/BARZ-/placeholder-release.svg', mutual: 8, lastSpin: 'Hiver 04 — Sacha Rubis' },
  { name: 'Lou Valentin', handle: '@lou.valentin', avatar: '/BARZ-/placeholder-release.svg', mutual: 5, lastSpin: 'Sous silence — Lou Valentin' },
  { name: 'Thomas', handle: '@thomas.gg', avatar: '/BARZ-/placeholder-release.svg', mutual: 3, lastSpin: 'Kintsugi — Tamo & The Fold' },
  { name: 'Chloé', handle: '@chloe.wav', avatar: '/BARZ-/placeholder-release.svg', mutual: 7, lastSpin: 'Selva Eléctrica — Los Cometas' },
];

const discoveries = [
  { name: 'Nina Kraviz', handle: '@nina.kraviz', reason: 'Électro / Techno — 3 amis en commun', avatar: '/BARZ-/placeholder-release.svg' },
  { name: 'Alpha Wann', handle: '@alpha.wann', reason: 'Rap FR — Tu as noté "Don Dada Mixtape"', avatar: '/BARZ-/placeholder-release.svg' },
  { name: 'Floating Points', handle: '@floatingpoints', reason: 'Jazz / Électro — Similaire à ton ADN 11% Jazz', avatar: '/BARZ-/placeholder-release.svg' },
];

const feedItemStyle = 'card p-5 transition group';
const avatarStyle = 'w-10 h-10 rounded-full object-cover border border-[var(--color-border)]';
const actionStyle = 'text-sm text-[var(--color-text-muted)]';
const targetStyle = 'flex items-center gap-3 mt-2 p-3 bg-[var(--color-bg-hover)] rounded-[var(--radius-md)]';
const targetImgStyle = 'w-12 h-12 rounded-[var(--radius-sm)] object-cover flex-shrink-0';
const targetInfoStyle = 'min-w-0 flex-1';
const targetTitleStyle = 'font-semibold text-sm truncate text-[var(--color-text)]';
const targetArtistStyle = 'text-xs text-muted truncate';
const ratingStyle = 'flex items-center gap-1 mt-2 text-sm font-bold text-[#a3e635]';
const commentStyle = 'mt-3 text-sm text-[var(--color-text)] bg-[var(--color-bg-surface)] p-3 rounded-[var(--radius-sm)]';
const metaStyle = 'flex items-center gap-4 mt-3 text-xs text-dim';
const followedItemStyle = 'flex items-center gap-3 py-3 border-b border-[var(--color-border)] last:border-0';
const followedInfoStyle = 'min-w-0 flex-1';
const followedNameStyle = 'font-semibold text-sm text-[var(--color-text)]';
const followedHandleStyle = 'text-xs text-muted truncate';
const followedMetaStyle = 'text-[0.7rem] text-dim';
const discoverItemStyle = 'flex items-center gap-3 p-3 card card-interactive transition group';
const discoverAvatarStyle = 'w-12 h-12 rounded-full object-cover border border-[var(--color-border)]';
const discoverNameStyle = 'font-semibold text-sm text-[var(--color-text)]';
const discoverReasonStyle = 'text-xs text-muted';
const btnStyle = 'ml-auto btn btn-primary btn-sm whitespace-nowrap';
const emptyStyle = 'text-center py-12 text-muted';
---

<Layout title="Commu - BARZ" description="Ta communauté musicale : activité des amis, suivis, nouvelles découvertes.">
  <div class="container section-lg">
    <header class="mb-12">
      <span class="inline-block px-2 py-0.5 rounded text-xs font-semibold uppercase tracking-wider text-[#a3e635] bg-[#a3e635]/10 border border-[#a3e635]/25">
        Commu
      </span>
      <h1 class="text-5xl md:text-6xl font-bold mt-3 mb-2 text-[var(--color-text)] [letter-spacing:-0.02em]">
        Ta commu<span class="gradient-text">.</span>
      </h1>
      <p class="text-lg text-muted max-w-2xl">
        Ce que tes potes écoutent, notent, partagent. Et qui tu devrais suivre.
      </p>
    </header>

    <!-- Onglets -->
    <div class="flex gap-1 mb-10" role="tablist" aria-label="Sections communauté">
      {tabs.map((t) => (
        <button
          key={t.id}
          type="button"
          role="tab"
          aria-selected={t.active ? 'true' : 'false'}
          class={`px-5 py-2.5 rounded-full text-sm font-semibold transition ${t.active ? 'bg-[#a3e635] text-[#09090b] shadow-[0_0_20px_rgba(163,230,53,0.35)]' : 'text-[var(--color-text-muted)] hover:text-[var(--color-text)]'}`}
        >
          {t.label}
        </button>
      ))}
    </div>

    <!-- Onglet Activité -->
    <section id="activite" role="tabpanel" aria-labelledby="activite" class="space-y-4">
      {activityFeed.length > 0 ? (
        activityFeed.map((a) => (
          <article key={a.id} class={feedItemStyle}>
            <div class="flex items-start gap-3">
              <img src={a.user.avatar} alt={a.user.name} class={avatarStyle} />
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2">
                  <span class="font-semibold text-sm text-[var(--color-text)]">{a.user.name}</span>
                  <span class="text-xs text-muted">{a.user.handle}</span>
                  <span class="text-xs text-dim ml-auto">{a.time}</span>
                </div>
                <p class={actionStyle}><span class="font-medium text-[var(--color-text)]">{a.user.name}</span> {a.action} <span class="font-medium text-[var(--color-accent)]">{a.target.title}</span> {a.target.artist ? <span>— {a.target.artist}</span> : null}</p>
                <div class={targetStyle}>
                  <img src={a.target.cover} alt={a.target.title} class={targetImgStyle} />
                  <div class={targetInfoStyle}>
                    <p class={targetTitleStyle}>{a.target.title}</p>
                    {a.target.artist && <p class={targetArtistStyle}>{a.target.artist}</p>}
                  </div>
                  {a.rating && <span class={ratingStyle}>{a.rating} / 10</span>}
                </div>
                {a.comment && <p class={commentStyle}>{a.comment}</p>}
                <div class={metaStyle}>
                  <button class="flex items-center gap-1 hover:text-[var(--color-accent)] transition" aria-label="J'aime">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" /></svg>
                    <span>{a.likes}</span>
                  </button>
                  <button class="flex items-center gap-1 hover:text-[var(--color-accent)] transition" aria-label="Commentaires">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" /></svg>
                    <span>{a.comments}</span>
                  </button>
                  <button class="flex items-center gap-1 hover:text-[var(--color-accent)] transition ml-auto" aria-label="Partager">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" aria-hidden="true"><circle cx="18" cy="5" r="3" /><circle cx="6" cy="12" r="3" /><circle cx="18" cy="19" r="3" /><line x1="8.59" y1="13.51" x2="15.42" y2="17.49" /><line x1="15.41" y1="6.51" x2="8.59" y2="10.49" /></svg>
                  </button>
                </div>
              </div>
            </div>
          </article>
        ))
      ) : (
        <p class={emptyStyle}>Aucune activité pour l'instant. Suis des amis pour voir leur actu ici.</p>
      )}
    </section>

    <!-- Onglet Suivis -->
    <section id="suivis" role="tabpanel" aria-labelledby="suivis" class="hidden space-y-0">
      {followedUsers.length > 0 ? (
        followedUsers.map((u, i) => (
          <div key={i} class={followedItemStyle}>
            <img src={u.avatar} alt={u.name} class={avatarStyle} />
            <div class={followedInfoStyle}>
              <p class={followedNameStyle}>{u.name}</p>
              <p class={followedHandleStyle}>{u.handle}</p>
              <p class={followedMetaStyle}>{u.mutual} ami{u.mutual > 1 ? 's' : ''} en commun · Dernier spin : {u.lastSpin}</p>
            </div>
            <button class={btnStyle}>Suivi</button>
          </div>
        ))
      ) : (
        <p class={emptyStyle}>Tu ne suis personne encore. Pars à la découverte !</p>
      )}
    </section>

    <!-- Onglet Découvertes -->
    <section id="decouvertes" role="tabpanel" aria-labelledby="decouvertes" class="hidden space-y-3">
      {discoveries.length > 0 ? (
        discoveries.map((d, i) => (
          <div key={i} class={discoverItemStyle}>
            <img src={d.avatar} alt={d.name} class={discoverAvatarStyle} />
            <div class="min-w-0 flex-1">
              <p class={discoverNameStyle}>{d.name}</p>
              <p class={discoverReasonStyle}>{d.reason}</p>
            </div>
            <button class={btnStyle}>Suivre</button>
          </div>
        ))
      ) : (
        <p class={emptyStyle}>Aucune suggestion pour l'instant. Continue d'écouter pour affiner l'algo.</p>
      )}
    </section>
  </div>
</Layout>

<style>
  /* JS simple pour basculer les onglets (pas d'hydratation React nécessaire) */
  <script is:inline>
    document.querySelectorAll('[role="tablist"] button').forEach(btn => {
      btn.addEventListener('click', () => {
        const tabs = btn.closest('[role="tablist"]').querySelectorAll('button');
        const panels = btn.closest('main').querySelectorAll('[role="tabpanel"]');
        tabs.forEach(t => { t.setAttribute('aria-selected', 'false'); t.classList.remove('bg-[#a3e635]', 'text-[#09090b]', 'shadow-[0_0_20px_rgba(163,230,53,0.35)]'); t.classList.add('text-[var(--color-text-muted)]', 'hover:text-[var(--color-text)]'); });
        btn.setAttribute('aria-selected', 'true');
        btn.classList.add('bg-[#a3e635]', 'text-[#09090b]', 'shadow-[0_0_20px_rgba(163,230,53,0.35)]');
        btn.classList.remove('text-[var(--color-text-muted)]', 'hover:text-[var(--color-text)]');
        panels.forEach(p => p.classList.add('hidden'));
        const target = btn.closest('main').querySelector(`#${btn.id}`);
        if (target) target.classList.remove('hidden');
      });
    });
  </script>
</style>