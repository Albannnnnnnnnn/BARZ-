---
// PAGE COMMUNAUTÉ : les Barz du jour, écoute commune, blend, top contributeurs (contenu de démonstration)
import Layout from '../layouts/Layout.astro';
import Cover from '../components/Cover.astro';
import Scene from '../components/Scene.astro';
import { DEMO_ALBUMS, DEMO_BARZ, DEMO_CONTRIBUTORS } from '../data/demo';
---

<Layout title="Communauté" description="Les Barz du jour : avis de la communauté, écoutes communes et blends.">
  <div class="bz-page">
    <span class="bz-eyebrow">Communauté</span>
    <h1 class="bz-display">Les <em>Barz</em> du jour.</h1>

    <div class="layout">
      <div class="feed">
        <form class="composer" onsubmit="return false">
          <span class="me">A</span>
          <label for="barz-input" class="sr-only">Écris ton Barz</label>
          <input id="barz-input" type="text" placeholder="Qu’as-tu écouté aujourd’hui ? Écris ton Barz…" />
          <button type="submit" class="bz-btn bz-btn--lime bz-btn--small" title="Bientôt : il faut d’abord les comptes utilisateurs">Publier</button>
        </form>

        {DEMO_BARZ.map((post) => {
          const album = DEMO_ALBUMS[post.album];
          return (
            <article class="post">
              <div class="post-body">
                <header>
                  <span class="avatar" style={`background:${post.color}`}>{post.name[0]}</span>
                  <b>{post.name}</b>
                  <span class="handle">{post.handle} · {post.time}</span>
                </header>
                <p class="text">{post.text}</p>
                <footer>
                  <span class="likes">♥ {post.likes}</span>
                  <span>Répondre</span>
                  <span>Partager</span>
                </footer>
              </div>
              <div class="post-album">
                <Cover title={album.title} palette={album.palette} />
                <div class="post-album-row"><b>{album.title}</b><span class="bz-score">{post.score}</span></div>
              </div>
            </article>
          );
        })}
      </div>

      <aside class="side">
        <section class="live">
          <Scene variant={1} class="live-bg" />
          <div class="live-body">
            <span class="live-eyebrow">En direct · Écoute commune</span>
            <h2>Kintsugi en entier, ce soir 21 h</h2>
            <span class="bz-btn bz-btn--lime bz-btn--small">Rejoindre · 342 inscrits</span>
          </div>
        </section>

        <section class="blend">
          <span class="bz-eyebrow">Blend</span>
          <h2>Toi et Inès avez 72 % de goûts en commun.</h2>
          <span class="bz-btn bz-btn--lime bz-btn--small">Créer une playlist commune</span>
        </section>

        <section>
          <div class="bz-section-head"><h2 class="bz-h2">Top contributeurs</h2></div>
          <ol class="top">
            {DEMO_CONTRIBUTORS.map((handle, i) => (
              <li>
                <span class="rank">{i + 1}</span>
                <span class="who">{handle}</span>
                <span class="bz-btn bz-btn--outline">Suivre</span>
              </li>
            ))}
          </ol>
        </section>
      </aside>
    </div>
  </div>
</Layout>

<style>
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(320px, 1fr);
    gap: 56px;
    margin-top: 56px;
  }

  .feed {
    display: flex;
    flex-direction: column;
    gap: 26px;
  }

  .composer {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 18px 20px 18px 22px;
    border: 1px solid var(--color-border);
    border-radius: 22px;
  }

  .me {
    flex-shrink: 0;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--color-lime);
    color: var(--color-ink);
    font: 400 26px/1 var(--font-serif);
  }

  .composer input {
    flex: 1;
    min-width: 0;
    border: 0;
    outline: none;
    background: transparent;
    color: var(--color-text);
    font: 400 17px/1.3 var(--font-sans);
  }

  .composer input::placeholder {
    color: #8b877f;
  }

  .post {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 210px;
    gap: 32px;
    padding: 32px;
    border-radius: 22px;
    background: var(--color-bg-elevated);
  }

  .post header {
    display: flex;
    align-items: center;
    gap: 14px;
    font-size: 18px;
  }

  .avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    color: var(--color-ink);
    font: 700 18px/1 var(--font-sans);
  }

  .handle {
    color: var(--color-text-muted);
    font-size: 16px;
  }

  .text {
    margin: 26px 0 24px;
    font: 400 clamp(30px, 2.6vw, 40px) / 1.15 var(--font-serif);
    color: var(--color-text);
  }

  .post footer {
    display: flex;
    gap: 30px;
    font-size: 16px;
    color: var(--color-text-muted);
  }

  .post-album-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 14px;
    font-size: 16px;
  }

  .side {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .live {
    position: relative;
    min-height: 300px;
    border-radius: 22px;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
  }

  .live :global(.live-bg) {
    position: absolute;
    inset: 0;
  }

  .live::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.75), transparent 70%);
  }

  .live-body {
    position: relative;
    z-index: 1;
    padding: 26px;
  }

  .live-eyebrow {
    font: 700 13px/1 var(--font-sans);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-lime);
  }

  .live h2,
  .blend h2 {
    margin: 14px 0 20px;
    font: 400 36px/1.1 var(--font-serif);
    color: var(--color-text);
  }

  .blend {
    padding: 32px 28px;
    border: 1px solid #3b4220;
    border-radius: 22px;
  }

  .top {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .top li {
    display: flex;
    align-items: center;
    gap: 16px;
    font-size: 18px;
  }

  .rank {
    width: 18px;
    font: italic 400 26px/1 var(--font-serif);
    color: var(--color-text-muted);
  }

  .who {
    flex: 1;
  }

  @media (max-width: 1280px) {
    .layout {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 900px) {
    .layout {
      margin-top: 32px;
    }
    .post {
      grid-template-columns: minmax(0, 1fr) 96px;
      gap: 16px;
      padding: 20px;
    }
    .text {
      font-size: 24px;
      margin: 16px 0;
    }
    .post footer {
      gap: 18px;
      font-size: 14px;
    }
    .composer .bz-btn {
      padding: 10px 14px;
    }
  }
</style>
