---
// GUIDE : comment marche BARZ¡ et quels comptes connecter, étape par étape (une étape par écran).
// Montré juste après Bienvenue (?premiere=1, avec ?next= pour la suite), puis retrouvable depuis la barre latérale et le profil.
// Sans JavaScript, toutes les étapes s'affichent l'une sous l'autre.
import Layout from '../layouts/Layout.astro';
import InstallApp from '../components/InstallApp.astro';

type Step = { image: string; focus?: string; tone: string; eyebrow: string; title: string; em: string; points: string[]; link?: { href: string; label: string } };

const STEPS: Step[] = [
  {
    image: '/BARZ-/guide/etape-1.jpg',
    tone: 'accent',
    eyebrow: 'Bienvenue',
    title: 'L’appli du',
    em: 'vendredi.',
    points: [
      'Toutes les nouvelles sorties, chaque semaine, dès minuit.',
      'Des découvertes choisies pour toi, et d’autres hors de ta bulle.',
      'L’avis de tes amis sur ce qu’ils écoutent.',
    ],
  },
  {
    image: '/BARZ-/guide/etape-2.jpg', focus: 'center 25%',
    tone: 'orange',
    eyebrow: 'L’accueil',
    title: 'Les sorties de',
    em: 'la semaine.',
    points: [
      'Une semaine va du vendredi au jeudi ; les flèches ramènent aux semaines passées.',
      '« Pour toi » : une sélection selon tes goûts, avec quelques disques hors de ta bulle.',
      '« Plus récentes » : tout, jour par jour, avec des filtres par genre et par type.',
    ],
    link: { href: '/BARZ-/', label: 'Voir les sorties' },
  },
  {
    image: '/BARZ-/guide/etape-3.jpg', focus: 'center 20%',
    tone: 'blue',
    eyebrow: 'Sur un disque',
    title: 'Écoute, range,',
    em: 'note.',
    points: [
      '« + Spin list » le met de côté pour plus tard.',
      '« ✓ Écouté » le range dans tes écoutes.',
      'Note-le sur 10 et écris ton Barz : ton avis en une phrase, visible par tous.',
    ],
  },
  {
    image: '/BARZ-/guide/etape-4.jpg',
    tone: 'sand',
    eyebrow: 'Tes artistes',
    title: 'Suis ceux que',
    em: 'tu aimes.',
    points: [
      'Leurs sorties remontent en premier et affinent tes recommandations.',
      'Une notification te prévient quand ils sortent quelque chose.',
      'Un artiste manque ? Cherche-le dans l’onglet Artistes : sa fiche se crée depuis Deezer.',
    ],
    link: { href: '/BARZ-/artistes', label: 'Parcourir les artistes' },
  },
  {
    image: '/BARZ-/guide/etape-5.jpg',
    tone: 'violet',
    eyebrow: 'Découvrir',
    title: 'Sors de',
    em: 'ta bulle.',
    points: [
      'Le défi te propose un disque loin de tes habitudes ; relève-le et un nouveau arrive.',
      'Le curseur de Découvrir va de tes habitudes à l’inconnu total.',
      'Le Rabbit Hole t’emmène d’artiste en artiste.',
    ],
    link: { href: '/BARZ-/search', label: 'Découvrir' },
  },
  {
    image: '/BARZ-/guide/etape-6.jpg',
    tone: 'orange',
    eyebrow: 'Avec tes amis',
    title: 'Écoute',
    em: 'ensemble.',
    points: [
      'Ajoute tes amis depuis ton profil, en cherchant leur pseudo.',
      '« Pour vous deux » montre les sorties qui vous plairaient à tous les deux.',
      'Aime et réponds aux Barz ; la cloche 🔔 te prévient des nouveautés.',
    ],
    link: { href: '/BARZ-/commu', label: 'Voir le Fil' },
  },
];

const ACCOUNTS = [
  { icon: '🔔', name: 'Notifications', tag: 'Recommandé', text: 'Sorties de tes artistes, demandes d’ami, Barz de tes amis. Sur iPhone, installe d’abord l’appli.', href: '/BARZ-/profil#p-push', action: 'Activer' },
  { icon: '🟢', name: 'Spotify', tag: 'Si tu l’utilises', text: 'Tes artistes les plus écoutés et suivis servent à tes recos ; ton écoute en direct, si tu veux.', href: '/BARZ-/profil#p-spotify', action: 'Connecter' },
  { icon: '🟣', name: 'Deezer', tag: 'Si tu l’utilises', text: 'Colle le lien de ton profil : tes artistes favoris (publics) servent à tes recos.', href: '/BARZ-/profil#p-deezer', action: 'Relier' },
  { icon: '🔴', name: 'Last.fm', tag: 'Sur Apple Music ? Par ici', text: 'Ton pseudo suffit. Sur Apple Music : fais enregistrer tes écoutes par Last.fm (appli Last.fm sur Mac, appli de « scrobbling » sur iPhone).', href: '/BARZ-/profil#p-lastfm', action: 'Ajouter' },
];

const TOTAL = STEPS.length + 2; // + comptes à connecter + installer
---

<Layout title="Guide" description="Comment marche BARZ¡ et quels comptes connecter, étape par étape.">
  <div class="bz-page guide" id="guide">
    <div class="guide-top">
      <span class="bz-eyebrow" id="guide-eyebrow">Guide</span>
      <a class="skip" id="guide-skip" href="/BARZ-/">Passer le guide</a>
    </div>

    <nav class="progress" id="guide-progress" aria-label="Étapes du guide" hidden>
      {Array.from({ length: TOTAL }, (_, i) => (
        <button type="button" class="progress-dot" data-go={i} aria-label={`Étape ${i + 1} sur ${TOTAL}`}><span></span></button>
      ))}
    </nav>

    <div class="stage" id="guide-stage">
      {STEPS.map((step, i) => (
        <section class="step" data-step={i} aria-roledescription="étape" aria-label={`Étape ${i + 1} sur ${TOTAL}`}>
          <div class:list={['visual', `tone-${step.tone}`]} aria-hidden="true">
            <img src={step.image} alt="" loading={i === 0 ? 'eager' : 'lazy'} style={step.focus ? `object-position: ${step.focus}` : undefined} />
          </div>
          <div class="copy">
            <span class="step-count">{step.eyebrow} · {i + 1}/{TOTAL}</span>
            <h1 class="step-title">{step.title} <em>{step.em}</em></h1>
            <ul class="points">
              {step.points.map((p) => <li>{p}</li>)}
            </ul>
            {step.link && <a class="bz-link step-link" href={step.link.href}>{step.link.label} →</a>}
          </div>
        </section>
      ))}

      <section class="step step-accounts" data-step={STEPS.length} aria-roledescription="étape" aria-label={`Étape ${STEPS.length + 1} sur ${TOTAL}`}>
        <div class="visual tone-sand" aria-hidden="true">
          <img src="/BARZ-/guide/etape-7.jpg" alt="" loading="lazy" style="object-position: center 30%" />
        </div>
        <div class="copy">
          <span class="step-count">Tes comptes · {STEPS.length + 1}/{TOTAL}</span>
          <h1 class="step-title">Connecte ce que <em>tu utilises.</em></h1>
          <p class="lead">Rien n’est obligatoire : tout se règle dans ton profil, et se défait aussi facilement.</p>
          <ul class="accounts">
            {ACCOUNTS.map((a) => (
              <li class="account">
                <span class="account-icon" aria-hidden="true">{a.icon}</span>
                <span class="account-text">
                  <span class="account-head"><b>{a.name}</b><span class:list={['tag', { 'tag--main': a.tag === 'Recommandé' }]}>{a.tag}</span></span>
                  <span class="account-desc">{a.text}</span>
                </span>
                <a class="bz-btn bz-btn--outline bz-btn--small" href={a.href} data-needs-account>{a.action}</a>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <section class="step" data-step={STEPS.length + 1} aria-roledescription="étape" aria-label={`Étape ${TOTAL} sur ${TOTAL}`}>
        <div class="visual tone-accent" aria-hidden="true">
          <img src="/BARZ-/guide/etape-8.jpg" alt="" loading="lazy" />
        </div>
        <div class="copy">
          <span class="step-count">Dernière chose · {TOTAL}/{TOTAL}</span>
          <h1 class="step-title">Garde BARZ¡ <em>sous la main.</em></h1>
          <ul class="points">
            <li>BARZ¡ s’installe sur ton téléphone ou ton ordinateur comme une vraie appli, sans passer par un store.</li>
            <li>Un bug, une idée ? « Un bug, une idée ? » te permet de l’écrire, chaque message est lu.</li>
            <li>Ce guide reste accessible avec « Comment ça marche ? ».</li>
          </ul>
          <InstallApp />
        </div>
      </section>
    </div>

    <div class="controls" id="guide-controls" hidden>
      <button type="button" class="bz-btn bz-btn--outline" id="guide-prev">← Précédent</button>
      <button type="button" class="bz-btn bz-btn--lime" id="guide-next">Suivant →</button>
      <a class="bz-btn bz-btn--lime" id="guide-done" href="/BARZ-/" hidden>C’est parti →</a>
    </div>
  </div>
</Layout>

<script>
  import { BASE, getSession, loginUrl } from '../scripts/social';
  import { markGuideSeen } from '../scripts/guide-prompt';

  const steps = [...document.querySelectorAll<HTMLElement>('[data-step]')];
  const dots = [...document.querySelectorAll<HTMLButtonElement>('[data-go]')];
  const prev = document.getElementById('guide-prev') as HTMLButtonElement;
  const next = document.getElementById('guide-next') as HTMLButtonElement;
  const done = document.getElementById('guide-done') as HTMLAnchorElement;
  const params = new URLSearchParams(location.search);
  const first = params.get('premiere') === '1';
  // Membre déjà inscrit, envoyé ici à l'ouverture de l'appli (src/scripts/guide-prompt.ts)
  const back = params.get('retour') === '1';
  const target = params.get('next');
  const exit = (first || back) && target && target.startsWith(BASE) ? target : BASE;
  let current = 0;

  // Juste après l'inscription : « dernière étape » de l'accueil, puis on file vers la page demandée au départ
  if (first) document.getElementById('guide-eyebrow')!.textContent = 'Dernière étape de ton inscription';
  if (back) document.getElementById('guide-eyebrow')!.textContent = 'Nouveau : le guide de BARZ¡';
  (document.getElementById('guide-skip') as HTMLAnchorElement).href = exit;
  done.href = exit;
  done.textContent = first || back ? 'C’est parti →' : 'Terminer';

  function show(index: number, focus = false) {
    current = Math.max(0, Math.min(steps.length - 1, index));
    steps.forEach((s, i) => {
      s.hidden = i !== current;
      s.classList.toggle('is-current', i === current);
    });
    dots.forEach((d, i) => {
      d.classList.toggle('is-done', i < current);
      d.classList.toggle('is-current', i === current);
      d.setAttribute('aria-current', i === current ? 'step' : 'false');
    });
    // Photo de cette étape et de la suivante chargées tout de suite : le médaillon n'apparaît jamais vide
    for (const s of steps.slice(current, current + 2)) s.querySelector('img')?.setAttribute('loading', 'eager');
    prev.disabled = current === 0;
    const last = current === steps.length - 1;
    next.hidden = last;
    done.hidden = !last;
    history.replaceState(null, '', `${location.search}#etape-${current + 1}`);
    if (focus) steps[current].querySelector<HTMLElement>('.step-title')?.focus({ preventScroll: true });
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  // Avec JavaScript : une étape par écran (sans, tout reste affiché à la suite)
  document.getElementById('guide')!.classList.add('is-stepped');
  document.getElementById('guide-progress')!.hidden = false;
  document.getElementById('guide-controls')!.hidden = false;
  steps.forEach((s) => s.querySelector('.step-title')?.setAttribute('tabindex', '-1'));
  prev.addEventListener('click', () => show(current - 1, true));
  next.addEventListener('click', () => show(current + 1, true));
  dots.forEach((d) => d.addEventListener('click', () => show(Number(d.dataset.go), true)));
  document.addEventListener('keydown', (event) => {
    if ((event.target as HTMLElement).closest('input, textarea, select')) return;
    if (event.key === 'ArrowRight') show(current + 1);
    if (event.key === 'ArrowLeft') show(current - 1);
  });

  // Glisser le doigt vers la gauche ou la droite sur mobile
  let startX = 0;
  let startY = 0;
  const stage = document.getElementById('guide-stage')!;
  stage.addEventListener('touchstart', (e) => ((startX = e.touches[0].clientX), (startY = e.touches[0].clientY)), { passive: true });
  stage.addEventListener(
    'touchend',
    (e) => {
      const dx = e.changedTouches[0].clientX - startX;
      const dy = e.changedTouches[0].clientY - startY;
      if (Math.abs(dx) > 60 && Math.abs(dx) > Math.abs(dy) * 1.5) show(current + (dx < 0 ? 1 : -1));
    },
    { passive: true }
  );

  const fromHash = Number(location.hash.match(/^#etape-(\d+)$/)?.[1] ?? 1) - 1;
  show(Number.isFinite(fromHash) ? fromHash : 0);

  // Vu : on ne le remontrera pas à l'ouverture de l'appli (src/scripts/guide-prompt.ts)
  markGuideSeen().catch(() => {});

  // Sans compte, les réglages du profil passent d'abord par la connexion
  getSession().then((session) => {
    if (session) return;
    document.querySelectorAll<HTMLAnchorElement>('[data-needs-account]').forEach((a) => (a.href = loginUrl()));
  });
</script>

<style>
  .guide {
    max-width: 980px;
  }

  .guide-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .skip {
    color: var(--color-text-muted) !important;
    font-size: 14px;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Barre de progression : un segment par étape, cliquable */
  .progress {
    display: flex;
    gap: 6px;
    margin-top: 22px;
  }

  .progress[hidden] {
    display: none;
  }

  .progress-dot {
    flex: 1;
    padding: 8px 0;
    border: 0;
    background: transparent;
    cursor: pointer;
  }

  .progress-dot span {
    display: block;
    height: 5px;
    border-radius: 10px;
    background: var(--color-border);
    transition: background 0.3s ease;
  }

  .progress-dot.is-done span {
    background: var(--color-accent-line);
  }

  .progress-dot.is-current span {
    background: var(--color-accent);
  }

  .stage {
    margin-top: 28px;
  }

  .step {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    align-items: center;
    gap: 48px;
    padding: 40px;
    border: 1px solid var(--color-border);
    border-radius: 14px;
    background: var(--color-paper);
  }

  /* Sans JavaScript : les étapes s'empilent */
  .guide:not(.is-stepped) .step + .step {
    margin-top: 20px;
  }

  .step[hidden] {
    display: none;
  }

  .step.is-current {
    animation: step-in 0.35s ease both;
  }

  @keyframes step-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .step.is-current {
      animation: none;
    }
  }

  /* Comptes : la photo plus petite, la liste plus large */
  .step-accounts {
    grid-template-columns: minmax(0, 0.55fr) minmax(0, 1.45fr);
    align-items: start;
  }

  /* Illustration : un médaillon coloré par étape */
  /* Médaillon : le fond coloré fait un liseré de largeur fixe autour d'une photo carrée.
     Pas de hauteur en % : certains navigateurs (Safari) l'ignorent dans un bloc carré, la photo débordait */
  .visual {
    box-sizing: border-box;
    width: 100%;
    max-width: 340px;
    margin: 0 auto;
    padding: 10px;
    border-radius: 32px;
  }

  .tone-accent {
    background: linear-gradient(145deg, var(--color-accent), #34508f);
  }

  .tone-orange {
    background: linear-gradient(145deg, var(--color-orange), #f39a6e);
  }

  .tone-blue {
    background: linear-gradient(145deg, var(--color-blue), #7d9cf8);
  }

  .tone-violet {
    background: linear-gradient(145deg, var(--color-violet), #b4a9fa);
  }

  .tone-sand {
    background: linear-gradient(145deg, #d9ae4f, var(--color-sand));
  }

  /* La photo de l'étape, cadrée dans le médaillon ; le fond coloré fait un liseré */
  .visual img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    border-radius: 14px;
    object-fit: cover;
    background: rgba(255, 255, 255, 0.25); /* pendant le chargement */
    box-shadow: 0 18px 40px rgba(20, 26, 46, 0.22);
  }

  .step-count {
    display: block;
    font: 700 12px/1 var(--font-sans);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .step-title {
    margin: 14px 0 0;
    font: 800 clamp(33px, 4.6vw, 52px) / 1 var(--font-display);
    letter-spacing: -0.02em;
    color: var(--color-text);
    outline: none;
  }

  .step-title em {
    font-style: italic;
  }

  .points {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin: 26px 0 0;
    padding: 0;
    list-style: none;
  }

  .points li {
    position: relative;
    padding-left: 30px;
    color: var(--color-text-muted);
    font-size: 17px;
    line-height: 1.5;
  }

  .points li::before {
    content: '';
    position: absolute;
    top: 0.45em;
    left: 4px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    border: 3px solid var(--color-accent);
  }

  .step-link {
    display: inline-block;
    margin-top: 22px;
  }

  .lead {
    margin: 14px 0 0;
    color: var(--color-text-muted);
    font-size: 17px;
    line-height: 1.5;
  }

  .copy :global([data-install]) {
    margin-top: 22px;
  }

  /* Comptes à connecter */
  .accounts {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin: 26px 0 0;
    padding: 0;
    list-style: none;
  }

  .account {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px 18px;
    border: 1px solid var(--color-border);
    border-radius: 14px;
    background: var(--color-bg);
  }

  .account-icon {
    flex-shrink: 0;
    font-size: 24px;
  }

  .account-text {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .account-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }

  .account-head b {
    font-size: 17px;
  }

  .account-desc {
    color: var(--color-text-muted);
    font-size: 14px;
    line-height: 1.45;
  }

  .account .bz-btn {
    flex-shrink: 0;
  }

  .tag {
    padding: 4px 10px;
    border-radius: 10px;
    background: var(--color-bg-elevated);
    color: var(--color-text-muted);
    font: 600 12px/1 var(--font-sans);
  }

  .tag--main {
    background: var(--color-accent);
    color: var(--color-on-accent);
  }

  .controls {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin-top: 24px;
  }

  .controls[hidden],
  .controls [hidden] {
    display: none;
  }

  .controls .bz-btn:disabled {
    opacity: 0.4;
    cursor: default;
  }

  @media (max-width: 760px) {
    .step {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
      padding: 22px;
      border-radius: 14px;
    }
    .visual {
      max-width: 220px;
      padding: 7px;
      border-radius: 14px;
    }
    .visual img {
      border-radius: 14px;
    }
    .points li {
      font-size: 16px;
    }
    .account {
      flex-wrap: wrap;
      gap: 12px;
    }
    .account .bz-btn {
      margin-left: 40px;
    }
    .controls {
      position: sticky;
      bottom: 92px; /* au-dessus de la barre de navigation du bas */
      padding: 12px 0;
      background: linear-gradient(transparent, var(--color-bg) 30%);
    }
  }
</style>
