---
// PAGE VENDREDI : les sorties de la semaine (données réelles) + défi, concerts, Barz (démo)
import { addDays, format, getISOWeek } from 'date-fns';
import { fr } from 'date-fns/locale';
import Layout from '../layouts/Layout.astro';
import AlbumTile from '../components/AlbumTile.astro';
import Cover from '../components/Cover.astro';
import GenreChips from '../components/GenreChips.astro';
import { getSupabaseServerSafe } from '../lib/supabase';
import { chipIdsFor, fetchReleasesBetween, getToday, type ReleaseRow } from '../lib/releases';
import { getReleaseTypeLabel } from '../lib/utils';
import { getConcertsOrDemo } from '../lib/concerts';
import { DEMO_ALBUMS, DEMO_BARZ, DEMO_CHALLENGE, DEMO_CONCERTS } from '../data/demo';

const today = getToday();
// Le vendredi de référence : aujourd'hui si c'est vendredi, sinon le dernier vendredi passé
const friday = addDays(today, -((today.getDay() - 5 + 7) % 7));
const releases = await fetchReleasesBetween(getSupabaseServerSafe(), addDays(friday, -6), addDays(friday, 6));

// Les artistes suivis d'abord, puis les sorties les plus suivies sur Deezer
const fans = (r: ReleaseRow) => r.metadata?.fans ?? 0;
const sorted = [...releases].sort((a, b) => Number(!!b.metadata?.watched) - Number(!!a.metadata?.watched) || fans(b) - fans(a));
const count = sorted.length;
const fan = sorted.slice(0, 5);
const watched = sorted.filter((r) => r.metadata?.watched).slice(0, 6);

const eyebrow = `Vendredi ${format(friday, 'd MMMM', { locale: fr })} · Semaine ${getISOWeek(friday)}`;
const subtitleOf = (r: ReleaseRow) => `${r.artist?.name ?? 'Artiste inconnu'} · ${getReleaseTypeLabel(r.release_type)}`;
const quotes = DEMO_BARZ.slice(0, 2);
const { concerts } = await getConcertsOrDemo(DEMO_CONCERTS);
---

<Layout title="Vendredi" description="Les sorties musicales du vendredi, triées pour toi.">
  <div class="bz-page">
    <span class="bz-eyebrow">{eyebrow}</span>
    <h1 class="bz-display">
      {count > 0 ? (
        <>Salut Alban, <em>{count} sortie{count > 1 ? 's' : ''}</em> pour toi.</>
      ) : (
        <>Salut Alban, <em>calme plat</em> cette semaine.</>
      )}
    </h1>

    <section class="recap" aria-labelledby="recap-title">
      <div class="recap-text">
        <span class="recap-eyebrow">Le récap du vendredi · 3 min</span>
        {count > 0 ? (
          <h2 id="recap-title" class="recap-title">
            {count === 1 && <>{fan[0].title} à ne pas rater.</>}
            {count === 2 && <>{fan[0].title}{' '}<em>et</em>{' '}{fan[1].title} à ne pas rater.</>}
            {count > 2 && <>{fan[0].title}, {fan[1].title}{' '}<em>et {count - 2} autres</em>{' '}à ne pas rater.</>}
          </h2>
        ) : (
          <h2 id="recap-title" class="recap-title">Le récap arrive{' '}<em>vendredi</em>{' '}matin.</h2>
        )}
        <p>Les sorties essentielles de la semaine en stories, triées selon tes goûts et ton curseur d’exploration.</p>
        {count > 0 && <a class="bz-btn bz-btn--ink" href={`/BARZ-/releases/${fan[0].slug}`}>Lancer le récap →</a>}
      </div>
      <div class="fan" aria-hidden="true">
        {(fan.length ? fan : Object.values(DEMO_ALBUMS).slice(0, 5)).map((r: any, i: number) => (
          <div class="fan-card" style={`--i:${i};--n:${Math.max(fan.length, 5)}`}>
            <Cover title={r.title} src={r.cover_url} palette={r.palette} />
          </div>
        ))}
      </div>
    </section>

    <div class="split">
      <section aria-labelledby="all-title">
        <div class="bz-section-head">
          <h2 id="all-title" class="bz-h2">Toutes les sorties</h2>
          <a class="bz-link" href="/BARZ-/calendar">Mode digest</a>
        </div>

        {count > 0 ? (
          <>
            <GenreChips target="#all-grid" />
            <div id="all-grid" class="bz-tiles grid">
              {sorted.slice(0, 24).map((r) => (
                <AlbumTile
                  title={r.title}
                  subtitle={subtitleOf(r)}
                  cover={r.cover_url}
                  href={`/BARZ-/releases/${r.slug}`}
                  chips={chipIdsFor(r.genres)}
                />
              ))}
            </div>
            <p class="chip-empty" hidden>Aucune sortie de ce genre cette semaine.</p>
            {count > 24 && <a class="bz-link more" href="/BARZ-/releases">Voir les {count} sorties →</a>}
          </>
        ) : (
          <p class="bz-empty">
            <strong>Aucune sortie enregistrée pour cette semaine.</strong><br />
            Elles apparaissent après le sync du vendredi matin (GitHub Actions → « Sync Weekly Releases »).
          </p>
        )}
      </section>

      <aside class="side">
        <section class="challenge">
          <span class="challenge-eyebrow">Défi de la semaine</span>
          <h2>{DEMO_CHALLENGE.title}</h2>
          <p>{DEMO_CHALLENGE.meta}</p>
          <a class="bz-btn bz-btn--ink bz-btn--small" href="/BARZ-/search">Relever le défi</a>
        </section>

        <section>
          <div class="bz-section-head"><h2 class="bz-h2">Concerts</h2><a class="bz-link" href="/BARZ-/actus#concerts-title">Tout voir</a></div>
          <ul class="concerts">
            {concerts.slice(0, 3).map((c) => (
              <li>
                <span class="concert-date"><b>{c.day}</b>{c.month}</span>
                <span class="concert-info">
                  {c.url ? <a href={c.url} target="_blank" rel="noopener"><b>{c.artist}</b></a> : <b>{c.artist}</b>}
                  {c.venue}
                </span>
                {c.price && <span class="concert-price">{c.price}</span>}
              </li>
            ))}
          </ul>
        </section>

        <section>
          <div class="bz-section-head"><h2 class="bz-h2">Barz du jour</h2></div>
          {quotes.map((q) => (
            <a class="quote" href="/BARZ-/commu">
              <span class="quote-meta">{q.handle} · <b>{q.score}</b></span>
              <span class="quote-text">{q.text}</span>
            </a>
          ))}
        </section>
      </aside>
    </div>

    <section class="artists" aria-labelledby="artists-title">
      <div class="bz-section-head"><h2 id="artists-title" class="bz-h2">Tes artistes ont sorti</h2></div>
      {watched.length > 0 ? (
        <div class="bz-tiles">
          {watched.map((r) => (
            <AlbumTile title={r.title} subtitle={r.artist?.name ?? ''} cover={r.cover_url} href={`/BARZ-/releases/${r.slug}`} />
          ))}
        </div>
      ) : (
        <p class="bz-empty">Rien de neuf chez tes artistes suivis cette semaine. La liste se modifie dans <strong>scripts/artist-watchlist.json</strong>.</p>
      )}
    </section>
  </div>
</Layout>

<style>
  .recap {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    align-items: center;
    gap: 40px;
    margin-top: 64px;
    padding: 56px;
    border-radius: 28px;
    background: var(--color-cream);
    color: var(--color-ink);
    overflow: hidden;
  }

  .recap-text {
    position: relative;
    z-index: 20;
  }

  .recap-eyebrow {
    font: 700 13px/1 var(--font-sans);
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .recap-title {
    margin: 24px 0 26px;
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(40px, 4.6vw, 76px);
    line-height: 0.92;
    letter-spacing: -0.02em;
    color: var(--color-ink);
  }

  .recap-title em {
    font-style: italic;
  }

  .recap p {
    max-width: 540px;
    margin-bottom: 34px;
    font-size: 17px;
    line-height: 1.55;
    color: #3d3a35;
  }

  .fan {
    position: relative;
    height: 300px;
  }

  .fan-card {
    position: absolute;
    top: 50%;
    left: 62%;
    width: 210px;
    box-shadow: 0 30px 50px -20px rgba(0, 0, 0, 0.45);
    border-radius: 6px;
    transform: translate(calc(-50% + (var(--i) - 2) * 92px), -50%) rotate(calc((var(--i) - 2) * 5deg));
    z-index: calc(10 - var(--i));
  }

  .fan-card:nth-child(1) {
    z-index: 12;
    transform: translate(-50%, -54%) rotate(0deg);
  }

  .fan-card:nth-child(2) {
    transform: translate(calc(-50% - 100px), -48%) rotate(-7deg);
  }

  .fan-card:nth-child(3) {
    transform: translate(calc(-50% + 100px), -48%) rotate(6deg);
  }

  .fan-card:nth-child(4) {
    transform: translate(calc(-50% - 190px), -44%) rotate(-12deg);
  }

  .fan-card:nth-child(5) {
    transform: translate(calc(-50% + 190px), -44%) rotate(11deg);
  }

  .split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 440px;
    gap: 64px;
    margin-top: 76px;
  }

  .grid {
    margin-top: 28px;
  }

  .chip-empty {
    margin-top: 24px;
    color: var(--color-text-muted);
  }

  .more {
    display: inline-block;
    margin-top: 28px;
  }

  .side {
    display: flex;
    flex-direction: column;
    gap: 56px;
  }

  .challenge {
    padding: 36px 32px;
    border-radius: 24px;
    background: var(--color-orange);
    color: var(--color-ink);
  }

  .challenge-eyebrow {
    font: 700 13px/1 var(--font-sans);
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .challenge h2 {
    margin: 20px 0 18px;
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: 48px;
    line-height: 0.95;
    color: var(--color-ink);
  }

  .challenge p {
    margin-bottom: 26px;
    color: #2b1609;
    font-size: 16px;
  }

  .concerts {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .concerts li {
    display: flex;
    align-items: center;
    gap: 22px;
    padding: 18px 20px;
    border: 1px solid var(--color-border);
    border-radius: 16px;
  }

  .concert-date {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 44px;
    font: 700 12px/1 var(--font-sans);
    letter-spacing: 0.12em;
    color: var(--color-lime);
  }

  .concert-date b {
    margin-bottom: 6px;
    font: 400 38px/1 var(--font-serif);
    letter-spacing: 0;
    color: var(--color-text);
  }

  .concert-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 15px;
    color: var(--color-text-muted);
  }

  .concert-info b {
    font-size: 17px;
    color: var(--color-text);
  }

  .concert-price {
    padding: 7px 12px;
    border: 1px solid #3a3a3a;
    border-radius: 999px;
    font-weight: 700;
    font-size: 14px;
  }

  .quote {
    display: block;
    margin-bottom: 14px;
    padding: 22px;
    border-radius: 16px;
    background: var(--color-bg-elevated);
    transition: background var(--transition-fast);
  }

  .quote:hover {
    background: var(--color-bg-surface);
  }

  .quote-meta {
    display: block;
    font-weight: 700;
    font-size: 14px;
  }

  .quote-meta b {
    color: var(--color-lime);
  }

  .quote-text {
    display: block;
    margin-top: 10px;
    font: 400 24px/1.25 var(--font-serif);
  }

  .artists {
    margin-top: 80px;
  }

  @media (max-width: 1280px) {
    .split {
      grid-template-columns: minmax(0, 1fr);
    }
    .side {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 40px;
    }
  }

  @media (max-width: 900px) {
    .recap {
      grid-template-columns: minmax(0, 1fr);
      margin-top: 36px;
      padding: 32px 24px;
    }
    .fan {
      height: 200px;
      order: -1;
    }
    .fan-card {
      width: 150px;
    }
    .fan-card:nth-child(4),
    .fan-card:nth-child(5) {
      display: none;
    }
    .fan-card:nth-child(2) {
      transform: translate(calc(-50% - 80px), -48%) rotate(-7deg);
    }
    .fan-card:nth-child(3) {
      transform: translate(calc(-50% + 80px), -48%) rotate(6deg);
    }
    .split {
      margin-top: 48px;
    }
    .challenge h2 {
      font-size: 38px;
    }
  }
</style>
