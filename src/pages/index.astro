---
import Layout from '../layouts/Layout.astro';
import { getSupabaseServerSafe, WeeklyReleases } from '../lib/supabase';
import ReleaseGrid from '../components/ReleaseGrid.tsx';
import { getCurrentWeekStart } from '../lib/utils';
import { format } from 'date-fns';
import { fr } from 'date-fns/locale';

const supabase = getSupabaseServerSafe();
const currentWeek = format(getCurrentWeekStart(), 'yyyy-MM-dd');

let weeklyData = [];
if (supabase) {
  try {
    const { data, error } = await supabase
      .from('weekly_releases')
      .select('*')
      .gte('week_start', currentWeek)
      .lte('week_start', format(new Date(Date.now() + 21 * 24 * 60 * 60 * 1000), 'yyyy-MM-dd'))
      .order('week_start', { ascending: true });

    if (!error && data) {
      weeklyData = data;
    }
  } catch (e) {
    console.warn('Supabase query failed:', e);
  }
} else {
  console.warn('Supabase not configured, using empty data for build');
}

const fridayReleases = [];
let totalThisWeek = 0;

weeklyData.forEach((w) => {
  (w.releases || []).forEach((r) => {
    const day = new Date(r.release_date);
    if (day.getDay() === 5) {
      fridayReleases.push(r);
    }
  });
});
totalThisWeek = fridayReleases.length;

const currentWeekData = weeklyData.find(w => w.week_start === currentWeek);
const recapRelease = currentWeekData?.releases?.[0] || null;
---

<Layout title="Vendredi - BARZ" description="Salut Alban, découvre les sorties de ce vendredi. Ton récap musical et tes artistes suivis.">
  <div class="container section-lg">
    <!-- En-tête Vendredi personnalisé -->
    <header class="mb-12">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div>
          <span class="inline-block px-2 py-0.5 rounded text-xs font-semibold uppercase tracking-wider text-[#a3e635] bg-[#a3e635]/10 border border-[#a3e635]/25">
            Vendredi {format(getCurrentWeekStart(), "d MMMM", { locale: fr })}
          </span>
          <h1 class="text-5xl md:text-6xl font-bold mt-3 mb-2 text-[var(--color-text)]">
            Salut Alban, {totalThisWeek} sortie{totalThisWeek > 1 ? 's' : ''} pour toi<span class="gradient-text">.</span>
          </h1>
          <p class="text-lg text-muted">
            Ton récap musical du vendredi. Découvre les nouveaux albums, EPs et singles qui sortent aujourd'hui.
          </p>
        </div>
        <a href="/BARZ-/releases" class="btn btn-secondary btn-sm hidden md:flex">
          Toutes les sorties
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" aria-hidden="true">
            <path d="M5 12h14M12 5l7 7-7 7" />
          </svg>
        </a>
      </div>
    </header>

    <!-- Récap du vendredi -->
    {recapRelease && (
      <section class="mb-12 relative overflow-hidden rounded-[var(--radius-xl2)] border border-[var(--color-border)] bg-[var(--color-bg-surface)] card">
        <div class="grid md:grid-cols-12 gap-0">
          <div class="md:col-span-5 relative aspect-[16/9] overflow-hidden">
            <img
              src={recapRelease!.cover_url || '/BARZ-/placeholder-release.svg'}
              alt={`Couverture de ${recapRelease!.title}`}
              class="w-full h-full object-cover"
              loading="eager"
            />
            <div class="absolute inset-0 bg-gradient-to-r from-[var(--color-bg)]/95 to-transparent" />
            <span class="absolute top-3 left-3 badge bg-[#a3e635] text-[#09090b]">Récap</span>
          </div>
          <div class="md:col-span-7 p-6 md:p-10 flex flex-col justify-center">
            <div class="flex items-center gap-2 mb-2 text-xs text-muted uppercase tracking-wider">
              <span>LE RÉCAP</span>
              <span>·</span>
              <span>3 MIN</span>
            </div>
            <h2 class="text-3xl md:text-4xl font-bold mb-4 text-[var(--color-text)] leading-tight">
              {recapRelease!.title}
            </h2>
            <p class="text-xl text-muted mb-6 font-medium">
              {recapRelease!.artist?.name}
            </p>
            <p class="text-base text-muted mb-8 max-w-md">
              {recapRelease!.genres?.slice(0, 2).join(' · ') || 'Nouvelle sortie'} : le disque à ne pas manquer ce vendredi.
            </p>
            <a href={`/BARZ-/releases/${recapRelease!.slug}`} class="btn btn-primary">
              Lancer le récap →
            </a>
          </div>
        </div>
      </section>
    )}

    <!-- Tes artistes suivis -->
    <section class="mb-12">
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-2xl font-bold text-[var(--color-text)]">Tes artistes</h2>
        <a href="/BARZ-/commu" class="text-sm text-[var(--color-accent)] font-semibold hover:text-[var(--color-accent-hover)]">Voir tous</a>
      </div>
      <div class="grid gap-4 md:grid-cols-3 lg:grid-cols-4">
        {[
          { name: 'Néons Lents', artist: 'Mira Kale', cover: '/BARZ-/placeholder-release.svg' },
          { name: 'Hiver 04', artist: 'Sacha Rubis', cover: '/BARZ-/placeholder-release.svg' },
          { name: 'Sous silence', artist: 'Lou Valentin', cover: '/BARZ-/placeholder-release.svg' },
        ].map((a) => (
          <a href="/BARZ-/" class="card card-interactive flex items-center gap-3 p-3 transition" key={a.name}>
            <div class="relative w-16 h-16 flex-shrink-0 overflow-hidden rounded-[var(--radius-md)]">
              <img src={a.cover} alt={a.name} class="w-full h-full object-cover" loading="lazy" />
            </div>
            <div class="min-w-0">
              <p class="font-medium truncate text-[var(--color-text)]">{a.name}</p>
              <p class="text-sm text-muted truncate">{a.artist}</p>
              <div class="flex items-center gap-1.5 mt-1">
                <span class="badge badge-type text-[0.65rem] bg-[var(--color-bg-hover)] text-[var(--color-text-muted)] border-[var(--color-border)]">
                  Suivi
                </span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Toutes les sorties de la semaine (grille) -->
    <section>
      <div class="flex items-center justify-between mb-8">
        <h2 class="text-2xl font-bold text-[var(--color-text)]">Toutes les sorties de la semaine</h2>
        <a href="/BARZ-/calendar" class="btn btn-ghost btn-sm">Voir le calendrier</a>
      </div>
      <ReleaseGrid
        client:visible
        releases={fridayReleases}
        emptyMessage="Aucune sortie ce vendredi"
        variant="default"
      />
    </section>
  </div>
</Layout>
