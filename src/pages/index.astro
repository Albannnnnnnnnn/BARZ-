---
// HOME - "Cette semaine" : Calendrier des sorties
import Layout from '../layouts/Layout.astro';
import { getSupabaseServerSafe, WeeklyReleases } from '../lib/supabase';
import CalendarView from '../components/CalendarView.tsx';
import { getCurrentWeekStart } from '../lib/utils';
import { format } from 'date-fns';

// Récupérer les données de la semaine courante + 3 semaines suivantes
const supabase = getSupabaseServerSafe();
const currentWeek = format(getCurrentWeekStart(), 'yyyy-MM-dd');

let weeklyData: WeeklyReleases[] = [];
if (supabase) {
  try {
    const { data, error } = await supabase
      .from('weekly_releases')
      .select('*')
      .gte('week_start', currentWeek)
      .lte('week_start', format(new Date(Date.now() + 21 * 24 * 60 * 60 * 1000), 'yyyy-MM-dd'))
      .order('week_start', { ascending: true });

    if (!error && data) {
      weeklyData = data as WeeklyReleases[];
    }
  } catch (e) {
    console.warn('Supabase query failed:', e);
  }
} else {
  console.warn('Supabase not configured, using empty data for build');
}

if (import.meta.env.PROD && weeklyData.length === 0) {
  console.warn('No weekly releases data found - check Supabase connection');
}

// Extraire tous les genres disponibles
const allGenres = [...new Set(
  (weeklyData || []).flatMap(w => w.releases || []).flatMap((r: any) => r.genres || [])
)].sort();

const weeklyReleases: WeeklyReleases[] = weeklyData;
---

<Layout title="Cette semaine - BARZ" description="Découvre les sorties musicales de la semaine. Albums, EPs, singles - tous les vendredis sur BARZ.">
  <div class="container section">
    <!-- Hero -->
    <header class="mb-10 text-center">
      <h1 class="text-4xl md:text-5xl font-bold mb-4" style="letter-spacing: -0.03em; color: var(--color-text);">
        Cette semaine
      </h1>
      <p class="text-lg max-w-2xl mx-auto" style="color: var(--color-text-muted);">
        Le calendrier des sorties musicales. Tous les vendredis, découvre les nouveaux albums, EPs et singles.
        Filtre par genre, navigue dans les semaines, ne rate rien.
      </p>
    </header>

    <!-- Calendar View (React Island) -->
    <CalendarView
      client:visible
      currentWeek={currentWeek}
      weeklyData={weeklyReleases}
      availableGenres={allGenres}
    />

    <!-- Stats rapides -->
    <section class="mt-12 grid grid-cols-2 md:grid-cols-4 gap-4 text-center">
      <div class="card p-6">
        <p class="text-3xl font-bold" style="color: var(--color-accent);">
          {weeklyReleases.reduce((sum, w) => sum + (w.releases?.length || 0), 0)}
        </p>
        <p class="text-sm text-muted mt-1">Sorties sur 4 semaines</p>
      </div>
      <div class="card p-6">
        <p class="text-3xl font-bold" style="color: var(--color-text);">
          {allGenres.length}
        </p>
        <p class="text-sm text-muted mt-1">Genres représentés</p>
      </div>
      <div class="card p-6">
        <p class="text-3xl font-bold" style="color: var(--color-text);">
          {new Set(weeklyReleases.flatMap(w => w.releases?.map((r: any) => r.artist?.name) || [])).size}
        </p>
        <p class="text-sm text-muted mt-1">Artistes uniques</p>
      </div>
      <div class="card p-6">
        <p class="text-3xl font-bold" style="color: var(--color-text);">
          {weeklyReleases.filter(w => w.releases?.some((r: any) => r.release_type === 'album')).length}
        </p>
        <p class="text-sm text-muted mt-1">Semaines avec albums</p>
      </div>
    </section>

    <!-- CTA -->
    <section class="mt-12 text-center">
      <a href="/releases" class="btn btn-primary btn-lg">
        Voir toutes les sorties
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" aria-hidden="true">
          <path d="M5 12h14M12 5l7 7-7 7" />
        </svg>
      </a>
    </section>
  </div>
</Layout>

<style is:global>
  /* Animations pour le calendrier */
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .calendar-view > * {
    animation: fadeIn 0.3s ease forwards;
  }
</style>