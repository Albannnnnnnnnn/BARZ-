---
// PAGE VENDREDI - Accueil (maquette PC)
import Layout from '../layouts/Layout.astro';
import { getSupabaseServerSafe } from '../lib/supabase';
import { getCurrentWeekStart } from '../lib/utils';
import { format } from 'date-fns';
import { fr } from 'date-fns/locale';

const supabase = getSupabaseServerSafe();
const currentWeek = format(getCurrentWeekStart(), 'yyyy-MM-dd');

let weeklyData = [];
if (supabase) {
  try {
    const { data, error } = await supabase
      .from('weekly_releases')
      .select('*')
      .gte('week_start', currentWeek)
      .lte(
        'week_start',
        format(new Date(Date.now() + 21 * 24 * 60 * 60 * 1000), 'yyyy-MM-dd')
      )
      .order('week_start', { ascending: true });

    if (!error && data) {
      weeklyData = data;
    }
  } catch (e) {
    console.warn('Supabase query failed:', e);
  }
} else {
  console.warn('Supabase not configured, using empty data for build');
}

const fridayReleases = [];
let totalThisWeek = 0;

weeklyData.forEach((w) => {
  (w.releases || []).forEach((r) => {
    const day = new Date(r.release_date);
    if (day.getDay() === 5) {
      fridayReleases.push(r);
    }
  });
});
totalThisWeek = fridayReleases.length;

const currentWeekData = weeklyData.find((w) => w.week_start === currentWeek);
const recapRelease = currentWeekData?.releases?.[0] || null;

const weekLabel = format(getCurrentWeekStart(), "dd MMMM", { locale: fr });
const weekNumber = Math.ceil(
  (getCurrentWeekStart().getDate() +
    new Date(getCurrentWeekStart().getFullYear(), 0, 1).getDay() -
    1) /
    7
);

const followedArtists = [
  { name: 'Néons Lents', artist: 'Mira Kale', cover: '/BARZ-/placeholder-release.svg' },
  { name: 'Hiver 04', artist: 'Sacha Rubis', cover: '/BARZ-/placeholder-release.svg' },
  { name: 'Sous silence', artist: 'Lou Valentin', cover: '/BARZ-/placeholder-release.svg' },
];
---

<Layout title="Vendredi - BARZ" description="Salut Alban, découvre les sorties de ce vendredi. Ton récap musical et tes artistes suivis.">
  <div class="container section-sm py-4">
    {/* Desktop: week label + hero */}
    <div class="desktop-only">
      <span class="inline-block px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-widest text-lime bg-lime/10 border border-lime/25 mb-2 block">
        Vendredi {weekLabel} • Semaine {weekNumber}
      </span>
      <h1 class="font-serif text-5xl font-bold mt-0 mb-6 text-[var(--color-text)] leading-tight">
        Salut Alban, {totalThisWeek} sortie{totalThisWeek > 1 ? 's' : ''} pour toi<span class="text-lime">.</span>
      </h1>
    </div>

    {/* Mobile: week label + hero */}
    <div class="mobile-only">
      <span class="inline-block px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-widest text-lime bg-lime/10 border border-lime/25 mb-4 block">
        Vendredi {weekLabel} • Semaine {weekNumber}
      </span>
      <h1 class="font-serif text-5xl md:text-6xl font-bold mt-2 mb-3 text-[var(--color-text)] leading-tight">
        Salut Alban, {totalThisWeek} sortie{totalThisWeek > 1 ? 's' : ''} pour toi<span class="text-lime">.</span>
      </h1>
      <p class="text-sm text-muted mb-6">
        Ton récap musical du vendredi. Découvre les nouveaux albums, EPs et singles qui sortent aujourd'hui.
      </p>
    </div>

    {/* Toutes les sorties link */}
    <a
      href="/BARZ-/releases"
      class="flex items-center justify-between px-4 py-2 rounded-2xl border border-[var(--color-border)] bg-[var(--color-bg-surface)]/50 mb-6 text-sm font-medium text-[var(--color-text)]"
    >
      <span>Toutes les sorties</span>
      <svg
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        strokeWidth="2"
        strokeLinecap="round"
        strokeLinejoin="round"
        aria-hidden="true"
      >
        <line x1="5" y1="12" x2="19" y2="12" />
        <line x1="12" y1="5" x2="12" y2="19" />
      </svg>
    </a>

    {/* Récap du vendredi */}
    {recapRelease && (
      <section class="mb-6 rounded-[var(--radius-xl2)] bg-[var(--color-surface-cream)] p-5 md:p-6 overflow-hidden">
        <div class="flex items-center justify-between mb-3">
          <span class="text-[10px] font-bold uppercase tracking-widest text-lime-dark">Le récap • 3 min</span>
        </div>
        <div class="grid md:grid-cols-12 gap-4">
          <div class="md:col-span-5 relative aspect-[3/4] overflow-hidden rounded-[var(--radius-lg)]">
            <img
              src={recapRelease!.cover_url || '/BARZ-/placeholder-release.svg'}
              alt={`Couverture de ${recapRelease!.title}`}
              class="w-full h-full object-cover"
              loading="eager"
            />
            <span class="absolute top-3 left-3 badge bg-[#a3e635] text-[#09090b] text-[10px] font-bold">Récap</span>
          </div>
          <div class="md:col-span-7 flex flex-col justify-center">
            <h2 class="font-serif text-2xl md:text-3xl font-bold mb-2 text-[var(--color-text)] leading-tight">
              {recapRelease!.title}
            </h2>
            <p class="text-sm text-muted mb-4">{recapRelease!.artist?.name}</p>
            <p class="text-xs text-muted mb-5 max-w-md">
              {recapRelease!.genres?.slice(0, 2).join(' · ') || 'Nouvelle sortie'} : le disque à ne pas manquer ce vendredi.
            </p>
            <a href={`/BARZ-/releases/${recapRelease!.slug}`} class="btn btn-primary btn-sm w-full">
              Lancer le récap →
            </a>
          </div>
        </div>
      </section>
    )}

    {/* Tes artistes suivis */}
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-2xl font-bold text-[var(--color-text)]">Tes artistes</h2>
      <span class="text-[12px] font-bold text-lime">{followedArtists.length} suivis</span>
    </div>
    <div class="grid gap-3">
      {followedArtists.map((a) => (
        <a href="/BARZ-/" class="card card-interactive flex items-center gap-3 p-3">
          <div class="relative w-14 h-14 flex-shrink-0 overflow-hidden rounded-[var(--radius-md)]">
            <img src={a.cover} alt={a.name} class="w-full h-full object-cover" loading="lazy" />
          </div>
          <div class="min-w-0 flex-1">
            <p class="font-medium truncate text-[var(--color-text)] text-sm">{a.name}</p>
            <p class="text-xs text-muted truncate">{a.artist}</p>
          </div>
          <span class="badge bg-[#a3e635] text-[#09090b] text-[10px] font-bold py-1 px-2">Suivi</span>
        </a>
      ))}
    </div>

    {/* ===== DESKTOP RIGHT SIDEBAR ===== */}
    <div class="desktop-only grid lg:grid-cols-12 gap-8 mt-8">
      <div class="lg:col-span-8">
        {/* Toutes les sorties section for desktop */}
        <h2 class="font-serif text-3xl font-bold mb-6 text-[var(--color-text)] leading-tight">
          Toutes les sorties
        </h2>
        <div class="flex gap-3 mb-6 overflow-x-auto pb-2 scrollbar-hide">
          <button class="px-4 py-1.5 rounded-full bg-[#a3e635] text-[#09090b] text-xs font-bold">Tout</button>
          <button class="px-4 py-1.5 rounded-full border border-[var(--color-border)] text-[var(--color-text-muted)] text-xs font-bold hover:text-[var(--color-text)] hover:border-[var(--color-border-hover)] transition">Rap</button>
          <button class="px-4 py-1.5 rounded-full border border-[var(--color-border)] text-[var(--color-text-muted)] text-xs font-bold hover:text-[var(--color-text)] hover:border-[var(--color-border-hover)] transition">Électro</button>
          <button class="px-4 py-1.5 rounded-full border border-[var(--color-border)] text-[var(--color-text-muted)] text-xs font-bold hover:text-[var(--color-text)] hover:border-[var(--color-border-hover)] transition">Pop</button>
          <button class="px-4 py-1.5 rounded-full border border-[var(--color-border)] text-[var(--color-text-muted)] text-xs font-bold hover:text-[var(--color-text)] hover:border-[var(--color-border-hover)] transition">Jazz</button>
          <button class="px-4 py-1.5 rounded-full border border-[var(--color-border)] text-[var(--color-text-muted)] text-xs font-bold hover:text-[var(--color-text)] hover:border-[var(--color-border-hover)] transition">Rock</button>
          <button class="px-4 py-1.5 rounded-full border border-[var(--color-border)] text-[var(--color-text-muted)] text-xs font-bold hover:text-[var(--color-text)] hover:border-[var(--color-border-hover)] transition">Soul</button>
          <button class="px-4 py-1.5 rounded-full border border-[var(--color-border)] text-[var(--color-text-muted)] text-xs font-bold hover:text-[var(--color-text)] hover:border-[var(--color-border-hover)] transition">Monde</button>
        </div>
        <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-6">
          {[
            { title: 'Kintsugi', artist: 'Tamo & Th...', score: 8.8, cover: '/BARZ-/placeholder-release.svg' },
            { title: 'Néon Lents', artist: 'Mira Kale - ...', score: 8.4, cover: '/BARZ-/placeholder-release.svg' },
            { title: 'Basse M...', artist: 'Ostra - EP', score: 7.9, cover: '/BARZ-/placeholder-release.svg' },
            { title: 'Sous la ...', artist: 'Lou Varenn...', score: 7.2, cover: '/BARZ-/placeholder-release.svg' },
            { title: 'Terre Brûlée', artist: 'Volta Noire ...', score: 7.6, cover: '/BARZ-/placeholder-release.svg' },
            { title: 'Hiver 04', artist: 'Sacha Rub...', score: 6.8, cover: '/BARZ-/placeholder-release.svg' },
          ].map((r) => (
            <article class="card card-interactive overflow-hidden group" key={r.title}>
              <div class="relative aspect-[1/1] overflow-hidden">
                <img src={r.cover} alt={r.title} class="w-full h-full object-cover" loading="lazy" />
                <span class="absolute bottom-3 left-3 bg-black/60 backdrop-blur text-white text-[10px] font-bold px-2 py-1 rounded">{r.score}</span>
              </div>
              <div class="p-3">
                <h3 class="font-bold text-sm truncate mb-1 text-[var(--color-text)]">{r.title}</h3>
                <p class="text-xs text-muted truncate">{r.artist}</p>
              </div>
            </article>
          ))}
        </div>
      </div>

      <div class="lg:col-span-4">
        <div class="space-y-6">
          {/* Défi de la semaine */}
          <div class="rounded-[var(--radius-xl2)] bg-[#f97316] p-6 text-white">
            <span class="text-[10px] font-bold uppercase tracking-widest opacity-90">Défi de la semaine</span>
            <h2 class="font-serif text-3xl font-bold mt-2 mb-4 leading-tight">Un album de cumbia psychédélique</h2>
            <p class="text-sm opacity-90 mb-6">1 248 membres relèvent le défi · se termine dimanche</p>
            <button class="bg-[#09090b] text-[#a3e635] px-6 py-2 rounded-full text-xs font-bold hover:bg-[#a3e635] hover:text-[#09090b] transition">Relever le défi</button>
          </div>

          {/* Concerts */}
          <div>
            <h3 class="font-serif text-2xl font-bold mb-4 text-[var(--color-text)]">Concerts</h3>
            <div class="space-y-3">
              {[
                { date: '12 AVR', artist: 'Mira Kale', venue: 'Zénith, Paris', price: '39 €' },
                { date: '18 AVR', artist: 'Tamo & The Fold', venue: 'New Morning, Paris', price: '28 €' },
                { date: '02 MAI', artist: 'Ostra', venue: 'Le Sucre, Lyon', price: '18 €' },
              ].map((c) => (
                <div class="flex items-center gap-3 p-3 rounded-[var(--radius-lg)] border border-[var(--color-border)] bg-[var(--color-bg-elevated)]" key={c.artist}>
                  <span class="text-[10px] font-bold text-lime w-12 text-center">{c.date}</span>
                  <div class="flex-1 min-w-0">
                    <p class="font-semibold text-sm text-[var(--color-text)] truncate">{c.artist}</p>
                    <p class="text-xs text-muted truncate">{c.venue}</p>
                  </div>
                  <span class="text-xs font-bold text-[var(--color-text)]">{c.price}</span>
                </div>
              ))}
            </div>
          </div>

          {/* Barz du jour */}
          <div>
            <h3 class="font-serif text-2xl font-bold mb-4 text-[var(--color-text)]">Barz du jour</h3>
            <div class="p-3 rounded-[var(--radius-lg)] border border-[var(--color-border)] bg-[var(--color-bg-elevated)]">
              <div class="flex items-start gap-3 mb-3">
                <div class="w-8 h-8 rounded-full bg-[#a3e635] flex items-center justify-center text-[10px] font-bold text-[#09090b]">I</div>
                <div class="flex-1 min-w-0">
                  <p class="font-semibold text-sm text-[var(--color-text)]">Inès</p>
                  <p class="text-xs text-muted">@ines.wav · il y a 1 h</p>
                </div>
              </div>
              <p class="text-sm text-[var(--color-text)] mb-3">« Je n'écoutais jamais de jazz. Le défi de la semaine m'a convertie. »</p>
              <div class="flex items-center justify-between">
                <img src="/BARZ-/placeholder-release.svg" alt="Kintsugi" class="w-16 h-16 rounded-[var(--radius-md)] object-cover" />
                <div class="text-right">
                  <span class="font-bold text-sm text-[var(--color-text)]">Kintsugi</span>
                  <span class="text-xs font-bold bg-[#a3e635] text-[#09090b] px-2 py-0.5 rounded">9.5</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
</style>