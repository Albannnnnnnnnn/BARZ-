---
// PAGE PROFIL : son propre profil (connecté), celui d'un membre (?u=pseudo), sinon une invitation à se connecter.
// Les vraies données sont lues par le navigateur (src/scripts/social.ts).
// Amis : demande puis acceptation (supabase/friends.sql) ; entre amis, la section « Pour vous deux ».
import Layout from '../layouts/Layout.astro';
---

<Layout title="Profil" description="Ton ADN musical, ta spin list, tes Barz.">
  <div class="bz-page">
    <section class="cta" id="profile-cta">
      <span class="bz-eyebrow">Profil</span>
      <h1 class="bz-display">Ta musique, <em>ton profil.</em></h1>
      <ul class="perks">
        <li><b>Spin list</b>Les sorties à écouter, gardées au même endroit.</li>
        <li><b>Barz</b>Note les sorties et donne ton avis en quelques mots.</li>
        <li><b>ADN musical</b>Tes genres et tes artistes, avec un bilan chaque mois.</li>
        <li><b>Amis</b>Vois ce que tes amis écoutent et compare vos goûts.</li>
      </ul>
      <div class="cta-actions">
        <a class="bz-btn bz-btn--lime" href="/BARZ-/connexion?mode=signup">Créer mon compte</a>
        <a class="bz-link" href="/BARZ-/connexion">Déjà membre ? Se connecter</a>
      </div>
    </section>
    <p class="bz-notice bz-notice--error" id="profile-error" hidden></p>

    <div id="p-content" hidden>
      <section class="hero">
        <span class="avatar" id="p-avatar"></span>
        <div class="identity">
          <h1 id="p-name"></h1>
          <p class="handle" id="p-handle"></p>
          <p class="bio" id="p-bio"></p>
          <a class="bz-link bilan-link" id="p-bilan" href="/BARZ-/bilan" hidden>Bilan du mois →</a>
          <div class="own-actions" id="p-own" hidden>
            <a class="bz-btn bz-btn--outline" href="/BARZ-/modifier-profil">Modifier le profil</a>
            <a class="bz-btn bz-btn--outline" href="/BARZ-/parametres">Paramètres</a>
          </div>
          <div class="own-actions" id="p-friend" hidden></div>
        </div>
        <dl class="stats" id="p-stats"></dl>
      </section>

      <div id="p-np" hidden></div>

      <section class="block" id="p-picks" hidden aria-labelledby="picks-title">
        <div class="bz-section-head"><h2 id="picks-title" class="bz-h2">Ses coups de cœur</h2></div>
        <div class="bz-tiles bz-rail" id="p-picks-releases"></div>
        <h3 class="sub" id="p-picks-artists-title">Artistes préférés</h3>
        <div class="bz-artists bz-rail bz-rail--compact" id="p-picks-artists"></div>
        <button type="button" class="bz-btn bz-btn--outline bz-btn--small picks-more" id="p-picks-more" hidden>Voir tous les artistes</button>
      </section>

      <section class="block" id="p-blend" hidden aria-labelledby="blend-title">
        <div class="bz-section-head"><h2 id="blend-title" class="bz-h2">Pour vous deux</h2></div>
        <p class="blend-note" id="p-blend-note"></p>
        <div class="bz-tiles bz-rail" id="p-blend-releases"></div>
        <h3 class="sub" id="p-blend-artists-title" hidden>Vos artistes en commun</h3>
        <div class="bz-artists bz-rail bz-rail--compact" id="p-blend-artists"></div>
      </section>

      <div class="layout">
        <div class="left">
          <section class="dna" aria-labelledby="dna-title">
            <h2 id="dna-title">Ton ADN musical</h2>
            <ul id="p-dna"></ul>
            <p id="p-dna-note"></p>
          </section>

          <section class="activity" aria-labelledby="activity-title">
            <div class="bz-section-head"><h2 id="activity-title" class="bz-h2">Activité récente</h2></div>
            <ul id="p-activity"></ul>
          </section>

          <section class="friends" id="p-friends" hidden aria-labelledby="friends-title">
            <div class="bz-section-head"><h2 id="friends-title" class="bz-h2">Amis</h2></div>
            <form id="friend-search" class="lastfm-form" role="search">
              <label class="sr-only" for="friend-input">Chercher un membre</label>
              <input id="friend-input" class="bz-input" maxlength="40" placeholder="Pseudo ou nom d’un membre" autocomplete="off" />
              <button type="submit" class="bz-btn bz-btn--lime bz-btn--small">Chercher</button>
            </form>
            <ul class="friend-list" id="friend-results"></ul>
            <ul class="friend-list" id="friend-list"></ul>
          </section>


        </div>

        <section class="collection" aria-label="Collections">
          <div class="bz-chips" role="tablist" id="p-tabs">
            <button type="button" class="bz-chip is-active" role="tab" aria-selected="true" data-tab="spin_list">Spin list</button>
            <button type="button" class="bz-chip" role="tab" aria-selected="false" data-tab="listened">Écoutés</button>
            <button type="button" class="bz-chip" role="tab" aria-selected="false" data-tab="barz">Barz</button>
            <button type="button" class="bz-chip" role="tab" aria-selected="false" data-tab="artists">Artistes</button>
            <button type="button" class="bz-chip" role="tab" aria-selected="false" data-tab="bilans">Bilans</button>
          </div>
          <div class="spin" id="p-collection"></div>
        </section>
      </div>

    </div>
  </div>
</Layout>

<script>
  import {
    ARTIST_LITE,
    BASE,
    artistCardHtml,
    authErrorMessage, errorText,
    barzCardHtml,
    barzFeed,
    avatarUrl,
    coverHtml,
    escapeHtml,
    acceptFriendRequest,
    friendStatusWith,
    getSession,
    loginUrl,
    myFollows,
    myFriendships,
    releaseTileHtml,
    removeFriendship,
    searchMembers,
    sendFriendRequest,
    shelfOf,
    supabase,
    wireBarzActions,
    wireFollowButtons,
    type ArtistLite,
    type FriendStatus,
    type Profile,
    type ReleaseLite,
  } from '../scripts/social';
  import { GENRE_CHIPS } from '../lib/genres';
  import { loadTaste, loadTasteOf, rankForTwo, recentReleases, sharedArtists, type Taste } from '../scripts/reco';
  import { nowPlaying, nowPlayingHtml, spotifyAvailable } from '../scripts/spotify';

  const MONTHS = ['janvier', 'février', 'mars', 'avril', 'mai', 'juin', 'juillet', 'août', 'septembre', 'octobre', 'novembre', 'décembre'];

  const $ = (id: string) => document.getElementById(id)!;
  const TYPE_LABELS: Record<string, string> = { album: 'Album', ep: 'EP', compilation: 'Compilation', single: 'Single', live: 'Live', remix: 'Remix', soundtrack: 'B.O.' };

  function tileHtml(r: ReleaseLite, badge?: string) {
    return `<a class="p-tile" href="${BASE}releases/${encodeURIComponent(r.slug)}">
      ${coverHtml(r.title, r.cover_url)}
      <span class="p-tile-row"><b>${escapeHtml(r.title)}</b>${badge ? `<span class="bz-score">${escapeHtml(badge)}</span>` : ''}</span>
      <span class="p-tile-sub">${escapeHtml(r.artist?.name ?? '')} · ${TYPE_LABELS[r.release_type] ?? ''}</span>
    </a>`;
  }

  // ADN musical : part de chaque genre dans tout ce que le membre a écouté, mis de côté ou noté
  function dnaOf(releases: ReleaseLite[]) {
    const counts = new Map<string, number>();
    let total = 0;
    for (const r of releases) {
      const labels = GENRE_CHIPS.filter((c) => c.genres.some((g) => r.genres?.includes(g))).map((c) => c.label);
      for (const label of labels.length ? labels : ['Autres']) {
        counts.set(label, (counts.get(label) ?? 0) + 1);
        total++;
      }
    }
    const sorted = [...counts.entries()].sort((a, b) => b[1] - a[1]);
    const top = sorted.filter(([label]) => label !== 'Autres').slice(0, 3);
    const others = total - top.reduce((sum, [, n]) => sum + n, 0);
    const rows = [...top, ...(others > 0 ? [['Autres', others] as [string, number]] : [])];
    return rows.map(([genre, n]) => ({ genre, pct: Math.round((n / total) * 100) }));
  }

  // Les écouteurs de clics ne sont branchés qu'une fois : load() se relance après chaque action
  let renderTab: (tab: string) => void = () => {};
  let wired = false;

  async function load() {
    if (!supabase) return;
    const wanted = new URLSearchParams(location.search).get('u');
    const session = await getSession();

    let profile: Profile | null = null;
    if (wanted) {
      const { data } = await supabase.from('profiles').select('*').eq('username', wanted.toLowerCase()).maybeSingle();
      profile = data as Profile | null;
      if (!profile) {
        $('profile-error').textContent = `Aucun membre ne s’appelle @${wanted}.`;
        $('profile-error').hidden = false;
        $('profile-cta').hidden = true;
        return;
      }
    } else if (session) {
      const { data } = await supabase.from('profiles').select('*').eq('id', session.user.id).maybeSingle();
      profile = data as Profile | null;
    }
    if (!profile) return; // pas connecté : on garde l'invitation

    const isMe = session?.user.id === profile.id;
    $('profile-cta').hidden = true;
    $('p-content').hidden = false;
    document.title = `${profile.display_name} | BARZ¡`;

    const [spin, listened, barz, follows, mine] = await Promise.all([
      shelfOf('spin_list', profile.id),
      shelfOf('listened', profile.id),
      barzFeed({ userId: profile.id, limit: 100 }),
      supabase.from('follows').select(`artist:artists(${ARTIST_LITE})`).eq('user_id', profile.id).order('created_at', { ascending: false }),
      myFollows().catch(() => [] as ArtistLite[]),
    ]);
    const artists = ((follows.data ?? []) as any[]).map((f) => f.artist).filter(Boolean) as ArtistLite[];
    const iFollow = new Set(mine.map((a) => a.id));

    $('p-avatar').innerHTML = profile.avatar_path
      ? `<img src="${escapeHtml(avatarUrl(profile.avatar_path))}" alt="" />`
      : escapeHtml(profile.display_name.slice(0, 1).toUpperCase());
    if (isMe && new URLSearchParams(location.search).get('modifie') === '1') {
      $('profile-error').textContent = 'Profil mis à jour.';
      $('profile-error').className = 'bz-notice bz-notice--ok';
      $('profile-error').hidden = false;
    }
    $('p-name').textContent = profile.display_name;
    $('p-handle').textContent = `@${profile.username}`;
    $('p-bio').textContent = profile.bio?.trim() ?? '';
    $('p-bio').hidden = !profile.bio?.trim();
    $('p-own').hidden = !isMe;
    // Le bilan du mois qui vient de finir, mis en avant les 4 premiers jours du mois ; ensuite dans l'onglet Bilans
    const today = new Date();
    const bilanHref = (d: Date) => `${BASE}bilan?m=${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}&u=${encodeURIComponent(profile.username)}`;
    const monthOf = (d: Date) => `${/^[aeiou]/.test(MONTHS[d.getMonth()]) ? 'd’' : 'de '}${MONTHS[d.getMonth()]}`;
    if (today.getDate() <= 4) {
      const last = new Date(today.getFullYear(), today.getMonth() - 1, 1);
      const bilan = $('p-bilan') as HTMLAnchorElement;
      bilan.href = bilanHref(last);
      bilan.textContent = `${isMe ? 'Ton bilan' : 'Son bilan'} ${monthOf(last)} →`;
      bilan.hidden = false;
    }
    // Chaque compteur ouvre la liste correspondante plus bas
    $('p-stats').innerHTML = [
      ['Écoutés', listened.length, 'listened'],
      ['Spin list', spin.length, 'spin_list'],
      ['Barz', barz.length, 'barz'],
      ['Artistes', artists.length, 'artists'],
    ].map(([label, value, tab]) => `<div role="button" tabindex="0" data-stat-tab="${tab}" aria-label="Voir : ${label} (${value})"><dt>${label}</dt><dd>${value}</dd></div>`).join('');

    $('dna-title').textContent = isMe ? 'Ton ADN musical' : `L’ADN musical de ${profile.display_name}`;
    const all = [...listened.map((l) => l.release), ...spin.map((s) => s.release), ...barz.map((b) => b.release).filter((r): r is ReleaseLite => !!r)];
    const dna = all.length ? dnaOf(all) : [];
    $('p-dna').innerHTML = dna.length
      ? dna.map((d) => `<li><span>${escapeHtml(d.genre)}</span><span class="bar"><span style="width:${d.pct}%"></span></span><span class="pct">${d.pct} %</span></li>`).join('')
      : '';
    $('p-dna-note').textContent = all.length
      ? `Calculé sur ${all.length} sortie${all.length > 1 ? 's' : ''} écoutée${all.length > 1 ? 's' : ''}, notée${all.length > 1 ? 's' : ''} ou mise${all.length > 1 ? 's' : ''} de côté.`
      : isMe ? 'Marque des sorties comme écoutées ou écris des Barz : ton ADN apparaîtra ici.' : 'Pas encore assez d’activité.';

    const events = [
      ...barz.filter((b) => b.release).map((b) => ({ at: b.created_at, html: `<b>A noté</b> <a href="${BASE}releases/${encodeURIComponent(b.release!.slug)}">${escapeHtml(b.release!.title)}</a> · ${Number(b.score).toFixed(1)}` })),
      ...listened.map((l) => ({ at: l.created_at, html: `<b>A écouté</b> <a href="${BASE}releases/${encodeURIComponent(l.release.slug)}">${escapeHtml(l.release.title)}</a>` })),
      ...spin.map((s) => ({ at: s.created_at, html: `<b>A ajouté</b> <a href="${BASE}releases/${encodeURIComponent(s.release.slug)}">${escapeHtml(s.release.title)}</a> à sa spin list` })),
    ].sort((a, b) => b.at.localeCompare(a.at)).slice(0, 6);
    $('p-activity').innerHTML = events.length ? events.map((e) => `<li>${e.html}</li>`).join('') : '<li>Rien pour l’instant.</li>';

    const scoreOf = new Map(barz.filter((b) => b.release).map((b) => [b.release!.id, Number(b.score).toFixed(1)]));
    renderTab = (tab: string) => {
      const collection = $('p-collection');
      collection.classList.toggle('is-barz', tab === 'barz');
      // Sur mobile, sorties et artistes défilent sur le côté ; les Barz et les bilans restent en colonne
      collection.classList.toggle('bz-rail', ['spin_list', 'listened', 'artists'].includes(tab));
      collection.classList.toggle('bz-rail--compact', tab === 'artists');
      if (tab === 'artists') {
        collection.classList.add('is-artists');
        collection.innerHTML = artists.length
          ? artists.map((a) => artistCardHtml(a, iFollow.has(a.id))).join('')
          : `<p class="bz-empty">Aucun artiste suivi. <a href="${BASE}artistes" style="color:var(--color-accent)">Parcourir le catalogue →</a></p>`;
        return;
      }
      collection.classList.remove('is-artists');
      if (tab === 'bilans') {
        const months: Date[] = [];
        const first = new Date(profile.created_at);
        for (let d = new Date(today.getFullYear(), today.getMonth(), 1); d >= new Date(first.getFullYear(), first.getMonth(), 1); d = new Date(d.getFullYear(), d.getMonth() - 1, 1)) months.push(d);
        collection.innerHTML = `<div class="bilans">${months
          .map((d, i) => `<a class="bilan-month" href="${bilanHref(d)}"><b>${MONTHS[d.getMonth()]} ${d.getFullYear()}</b><span>${i === 0 ? 'En cours' : 'Voir le bilan →'}</span></a>`)
          .join('')}</div>`;
        return;
      }
      if (tab === 'barz') {
        collection.innerHTML = barz.length ? barz.map((b) => barzCardHtml(b, session?.user.id ?? null)).join('') : '<p class="bz-empty">Aucun Barz pour l’instant.</p>';
        return;
      }
      const items = (tab === 'spin_list' ? spin : listened).map((x) => x.release);
      const empty = tab === 'spin_list' ? 'Spin list vide : ajoute des sorties depuis leur fiche (« + Spin list »).' : 'Aucune sortie marquée comme écoutée.';
      collection.innerHTML = items.length ? items.map((r) => tileHtml(r, scoreOf.get(r.id))).join('') : `<p class="bz-empty">${empty}</p>`;
    };

    const active = $('p-tabs').querySelector<HTMLElement>('[aria-selected="true"]')?.dataset.tab ?? 'spin_list';
    renderTab(active);

    const theirTaste = loadTasteOf(profile.id);
    renderFriendship(profile, isMe, !!session).catch((err) => console.warn('Amis indisponibles :', err));
    renderPicks(profile, isMe, barz, theirTaste, iFollow).catch((err) => console.warn('Coups de cœur indisponibles :', err));
    watchNowPlaying(profile, isMe, !!session);

    if (!wired) {
      wired = true;
      $('p-tabs').addEventListener('click', (event) => {
        const tab = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-tab]');
        if (!tab) return;
        $('p-tabs').querySelectorAll('[data-tab]').forEach((t) => {
          t.classList.toggle('is-active', t === tab);
          t.setAttribute('aria-selected', String(t === tab));
        });
        renderTab(tab.dataset.tab!);
      });
      const openStat = (event: Event) => {
        const stat = (event.target as HTMLElement).closest<HTMLElement>('[data-stat-tab]');
        if (!stat) return;
        $('p-tabs').querySelector<HTMLButtonElement>(`[data-tab="${stat.dataset.statTab}"]`)?.click();
        $('p-tabs').scrollIntoView({ behavior: 'smooth', block: 'start' });
      };
      $('p-stats').addEventListener('click', openStat);
      $('p-stats').addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          openStat(event);
        }
      });
      wireBarzActions($('p-collection'), load);
      wireFollowButtons($('p-collection'));
      wireFollowButtons($('p-picks-artists'));
      wireFollowButtons($('p-blend-artists'));
      wireFriendActions();
    }
  }

  // Carte « En écoute » : relue toutes les 15 secondes (et dès qu'on revient sur l'onglet),
  // la barre de progression avance chaque seconde entre deux lectures
  const NP_POLL_MS = 15_000;
  let npPoll: number | undefined;
  let npClock: number | undefined;
  let npRefresh: (() => void) | null = null;
  document.addEventListener('visibilitychange', () => {
    if (!document.hidden) npRefresh?.();
  });

  function watchNowPlaying(profile: Profile, isMe: boolean, loggedIn: boolean) {
    clearInterval(npPoll);
    clearInterval(npClock);
    npRefresh = null;
    const box = $('p-np');
    box.hidden = true;
    if (!loggedIn || !spotifyAvailable()) return;

    let current: { key: string; playing: boolean; progressMs: number; durationMs: number; at: number } | null = null;
    let endTimer: number | undefined;

    const tick = async () => {
      if (document.hidden) return;
      const np = (await nowPlaying([profile.id]).catch(() => ({}) as Record<string, null>))[profile.id];
      if (!np?.title) {
        current = null;
        return void (box.hidden = true);
      }
      const key = `${np.title}|${np.artists}|${np.playing}`;
      // On ne redessine la carte (et sa pochette) que si le morceau ou l'état change
      if (key !== current?.key) {
        const label = np.playing ? (isMe ? 'Tu écoutes' : 'En écoute') : 'En pause';
        box.innerHTML = nowPlayingHtml(np, label);
        box.hidden = false;
      }
      current = { key, playing: np.playing, progressMs: np.progressMs ?? 0, durationMs: np.durationMs ?? 0, at: Date.now() };
      // À la fin du morceau, on relit tout de suite pour afficher le suivant
      clearTimeout(endTimer);
      if (np.playing && current.durationMs) endTimer = window.setTimeout(tick, Math.max(1_000, current.durationMs - current.progressMs + 1_500));
    };

    npRefresh = tick;
    tick();
    npPoll = window.setInterval(tick, NP_POLL_MS);
    npClock = window.setInterval(() => {
      if (!current?.playing || !current.durationMs) return;
      const progress = Math.min(1, (current.progressMs + Date.now() - current.at) / current.durationMs);
      const bar = box.querySelector<HTMLElement>('.np-bar span');
      if (bar) bar.style.width = `${progress * 100}%`;
    }, 1_000);
  }

  // Liste d'amis : ce qu'ils écoutent, pour ceux qui partagent
  async function markListeningFriends(ids: string[]) {
    if (!ids.length || !spotifyAvailable()) return;
    const listening = await nowPlaying(ids).catch(() => ({}) as Record<string, null>);
    for (const [id, np] of Object.entries(listening)) {
      if (!np?.playing || !np.title) continue;
      const row = document.querySelector<HTMLElement>(`#friend-list li[data-friend-id="${CSS.escape(id)}"]`);
      row?.insertAdjacentHTML('beforeend', `<span class="friend-np">♪ ${escapeHtml(np.title)} — ${escapeHtml(np.artists ?? '')}</span>`);
    }
  }

  // ============================================================
  // AMIS
  // ============================================================
  let current: { id: string; isMe: boolean } | null = null;

  const FRIEND_BUTTONS: Record<FriendStatus, string> = {
    none: `<button type="button" class="bz-btn bz-btn--lime" data-friend="add">Ajouter en ami</button>`,
    sent: `<span class="friend-state">Demande envoyée</span><button type="button" class="bz-btn bz-btn--outline" data-friend="remove">Annuler</button>`,
    received: `<button type="button" class="bz-btn bz-btn--lime" data-friend="accept">Accepter la demande</button><button type="button" class="bz-btn bz-btn--outline" data-friend="remove">Refuser</button>`,
    friends: `<span class="friend-state">Amis ✓</span><button type="button" class="bz-btn bz-btn--outline" data-friend="remove" data-confirm="1">Retirer</button>`,
  };

  // Nom, @pseudo et, en dessous, la bio : deux membres au même nom se distinguent
  function memberLinkHtml(m: Pick<Profile, 'username' | 'display_name' | 'bio'>) {
    const bio = m.bio?.trim();
    return `<a href="${BASE}profil?u=${encodeURIComponent(m.username)}"><b>${escapeHtml(m.display_name)}</b> <span>@${escapeHtml(m.username)}</span>${bio ? `<small class="member-bio">${escapeHtml(bio)}</small>` : ''}</a>`;
  }

  function friendRowHtml(f: Awaited<ReturnType<typeof myFriendships>>[number]) {
    const actions =
      f.status === 'received'
        ? `<button type="button" class="bz-btn bz-btn--lime bz-btn--small" data-friend="accept" data-user="${escapeHtml(f.profile.id)}">Accepter</button>
           <button type="button" class="bz-btn bz-btn--outline bz-btn--small" data-friend="remove" data-user="${escapeHtml(f.profile.id)}">Refuser</button>`
        : f.status === 'sent'
          ? `<span class="friend-state">Demande envoyée</span>
             <button type="button" class="bz-btn bz-btn--outline bz-btn--small" data-friend="remove" data-user="${escapeHtml(f.profile.id)}">Annuler</button>`
          : '';
    const face = f.profile.avatar_path
      ? `<img src="${escapeHtml(avatarUrl(f.profile.avatar_path))}" alt="" />`
      : escapeHtml(f.profile.display_name.slice(0, 1).toUpperCase());
    return `<li data-friend-id="${escapeHtml(f.profile.id)}">
      <span class="friend-face" aria-hidden="true">${face}</span>
      ${memberLinkHtml(f.profile)}
      ${actions}
    </li>`;
  }

  async function renderFriendship(profile: Profile, isMe: boolean, loggedIn: boolean) {
    current = { id: profile.id, isMe };
    $('p-friends').hidden = true;
    if (isMe) {
      const all = await myFriendships();
      const order: FriendStatus[] = ['received', 'friends', 'sent'];
      const sorted = [...all].sort((a, b) => order.indexOf(a.status) - order.indexOf(b.status));
      const pending = all.filter((f) => f.status === 'received').length;
      $('friends-title').textContent = pending ? `Amis · ${pending} demande${pending > 1 ? 's' : ''}` : 'Amis';
      $('friend-list').innerHTML = sorted.length
        ? sorted.map(friendRowHtml).join('')
        : '<li class="friend-empty">Pas encore d’amis : cherche un membre par son pseudo.</li>';
      $('p-friends').hidden = false; // seulement si la table friendships existe
      markListeningFriends(all.filter((f) => f.status === 'friends').map((f) => f.profile.id));
      return;
    }
    const status = loggedIn ? await friendStatusWith(profile.id) : 'none';
    $('p-friend').innerHTML = FRIEND_BUTTONS[status];
    $('p-friend').hidden = false;
    await renderBlend(profile, status, loggedIn);
  }

  function wireFriendActions() {
    document.addEventListener('click', async (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-friend]');
      if (!button || !current) return;
      if (!(await getSession())) return void (location.href = loginUrl());
      const userId = button.dataset.user ?? current.id;
      if (button.dataset.confirm && !confirm('Retirer cette personne de tes amis ?')) return;
      button.disabled = true;
      try {
        if (button.dataset.friend === 'add') await sendFriendRequest(userId);
        if (button.dataset.friend === 'accept') await acceptFriendRequest(userId);
        if (button.dataset.friend === 'remove') await removeFriendship(userId);
        await load();
      } catch (err) {
        button.disabled = false;
        alert(errorText(err));
      }
    });

    $('friend-search').addEventListener('submit', async (event) => {
      event.preventDefault();
      const results = $('friend-results');
      const query = (document.getElementById('friend-input') as HTMLInputElement).value;
      try {
        const members = (await searchMembers(query)).filter((m) => m.id !== current?.id);
        results.innerHTML = members.length
          ? members.map((m) => `<li>${memberLinkHtml(m)}<span class="friend-state">Voir le profil →</span></li>`).join('')
          : '<li class="friend-empty">Aucun membre trouvé.</li>';
      } catch (err) {
        results.innerHTML = `<li class="friend-empty">${escapeHtml(errorText(err))}</li>`;
      }
    });
  }

  // ============================================================
  // COUPS DE CŒUR et POUR VOUS DEUX
  // ============================================================
  const PICKS_SHOWN = 6;

  async function artistsByIds(ids: string[]): Promise<ArtistLite[]> {
    if (!ids.length || !supabase) return [];
    // Par paquets de 100 : une longue liste d'identifiants ne tient pas dans une seule adresse
    const parts = await Promise.all(
      Array.from({ length: Math.ceil(ids.length / 100) }, (_, i) => supabase!.from('artists').select(ARTIST_LITE).in('id', ids.slice(i * 100, i * 100 + 100)))
    );
    const byId = new Map(parts.flatMap((p) => (p.data ?? []) as ArtistLite[]).map((a) => [a.id, a]));
    return ids.map((id) => byId.get(id)).filter((a): a is ArtistLite => !!a);
  }

  async function renderPicks(profile: Profile, isMe: boolean, barz: Awaited<ReturnType<typeof barzFeed>>, tastePromise: Promise<Taste | null>, iFollow: Set<string>) {
    $('picks-title').textContent = isMe ? 'Tes coups de cœur' : 'Ses coups de cœur';
    const best = barz.filter((b) => b.release && Number(b.score) >= 7).sort((a, b) => Number(b.score) - Number(a.score)).slice(0, 6);
    $('p-picks-releases').innerHTML = best.map((b) => releaseTileHtml(b.release!, { badge: Number(b.score).toFixed(1) })).join('');

    const taste = await tastePromise;
    // Tous ses artistes préférés, du plus aimé au moins aimé : les 6 premiers, puis « Voir les N artistes »
    const topIds = taste ? [...taste.artistWeights.entries()].filter(([, w]) => w > 0).sort((a, b) => b[1] - a[1]).slice(0, 300).map(([id]) => id) : [];
    const artists = await artistsByIds(topIds);
    const grid = $('p-picks-artists');
    grid.innerHTML = artists.map((a) => artistCardHtml(a, iFollow.has(a.id))).join('');
    grid.classList.toggle('is-collapsed', artists.length > PICKS_SHOWN);
    const more = $('p-picks-more') as HTMLButtonElement;
    more.hidden = artists.length <= PICKS_SHOWN;
    more.textContent = `Voir les ${artists.length} artistes`;
    more.onclick = () => {
      const collapsed = grid.classList.toggle('is-collapsed');
      more.textContent = collapsed ? `Voir les ${artists.length} artistes` : 'Voir moins';
      if (collapsed) $('p-picks-artists-title').scrollIntoView({ behavior: 'smooth', block: 'center' });
    };
    $('p-picks-artists-title').hidden = !artists.length;
    $('p-picks').hidden = !best.length && !artists.length;
  }

  async function renderBlend(profile: Profile, status: FriendStatus, loggedIn: boolean) {
    const section = $('p-blend');
    if (!loggedIn || !supabase) return void (section.hidden = true);
    section.hidden = false;
    const note = $('p-blend-note');
    if (status !== 'friends') {
      note.textContent = `Devenez amis pour voir les sorties qui vous plairaient à tous les deux et vos artistes en commun.`;
      $('p-blend-releases').innerHTML = '';
      $('p-blend-artists').innerHTML = '';
      $('p-blend-artists-title').hidden = true;
      return;
    }
    note.textContent = 'Les sorties récentes qui collent à vos deux profils de goûts.';
    const [mine, theirs, releases, myArtists] = await Promise.all([loadTaste(), loadTasteOf(profile.id), recentReleases(), myFollows().catch(() => [] as ArtistLite[])]);
    if (!mine || !theirs || mine.empty || theirs.empty) {
      note.textContent = 'Pas encore assez d’activité de l’un de vous deux : suivez des artistes ou notez des sorties.';
      return;
    }
    const picks = rankForTwo(releases, mine, theirs).slice(0, 8);
    $('p-blend-releases').innerHTML = picks.length
      ? picks.map((s) => releaseTileHtml(s.item, { reason: s.reason })).join('')
      : '<p class="bz-empty">Aucune sortie récente ne vous rapproche pour l’instant.</p>';
    const shared = await artistsByIds(sharedArtists(mine, theirs).slice(0, 8).map((a) => a.id));
    const iFollow = new Set(myArtists.map((a) => a.id));
    $('p-blend-artists').innerHTML = shared.map((a) => artistCardHtml(a, iFollow.has(a.id))).join('');
    $('p-blend-artists-title').hidden = !shared.length;
  }

  load().catch((err) => {
    $('profile-error').textContent = errorText(err);
    $('profile-error').hidden = false;
  });
</script>

