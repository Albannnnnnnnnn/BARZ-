---
// PAGE PROFIL : en-tête, ADN musical, spin list, activité récente (contenu de démonstration)
import Layout from '../layouts/Layout.astro';
import AlbumTile from '../components/AlbumTile.astro';
import { DEMO_ALBUMS, DEMO_USER } from '../data/demo';

const user = DEMO_USER;
---

<Layout title={`Profil de ${user.name}`} description={`L’ADN musical de ${user.name} : ${user.bio}.`}>
  <div class="bz-page">
    <section class="hero">
      <span class="avatar">{user.name[0]}</span>
      <div class="identity">
        <h1>{user.name}</h1>
        <p>{user.handle} · {user.bio}</p>
      </div>
      <dl class="stats">
        {user.stats.map((s) => (
          <div>
            <dt>{s.label}</dt>
            <dd>{s.value}</dd>
          </div>
        ))}
      </dl>
    </section>

    <div class="layout">
      <div class="left">
        <section class="dna" aria-labelledby="dna-title">
          <h2 id="dna-title">Ton ADN musical · Mars</h2>
          <ul>
            {user.dna.map((d) => (
              <li>
                <span>{d.genre}</span>
                <span class="bar"><span style={`width:${d.pct}%`} /></span>
                <span class="pct">{d.pct} %</span>
              </li>
            ))}
          </ul>
          <p>{user.dnaNote}</p>
        </section>

        <section class="activity" aria-labelledby="activity-title">
          <div class="bz-section-head"><h2 id="activity-title" class="bz-h2">Activité récente</h2></div>
          <ul>
            {user.activity.map(([verb, rest]) => (
              <li><b>{verb}</b> {rest}</li>
            ))}
          </ul>
        </section>
      </div>

      <section class="collection" aria-label="Collections">
        <div class="bz-chips" role="tablist">
          <span class="bz-chip is-active" role="tab" aria-selected="true">Spin list</span>
          <span class="bz-chip" role="tab" aria-selected="false">Écoutés</span>
          <span class="bz-chip" role="tab" aria-selected="false">Barz</span>
        </div>
        <div class="spin">
          {user.spinList.map((item) => {
            const album = DEMO_ALBUMS[item.album as keyof typeof DEMO_ALBUMS];
            return <AlbumTile title={album.title} subtitle={`${album.artist} · ${item.type}`} palette={album.palette} badge={item.score} checked />;
          })}
        </div>
      </section>
    </div>
  </div>
</Layout>

<style>
  .hero {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 44px;
    padding: 56px;
    border-radius: 28px;
    background:
      radial-gradient(ellipse 60% 120% at 90% 10%, #5d6b2a 0%, transparent 70%),
      linear-gradient(100deg, #4a2a1e 0%, #2e2a1d 50%, #3c4721 100%);
  }

  .avatar {
    width: 196px;
    height: 196px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--color-lime);
    color: var(--color-ink);
    font: 400 110px/1 var(--font-serif);
  }

  .identity h1 {
    font: 400 clamp(64px, 6vw, 96px) / 1 var(--font-serif);
    color: var(--color-text);
  }

  .identity p {
    max-width: 380px;
    margin-top: 14px;
    font-size: 18px;
    line-height: 1.5;
    color: #d9d3c6;
  }

  .stats {
    display: flex;
    gap: 44px;
  }

  .stats div {
    display: flex;
    flex-direction: column-reverse;
    align-items: center;
    gap: 6px;
  }

  .stats dd {
    font: 900 48px/1 var(--font-sans);
    font-stretch: 115%;
    color: var(--color-text);
  }

  .stats dt {
    font: 600 12px/1 var(--font-sans);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #cfc8b8;
  }

  .layout {
    display: grid;
    grid-template-columns: minmax(320px, 490px) minmax(0, 1fr);
    gap: 64px;
    margin-top: 64px;
  }

  .dna {
    padding: 36px 32px;
    border-radius: 22px;
    background: var(--color-cream);
    color: var(--color-ink);
  }

  .dna h2 {
    font: 700 14px/1 var(--font-sans);
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--color-ink);
  }

  .dna ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 18px;
    margin: 28px 0;
  }

  .dna li {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr) 48px;
    align-items: center;
    gap: 12px;
    font-weight: 700;
    font-size: 17px;
  }

  .bar {
    height: 12px;
    border-radius: 999px;
    background: #dcd7cc;
    overflow: hidden;
  }

  .bar span {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: var(--color-ink);
  }

  .pct {
    text-align: right;
    font-weight: 500;
  }

  .dna p {
    font-size: 17px;
    color: #2d2a25;
  }

  .activity {
    margin-top: 48px;
  }

  .activity ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 16px;
    font-size: 18px;
    color: #cfcbc2;
  }

  .activity b {
    color: var(--color-text);
  }

  .spin {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 190px));
    gap: 24px;
    margin-top: 32px;
  }

  @media (max-width: 1280px) {
    .hero {
      grid-template-columns: auto minmax(0, 1fr);
    }
    .stats {
      grid-column: 1 / -1;
      justify-content: space-around;
    }
    .layout {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 900px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
      justify-items: center;
      text-align: center;
      gap: 24px;
      padding: 32px 20px;
    }
    .avatar {
      width: 110px;
      height: 110px;
      font-size: 64px;
    }
    .identity p {
      margin-inline: auto;
    }
    .stats {
      gap: 18px;
      justify-content: space-between;
      width: 100%;
    }
    .stats dd {
      font-size: 30px;
    }
    .layout {
      margin-top: 40px;
    }
    .spin {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
