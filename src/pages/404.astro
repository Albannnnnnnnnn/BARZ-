---
// PAGE INTROUVABLE (servie par GitHub Pages pour toute adresse inconnue). Une sortie que la veille vient
// d'enregistrer n'a pas encore de fiche construite : pour /releases/<slug>, on affiche une fiche provisoire
// lue en direct, en attendant la prochaine reconstruction du site.
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page introuvable" description="Cette page n’existe pas ou plus sur BARZ¡.">
  <div class="bz-page">
    <section class="fresh-release" id="fresh-release" hidden>
      <div class="art" id="fr-art"></div>
      <div class="info">
        <span class="bz-eyebrow" id="fr-eyebrow"></span>
        <h1 class="bz-display" id="fr-title"></h1>
        <a class="artist" id="fr-artist"></a>
        <div id="fr-listen"></div>
        <p class="note">Sortie tout juste ajoutée : sa fiche complète (extraits, Barz, sorties proches) arrive dans quelques minutes.</p>
      </div>
    </section>

    <section class="missing" id="missing">
      <span class="bz-eyebrow">Erreur 404</span>
      <h1 class="bz-display">Page <em>introuvable.</em></h1>
      <p>Cette page n’existe pas ou plus.</p>
      <a class="bz-btn bz-btn--lime" href="/BARZ-/">Voir les sorties de la semaine</a>
    </section>
  </div>
</Layout>

<script>
  import { BASE, coverHtml, supabase } from '../scripts/social';
  import { listenMenuHtml } from '../lib/listen';

  const TYPES: Record<string, string> = { album: 'Album', ep: 'EP', single: 'Single', compilation: 'Compilation', live: 'Live', remix: 'Remix', soundtrack: 'Bande originale' };
  const slug = location.pathname.match(/\/releases\/([^/]+)\/?$/)?.[1];

  async function showRelease() {
    if (!slug || !supabase) return;
    const { data } = await supabase
      .from('releases')
      .select('title, release_type, release_date, cover_url, deezer_url, spotify_url, apple_music_url, artist:artists!artist_id(name, slug)')
      .eq('slug', decodeURIComponent(slug))
      .maybeSingle();
    const r = data as any;
    if (!r) return;
    const $ = (id: string) => document.getElementById(id)!;
    document.title = `${r.title} — ${r.artist?.name ?? ''} | BARZ¡`;
    $('fr-art').innerHTML = coverHtml(r.title, r.cover_url);
    const date = new Date(`${r.release_date}T12:00:00`).toLocaleDateString('fr-FR', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
    $('fr-eyebrow').textContent = `${TYPES[r.release_type] ?? r.release_type} · ${date}`;
    $('fr-title').textContent = r.title;
    const artist = $('fr-artist') as HTMLAnchorElement;
    artist.textContent = r.artist?.name ?? '';
    artist.href = r.artist?.slug ? `${BASE}artiste?a=${encodeURIComponent(r.artist.slug)}` : `${BASE}`;
    $('fr-listen').innerHTML = listenMenuHtml({ artist: r.artist?.name ?? '', title: r.title, deezerUrl: r.deezer_url, spotifyUrl: r.spotify_url, appleUrl: r.apple_music_url });
    $('missing').hidden = true;
    $('fresh-release').hidden = false;
  }

  showRelease().catch(() => {});
</script>

<style>
  .missing p {
    margin: 12px 0 24px;
    color: var(--color-text-muted);
  }

  .fresh-release {
    display: grid;
    grid-template-columns: minmax(0, 360px) minmax(0, 1fr);
    gap: 40px;
    align-items: center;
  }

  .art {
    padding: 24px;
    border: var(--line);
    border-radius: 14px;
    background: var(--color-accent);
    box-shadow: var(--shadow-hard);
  }

  .artist {
    display: inline-block;
    margin: 12px 0 20px;
    font: 700 18px/1.2 var(--font-sans);
    color: var(--color-text);
  }

  .note {
    margin-top: 20px;
    font-size: 14px;
    color: var(--color-text-muted);
  }

  @media (max-width: 900px) {
    .fresh-release {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
    }
    .art {
      max-width: 300px;
      padding: 16px;
    }
  }
</style>
