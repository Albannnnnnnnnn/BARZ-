---
// VUE CALENDRIER MENSUAL
import Layout from '../layouts/Layout.astro';
import { getSupabaseServerSafe } from '../lib/supabase';
import CalendarView from '../components/CalendarView.tsx';
import { format, addMonths, subMonths, parseISO } from 'date-fns';
import { fr } from 'date-fns/locale';

const supabase = getSupabaseServerSafe();

const monthParam = Astro.url.searchParams.get('month');
const currentMonth = monthParam ? parseISO(monthParam + '-01') : new Date();
const monthStart = format(currentMonth, 'yyyy-MM');
const nextMonth = format(addMonths(currentMonth, 1), 'yyyy-MM');
const prevMonth = format(subMonths(currentMonth, 1), 'yyyy-MM');

let weeklyData: any[] = [];
if (supabase) {
  try {
    const { data, error } = await supabase
      .from('weekly_releases')
      .select('*')
      .gte('week_start', format(subMonths(currentMonth, 1), 'yyyy-MM-dd'))
      .lte('week_start', format(addMonths(currentMonth, 2), 'yyyy-MM-dd'))
      .order('week_start', { ascending: true });

    if (!error && data) {
      weeklyData = data;
    }
  } catch (e) {
    console.warn('Supabase query failed:', e);
  }
} else {
  console.warn('Supabase not configured, using empty data for build');
}

const allGenres = [...new Set(
  (weeklyData || []).flatMap(w => w.releases || []).flatMap((r: any) => r.genres || [])
)].sort();
---

<Layout title="Calendrier mensuel - BARZ" description="Vue calendrier mensuel des sorties musicales. Navigue mois par mois, vois toutes les sorties par semaine.">
  <div class="container section">
    <header class="mb-10 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
      <div>
        <h1 class="text-6xl font-bold mb-2" style="letter-spacing: -0.03em;">
          Calendrier<span class="gradient-text"> mensuel</span>
        </h1>
        <p class="text-lg" style="color: var(--color-text-muted);">
          Vue d'ensemble du mois. Clique sur une semaine pour voir le détail.
        </p>
      </div>

      <div class="flex items-center gap-3">
        <a href={`/BARZ-/calendar?month=${prevMonth}`} class="btn btn-secondary btn-sm">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" aria-hidden="true">
            <path d="M15 18l-6-6 6-6" />
          </svg>
        </a>
        <span class="font-semibold text-lg whitespace-nowrap" style="color: var(--color-text);">
          {format(currentMonth, 'MMMM yyyy', { locale: fr })}
        </span>
        <a href={`/BARZ-/calendar?month=${nextMonth}`} class="btn btn-secondary btn-sm">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" aria-hidden="true">
            <path d="M9 18l6-6-6-6" />
          </svg>
        </a>
      </div>
    </header>

    <div class="space-y-10">
      {(weeklyData || []).slice(0, 4).map((week: any, index: number) => (
        <section class="card p-6" aria-labelledby={`week-${week.week_start}`}>
          <div class="flex items-center justify-between mb-4">
            <h2 id={`week-${week.week_start}`} class="text-xl font-semibold" style={{ color: 'var(--color-text)' }}>
              Semaine du {format(week.week_start, 'd MMMM', { locale: fr })}
            </h2>
            <a href={`/BARZ-/?week=${week.week_start}`} class="btn btn-ghost btn-sm">
              Voir le détail
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" aria-hidden="true">
                <path d="M5 12h14M12 5l7 7-7 7" />
              </svg>
            </a>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
            {week.releases.slice(0, 4).map((release: any) => (
              <a href={`/BARZ-/releases/${release.slug}`} class="card card-interactive flex items-center gap-3 p-3 transition">
                <div class="relative w-16 h-16 flex-shrink-0 overflow-hidden" style={{ borderRadius: 'var(--radius-md)' }}>
                  <img src={release.cover_url || '/BARZ-/placeholder-release.svg'} alt="" loading="lazy" class="w-full h-full object-cover" />
                </div>
                <div class="min-w-0">
                  <p class="font-medium truncate" style={{ color: 'var(--color-text)' }}>{release.title}</p>
                  <p class="text-sm text-muted truncate">{release.artist?.name}</p>
                  <div class="flex items-center gap-1.5 mt-1">
                    <span class="badge badge-type text-[0.65rem]" style={{
                      background: 'var(--color-bg-hover)',
                      color: 'var(--color-text-muted)',
                      borderColor: 'var(--color-border)',
                    }}>
                      {release.release_type}
                    </span>
                  </div>
                </div>
              </a>
            ))}
            {week.releases.length > 4 && (
              <a href={`/BARZ-/?week=${week.week_start}`} class="card card-interactive flex items-center justify-center p-6 text-center" style={{ background: 'var(--color-bg-hover)' }}>
                <p class="text-muted">+{week.releases.length - 4} autres sorties</p>
                <p class="text-xs text-dim mt-1">Voir la semaine complète</p>
              </a>
            )}
          </div>
        </section>
      ))}
    </div>

    <div class="text-center mt-12">
      <a href="/BARZ-/" class="btn btn-primary btn-lg">
        Vue semaine interactive
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" aria-hidden="true">
          <path d="M5 12h14M12 5l7 7-7 7" />
        </svg>
      </a>
    </div>
  </div>
</Layout>