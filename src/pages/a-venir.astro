---
// CALENDRIER DES SORTIES À VENIR (4 mois) : vue par mois + liste par date.
// Sources : pré-sorties Deezer / Spotify et annonces MusicBrainz (voir scripts/sync-releases.ts).
// En haut, lues en direct : les annonces sans fiche (précommandes Apple, dates approximatives, annonces validées par
// Alban), table announcements (src/scripts/announcements.ts).
import { addDays, addMonths, eachDayOfInterval, endOfMonth, endOfWeek, format, isSameMonth, parseISO, startOfMonth, startOfWeek } from 'date-fns';
import { fr } from 'date-fns/locale';
import Layout from '../layouts/Layout.astro';
import AlbumTile from '../components/AlbumTile.astro';
import Cover from '../components/Cover.astro';
import SortiesTabs from '../components/SortiesTabs.astro';
import { getSupabaseServerSafe } from '../lib/supabase';
import { fetchReleasesBetween, getToday, type ReleaseRow } from '../lib/releases';
import { releaseSubtitle } from '../lib/utils';

const today = getToday();
const releases = [...(await fetchReleasesBetween(getSupabaseServerSafe(), addDays(today, 1), addDays(today, 120)))].reverse();

const byDate = new Map<string, ReleaseRow[]>();
for (const r of releases) {
  if (!byDate.has(r.release_date)) byDate.set(r.release_date, []);
  byDate.get(r.release_date)!.push(r);
}

// Au moins 3 mois affichés, plus si des sorties sont annoncées au-delà
const lastDate = releases.at(-1) ? parseISO(releases.at(-1)!.release_date) : today;
const months: Date[] = [];
for (let m = startOfMonth(today); m <= lastDate || months.length < 3; m = addMonths(m, 1)) months.push(m);

const todayIso = format(today, 'yyyy-MM-dd');
const announcedOnly = (r: ReleaseRow) => !r.deezer_url && !r.spotify_url;
const WEEKDAYS = ['Lun', 'Mar', 'Mer', 'Jeu', 'Ven', 'Sam', 'Dim'];
// « Date par date » : les prochaines dates d'abord, les suivantes derrière un bouton (ou un clic dans le calendrier)
const DATES_SHOWN = 4;
---

<Layout title="À venir" description="Le calendrier des sorties musicales annoncées pour les prochains mois.">
  <div class="bz-page">
    <span class="bz-eyebrow">Les 4 prochains mois</span>
    <h1 class="bz-display">Sorties</h1>
    <SortiesTabs active="a-venir" upcomingCount={releases.length} />
        <p class="lead">
          {releases.length > 0
            ? `${releases.length} sortie${releases.length > 1 ? 's' : ''} annoncée${releases.length > 1 ? 's' : ''} pour les 4 prochains mois.`
            : 'Aucune sortie annoncée pour l’instant.'}
          <span class="lead-note">Les annonces arrivent au fil des pré-sorties : le calendrier se remplit deux fois par jour. Les albums annoncés sans date : <a href="/BARZ-/annonces">les annonces</a>.</span>
        </p>

    <section class="announced" id="announced" hidden aria-labelledby="announced-title">
      <div class="bz-section-head"><h2 id="announced-title" class="bz-h2">Annoncés <em>par les artistes</em></h2><a class="bz-link" href="/BARZ-/annonces">Tout voir</a></div>
      <p class="announced-note">Albums et EP annoncés, pas encore en pré-sortie. Le compte à rebours démarre dès que la date exacte est connue.</p>
      <div class="bz-tiles bz-rail" id="announced-list"></div>
    </section>

    <!-- Sur mobile, un mois à la fois : on fait défiler les mois sur le côté -->
    <div class="months bz-rail">
      {months.map((month) => {
        const days = eachDayOfInterval({ start: startOfWeek(startOfMonth(month), { weekStartsOn: 1 }), end: endOfWeek(endOfMonth(month), { weekStartsOn: 1 }) });
        return (
          <section class="month" aria-label={format(month, 'MMMM yyyy', { locale: fr })}>
            <h2 class="month-title">{format(month, 'MMMM', { locale: fr })} <em>{format(month, 'yyyy')}</em></h2>
            <div class="grid" role="grid">
              {WEEKDAYS.map((d) => <span class="weekday" role="columnheader">{d}</span>)}
              {days.map((day) => {
                const iso = format(day, 'yyyy-MM-dd');
                const list = byDate.get(iso) ?? [];
                const outside = !isSameMonth(day, month);
                const Tag = list.length && !outside ? 'a' : 'div';
                return (
                  <Tag
                    class:list={['day', { outside, past: iso <= todayIso, friday: day.getDay() === 5, 'has-releases': list.length > 0 && !outside }]}
                    href={Tag === 'a' ? `#jour-${iso}` : undefined}
                    data-date={iso}
                    data-artists={list.map((r) => r.artist?.id).filter(Boolean).join(' ')}
                    role="gridcell"
                  >
                    <span class="day-num">{format(day, 'd')}</span>
                    {list.length > 0 && !outside && (
                      <span class="day-covers">
                        {list.slice(0, 3).map((r) => <Cover title={r.title} src={r.cover_url} showTitle={false} class="mini" sizes="40px" />)}
                        {list.length > 3 && <span class="more">+{list.length - 3}</span>}
                      </span>
                    )}
                  </Tag>
                );
              })}
            </div>
          </section>
        );
      })}
    </div>

    {releases.length > 0 && (
      <section class:list={['list', { 'is-capped': byDate.size > DATES_SHOWN }]} id="date-list" aria-labelledby="list-title">
        <div class="bz-section-head"><h2 id="list-title" class="bz-h2">Date <em>par date</em></h2></div>
        {[...byDate.entries()].map(([date, list]) => (
          <section class="date-block" id={`jour-${date}`}>
            <h3 class="date-title">{format(parseISO(date), 'EEEE d MMMM', { locale: fr })}</h3>
            <div class="bz-tiles bz-rail">
              {list.map((r) => (
                <div class="item" data-artist-id={r.artist?.id} data-artist-name={r.artist?.name}>
                  <AlbumTile
                    title={r.title}
                    subtitle={releaseSubtitle(r)}
                    cover={r.cover_url}
                    href={`/BARZ-/releases/${r.slug}`}
                    badge={announcedOnly(r) ? 'Annoncé' : undefined}
                  />
                </div>
              ))}
            </div>
          </section>
        ))}
        {byDate.size > DATES_SHOWN && (
          <button type="button" class="bz-btn bz-btn--outline more-dates" id="more-dates">Voir les {byDate.size} dates</button>
        )}
      </section>
    )}
  </div>
</Layout>

<script>
  import { escapeHtml, myFollows } from '../scripts/social';
  import { announcementCardHtml, publishedAnnouncements } from '../scripts/announcements';

  // Annonces sans fiche, lues en direct (elles arrivent entre deux reconstructions du site)
  publishedAnnouncements().then((list) => {
    if (!list.length) return;
    document.getElementById('announced-list')!.innerHTML = list.map((a) => announcementCardHtml(a)).join('');
    document.getElementById('announced')!.hidden = false;
  });

  // Toutes les dates : bouton, ou clic sur un jour du calendrier qui vise une date encore masquée
  const dateList = document.getElementById('date-list');
  const showAllDates = () => {
    dateList?.classList.remove('is-capped');
    document.getElementById('more-dates')?.remove();
  };
  document.getElementById('more-dates')?.addEventListener('click', showAllDates);
  document.querySelectorAll<HTMLAnchorElement>('a.day[href^="#jour-"]').forEach((day) => day.addEventListener('click', showAllDates));
  if (location.hash.startsWith('#jour-')) {
    showAllDates();
    document.querySelector(location.hash)?.scrollIntoView();
  }

  // Connecté : les sorties de ses artistes suivis sont mises en avant
  myFollows()
    .then((follows) => {
      const ids = new Set(follows.map((a) => a.id));
      if (!ids.size) return;
      document.querySelectorAll<HTMLElement>('.item[data-artist-id]').forEach((item) => {
        if (!ids.has(item.dataset.artistId!)) return;
        item.classList.add('is-followed');
        item.querySelector('.tile')?.insertAdjacentHTML('beforeend', `<span class="bz-reason">Tu suis ${escapeHtml(item.dataset.artistName ?? '')}</span>`);
      });
      document.querySelectorAll<HTMLElement>('.day[data-artists]').forEach((day) => {
        if (day.dataset.artists!.split(' ').some((id) => ids.has(id))) day.classList.add('has-followed');
      });
    })
    .catch(() => {});
</script>

<style>
  .announced {
    margin: 8px 0 40px;
  }

  .announced[hidden] {
    display: none;
  }

  .announced-note {
    margin: -6px 0 18px;
    color: var(--color-text-muted);
    font-size: 15px;
  }

  .lead {
    margin-top: 28px;
    font-size: 17px;
    color: var(--color-text-muted);
  }

  .lead-note {
    display: block;
    margin-top: 6px;
    font-size: 14px;
    color: var(--color-text-dim);
  }

  .lead-note a {
    color: var(--color-accent);
    text-decoration: underline;
  }

  .list.is-capped > :global(.date-block:nth-of-type(n + 5)) {
    display: none;
  }

  .more-dates {
    display: block;
    margin: 32px auto 0;
  }

  .months {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(380px, 1fr));
    gap: 40px;
    margin-top: 56px;
  }

  .month-title {
    margin-bottom: 18px;
    font: 800 33px/1 var(--font-display);
    text-transform: capitalize;
  }

  .month-title em {
    color: var(--color-text-dim);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 6px;
  }

  .weekday {
    padding-bottom: 6px;
    text-align: center;
    font: 600 11px/1 var(--font-sans);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-dim);
  }

  .day {
    position: relative;
    min-height: 74px;
    padding: 6px;
    border-radius: 10px;
    background: var(--color-bg-elevated);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .day.outside {
    background: transparent;
  }

  .day.outside .day-num {
    color: var(--color-border-hover);
  }

  .day.past {
    opacity: 0.35;
  }

  .day.friday:not(.outside) {
    box-shadow: inset 0 0 0 1px var(--color-accent-line);
  }

  .day-num {
    font-size: 13px;
    font-weight: 600;
    color: var(--color-text-muted);
  }

  .day.has-releases {
    background: var(--color-accent-soft);
    transition: transform var(--transition-fast);
  }

  .day.has-releases:hover {
    transform: translateY(-2px);
  }

  .day.has-releases .day-num {
    color: var(--color-accent);
  }

  .day.has-followed {
    box-shadow: inset 0 0 0 2px var(--color-accent);
  }

  .day-covers {
    display: flex;
    align-items: center;
  }

  .day-covers :global(.mini) {
    width: 30px;
    border-radius: 4px;
    box-shadow: 0 0 0 2px var(--color-accent-soft);
  }

  .day-covers :global(.mini + .mini) {
    margin-left: -10px;
  }

  .more {
    margin-left: 4px;
    font-size: 11px;
    font-weight: 700;
    color: var(--color-accent);
  }

  .list {
    margin-top: 80px;
  }

  .date-block {
    margin-bottom: 48px;
    scroll-margin-top: 110px;
  }

  .date-title {
    margin-bottom: 20px;
    font: 800 25px/1 var(--font-display);
    text-transform: capitalize;
    color: var(--color-text);
  }

  .item.is-followed :global(.tile-title) {
    color: var(--color-accent);
  }

  @media (max-width: 900px) {
    .months {
      grid-template-columns: minmax(0, 1fr);
      margin-top: 36px;
    }
    body .months.bz-rail.bz-rail {
      grid-auto-columns: calc(100% - 40px);
      gap: 20px;
    }
    .day {
      min-height: 52px;
      padding: 4px;
    }
    .day-covers :global(.mini) {
      width: 22px;
    }
    .day-covers :global(.mini:nth-child(n + 3)) {
      display: none;
    }
  }
</style>
