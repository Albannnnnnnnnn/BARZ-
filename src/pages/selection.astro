---
// SÉLECTION : seulement les sorties d'une notification (« 3 sorties de tes artistes »)
// Le lien porte leurs identifiants : selection?ids=uuid,uuid,… (écrit par supabase/functions/notify)
// t=uuid|titre|invité|numéro Deezer du titre;… : l'artiste suivi est invité sur un titre de ce disque ; la tuile le dit et ouvre la fiche sur ce titre
import Layout from '../layouts/Layout.astro';
---

<Layout title="Tes sorties" description="Les sorties de tes artistes annoncées dans ta notification.">
  <div class="bz-page">
    <span class="bz-eyebrow">Pour toi</span>
    <h1 class="bz-display" id="sel-title">Tes <em>artistes.</em></h1>
    <p class="sel-status" id="sel-status">Chargement…</p>
    <div class="bz-tiles" id="sel-tiles"></div>
    <a class="bz-btn bz-btn--outline sel-all" href="/BARZ-/">Voir toutes les sorties de la semaine</a>
  </div>
</Layout>

<script>
  import { errorText, getSession, myFollows, releaseTileHtml, supabase } from '../scripts/social';
  import { normName } from '../lib/feat';

  const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
  const ids = [...new Set((new URLSearchParams(location.search).get('ids') ?? '').split(',').filter((id) => UUID.test(id)))].slice(0, 100);
  // Invités sur un titre d'album : identifiant de la sortie → titre et nom de l'invité
  const onTrack = new Map<string, { track: string; name: string; trackId?: number }>();
  for (const part of (new URLSearchParams(location.search).get('t') ?? '').split(';')) {
    const [id, track, name, trackId] = part.split('|');
    if (UUID.test(id ?? '') && track) onTrack.set(id, { track: track.slice(0, 200), name: (name ?? '').slice(0, 100), trackId: Number(trackId) || undefined });
  }
  const status = document.getElementById('sel-status')!;
  const tiles = document.getElementById('sel-tiles')!;

  type Row = { id: string; title: string; slug: string; cover_url: string | null; release_type: string; metadata: { featuring?: string[] } | null; artist_id: string | null; artist: { name: string } | null };

  if (!ids.length || !supabase) {
    status.textContent = 'Cette sélection est vide.';
  } else {
    supabase
      .from('releases')
      .select('id, title, slug, cover_url, release_type, metadata, artist_id, artist:artists!artist_id(name)')
      .in('id', ids)
      .then(async ({ data, error }) => {
        if (error) {
          status.textContent = errorText(error);
          return;
        }
        // Dans l'ordre de la notification
        const rows = ((data ?? []) as unknown as Row[]).sort((a, b) => ids.indexOf(a.id) - ids.indexOf(b.id));
        if (!rows.length) {
          status.textContent = 'Ces sorties ne sont plus au catalogue.';
          return;
        }
        // Lien sans « t » (notifs plus anciennes) : les invités des titres et les artistes suivis, lus ici
        if (!onTrack.size && (await getSession())) {
          const follows = await myFollows().catch(() => []);
          const followedIds = new Set(follows.map((a) => a.id));
          const names = new Map(follows.map((a) => [normName(a.name), a.name]));
          const { data: feats } = await supabase!.from('release_track_feats' as never).select('release_id, feats').in('release_id', rows.map((r) => r.id));
          for (const f of (feats ?? []) as { release_id: string; feats: { name: string; track: string; trackId?: number }[] }[]) {
            const row = rows.find((r) => r.id === f.release_id);
            if (!row || (row.artist_id && followedIds.has(row.artist_id))) continue;
            if ((row.metadata?.featuring ?? []).some((n) => names.has(normName(n)))) continue;
            const hit = (f.feats ?? []).find((x) => names.has(normName(x.name)));
            if (hit) onTrack.set(row.id, { track: hit.track, name: names.get(normName(hit.name)) ?? hit.name, trackId: hit.trackId });
          }
        }
        document.getElementById('sel-title')!.innerHTML = `${rows.length} sortie${rows.length > 1 ? 's' : ''} de <em>tes artistes.</em>`;
        status.hidden = true;
        tiles.innerHTML = rows
          .map((r) => {
            const hint = onTrack.get(r.id);
            return releaseTileHtml({ ...r, featuring: r.metadata?.featuring }, hint ? { track: hint.track, trackId: hint.trackId, reason: `${hint.name ? `${hint.name} sur` : 'Sur'} « ${hint.track} »` } : {});
          })
          .join('');
      });
  }
</script>

<style>
  .sel-status {
    color: var(--color-text-muted);
  }

  .bz-tiles {
    margin-top: 24px;
  }

  .sel-all {
    display: inline-flex;
    margin-top: 32px;
  }
</style>
