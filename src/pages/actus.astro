---
// PAGE ACTUS : actus réelles (flux RSS des médias, lus au build) + concerts Ticketmaster s'il y en a
import { format, parseISO } from 'date-fns';
import { fr } from 'date-fns/locale';
import Layout from '../layouts/Layout.astro';
import FilTabs from '../components/FilTabs.astro';
import Scene from '../components/Scene.astro';
import { getNews, type NewsItem } from '../lib/news';
import { CONCERTS_CITY, getConcerts } from '../lib/concerts';

const news = await getNews();
const concerts = (await getConcerts()) ?? [];
// À la une : l'actu la plus récente qui a une image ; à côté : 3 autres, de médias différents si possible
const withImage = news.filter((n) => n.image);
const feature = withImage[0] ?? news[0];
const side: NewsItem[] = [];
for (const n of withImage.slice(1)) {
  if (side.length === 3) break;
  if (!side.some((s) => s.source === n.source) || withImage.length < 8) side.push(n);
}
const rest = news.filter((n) => n !== feature && !side.includes(n)).slice(0, 15);

const when = (n: NewsItem) => format(parseISO(n.date), 'd MMM', { locale: fr });
const meta = (n: NewsItem) => `${n.source} · ${when(n)}`;
---

<Layout title="Actus" description="L’actualité musicale de la semaine, sélectionnée dans les médias musicaux.">
  <div class="bz-page">
    <span class="bz-eyebrow">Fil</span>
    <h1 class="bz-display">Ce qui bouge <em>cette semaine.</em></h1>
    <FilTabs active="actus" />

    {feature ? (
      <>
        <div class="news">
          <a class="feature" href={feature.link} target="_blank" rel="noopener">
            {feature.image ? (
              <img class="feature-bg" src={feature.image} alt="" referrerpolicy="no-referrer" />
            ) : (
              <Scene variant={3} class="feature-bg" />
            )}
            <div class="feature-body">
              {feature.category && <span class="tag">{feature.category}</span>}
              <h2>{feature.title}</h2>
              <p>{meta(feature)} ↗</p>
            </div>
          </a>

          <ul class="side">
            {side.map((n, i) => (
              <li>
                <a class="brief" href={n.link} target="_blank" rel="noopener">
                  {n.image ? (
                    <img class="brief-thumb" src={n.image} alt="" loading="lazy" referrerpolicy="no-referrer" />
                  ) : (
                    <Scene variant={i} class="brief-thumb" />
                  )}
                  <div>
                    {n.category && <span class="category">{n.category}</span>}
                    <h3>{n.title}</h3>
                    <p>{meta(n)}</p>
                  </div>
                </a>
              </li>
            ))}
          </ul>
        </div>

        {rest.length > 0 && (
          <section class="feed" aria-labelledby="feed-title">
            <div class="bz-section-head">
              <h2 id="feed-title" class="bz-h2">Le fil</h2>
              <span class="sources">Sélection automatique des médias musicaux</span>
            </div>
            <div class="feed-grid">
              {rest.map((n, i) => (
                <a class="card" href={n.link} target="_blank" rel="noopener">
                  {n.image ? (
                    <img class="card-img" src={n.image} alt="" loading="lazy" referrerpolicy="no-referrer" />
                  ) : (
                    <Scene variant={i} class="card-img" />
                  )}
                  {n.category && <span class="category">{n.category}</span>}
                  <h3>{n.title}</h3>
                  <p>{meta(n)}</p>
                </a>
              ))}
            </div>
          </section>
        )}
      </>
    ) : (
      // Aucun flux joignable au moment du build
      <p class="bz-empty">Les actus n’ont pas pu être chargées. Elles reviendront à la prochaine mise à jour du site.</p>
    )}

    {concerts.length > 0 && (
      <section class="concerts" aria-labelledby="concerts-title">
        <div class="bz-section-head">
          <h2 id="concerts-title" class="bz-h2">Concerts près de toi</h2>
          <span class="bz-link">{CONCERTS_CITY}</span>
        </div>
        <div class="concert-grid">
          {concerts.slice(0, 8).map((c, i) => {
            const Tag = c.url ? 'a' : 'article';
            return (
              <Tag class="concert" href={c.url || undefined} target={c.url ? '_blank' : undefined} rel={c.url ? 'noopener' : undefined}>
                {c.image ? (
                  <img class="concert-photo" src={c.image} alt="" loading="lazy" referrerpolicy="no-referrer" />
                ) : (
                  <Scene variant={i} class="concert-photo" />
                )}
                <div class="concert-info">
                  <span class="date"><b>{c.day}</b>{c.month}</span>
                  <span class="who"><b>{c.artist}{c.watched && <span class="followed"> · suivi</span>}</b>{c.venue}</span>
                </div>
                <span class="tickets">{c.price ? `Billets · ${c.price}` : 'Billets'}</span>
              </Tag>
            );
          })}
        </div>
      </section>
    )}
  </div>
</Layout>

<style>
  .news {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(320px, 1fr);
    gap: 44px;
    margin-top: 64px;
  }

  .feature {
    position: relative;
    min-height: 600px;
    border-radius: 14px;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    background: var(--color-bg-elevated);
  }

  .feature :global(.feature-bg),
  .feature img.feature-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  a.feature:hover img.feature-bg {
    transform: scale(1.03);
  }

  .feature::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.9) 0%, rgba(0, 0, 0, 0.25) 55%, transparent 80%);
  }

  .feature-body {
    position: relative;
    z-index: 1;
    padding: 44px;
  }

  .tag {
    display: inline-block;
    padding: 6px 14px;
    border-radius: 10px;
    background: var(--color-accent);
    color: var(--color-on-accent);
    font: 700 14px/1 var(--font-sans);
    text-transform: uppercase;
  }

  .feature h2 {
    max-width: 680px;
    margin: 18px 0 14px;
    font: 800 clamp(31px, 3.8vw, 49px) / 1 var(--font-display);
    color: #fff;
  }

  .feature p {
    color: #cfcbc2;
    font-size: 16px;
  }

  .side {
    list-style: none;
    display: flex;
    flex-direction: column;
  }

  .side li + li {
    border-top: 1px solid var(--color-border);
  }

  .brief {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr);
    gap: 22px;
    padding: 0 0 28px;
  }

  .side li + li .brief {
    padding-top: 28px;
  }

  .brief :global(.brief-thumb),
  .brief img.brief-thumb {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 14px;
  }

  .category {
    font: 700 13px/1 var(--font-sans);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-orange);
  }

  .brief h3,
  .card h3 {
    margin: 12px 0 10px;
    font: 800 21px/1.12 var(--font-display);
    color: var(--color-text);
  }

  .brief:hover h3,
  .card:hover h3 {
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-underline-offset: 4px;
  }

  .brief p,
  .card p {
    font-size: 15px;
    color: var(--color-text-muted);
  }

  .feed {
    margin-top: 76px;
  }

  .sources {
    font-size: 14px;
    color: var(--color-text-dim);
  }

  .feed-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 40px 28px;
  }

  .card {
    display: flex;
    flex-direction: column;
  }

  .card :global(.card-img),
  .card img.card-img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: 14px;
    margin-bottom: 16px;
  }

  .concerts {
    margin-top: 76px;
  }

  .concert-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
  }

  .concert {
    border: 1px solid var(--color-border);
    border-radius: 14px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .concert :global(.concert-photo),
  .concert img.concert-photo {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  .followed {
    color: var(--color-accent);
    font-weight: 600;
    font-size: 14px;
  }

  .concert-info {
    display: flex;
    gap: 16px;
    padding: 20px;
  }

  .date {
    display: flex;
    flex-direction: column;
    align-items: center;
    font: 700 12px/1 var(--font-sans);
    letter-spacing: 0.12em;
    color: var(--color-accent);
  }

  .date b {
    margin-bottom: 6px;
    font: 800 31px/1 var(--font-display);
    letter-spacing: 0;
    color: var(--color-text);
  }

  .who {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 15px;
    color: var(--color-text-muted);
  }

  .who b {
    font-size: 18px;
    color: var(--color-text);
  }

  .tickets {
    margin-top: auto;
    padding: 16px;
    border-top: 1px solid var(--color-border);
    text-align: center;
    font-weight: 700;
    font-size: 15px;
  }

  @media (max-width: 1280px) {
    .news {
      grid-template-columns: minmax(0, 1fr);
    }
    .feed-grid,
    .concert-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 900px) {
    .news {
      margin-top: 32px;
      gap: 32px;
    }
    .feature {
      min-height: 420px;
    }
    .feature-body {
      padding: 24px;
    }
    .brief {
      grid-template-columns: 96px minmax(0, 1fr);
      gap: 16px;
    }
    .brief h3,
    .card h3 {
      font-size: 22px;
    }
    .feed-grid,
    .concert-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
