---
// PAGE ACTUS : article à la une, brèves, concerts près de toi (contenu de démonstration)
import Layout from '../layouts/Layout.astro';
import Scene from '../components/Scene.astro';
import { DEMO_CONCERTS, DEMO_NEWS } from '../data/demo';

const { feature, side } = DEMO_NEWS;
---

<Layout title="Actus" description="L’actualité musicale de la semaine : tournées, festivals, interviews, industrie.">
  <div class="bz-page">
    <span class="bz-eyebrow">Actus</span>
    <h1 class="bz-display">Ce qui bouge <em>cette semaine.</em></h1>

    <div class="news">
      <article class="feature">
        <Scene variant={feature.scene} class="feature-bg" />
        <div class="feature-body">
          <span class="tag">{feature.tag}</span>
          <h2>{feature.title}</h2>
          <p>{feature.meta}</p>
        </div>
      </article>

      <ul class="side">
        {side.map((n) => (
          <li>
            <article class="brief">
              <Scene variant={n.scene} class="brief-thumb" />
              <div>
                <span class="category">{n.category}</span>
                <h3>{n.title}</h3>
                <p>{n.meta}</p>
              </div>
            </article>
          </li>
        ))}
      </ul>
    </div>

    <section class="concerts" aria-labelledby="concerts-title">
      <div class="bz-section-head">
        <h2 id="concerts-title" class="bz-h2">Concerts près de toi</h2>
        <span class="bz-link">Paris ▾</span>
      </div>
      <div class="concert-grid">
        {DEMO_CONCERTS.map((c) => (
          <article class="concert">
            <Scene variant={c.scene} class="concert-photo" />
            <div class="concert-info">
              <span class="date"><b>{c.day}</b>{c.month}</span>
              <span class="who"><b>{c.artist}</b>{c.venue}</span>
            </div>
            <span class="tickets">Billets · {c.price}</span>
          </article>
        ))}
      </div>
    </section>
  </div>
</Layout>

<style>
  .news {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(320px, 1fr);
    gap: 44px;
    margin-top: 64px;
  }

  .feature {
    position: relative;
    min-height: 600px;
    border-radius: 24px;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
  }

  .feature :global(.feature-bg) {
    position: absolute;
    inset: 0;
  }

  .feature::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.85) 0%, rgba(0, 0, 0, 0.2) 55%, transparent 80%);
  }

  .feature-body {
    position: relative;
    z-index: 1;
    padding: 44px;
  }

  .tag {
    display: inline-block;
    padding: 6px 14px;
    border-radius: 999px;
    background: var(--color-lime);
    color: var(--color-ink);
    font: 700 14px/1 var(--font-sans);
    text-transform: uppercase;
  }

  .feature h2 {
    max-width: 640px;
    margin: 18px 0 14px;
    font: 400 clamp(40px, 4vw, 64px) / 0.98 var(--font-serif);
    color: #fff;
  }

  .feature p {
    color: #cfcbc2;
    font-size: 16px;
  }

  .side {
    list-style: none;
    display: flex;
    flex-direction: column;
  }

  .side li + li {
    border-top: 1px solid var(--color-border);
  }

  .brief {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr);
    gap: 22px;
    padding: 0 0 28px;
  }

  .side li + li .brief {
    padding-top: 28px;
  }

  .brief :global(.brief-thumb) {
    aspect-ratio: 1;
    border-radius: 14px;
  }

  .category {
    font: 700 13px/1 var(--font-sans);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-orange);
  }

  .brief h3 {
    margin: 12px 0 10px;
    font: 400 28px/1.1 var(--font-serif);
  }

  .brief p {
    font-size: 15px;
    color: var(--color-text-muted);
  }

  .concerts {
    margin-top: 76px;
  }

  .concert-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
  }

  .concert {
    border: 1px solid var(--color-border);
    border-radius: 16px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .concert :global(.concert-photo) {
    aspect-ratio: 3 / 2;
  }

  .concert-info {
    display: flex;
    gap: 16px;
    padding: 20px;
  }

  .date {
    display: flex;
    flex-direction: column;
    align-items: center;
    font: 700 12px/1 var(--font-sans);
    letter-spacing: 0.12em;
    color: var(--color-lime);
  }

  .date b {
    margin-bottom: 6px;
    font: 400 38px/1 var(--font-serif);
    letter-spacing: 0;
    color: var(--color-text);
  }

  .who {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 15px;
    color: var(--color-text-muted);
  }

  .who b {
    font-size: 18px;
    color: var(--color-text);
  }

  .tickets {
    margin-top: auto;
    padding: 16px;
    border-top: 1px solid var(--color-border);
    text-align: center;
    font-weight: 700;
    font-size: 15px;
  }

  @media (max-width: 1280px) {
    .news {
      grid-template-columns: minmax(0, 1fr);
    }
    .concert-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 900px) {
    .news {
      margin-top: 32px;
      gap: 32px;
    }
    .feature {
      min-height: 420px;
    }
    .feature-body {
      padding: 24px;
    }
    .brief {
      grid-template-columns: 96px minmax(0, 1fr);
      gap: 16px;
    }
    .brief h3 {
      font-size: 22px;
    }
    .concert-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
