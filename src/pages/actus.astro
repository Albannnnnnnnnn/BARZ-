---
// PAGE ACTUS - Actualités musicales (inspiré des maquettes)
import Layout from '../layouts/Layout.astro';

const news = [
  {
    id: 1,
    category: 'SORTIE',
    title: 'Kendrick Lamar dévoile "GNX", album surprise de 12 titres',
    excerpt: 'Sans prévenir, le rappeur de Compton balance un projet court, dense, produit par Sounwave et Jack Antonoff. West Coast modern à l\'état pur.',
    date: '23 nov. 2024',
    image: '/BARZ-/placeholder-release.svg',
    tag: 'À la une',
  },
  {
    id: 2,
    category: 'TOURNÉE',
    title: 'Justice annonce une tournée européenne 2025 — dates françaises',
    excerpt: 'Le duo d\'Ed Banger rempile pour "Hyperdrama Live". Paris, Lyon, Nantes au programme. Prévente le 29 nov.',
    date: '21 nov. 2024',
    image: '/BARZ-/placeholder-release.svg',
    tag: 'Billetterie',
  },
  {
    id: 3,
    category: 'CLIP',
    title: 'Tame Impala — "The Boat I Row" : Kevin Parker en animation psyché',
    excerpt: 'Nouveau visuel pour le morceau de "The Slow Rush". Réalisé par Robert Beatty, c\'est un trip kaleidoscopique 70\'s.',
    date: '19 nov. 2024',
    image: '/BARZ-/placeholder-release.svg',
    tag: 'Nouveau clip',
  },
  {
    id: 4,
    category: 'SORTIE',
    title: 'Charli XCX — "Brat and it\'s completely different but also still brat"',
    excerpt: 'La version remixée de "Brat" avec Lorde, Billie Eilish, Ariana Grande, Addison Rae... Le phénomène de l\'été continue.',
    date: '18 nov. 2024',
    image: '/BARZ-/placeholder-release.svg',
    tag: 'Remix',
  },
  {
    id: 5,
    category: 'ANNONCE',
    title: 'Fontaines D.C. : nouvel album "Romance" prévu pour août 2025',
    excerpt: 'Le quatuor irlandais tease un virage plus mélodique, produit par James Ford. Premier single "Starburster" déjà dispo.',
    date: '15 nov. 2024',
    image: '/BARZ-/placeholder-release.svg',
    tag: 'À venir',
  },
  {
    id: 6,
    category: 'FESTIVAL',
    title: 'We Love Green 2025 : la prog complète dévoilée',
    excerpt: 'Tyler, The Creator, PJ Harvey, NTO, Charlotte de Witte, L\'Impératrice... 3 jours au Bois de Vincennes, 6-8 juin.',
    date: '12 nov. 2024',
    image: '/BARZ-/placeholder-release.svg',
    tag: 'Festival',
  },
];

const sideNews = [
  { category: 'SORTIE', title: 'Little Simz — "Fever" (feat. Ghetts)', date: '22 nov.' },
  { category: 'CLIP', title: 'Fred again.. — "ten" (visualizer)', date: '21 nov.' },
  { category: 'SORTIE', title: 'André 3000 — "New Blue Sun" (réédition vinyle)', date: '20 nov.' },
  { category: 'TOURNÉE', title: 'Kaytranada : dates US + Europe 2025', date: '19 nov.' },
  { category: 'ANNONCE', title: 'Björk tease un projet "sonore et visuel"', date: '18 nov.' },
];

const cardStyle = 'card card-interactive overflow-hidden transition group h-full';
const badgeStyle = 'badge badge-type text-[0.65rem] mb-2';
const tagStyle = 'text-[0.7rem] uppercase tracking-widest text-[var(--color-accent)] font-semibold';
const titleStyle = 'font-bold text-lg mb-2 text-[var(--color-text)] line-clamp-2 group-hover:text-[var(--color-accent)] transition';
const excerptStyle = 'text-sm text-muted line-clamp-3 mb-4';
const metaStyle = 'flex items-center gap-2 text-xs text-dim';
const sideItemStyle = 'flex items-start gap-3 py-2 border-b border-[var(--color-border)] last:border-0 group';
const sideTitleStyle = 'font-medium text-sm text-[var(--color-text)] group-hover:text-[var(--color-accent)] transition';
const sideMetaStyle = 'text-[0.7rem] text-dim';
---

<Layout title="Actus - BARZ" description="Toute l'actualité musicale : sorties albums, clips, tournées, festivals.">
  <div class="container section-lg">
    <header class="mb-12">
      <span class="inline-block px-2 py-0.5 rounded text-xs font-semibold uppercase tracking-wider text-[#a3e635] bg-[#a3e635]/10 border border-[#a3e635]/25">
        Actus
      </span>
      <h1 class="text-5xl md:text-6xl font-bold mt-3 mb-2 text-[var(--color-text)] [letter-spacing:-0.02em]">
        L'actu qui compte<span class="gradient-text">.</span>
      </h1>
      <p class="text-lg text-muted max-w-2xl">
        Sorties, tournées, clips, festivals — la sélection BARZ, sans le bruit.
      </p>
    </header>

    <div class="grid gap-6 lg:grid-cols-4">
      <!-- Colonne principale (3/4) -->
      <div class="lg:col-span-3 space-y-6">
        {news.map((n) => (
          <article key={n.id} class={cardStyle}>
            <div class="relative aspect-[16/10] overflow-hidden">
              <img src={n.image} alt={n.title} class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" />
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/20 to-transparent" />
              <div class="absolute top-3 left-3 flex flex-col gap-1">
                <span class={badgeStyle}>{n.category}</span>
                {n.tag && <span class="text-[0.65rem] px-2 py-0.5 rounded bg-[#a3e635]/90 text-[#09090b] font-semibold">{n.tag}</span>}
              </div>
            </div>
            <div class="p-5 md:p-6">
              <div class={metaStyle}>
                <time>{n.date}</time>
                <span aria-hidden="true">·</span>
                <span>3 min de lecture</span>
              </div>
              <h2 class={titleStyle}>{n.title}</h2>
              <p class={excerptStyle}>{n.excerpt}</p>
              <a href="/BARZ-/" class="inline-flex items-center gap-1.5 text-sm font-semibold text-[var(--color-accent)] hover:text-[var(--color-accent-hover)]">
                Lire la suite
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5" aria-hidden="true">
                  <path d="M5 12h14M12 5l7 7-7 7" />
                </svg>
              </a>
            </div>
          </article>
        ))}
      </div>

      <!-- Sidebar (1/4) -->
      <aside class="lg:col-span-1 hidden lg:block">
        <div class="card p-5 sticky top-[100px]">
          <h3 class="font-bold text-base mb-4 text-[var(--color-text)] uppercase tracking-wider">Dernières minutes</h3>
          <div class="space-y-0">
            {sideNews.map((s, i) => (
              <div key={i} class={sideItemStyle}>
                <div class="flex-shrink-0 w-8 h-8 rounded-full bg-[var(--color-bg-hover)] flex items-center justify-center">
                  <span class={tagStyle}>{s.category}</span>
                </div>
                <div class="min-w-0 flex-1">
                  <p class={sideTitleStyle}>{s.title}</p>
                  <p class={sideMetaStyle}>{s.date}</p>
                </div>
              </div>
            ))}
          </div>
          <a href="/BARZ-/search" class="btn btn-ghost btn-sm w-full mt-4">Voir toutes les actus</a>
        </div>
      </aside>
    </div>
  </div>
</Layout>