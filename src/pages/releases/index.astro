---
// LISTE TOUTES LES SORTIES (paginée)
import Layout from '../../layouts/Layout.astro';
import { getSupabaseServerSafe } from '../../lib/supabase';
import ReleaseGrid from '../../components/ReleaseGrid.tsx';
import GenreFilter from '../../components/GenreFilter.tsx';

export async function getStaticPaths() {
  return [{ params: { page: '1' } }];
}

const { page } = Astro.params;
const currentPage = parseInt(page as string) || 1;
const PAGE_SIZE = 48;

const supabase = getSupabaseServerSafe();

// Récupérer tous les genres pour le filtre
let allGenres: string[] = [];
let releases: any[] = [];
let count = 0;
let totalPages = 0;

if (supabase) {
  try {
    const { data: allReleasesForGenres } = await supabase
      .from('releases')
      .select('genres')
      .not('genres', 'is', null);

    allGenres = [...new Set(
      (allReleasesForGenres || []).flatMap((r: any) => r.genres || [])
    )].sort();

    // Récupérer les releases paginées
    const from = (currentPage - 1) * PAGE_SIZE;
    const to = from + PAGE_SIZE - 1;

    const { data, count: totalCount, error } = await supabase
      .from('releases')
      .select(`
        *,
        artist:artists!artist_id(*)
      `, { count: 'exact' })
      .order('release_date', { ascending: false })
      .range(from, to);

    if (!error && data) {
      releases = data;
      count = totalCount || 0;
    }
  } catch (e) {
    console.warn('Supabase query failed:', e);
  }
} else {
  console.warn('Supabase not configured, using empty data for build');
}

totalPages = Math.ceil((count || 0) / PAGE_SIZE);

// Pagination pages à afficher
function getPaginationPages(current: number, total: number): number[] {
  if (total <= 5) return Array.from({ length: total }, (_, i) => i + 1);
  if (current <= 3) return [1, 2, 3, 4, 5];
  if (current >= total - 2) return [total - 4, total - 3, total - 2, total - 1, total];
  return [current - 2, current - 1, current, current + 1, current + 2];
}

const paginationPages = getPaginationPages(currentPage, totalPages);
---

<Layout title="Toutes les sorties - BARZ" description="Parcours toutes les sorties musicales référencées sur BARZ. Albums, EPs, singles - filtre par genre, tri par date.">
  <div class="container section">
    <header class="mb-8">
      <h1 class="text-4xl font-bold mb-2" style="letter-spacing: -0.03em; color: var(--color-text);">
        Toutes les sorties
      </h1>
      <p class="text-lg" style="color: var(--color-text-muted);">
        {count || 0} sorties référencées. Filtre par genre, navigue dans les pages.
      </p>
    </header>

    <!-- Filtres -->
    <div class="card p-6 mb-8">
      <GenreFilter
        client:visible
        selectedGenres={[]}
        availableGenres={allGenres}
        onChange={(genres) => {
          const url = new URL(window.location.href);
          if (genres.length) url.searchParams.set('genres', genres.join(','));
          else url.searchParams.delete('genres');
          url.searchParams.set('page', '1');
          window.location.href = url.toString();
        }}
      />
    </div>

    <!-- Grille releases -->
    <ReleaseGrid
      client:visible
      releases={releases}
      emptyMessage="Aucune sortie trouvée"
    />

    <!-- Pagination -->
    {totalPages > 1 && (
      <nav class="flex items-center justify-center gap-2 mt-10" aria-label="Pagination">
        {currentPage > 1 && (
          <a href={`/releases?page=${currentPage - 1}`} class="btn btn-secondary">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" aria-hidden="true">
              <path d="M15 18l-6-6 6-6" />
            </svg>
            Précédente
          </a>
        )}

        <div class="flex items-center gap-1">
          {paginationPages.map((pageNum) => (
            <a
              href={`/releases?page=${pageNum}`}
              class={`btn btn-sm ${currentPage === pageNum ? 'btn-primary' : 'btn-secondary'}`}
              aria-current={currentPage === pageNum ? 'page' : undefined}
              aria-label={`Page ${pageNum}`}
            >
              {pageNum}
            </a>
          ))}
        </div>

        {currentPage < totalPages && (
          <a href={`/releases?page=${currentPage + 1}`} class="btn btn-secondary">
            Suivante
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" aria-hidden="true">
              <path d="M9 18l6-6-6-6" />
            </svg>
          </a>
        )}
      </nav>
    )}
  </div>
</Layout>