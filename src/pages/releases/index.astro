---
// TOUTES LES SORTIES : le catalogue complet, filtrable par genre
import Layout from '../../layouts/Layout.astro';
import AlbumTile from '../../components/AlbumTile.astro';
import GenreChips from '../../components/GenreChips.astro';
import SortiesTabs from '../../components/SortiesTabs.astro';
import { getSupabaseServerSafe } from '../../lib/supabase';
import { chipIdsFor, fetchReleasesBetween } from '../../lib/releases';
import { releaseSubtitle } from '../../lib/utils';

const releases = await fetchReleasesBetween(getSupabaseServerSafe(), new Date('1900-01-01'), new Date('2100-01-01'));
---

<Layout title="Toutes les sorties" description="Toutes les sorties référencées sur BARZ¡, filtrables par genre.">
  <div class="bz-page">
    <span class="bz-eyebrow">Tout le catalogue</span>
    <h1 class="bz-display">Sorties</h1>
    <SortiesTabs active="toutes" />
    <p class="count">{releases.length} sortie{releases.length > 1 ? 's' : ''} référencée{releases.length > 1 ? 's' : ''}, de la plus récente à la plus ancienne.</p>

    {releases.length > 0 ? (
      <section>
        <GenreChips target="#catalog" />
        <div id="catalog" class="bz-tiles catalog">
          {releases.map((r) => (
            <AlbumTile
              title={r.title}
              subtitle={releaseSubtitle(r)}
              cover={r.cover_url}
              href={`/BARZ-/releases/${r.slug}`}
              chips={chipIdsFor(r.genres)}
            />
          ))}
        </div>
        <p class="chip-empty" hidden>Aucune sortie de ce genre pour l’instant.</p>
      </section>
    ) : (
      <p class="bz-empty">Aucune sortie en base. Lance le sync : <strong>npm run sync:releases</strong>.</p>
    )}
  </div>
</Layout>

<style>
  .count {
    margin: 28px 0 32px;
    font-size: 17px;
    color: var(--color-text-muted);
  }

  .catalog {
    margin-top: 28px;
  }

  .chip-empty {
    margin-top: 24px;
    color: var(--color-text-muted);
  }
</style>
