---
// FICHE D'UNE SORTIE : pochette, infos, écoute Spotify, sorties proches (calculées au build)
import { format, parseISO } from 'date-fns';
import { fr } from 'date-fns/locale';
import Layout from '../../layouts/Layout.astro';
import Cover from '../../components/Cover.astro';
import AlbumTile from '../../components/AlbumTile.astro';
import Player from '../../components/Player.astro';
import { getSupabaseServerSafe } from '../../lib/supabase';
import { GENRE_CHIPS, fetchReleasesBetween, type ReleaseRow } from '../../lib/releases';
import { getReleaseTypeLabel, releaseSubtitle } from '../../lib/utils';
import { listenMenuHtml } from '../../lib/listen';
import { normName } from '../../lib/feat';
import { audience, recommendable, releaseScore } from '../../lib/audience';

export async function getStaticPaths() {
  const supabase = getSupabaseServerSafe();
  const all = await fetchReleasesBetween(supabase, new Date('1900-01-01'), new Date('2100-01-01'));
  // Artistes invités (feat.) retrouvés dans le catalogue par leur nom réduit (colonne search_name, supabase/artist-search.sql) :
  // leur nom devient un lien vers leur fiche (sinon ?nom=, qui l'ajoute au catalogue)
  const guests = [...new Set(all.flatMap((r) => r.metadata?.featuring ?? []).map(normName).filter(Boolean))];
  const guestSlugs = new Map<string, { slug: string; audience: number }>();
  for (let i = 0; supabase && i < guests.length; i += 200) {
    const { data } = await supabase.from('artists').select('slug, search_name, audience').in('search_name', guests.slice(i, i + 200));
    for (const a of (data ?? []) as { slug: string; search_name: string; audience: number | null }[]) {
      const current = guestSlugs.get(a.search_name);
      if (!current || (a.audience ?? 0) > current.audience) guestSlugs.set(a.search_name, { slug: a.slug, audience: a.audience ?? 0 });
    }
  }
  // Artistes proches (Deezer, supabase/discovery.sql), dans les deux sens : proximité de 0 à 1 (1 = le plus proche)
  const closeness = new Map<string, number>();
  const artistIds = [...new Set(all.map((r) => r.artist?.id).filter((id): id is string => !!id))];
  const CHUNK = 30; // 30 artistes × 25 voisins : sous la limite de 1 000 lignes par requête
  const chunks = Array.from({ length: Math.ceil(artistIds.length / CHUNK) }, (_, i) => artistIds.slice(i * CHUNK, (i + 1) * CHUNK));
  for (let i = 0; supabase && i < chunks.length; i += 10) {
    const pages = await Promise.all(
      chunks.slice(i, i + 10).map((ids) => supabase!.from('artist_relations').select('artist_id, related_id, rank').in('artist_id', ids))
    );
    for (const { data } of pages) {
      for (const e of (data ?? []) as { artist_id: string; related_id: string; rank: number }[]) {
        const c = Math.max(0, 1 - e.rank / 25);
        for (const key of [`${e.artist_id}|${e.related_id}`, `${e.related_id}|${e.artist_id}`]) closeness.set(key, Math.max(closeness.get(key) ?? 0, c));
      }
    }
  }
  const candidates = all.filter((r) =>
    recommendable({ releaseType: r.release_type, artistName: r.artist?.name, featuring: r.metadata?.featuring, fans: audience(r.artist) })
  );
  const logAudience = (r: ReleaseRow) => Math.log10(audience(r.artist) + 1);

  return all.map((release) => {
    // Sorties proches : d'abord les artistes proches (Deezer), puis les genres en commun et une audience comparable ;
    // jamais le même artiste, une seule sortie par artiste, pas de compilation ni d'artiste presque inconnu
    const artistId = release.artist?.id;
    const shared = (r: ReleaseRow) => r.genres?.filter((g) => release.genres?.includes(g)).length ?? 0;
    const sameLevel = (r: ReleaseRow) => 1 - Math.min(1, Math.abs(logAudience(r) - logAudience(release)) / 2);
    const seen = new Set<string>();
    const related = candidates
      .filter((r) => r.id !== release.id && r.artist?.id && r.artist.id !== artistId)
      .map((r) => {
        const near = artistId ? closeness.get(`${artistId}|${r.artist!.id}`) ?? 0 : 0;
        const days = Math.abs(Date.parse(r.release_date) - Date.parse(release.release_date)) / 86_400_000;
        return { r, score: near * 100 + shared(r) * 10 + sameLevel(r) * 8 + releaseScore(r) * 0.5 - days / 365 };
      })
      .sort((a, b) => b.score - a.score)
      .filter(({ r }) => !seen.has(r.artist!.id) && !!seen.add(r.artist!.id))
      .slice(0, 6)
      .map(({ r }) => r);
    const featLinks = (release.metadata?.featuring ?? []).map((name) => ({ name, slug: guestSlugs.get(normName(name))?.slug ?? null }));
    return { params: { slug: release.slug }, props: { release, related, featLinks } };
  });
}

interface Props {
  release: ReleaseRow;
  related: ReleaseRow[];
  featLinks: { name: string; slug: string | null }[];
}

const { release, related, featLinks } = Astro.props;
const artistName = release.artist?.name ?? 'Artiste inconnu';
const typeLabel = getReleaseTypeLabel(release.release_type);
const dateLabel = format(parseISO(release.release_date), 'EEEE d MMMM yyyy', { locale: fr });
const genreLabels = GENRE_CHIPS.filter((c) => c.genres.some((g) => release.genres?.includes(g))).map((c) => c.label);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'MusicAlbum',
  name: release.title,
  byArtist: { '@type': 'MusicGroup', name: artistName },
  datePublished: release.release_date,
  genre: genreLabels,
  numTracks: release.track_count,
  image: release.cover_url ?? undefined,
};
---

<Layout
  title={`${release.title} — ${artistName}`}
  description={`${typeLabel} de ${artistName}, ${Date.parse(release.release_date) > Date.now() ? 'à paraître le' : 'sorti le'} ${dateLabel}.`}
  image={release.cover_url ?? undefined}
  type="article"
>
  <script type="application/ld+json" slot="json-ld" set:html={JSON.stringify(jsonLd)} />

  <div class="bz-page">
    <a class="back" href="/BARZ-/">← Sorties</a>

    <section class="hero">
      <div class="hero-art"><Cover title={release.title} src={release.cover_url} class="hero-cover" sizes="(max-width: 900px) 90vw, 440px" eager /></div>
      <div class="info">
        <span class="bz-eyebrow">{typeLabel} · {dateLabel}</span>
        <p class="countdown" id="countdown" data-date={release.release_date} hidden></p>
        <h1 class="bz-display">{release.title}</h1>
        <div class="artist">
          {release.artist?.image_url && <img src={release.artist.image_url} alt="" />}
          <span>
            {release.artist ? <a href={`/BARZ-/artiste?a=${release.artist.slug}`}><b>{artistName}</b></a> : <b>{artistName}</b>}
            {featLinks.length > 0 && (
              <>
                {' '}avec{' '}
                {featLinks.map((f, i) => (
                  <>
                    {i > 0 && (i === featLinks.length - 1 ? ' et ' : ', ')}
                    {/* Hors catalogue : la fiche le cherche sur Deezer et l'ajoute */}
                    <a class="feat-link" href={f.slug ? `/BARZ-/artiste?a=${f.slug}` : `/BARZ-/artiste?nom=${encodeURIComponent(f.name)}`}>{f.name}</a>
                  </>
                ))}
              </>
            )}
          </span>
        </div>
        <dl class="facts">
          {release.track_count > 0 && (
            <div><dt>Titres</dt><dd>{release.track_count}</dd></div>
          )}
          <div><dt>Format</dt><dd>{typeLabel}</dd></div>
          {genreLabels.length > 0 && (
            <div><dt>Genre</dt><dd>{genreLabels.join(' · ')}</dd></div>
          )}
          {release.metadata?.label && (
            <div><dt>Label</dt><dd>{release.metadata.label}</dd></div>
          )}
        </dl>
        <div class="actions" data-links-missing={!(release.spotify_url && release.apple_music_url) && release.metadata?.upc ? "" : undefined}>
          <Fragment set:html={listenMenuHtml({ artist: artistName, title: release.title, deezerUrl: release.deezer_url, spotifyUrl: release.spotify_url, appleUrl: release.apple_music_url })} />
        </div>
        <div class="shelves" data-release-id={release.id}>
          <button type="button" class="bz-chip" data-shelf="spin_list" aria-pressed="false">+ Spin list</button>
          <button type="button" class="bz-chip" data-shelf="listened" aria-pressed="false">✓ Écouté</button>
        </div>
        <div class="friends-box" id="friends-box" hidden></div>
      </div>
    </section>

    <Player title={release.title} deezerUrl={release.deezer_url} />

    <section class="barz" aria-labelledby="barz-title" data-release-id={release.id}>
      <div class="bz-section-head">
        <h2 id="barz-title" class="bz-h2">Les <em>Barz</em></h2>
        <span class="barz-avg" id="barz-avg"></span>
      </div>
      <form class="barz-form" id="barz-form" hidden>
        <label class="bz-field score-field">
          Ta note
          <span class="score-row">
            <input type="range" name="score" min="0" max="10" step="0.5" value="7" />
            <output name="score-out">7.0</output>
          </span>
        </label>
        <label class="bz-field">
          Ton Barz
          <textarea class="bz-input" name="body" maxlength="1000" rows="4" placeholder="Ce que tu en as pensé, en une phrase ou en détail…" required></textarea>
        </label>
        <p class="bz-notice" id="barz-message" hidden></p>
        <button type="submit" class="bz-btn bz-btn--lime bz-btn--small">Publier mon Barz</button>
      </form>
      <a class="bz-notice login-hint" id="barz-login" href="/BARZ-/connexion" hidden>Connecte-toi pour noter cette sortie et écrire ton Barz →</a>
      <div class="barz-list" id="barz-list"></div>
    </section>

    {related.length > 0 && (
      <section class="related" aria-labelledby="related-title">
        <div class="bz-section-head"><h2 id="related-title" class="bz-h2">Dans la même veine</h2></div>
        <div class="bz-tiles bz-rail">
          {related.map((r) => (
            <AlbumTile
              title={r.title}
              subtitle={releaseSubtitle(r)}
              cover={r.cover_url}
              href={`/BARZ-/releases/${r.slug}`}
            />
          ))}
        </div>
      </section>
    )}
  </div>
</Layout>

<script>
  // Compte à rebours, calculé dans le navigateur (la page est construite à l'avance)
  const countdown = document.getElementById('countdown');
  if (countdown) {
    const days = Math.round((Date.parse(`${countdown.dataset.date}T00:00:00`) - new Date(new Date().toDateString()).getTime()) / 86_400_000);
    if (days > 0) {
      countdown.textContent = days === 1 ? 'Sort demain' : `Sort dans ${days} jours`;
      countdown.hidden = false;
    } else if (days === 0) {
      countdown.textContent = 'Sort aujourd’hui';
      countdown.hidden = false;
    }
  }

  import { applyListenPreference } from '../../scripts/listen';
  import { BASE, avatarUrl, barzCardHtml, barzFeed, escapeHtml, formatScore, getSession, isOnShelf, loginUrl, myFriendships, saveBarz, setOnShelf, supabase, wireBarzActions, authErrorMessage, errorText, type Barz, type FriendEntry, type Shelf } from '../../scripts/social';

  const releaseId = document.querySelector<HTMLElement>('.shelves')!.dataset.releaseId!;

  // Liens exacts Spotify / Apple Music pas encore connus : cherchés une fois par la fonction links (par code-barres),
  // puis mis à la place de la recherche dans le menu « Écouter »
  const listenBox = document.querySelector<HTMLElement>('[data-links-missing]');
  if (listenBox && supabase) {
    supabase.functions.invoke('links', { body: { release: releaseId } }).then(({ data }) => {
      const found: Record<string, string | null | undefined> = { Spotify: data?.spotify, 'Apple Music': data?.apple };
      const main = listenBox.querySelector<HTMLAnchorElement>('.bz-listen-main');
      for (const [platform, url] of Object.entries(found)) {
        if (!url) continue;
        const item = listenBox.querySelector<HTMLAnchorElement>(`[data-platform="${platform}"]`);
        if (item) item.href = url;
        if (main?.querySelector('b')?.textContent === platform) main.href = url;
      }
      applyListenPreference(listenBox);
    });
  }

  // Spin list / Écouté
  const shelfButtons = document.querySelectorAll<HTMLButtonElement>('[data-shelf]');
  const paintShelf = (button: HTMLButtonElement, on: boolean) => {
    button.classList.toggle('is-active', on);
    button.setAttribute('aria-pressed', String(on));
  };
  shelfButtons.forEach(async (button) => {
    paintShelf(button, await isOnShelf(button.dataset.shelf as Shelf, releaseId));
    button.addEventListener('click', async () => {
      const session = await getSession();
      if (!session) return void (location.href = loginUrl());
      const on = button.getAttribute('aria-pressed') !== 'true';
      paintShelf(button, on);
      try {
        await setOnShelf(button.dataset.shelf as Shelf, releaseId, on);
      } catch (err) {
        paintShelf(button, !on);
        alert(errorText(err));
      }
    });
  });

  // Barz de cette sortie
  const list = document.getElementById('barz-list')!;
  const avg = document.getElementById('barz-avg')!;
  const form = document.getElementById('barz-form') as HTMLFormElement;
  const message = document.getElementById('barz-message')!;
  let myId: string | null = null;
  let friends: FriendEntry['profile'][] = [];

  // Tes amis et cette sortie : qui l'a notée (avec la moyenne), écoutée, mise de côté
  const names = (list: string[]) => (list.length > 1 ? `${list.slice(0, -1).join(', ')} et ${list[list.length - 1]}` : list[0] ?? '');
  async function renderFriends(barz: Barz[]) {
    const box = document.getElementById('friends-box')!;
    if (!friends.length || !supabase) return void (box.hidden = true);
    const ids = friends.map((f) => f.id);
    const byId = new Map(friends.map((f) => [f.id, f]));
    const [listened, spin] = await Promise.all([
      supabase.from('listened').select('user_id').eq('release_id', releaseId).in('user_id', ids),
      supabase.from('spin_list').select('user_id').eq('release_id', releaseId).in('user_id', ids),
    ]);
    const rated = barz.filter((b) => byId.has(b.user_id));
    const ratedIds = new Set(rated.map((b) => b.user_id));
    const heard = ((listened.data ?? []) as { user_id: string }[]).map((r) => r.user_id).filter((id) => !ratedIds.has(id));
    const saved = ((spin.data ?? []) as { user_id: string }[]).map((r) => r.user_id).filter((id) => !ratedIds.has(id) && !heard.includes(id));
    const nameOf = (id: string) => byId.get(id)?.display_name ?? '';
    const lines: string[] = [];
    if (rated.length) {
      const mean = rated.reduce((sum, b) => sum + Number(b.score), 0) / rated.length;
      lines.push(`<b>${rated.length} ami${rated.length > 1 ? 's' : ''} l’${rated.length > 1 ? 'ont' : 'a'} noté</b> · moyenne <b>${formatScore(mean)}</b>`);
    }
    if (heard.length) lines.push(`${escapeHtml(names(heard.map(nameOf)))} l’${heard.length > 1 ? 'ont' : 'a'} écouté`);
    if (saved.length) lines.push(`${escapeHtml(names(saved.map(nameOf)))} l’${saved.length > 1 ? 'ont dans leur' : 'a dans sa'} spin list`);
    if (!lines.length) return void (box.hidden = true);
    const faces = [...rated.map((b) => b.user_id), ...heard, ...saved].slice(0, 5).map((id) => {
      const f = byId.get(id)!;
      const inner = f.avatar_path ? `<img src="${escapeHtml(avatarUrl(f.avatar_path))}" alt="" />` : escapeHtml(f.display_name.slice(0, 1).toUpperCase());
      return `<a class="friend-face" href="${BASE}profil?u=${encodeURIComponent(f.username)}" title="${escapeHtml(f.display_name)}">${inner}</a>`;
    });
    box.innerHTML = `<span class="friend-faces">${faces.join('')}</span><span class="friend-lines">${lines.map((l) => `<span>${l}</span>`).join('')}</span>`;
    box.hidden = false;
  }

  async function render() {
    try {
      const all = await barzFeed({ releaseId, limit: 50 });
      // Les Barz de tes amis d'abord
      const friendIds = new Set(friends.map((f) => f.id));
      const barz = [...all.filter((b) => friendIds.has(b.user_id)), ...all.filter((b) => !friendIds.has(b.user_id))];
      renderFriends(all).catch((err) => console.warn('Amis indisponibles :', err));
      list.innerHTML = barz.length
        ? barz.map((b) => barzCardHtml(b, myId, { showRelease: false })).join('')
        : '<p class="bz-empty">Aucun Barz pour l’instant. Donne le premier avis.</p>';
      avg.textContent = barz.length
        ? `${formatScore(barz.reduce((sum, b) => sum + Number(b.score), 0) / barz.length)} / 10 · ${barz.length} avis`
        : '';
      const mine = barz.find((b) => b.user_id === myId);
      if (mine) {
        (form.elements.namedItem('score') as HTMLInputElement).value = String(mine.score);
        (form.elements.namedItem('score-out') as HTMLOutputElement).value = formatScore(mine.score);
        (form.elements.namedItem('body') as HTMLTextAreaElement).value = mine.body;
      }
    } catch (err) {
      list.innerHTML = `<p class="bz-empty">${errorText(err)}</p>`;
    }
  }

  getSession().then(async (session) => {
    myId = session?.user.id ?? null;
    if (session) friends = (await myFriendships().catch(() => [])).filter((f) => f.status === 'friends').map((f) => f.profile);
    form.hidden = !session;
    const hint = document.getElementById('barz-login') as HTMLAnchorElement;
    hint.hidden = !!session;
    hint.href = loginUrl();
    render();
  });

  form.addEventListener('input', () => {
    (form.elements.namedItem('score-out') as HTMLOutputElement).value = formatScore(Number((form.elements.namedItem('score') as HTMLInputElement).value));
  });

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    const data = new FormData(form);
    const body = String(data.get('body') ?? '').trim();
    if (!body) return;
    try {
      await saveBarz(releaseId, Number(data.get('score')), body);
      message.hidden = true;
      render();
    } catch (err) {
      message.textContent = errorText(err);
      message.className = 'bz-notice bz-notice--error';
      message.hidden = false;
    }
  });

  wireBarzActions(list, render);
</script>

<style>
  .friends-box {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 20px;
    padding: 12px 16px;
    border: var(--line);
    border-radius: 12px;
    background: var(--color-accent-soft);
    font-size: 15px;
    line-height: 1.4;
  }

  .friends-box :global(.friend-faces) {
    display: flex;
    flex-shrink: 0;
  }

  .friends-box :global(.friend-face) {
    width: 34px;
    height: 34px;
    margin-left: -8px;
    border-radius: 50%;
    overflow: hidden;
    display: grid;
    place-items: center;
    background: var(--color-accent);
    color: var(--color-on-accent);
    box-shadow: 0 0 0 2px var(--color-accent-soft);
    font: 700 14px/1 var(--font-sans);
  }

  .friends-box :global(.friend-face:first-child) {
    margin-left: 0;
  }

  .friends-box :global(.friend-face img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .friends-box :global(.friend-lines) {
    display: flex;
    flex-direction: column;
    gap: 2px;
    color: var(--color-text-muted);
  }

  .friends-box :global(b) {
    color: var(--color-text);
  }

  .countdown {
    display: inline-block;
    margin-top: 14px;
    padding: 7px 12px;
    border-radius: 6px;
    background: var(--color-ink);
    color: #ffffff;
    font: 700 13px/1 var(--font-display);
    text-transform: uppercase;
    transform: rotate(-3deg);
    letter-spacing: 0.04em;
  }

  .back {
    display: inline-block;
    margin-bottom: 36px;
    font-weight: 600;
    color: var(--color-text-muted) !important;
  }

  .back:hover {
    color: var(--color-text) !important;
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(260px, 440px) minmax(0, 1fr);
    gap: 56px;
    align-items: end;
  }

  /* Pochette sur un panneau bleu, ombre franche (style « Affiche ») */
  .hero-art {
    padding: 28px;
    border: var(--line);
    border-radius: 14px;
    background: var(--color-accent);
  }

  .hero :global(.hero-cover) {
    border-radius: 10px;
    box-shadow: 6px 6px 0 var(--color-ink);
  }

  .hero :global(.hero-cover .cover-title) {
    font-size: 40px;
  }

  .info .bz-eyebrow::first-letter {
    text-transform: uppercase;
  }

  .artist {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 24px;
    font-size: 20px;
    color: var(--color-text-muted);
  }

  .artist b {
    color: var(--color-text);
    font-weight: 900;
  }

  .artist a:hover b,
  .feat-link:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .feat-link {
    color: var(--color-text);
    font-weight: 600;
  }

  .artist img {
    width: 48px;
    height: 48px;
    border: var(--line);
    border-radius: 50%;
    object-fit: cover;
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 40px;
    margin-top: 28px;
    padding-top: 18px;
    border-top: var(--line);
  }

  .facts dt {
    font: 800 11px/1 var(--font-sans);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .facts dd {
    margin-top: 10px;
    font: 800 20px/1 var(--font-display);
    text-transform: uppercase;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 36px;
  }

  .actions .bz-btn--outline {
    padding: 13px 18px;
    font-size: 14px;
  }

  .shelves {
    display: flex;
    gap: 8px;
    margin-top: 16px;
  }

  .barz {
    margin-top: 88px;
  }

  .barz-avg {
    font-weight: 700;
    color: var(--color-accent);
  }

  .barz-form {
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr);
    gap: 20px 28px;
    align-items: start;
    margin-bottom: 32px;
    padding: 24px;
    border: var(--line);
    border-radius: 14px;
    box-shadow: var(--shadow-hard);
  }

  .barz-form .bz-notice,
  .barz-form .bz-btn {
    grid-column: 2;
    justify-self: start;
  }

  .score-row {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .score-row input {
    flex: 1;
    accent-color: var(--color-accent);
  }

  .score-row output {
    font: 800 30px/1 var(--font-display);
    color: var(--color-accent);
  }

  .login-hint {
    display: block;
    margin-bottom: 28px;
    color: var(--color-accent) !important;
    font-weight: 600;
  }

  .barz-form[hidden],
  .login-hint[hidden] {
    display: none;
  }

