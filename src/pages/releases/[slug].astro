---
// FICHE D'UNE SORTIE : pochette, infos, écoute Spotify, sorties proches (calculées au build)
import { format, parseISO } from 'date-fns';
import { fr } from 'date-fns/locale';
import Layout from '../../layouts/Layout.astro';
import Cover from '../../components/Cover.astro';
import AlbumTile from '../../components/AlbumTile.astro';
import Player from '../../components/Player.astro';
import { getSupabaseServerSafe } from '../../lib/supabase';
import { GENRE_CHIPS, fetchReleasesBetween, type ReleaseRow } from '../../lib/releases';
import { getReleaseTypeLabel, releaseSubtitle } from '../../lib/utils';

export async function getStaticPaths() {
  const all = await fetchReleasesBetween(getSupabaseServerSafe(), new Date('1900-01-01'), new Date('2100-01-01'));
  return all.map((release) => {
    // Sorties proches : genres en commun d'abord, puis dates voisines
    const shared = (r: ReleaseRow) => r.genres?.filter((g) => release.genres?.includes(g)).length ?? 0;
    const related = all
      .filter((r) => r.id !== release.id)
      .map((r) => ({ r, score: shared(r) * 1000 - Math.abs(Date.parse(r.release_date) - Date.parse(release.release_date)) / 86_400_000 }))
      .sort((a, b) => b.score - a.score)
      .slice(0, 6)
      .map(({ r }) => r);
    return { params: { slug: release.slug }, props: { release, related } };
  });
}

interface Props {
  release: ReleaseRow;
  related: ReleaseRow[];
}

const { release, related } = Astro.props;
const artistName = release.artist?.name ?? 'Artiste inconnu';
const typeLabel = getReleaseTypeLabel(release.release_type);
const dateLabel = format(parseISO(release.release_date), 'EEEE d MMMM yyyy', { locale: fr });
const genreLabels = GENRE_CHIPS.filter((c) => c.genres.some((g) => release.genres?.includes(g))).map((c) => c.label);
const featuring = release.metadata?.featuring ?? [];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'MusicAlbum',
  name: release.title,
  byArtist: { '@type': 'MusicGroup', name: artistName },
  datePublished: release.release_date,
  genre: genreLabels,
  numTracks: release.track_count,
  image: release.cover_url ?? undefined,
};
---

<Layout
  title={`${release.title} — ${artistName}`}
  description={`${typeLabel} de ${artistName}, ${Date.parse(release.release_date) > Date.now() ? 'à paraître le' : 'sorti le'} ${dateLabel}.`}
  image={release.cover_url ?? undefined}
  type="article"
>
  <script type="application/ld+json" slot="json-ld" set:html={JSON.stringify(jsonLd)} />

  <div class="bz-page">
    <a class="back" href="/BARZ-/">← Sorties</a>

    <section class="hero">
      <Cover title={release.title} src={release.cover_url} class="hero-cover" />
      <div class="info">
        <span class="bz-eyebrow">{typeLabel} · {dateLabel}</span>
        <p class="countdown" id="countdown" data-date={release.release_date} hidden></p>
        <h1 class="bz-display">{release.title}</h1>
        <div class="artist">
          {release.artist?.image_url && <img src={release.artist.image_url} alt="" />}
          <span>
            {release.artist ? <a href={`/BARZ-/artiste?a=${release.artist.slug}`}><b>{artistName}</b></a> : <b>{artistName}</b>}
            {featuring.length > 0 && <> avec {featuring.join(', ')}</>}
          </span>
        </div>
        <dl class="facts">
          {release.track_count > 0 && (
            <div><dt>Titres</dt><dd>{release.track_count}</dd></div>
          )}
          <div><dt>Format</dt><dd>{typeLabel}</dd></div>
          {genreLabels.length > 0 && (
            <div><dt>Genre</dt><dd>{genreLabels.join(' · ')}</dd></div>
          )}
          {release.metadata?.label && (
            <div><dt>Label</dt><dd>{release.metadata.label}</dd></div>
          )}
        </dl>
        <div class="actions">
          {release.spotify_url && (
            <a class="bz-btn bz-btn--lime" href={release.spotify_url} target="_blank" rel="noopener">Écouter sur Spotify ↗</a>
          )}
          {release.deezer_url && (
            <a class:list={['bz-btn', release.spotify_url ? 'bz-btn--outline' : 'bz-btn--lime']} href={release.deezer_url} target="_blank" rel="noopener">Écouter sur Deezer ↗</a>
          )}
          {release.apple_music_url && (
            <a class="bz-btn bz-btn--outline" href={release.apple_music_url} target="_blank" rel="noopener">Apple Music ↗</a>
          )}
        </div>
        <div class="shelves" data-release-id={release.id}>
          <button type="button" class="bz-chip" data-shelf="spin_list" aria-pressed="false">+ Spin list</button>
          <button type="button" class="bz-chip" data-shelf="listened" aria-pressed="false">✓ Écouté</button>
        </div>
      </div>
    </section>

    <Player title={release.title} spotifyId={release.spotify_id} appleUrl={release.apple_music_url} deezerUrl={release.deezer_url} />

    <section class="barz" aria-labelledby="barz-title" data-release-id={release.id}>
      <div class="bz-section-head">
        <h2 id="barz-title" class="bz-h2">Les <em>Barz</em></h2>
        <span class="barz-avg" id="barz-avg"></span>
      </div>
      <form class="barz-form" id="barz-form" hidden>
        <label class="bz-field score-field">
          Ta note
          <span class="score-row">
            <input type="range" name="score" min="0" max="10" step="0.5" value="7" />
            <output name="score-out">7.0</output>
          </span>
        </label>
        <label class="bz-field">
          Ton Barz
          <textarea class="bz-input" name="body" maxlength="280" rows="3" placeholder="Ce que tu en as pensé, en une phrase…" required></textarea>
        </label>
        <p class="bz-notice" id="barz-message" hidden></p>
        <button type="submit" class="bz-btn bz-btn--lime bz-btn--small">Publier mon Barz</button>
      </form>
      <a class="bz-notice login-hint" id="barz-login" href="/BARZ-/connexion" hidden>Connecte-toi pour noter cette sortie et écrire ton Barz →</a>
      <div class="barz-list" id="barz-list"></div>
    </section>

    {related.length > 0 && (
      <section class="related" aria-labelledby="related-title">
        <div class="bz-section-head"><h2 id="related-title" class="bz-h2">Dans la même veine</h2></div>
        <div class="bz-tiles">
          {related.map((r) => (
            <AlbumTile
              title={r.title}
              subtitle={releaseSubtitle(r)}
              cover={r.cover_url}
              href={`/BARZ-/releases/${r.slug}`}
            />
          ))}
        </div>
      </section>
    )}
  </div>
</Layout>

<script>
  // Compte à rebours, calculé dans le navigateur (la page est construite à l'avance)
  const countdown = document.getElementById('countdown');
  if (countdown) {
    const days = Math.round((Date.parse(`${countdown.dataset.date}T00:00:00`) - new Date(new Date().toDateString()).getTime()) / 86_400_000);
    if (days > 0) {
      countdown.textContent = days === 1 ? 'Sort demain' : `Sort dans ${days} jours`;
      countdown.hidden = false;
    } else if (days === 0) {
      countdown.textContent = 'Sort aujourd’hui';
      countdown.hidden = false;
    }
  }

  import { barzCardHtml, barzFeed, formatScore, getSession, isOnShelf, loginUrl, saveBarz, setOnShelf, wireBarzActions, authErrorMessage, errorText, type Shelf } from '../../scripts/social';

  const releaseId = document.querySelector<HTMLElement>('.shelves')!.dataset.releaseId!;

  // Spin list / Écouté
  const shelfButtons = document.querySelectorAll<HTMLButtonElement>('[data-shelf]');
  const paintShelf = (button: HTMLButtonElement, on: boolean) => {
    button.classList.toggle('is-active', on);
    button.setAttribute('aria-pressed', String(on));
  };
  shelfButtons.forEach(async (button) => {
    paintShelf(button, await isOnShelf(button.dataset.shelf as Shelf, releaseId));
    button.addEventListener('click', async () => {
      const session = await getSession();
      if (!session) return void (location.href = loginUrl());
      const on = button.getAttribute('aria-pressed') !== 'true';
      paintShelf(button, on);
      try {
        await setOnShelf(button.dataset.shelf as Shelf, releaseId, on);
      } catch (err) {
        paintShelf(button, !on);
        alert(errorText(err));
      }
    });
  });

  // Barz de cette sortie
  const list = document.getElementById('barz-list')!;
  const avg = document.getElementById('barz-avg')!;
  const form = document.getElementById('barz-form') as HTMLFormElement;
  const message = document.getElementById('barz-message')!;
  let myId: string | null = null;

  async function render() {
    try {
      const barz = await barzFeed({ releaseId, limit: 50 });
      list.innerHTML = barz.length
        ? barz.map((b) => barzCardHtml(b, myId, { showRelease: false })).join('')
        : '<p class="bz-empty">Aucun Barz pour l’instant. Sois le premier à donner ton avis.</p>';
      avg.textContent = barz.length
        ? `${formatScore(barz.reduce((sum, b) => sum + Number(b.score), 0) / barz.length)} / 10 · ${barz.length} avis`
        : '';
      const mine = barz.find((b) => b.user_id === myId);
      if (mine) {
        (form.elements.namedItem('score') as HTMLInputElement).value = String(mine.score);
        (form.elements.namedItem('score-out') as HTMLOutputElement).value = formatScore(mine.score);
        (form.elements.namedItem('body') as HTMLTextAreaElement).value = mine.body;
      }
    } catch (err) {
      list.innerHTML = `<p class="bz-empty">${errorText(err)}</p>`;
    }
  }

  getSession().then((session) => {
    myId = session?.user.id ?? null;
    form.hidden = !session;
    const hint = document.getElementById('barz-login') as HTMLAnchorElement;
    hint.hidden = !!session;
    hint.href = loginUrl();
    render();
  });

  form.addEventListener('input', () => {
    (form.elements.namedItem('score-out') as HTMLOutputElement).value = formatScore(Number((form.elements.namedItem('score') as HTMLInputElement).value));
  });

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    const data = new FormData(form);
    const body = String(data.get('body') ?? '').trim();
    if (!body) return;
    try {
      await saveBarz(releaseId, Number(data.get('score')), body);
      message.hidden = true;
      render();
    } catch (err) {
      message.textContent = errorText(err);
      message.className = 'bz-notice bz-notice--error';
      message.hidden = false;
    }
  });

  wireBarzActions(list, render);
</script>

<style>
  .countdown {
    display: inline-block;
    margin-top: 14px;
    padding: 8px 14px;
    border-radius: 999px;
    background: var(--color-accent);
    color: var(--color-on-accent);
    font: 700 13px/1 var(--font-sans);
    letter-spacing: 0.04em;
  }

  .back {
    display: inline-block;
    margin-bottom: 36px;
    font-weight: 600;
    color: var(--color-text-muted) !important;
  }

  .back:hover {
    color: var(--color-text) !important;
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(260px, 440px) minmax(0, 1fr);
    gap: 56px;
    align-items: end;
  }

  .hero :global(.hero-cover) {
    border-radius: 14px;
    box-shadow: 0 40px 80px -30px rgba(20, 26, 46, 0.35);
  }

  .hero :global(.hero-cover .cover-title) {
    font-size: 40px;
  }

  .info .bz-eyebrow::first-letter {
    text-transform: uppercase;
  }

  .artist {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 24px;
    font-size: 20px;
    color: var(--color-text-muted);
  }

  .artist b {
    color: var(--color-text);
  }

  .artist img {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    object-fit: cover;
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 40px;
    margin-top: 36px;
    padding-top: 24px;
    border-top: 1px solid var(--color-border);
  }

  .facts dt {
    font: 600 12px/1 var(--font-sans);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .facts dd {
    margin-top: 10px;
    font: 400 30px/1 var(--font-serif);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 36px;
  }

  .actions .bz-btn--outline {
    padding: 14px 22px;
    font-size: 16px;
  }

  .shelves {
    display: flex;
    gap: 8px;
    margin-top: 16px;
  }

  .barz {
    margin-top: 88px;
  }

  .barz-avg {
    font-weight: 700;
    color: var(--color-accent);
  }

  .barz-form {
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr);
    gap: 20px 28px;
    align-items: start;
    margin-bottom: 32px;
    padding: 28px;
    border: 1px solid var(--color-border);
    border-radius: 22px;
  }

  .barz-form .bz-notice,
  .barz-form .bz-btn {
    grid-column: 2;
    justify-self: start;
  }

  .score-row {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .score-row input {
    flex: 1;
    accent-color: var(--color-accent);
  }

  .score-row output {
    font: 400 40px/1 var(--font-serif);
    color: var(--color-accent);
  }

  .login-hint {
    display: block;
    margin-bottom: 28px;
    color: var(--color-accent) !important;
    font-weight: 600;
  }

  .barz-form[hidden],
  .login-hint[hidden] {
    display: none;
  }

  .related {
    margin-top: 88px;
  }

  @media (max-width: 900px) {
    .barz-form {
      grid-template-columns: minmax(0, 1fr);
      padding: 20px;
    }
    .barz-form .bz-notice,
    .barz-form .bz-btn {
      grid-column: 1;
    }
  }

  @media (max-width: 1100px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
    }
    .hero :global(.hero-cover) {
      max-width: 420px;
    }
  }
</style>
