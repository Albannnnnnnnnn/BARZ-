---
// FICHE RELEASE DÉTAILLÉE
import Layout from '../../layouts/Layout.astro';
import { getSupabaseServerSafe, ReleaseWithArtist } from '../../lib/supabase';
import { formatDate, formatDuration, getReleaseTypeLabel, getReleaseTypeColor, getGenreColor, slugify, getOptimizedImageUrl, createArtistUrl } from '../../lib/utils';
import { RELEASE_TYPE_LABELS } from '../../lib/utils';

export async function getStaticPaths() {
  let paths: { params: { slug: string } }[] = [];
  try {
    const supabase = getSupabaseServerSafe();
    if (supabase) {
      const { data: releases } = await supabase
        .from('releases')
        .select('slug')
        .limit(1000);
      paths = (releases || []).map((r: any) => ({ params: { slug: r.slug } }));
    }
  } catch (e) {
    console.warn('Supabase not configured, no static paths for releases');
  }
  return paths;
}

const { slug } = Astro.params;
const supabase = getSupabaseServerSafe();

let release: ReleaseWithArtist | null = null;
let error: any = null;

if (supabase) {
  try {
    const { data, error: err } = await supabase
      .from('releases')
      .select(`
        *,
        artist:artists!artist_id(*),
        label:labels!label_id(*)
      `)
      .eq('slug', slug)
      .single();
    release = data as ReleaseWithArtist | null;
    error = err;
  } catch (e) {
    console.warn('Supabase query failed:', e);
    error = e;
  }
} else {
  console.warn('Supabase not configured, release data unavailable');
}

if (error || !release) {
  return Astro.redirect('/404');
}

const typedRelease = release as ReleaseWithArtist;

// JSON-LD pour SEO
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "MusicAlbum",
  "name": typedRelease.title,
  "byArtist": {
    "@type": "MusicGroup",
    "name": typedRelease.artist?.name || "Unknown Artist",
  },
  "datePublished": typedRelease.release_date,
  "genre": typedRelease.genres,
  "numTracks": typedRelease.track_count,
  "image": typedRelease.cover_url,
  "url": new URL(Astro.url.pathname, Astro.site).toString(),
};
---

<Layout
  title={`${typedRelease.title} - ${typedRelease.artist?.name} | BARZ`}
  description={`${getReleaseTypeLabel(typedRelease.release_type)} de ${typedRelease.artist?.name} sorti le ${formatDate(typedRelease.release_date)}. ${typedRelease.track_count} titres, ${typedRelease.genres.join(', ')}.`}
  image={typedRelease.cover_url || '/og-default.jpg'}
  type="article"
>
  <slot name="json-ld">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </slot>

  <article class="container section">
    <!-- Header avec cover -->
    <header class="mb-10 grid md:grid-cols-[300px_1fr] gap-8 items-start">
      <div class="relative aspect-square max-w-xs mx-auto md:mx-0" style={{ borderRadius: 'var(--radius-xl)', overflow: 'hidden' }}>
        <img
          src={getOptimizedImageUrl(typedRelease.cover_url, 600)}
          alt={`Couverture de ${typedRelease.title}`}
          class="w-full h-full object-cover"
          loading="eager"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-[var(--color-bg)]/90 to-transparent bottom-0" aria-hidden="true" />
      </div>

      <div>
        <div class="flex flex-wrap gap-2 mb-4">
          <span class="badge badge-type" style={{
            background: `${getReleaseTypeColor(typedRelease.release_type)}20`,
            color: getReleaseTypeColor(typedRelease.release_type),
            borderColor: `${getReleaseTypeColor(typedRelease.release_type)}40`,
          }}>
            {RELEASE_TYPE_LABELS[typedRelease.release_type]}
          </span>
          <time class="badge badge-genre" dateTime={typedRelease.release_date} style={{ background: 'var(--color-bg-hover)', color: 'var(--color-text-muted)', borderColor: 'var(--color-border)' }}>
            {formatDate(typedRelease.release_date, 'd MMMM yyyy')}
          </time>
        </div>

        <h1 class="text-3xl md:text-4xl font-bold mb-2" style="letter-spacing: -0.02em; color: var(--color-text);">
          {typedRelease.title}
        </h1>

        <p class="text-xl mb-4" style="color: var(--color-text-muted);">
          <a href={createArtistUrl(typedRelease.artist?.slug || '')} class="hover:underline" style="color: var(--color-text);">
            {typedRelease.artist?.name}
          </a>
        </p>

        {typedRelease.label && (
          <p class="text-sm text-dim mb-4">
            Label: <a href={`/labels/${typedRelease.label.slug}`} class="hover:underline">{typedRelease.label.name}</a>
          </p>
        )}

        <div class="flex flex-wrap gap-2 mb-6">
          {typedRelease.genres.map((genre) => (
            <span key={genre} class="badge badge-genre" style={{ background: `${getGenreColor(genre)}20`, color: getGenreColor(genre), borderColor: `${getGenreColor(genre)}40` }}>
              {genre}
            </span>
          ))}
        </div>

        <div class="flex flex-wrap gap-3 text-sm text-muted">
          {typedRelease.track_count > 0 && (
            <span class="flex items-center gap-1">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" aria-hidden="true">
                <path d="M9 18V5l12-2v13" />
                <circle cx="6" cy="18" r="3" />
                <circle cx="18" cy="16" r="3" />
              </svg>
              {typedRelease.track_count} titre{typedRelease.track_count > 1 ? 's' : ''}
            </span>
          )}
          {typedRelease.total_duration_ms && (
            <span class="flex items-center gap-1">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" aria-hidden="true">
                <circle cx="12" cy="12" r="10" />
                <path d="M12 6v6l4 2" />
              </svg>
              {formatDuration(typedRelease.total_duration_ms)}
            </span>
          )}
        </div>

        <!-- Liens streaming -->
        <div class="flex flex-wrap gap-2 mt-6">
          {typedRelease.spotify_url && (
            <a href={typedRelease.spotify_url} target="_blank" rel="noopener" class="btn btn-secondary btn-sm flex items-center gap-2" style={{ background: '#1DB95420', borderColor: '#1DB95460', color: '#1DB954' }}>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="#1DB954" aria-hidden="true">
                <path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm5.521 17.34c-.24.359-.66.38-1.021.04-2.416-2.393-4.473-4.98-5.786-7.754-.131-.277-.07-.617.136-.825.236-.235.576-.238.812.022 1.526 3.187 3.926 6.12 6.847 7.517.24.11.3.41.138.671z" />
              </svg>
              Spotify
            </a>
          )}
          {typedRelease.apple_music_url && (
            <a href={typedRelease.apple_music_url} target="_blank" rel="noopener" class="btn btn-secondary btn-sm flex items-center gap-2" style={{ background: '#FA233B20', borderColor: '#FA233B60', color: '#FA233B' }}>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="#FA233B" aria-hidden="true">
                <path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm5.991 14.133c-.597.348-1.346.399-1.882.122-.904-.468-1.95-1.37-2.867-2.708C11.585 10.61 10.32 9.447 8.697 8.46c-.225-.136-.49-.104-.67.073-.275.26-.355.65-.187 1.022 1.005 2.204 1.96 4.452 2.539 6.571.057.21.264.35.472.31.366-.073.562-.418.485-.699zM19.438 5.817c-.535-.267-1.17-.212-1.6.112-.959.72-2.257 1.81-3.527 3.177-1.547 1.663-3.156 3.464-4.65 5.353-.153.194-.404.22-.605.068-.23-.17-.29-.503-.137-.735 1.302-1.99 2.707-4.053 4.102-6.18.138-.21.368-.3.576-.187.439.25.565.706.33.973z" />
              </svg>
              Apple Music
            </a>
          )}
          {typedRelease.deezer_url && (
            <a href={typedRelease.deezer_url} target="_blank" rel="noopener" class="btn btn-secondary btn-sm flex items-center gap-2" style={{ background: '#FF660020', borderColor: '#FF660060', color: '#FF6600' }}>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="#FF6600" aria-hidden="true">
                <path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm6.364 13.485c-.371.364-.935.483-1.502.244-.538-.227-1.014-.66-1.314-1.233-.62-.245-1.267-.235-1.8.06-.622.32-1.188.82-1.59 1.5-.676 1.147-.79 2.565-.408 3.803.525 1.7 2.122 2.945 3.878 2.676.767-.123 1.287-.734 1.478-1.464.175-.673-.167-1.295-.828-1.623z" />
              </svg>
              Deezer
            </a>
          )}
          {typedRelease.youtube_url && (
            <a href={typedRelease.youtube_url} target="_blank" rel="noopener" class="btn btn-secondary btn-sm flex items-center gap-2" style={{ background: '#FF000020', borderColor: '#FF000060', color: '#FF0000' }}>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="#FF0000" aria-hidden="true">
                <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z" />
              </svg>
              YouTube
            </a>
          )}
        </div>
      </div>
    </header>

    <!-- Tracklist (si disponible dans metadata) -->
    {typedRelease.metadata && typedRelease.metadata.spotify && (
      <section class="mb-12" aria-labelledby="tracklist-heading">
        <h2 id="tracklist-heading" class="text-2xl font-bold mb-6" style="color: var(--color-text);">Tracklist</h2>
        <div class="card overflow-hidden">
          {typedRelease.metadata.spotify.tracks?.items?.map((track: any, index: number) => (
            <div key={track.id} class="flex items-center gap-4 px-4 py-3 border-b last:border-0 hover:bg-[var(--color-bg-hover)] transition" style={{ borderColor: 'var(--color-border)' }}>
              <span class="text-dim font-mono w-8 text-right">{index + 1}.</span>
              <div class="flex-1 min-w-0">
                <p class="font-medium truncate" style={{ color: 'var(--color-text)' }}>{track.name}</p>
                {track.artists?.length > 1 && (
                  <p class="text-sm text-muted truncate">
                    {track.artists.map((a: any) => a.name).join(', ')}
                  </p>
                )}
              </div>
              <span class="text-sm text-dim whitespace-nowrap">{formatDuration(track.duration_ms)}</span>
              {track.external_urls?.spotify && (
                <a href={track.external_urls.spotify} target="_blank" rel="noopener" class="text-sm" style={{ color: '#1DB954' }} aria-label="Écouter sur Spotify">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="#1DB954" aria-hidden="true">
                    <path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm5.521 17.34c-.24.359-.66.38-1.021.04-2.416-2.393-4.473-4.98-5.786-7.754-.131-.277-.07-.617.136-.825.236-.235.576-.238.812.022 1.526 3.187 3.926 6.12 6.847 7.517.24.11.3.41.138.671z" />
                  </svg>
                </a>
              )}
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Infos additionnelles -->
    <section class="grid md:grid-cols-2 gap-6 mb-12">
      <div class="card p-6">
        <h3 class="font-semibold mb-4" style={{ color: 'var(--color-text)' }}>Informations</h3>
        <dl class="space-y-3 text-sm">
          <div class="flex justify-between">
            <dt class="text-muted">Type</dt>
            <dd style={{ color: 'var(--color-text)' }}>{RELEASE_TYPE_LABELS[typedRelease.release_type]}</dd>
          </div>
          <div class="flex justify-between">
            <dt class="text-muted">Date de sortie</dt>
            <dd style={{ color: 'var(--color-text)' }}>{formatDate(typedRelease.release_date, 'EEEE d MMMM yyyy')}</dd>
          </div>
          {typedRelease.label && (
            <div class="flex justify-between">
              <dt class="text-muted">Label</dt>
              <dd style={{ color: 'var(--color-text)' }}><a href={`/labels/${typedRelease.label.slug}`} class="hover:underline">{typedRelease.label.name}</a></dd>
            </div>
          )}
          {typedRelease.mbid && (
            <div class="flex justify-between">
              <dt class="text-muted">MusicBrainz ID</dt>
              <dd class="font-mono text-xs"><a href={`https://musicbrainz.org/release-group/${typedRelease.mbid}`} target="_blank" rel="noopener" class="hover:underline">{typedRelease.mbid}</a></dd>
            </div>
          )}
        </dl>
      </div>

      <div class="card p-6">
        <h3 class="font-semibold mb-4" style={{ color: 'var(--color-text)' }}>{typedRelease.artist?.name}</h3>
        {typedRelease.artist && (
          <div class="space-y-3 text-sm">
            {typedRelease.artist.genres?.length && (
              <div>
                <dt class="text-muted mb-1">Genres</dt>
                <div class="flex flex-wrap gap-1.5">
                  {typedRelease.artist.genres.map((genre: string) => (
                    <span key={genre} class="badge badge-genre text-xs" style={{ background: `${getGenreColor(genre)}20`, color: getGenreColor(genre), borderColor: `${getGenreColor(genre)}40` }}>
                      {genre}
                    </span>
                  ))}
                </div>
              </div>
            )}
            {typedRelease.artist.popularity && (
              <div class="flex justify-between">
                <dt class="text-muted">Popularité (Last.fm)</dt>
                <dd style={{ color: 'var(--color-text)' }}>{typedRelease.artist.popularity.toLocaleString()} listeners</dd>
              </div>
            )}
            <div class="flex justify-between">
              <dt class="text-muted">Voir la fiche artiste</dt>
              <dd><a href={createArtistUrl(typedRelease.artist.slug)} class="btn btn-secondary btn-sm">Ouvrir</a></dd>
            </div>
          </div>
        )}
      </div>
    </section>

    <!-- Artistes similaires / même label / même genre -->
    <section>
      <h2 class="text-2xl font-bold mb-6" style="color: var(--color-text);">À découvrir aussi</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4" id="related-releases">
        <p class="text-muted text-center py-8 col-span-3">Chargement...</p>
      </div>
    </section>
  </article>

  <script>
    // Charger les releases liées (même artiste, même label, même genres)
    async function loadRelated() {
      try {
        const params = new URLSearchParams();
        if (typedRelease.artist_id) params.set('artist_id', typedRelease.artist_id);
        if (typedRelease.label_id) params.set('label_id', typedRelease.label_id);
        if (typedRelease.genres?.length) params.set('genres', typedRelease.genres.slice(0, 2).join(','));
        params.set('exclude', typedRelease.id);
        params.set('limit', '6');

        const res = await fetch(`/api/releases/related?${params}`);
        const data = await res.json();

        const container = document.getElementById('related-releases');
        if (data.releases?.length > 0) {
          container.innerHTML = data.releases.map((r: any) => `
            <a href="/releases/${r.slug}" class="card card-interactive overflow-hidden p-0" style="min-height: 280px;">
              <img src="${r.cover_url || '/placeholder-release.svg'}" alt="" loading="lazy" class="w-full h-48 object-cover" />
              <div class="p-4">
                <p class="font-medium truncate" style="color: var(--color-text);">${r.title}</p>
                <p class="text-sm text-muted truncate mt-1">${r.artist?.name}</p>
                <div class="flex flex-wrap gap-1 mt-2">
                  ${(r.genres || []).slice(0, 2).map((g: string) => `<span class="badge badge-genre text-xs" style="background: ${getGenreColor(g)}20; color: ${getGenreColor(g)}; border-color: ${getGenreColor(g)}40;">${g}</span>`).join('')}
                </div>
              </div>
            </a>
          `).join('');
        } else {
          container.innerHTML = '<p class="text-muted text-center py-8 col-span-3">Aucune sortie liée trouvée</p>';
        }
      } catch (e) {
        console.error('Failed to load related releases:', e);
        document.getElementById('related-releases').innerHTML = '<p class="text-muted text-center py-8 col-span-3">Erreur de chargement</p>';
      }
    }

    // Utilitaire pour couleur genre (dupliqué côté client)
    function getGenreColor(genre: string) {
      const colors: Record<string, string> = {
        'hip-hop': '#e11d48', 'rap': '#e11d48', 'rnb': '#db2777', 'pop': '#f97316',
        'rock': '#ef4444', 'alternative': '#8b5cf6', 'indie': '#a855f7',
        'electronic': '#06b6d4', 'house': '#06b6d4', 'techno': '#06b6d4', 'ambient': '#6366f1',
        'jazz': '#84cc16', 'blues': '#3b82f6', 'classical': '#64748b', 'folk': '#f59e0b',
        'country': '#f97316', 'reggae': '#22c55e', 'metal': '#78716c', 'punk': '#ef4444',
        'soul': '#ec4899', 'funk': '#f97316', 'world': '#14b8a6', 'latin': '#eab308',
        'experimental': '#a855f7', 'soundtrack': '#64748b',
      };
      return colors[genre.toLowerCase()] || '#71717a';
    }

    loadRelated();
  </script>
</Layout>