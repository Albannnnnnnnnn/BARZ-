---
// JEU DU JOUR « POCHETTE FLOUE » : une pochette très floue qui se précise à chaque essai, 6 essais pour trouver l'album.
// La même pour tout le monde chaque jour (fonction supabase/functions/cover-game) ; résultats dans game_results
// (supabase/daily-games.sql) pour la série de jours et le classement entre amis.
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Pochette floue" description="Le jeu du jour de BARZ¡ : retrouve l’album derrière la pochette floue, en 6 essais.">
  <div class="bz-page game">
    <a class="back" href="/BARZ-/jeux">← Jeux</a>
    <span class="bz-eyebrow">Jeu du jour <span id="g-number"></span></span>
    <h1 class="bz-display">Pochette <em>floue.</em></h1>
    <p class="intro">Retrouve l’album. Chaque essai rend la pochette un peu plus nette.</p>

    <p class="status" id="g-status">Chargement de la pochette du jour…</p>

    <div class="board" id="g-board" hidden>
      <div class="cover-frame">
        <img id="g-cover" alt="Pochette à deviner" referrerpolicy="no-referrer" />
      </div>

      <div class="side">
        <ol class="tries" id="g-tries" aria-label="Tes essais"></ol>
        <ul class="hints" id="g-hints"></ul>

        <form class="guess" id="g-form" autocomplete="off">
          <label class="sr-only" for="g-input">Ta réponse</label>
          <input id="g-input" type="search" placeholder="Titre de l’album ou artiste…" maxlength="80" />
          <ul class="suggestions" id="g-suggestions" role="listbox" hidden></ul>
          <button type="button" class="skip" id="g-skip">Passer (dévoile un peu plus)</button>
        </form>

        <div class="end" id="g-end" hidden>
          <p class="verdict" id="g-verdict"></p>
          <p class="answer" id="g-answer"></p>
          <div class="end-actions">
            <button type="button" class="bz-btn bz-btn--lime" id="g-share">Partager mon résultat</button>
            <a class="bz-btn bz-btn--outline" id="g-listen" target="_blank" rel="noopener">Écouter sur Deezer ↗</a>
          </div>
          <p class="streak" id="g-streak" hidden></p>
          <p class="login" id="g-login" hidden><a href="/BARZ-/connexion">Connecte-toi</a> pour garder ta série de jours et te comparer à tes amis.</p>
          <p class="next">Nouvelle pochette demain à minuit.</p>
        </div>
      </div>
    </div>

    <section class="friends" id="g-friends" hidden>
      <h2 class="bz-h2">Tes amis <em>aujourd’hui</em></h2>
      <ul id="g-friends-list"></ul>
    </section>
  </div>
</Layout>

<script>
  import { escapeHtml, getSession, myFriendships, supabase } from '../../scripts/social';

  const MAX = 6;
  const BLUR = [28, 18, 11, 6, 3, 1.5]; // en pixels, selon le nombre d'essais déjà faits
  const SITE = 'https://albannnnnnnnnn.github.io/BARZ-/jeux/pochette';

  type Result = 'miss' | 'artist' | 'found' | 'skip';
  type Try = { title: string; artist: string; result: Result };
  type State = { tries: Try[]; done: boolean; won: boolean; saved?: boolean; cover?: string };
  type Today = { day: string; number: number; cover: string; hints: { year: string; genre: string | null; initial: string } };
  type Answer = { title: string; artist: string; year: string; cover: string; link: string };

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const status = $('g-status');
  const cover = $<HTMLImageElement>('g-cover');
  const input = $<HTMLInputElement>('g-input');
  const suggestions = $('g-suggestions');

  let today: Today;
  let state: State = { tries: [], done: false, won: false };
  let busy = false;

  const call = async <T,>(body: Record<string, unknown>): Promise<T> => {
    const { data, error } = await supabase!.functions.invoke('cover-game', { body });
    if (error || data?.error) throw new Error(data?.error ?? 'Le jeu ne répond pas. Réessaie dans un moment.');
    return data as T;
  };

  // Partie en cours gardée sur l'appareil : on peut fermer la page et revenir
  const storeKey = () => `barz-pochette-${today.day}`;
  const load = (): State | null => {
    try {
      const raw = localStorage.getItem(storeKey());
      return raw ? JSON.parse(raw) : null;
    } catch {
      return null;
    }
  };
  const store = () => {
    try {
      localStorage.setItem(storeKey(), JSON.stringify(state));
    } catch {
      // stockage bloqué : la partie reste valable tant que la page est ouverte
    }
  };

  const SQUARE: Record<Result, string> = { miss: '🟥', skip: '⬛', artist: '🟨', found: '🟩' };
  const LABEL: Record<Result, string> = { miss: 'raté', skip: 'passé', artist: 'bon artiste', found: 'trouvé' };

  function render() {
    const n = state.tries.length;
    cover.style.filter = state.done ? 'none' : `blur(${BLUR[Math.min(n, MAX - 1)]}px)`;
    $('g-tries').innerHTML = Array.from({ length: MAX }, (_, i) => {
      const t = state.tries[i];
      if (!t) return `<li class="try is-empty"><span>${i + 1}</span></li>`;
      const what = t.result === 'skip' ? 'Passé' : `${escapeHtml(t.title)} <small>${escapeHtml(t.artist)}</small>`;
      return `<li class="try is-${t.result}" aria-label="Essai ${i + 1} : ${LABEL[t.result]}"><b aria-hidden="true">${SQUARE[t.result]}</b><span>${what}</span></li>`;
    }).join('');

    // Indices : l'année après 2 essais ratés, le genre après 3, l'initiale de l'artiste après 4
    const misses = state.tries.filter((t) => t.result !== 'found').length;
    const hints = [
      misses >= 2 && today.hints.year && `Sorti en <b>${escapeHtml(today.hints.year)}</b>`,
      misses >= 3 && today.hints.genre && `Genre : <b>${escapeHtml(today.hints.genre)}</b>`,
      misses >= 4 && `L’artiste commence par <b>${escapeHtml(today.hints.initial)}</b>`,
    ].filter(Boolean);
    $('g-hints').innerHTML = state.done ? '' : hints.map((h) => `<li>💡 ${h}</li>`).join('');

    $('g-form').hidden = state.done;
    $('g-end').hidden = !state.done;
  }

  async function finish() {
    const answer = await call<Answer>({ action: 'answer' });
    const n = state.tries.length;
    $('g-verdict').textContent = state.won ? (n === 1 ? 'Du premier coup. Respect.' : `Trouvé en ${n} essais !`) : 'Raté pour aujourd’hui.';
    $('g-answer').innerHTML = `<b>${escapeHtml(answer.title)}</b> · ${escapeHtml(answer.artist)}${answer.year ? ` (${escapeHtml(answer.year)})` : ''}`;
    $<HTMLAnchorElement>('g-listen').href = answer.link;
    cover.src = answer.cover;
    render();
    await saveResult();
    showSocial();
  }

  // Résultat enregistré pour les membres connectés (une seule fois par jour, refusé ensuite par la base)
  async function saveResult() {
    const session = await getSession();
    if (!session) {
      $('g-login').hidden = false;
      return;
    }
    if (state.saved) return;
    await supabase!.from('game_results').insert({ user_id: session.user.id, game: 'pochette', day: today.day, solved: state.won, attempts: state.tries.length });
    state.saved = true;
    store();
  }

  // Série de jours joués d'affilée, et les parties des amis du jour
  async function showSocial() {
    const session = await getSession();
    if (!session) return;
    const { data: mine } = await supabase!.from('game_results').select('day').eq('user_id', session.user.id).eq('game', 'pochette').order('day', { ascending: false }).limit(400);
    const days = new Set((mine ?? []).map((r) => r.day as string));
    let streak = 0;
    for (let d = new Date(`${today.day}T12:00:00`); days.has(d.toISOString().slice(0, 10)); d.setDate(d.getDate() - 1)) streak++;
    if (streak > 0) {
      $('g-streak').textContent = streak === 1 ? '🔥 Premier jour de ta série. Reviens demain !' : `🔥 ${streak} jours d’affilée`;
      $('g-streak').hidden = false;
    }

    const friends = (await myFriendships()).filter((f) => f.status === 'friends').map((f) => f.profile);
    if (!friends.length) return;
    const { data: results } = await supabase!
      .from('game_results')
      .select('user_id, solved, attempts')
      .eq('game', 'pochette')
      .eq('day', today.day)
      .in('user_id', friends.map((f) => f.id));
    const byId = new Map((results ?? []).map((r) => [r.user_id as string, r]));
    const rows = friends
      .map((f) => ({ f, r: byId.get(f.id) }))
      .sort((a, b) => (a.r ? (a.r.solved ? a.r.attempts : 10) : 20) - (b.r ? (b.r.solved ? b.r.attempts : 10) : 20));
    $('g-friends-list').innerHTML = rows
      .map(({ f, r }) => {
        const score = !r ? '<span class="muted">Pas encore joué</span>' : r.solved ? `<b>${r.attempts}/${MAX}</b>` : `<b>X/${MAX}</b>`;
        return `<li><a href="/BARZ-/profil?u=${encodeURIComponent(f.username)}">${escapeHtml(f.display_name || f.username)}</a>${score}</li>`;
      })
      .join('');
    $('g-friends').hidden = false;
  }

  async function guess(t: { id?: number; title: string; artist: string } | null) {
    if (busy || state.done) return;
    busy = true;
    suggestions.hidden = true;
    try {
      let result: Result = 'skip';
      if (t) {
        const verdict = await call<{ correct: boolean; sameArtist: boolean }>({ action: 'guess', ...t });
        result = verdict.correct ? 'found' : verdict.sameArtist ? 'artist' : 'miss';
      }
      state.tries.push({ title: t?.title ?? '', artist: t?.artist ?? '', result });
      state.won = result === 'found';
      state.done = state.won || state.tries.length >= MAX;
      input.value = '';
      store();
      render();
      if (state.done) await finish();
    } catch (err) {
      alert(err instanceof Error ? err.message : String(err));
    } finally {
      busy = false;
    }
  }

  // Propositions : albums Deezer qui correspondent à ce qui est tapé
  let timer: number | undefined;
  let lastQuery = '';
  input.addEventListener('input', () => {
    clearTimeout(timer);
    const q = input.value.trim();
    if (q.length < 2) {
      suggestions.hidden = true;
      return;
    }
    timer = window.setTimeout(async () => {
      lastQuery = q;
      const { results } = await call<{ results: { id: number; title: string; artist: string; cover: string | null }[] }>({ action: 'search', q }).catch(() => ({ results: [] }));
      if (q !== lastQuery || input.value.trim() !== q) return;
      suggestions.innerHTML = results.length
        ? results
            .map(
              (r) =>
                `<li><button type="button" role="option" data-id="${r.id}" data-title="${escapeHtml(r.title)}" data-artist="${escapeHtml(r.artist)}">${r.cover ? `<img src="${escapeHtml(r.cover)}" alt="" referrerpolicy="no-referrer" />` : ''}<span><b>${escapeHtml(r.title)}</b><small>${escapeHtml(r.artist)}</small></span></button></li>`
            )
            .join('')
        : '<li class="none">Aucun album trouvé. Essaie avec l’artiste.</li>';
      suggestions.hidden = false;
    }, 300);
  });
  suggestions.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-id]');
    if (b) guess({ id: Number(b.dataset.id), title: b.dataset.title!, artist: b.dataset.artist! });
  });
  $('g-form').addEventListener('submit', (e) => {
    e.preventDefault();
    suggestions.querySelector<HTMLButtonElement>('button[data-id]')?.click();
  });
  $('g-skip').addEventListener('click', () => guess(null));

  $('g-share').addEventListener('click', async () => {
    const line = state.tries.map((t) => SQUARE[t.result]).join('');
    const text = `BARZ¡ · Pochette floue n° ${today.number}\n${line} ${state.won ? state.tries.length : 'X'}/${MAX}\n${SITE}`;
    try {
      if (navigator.share) await navigator.share({ text });
      else {
        await navigator.clipboard.writeText(text);
        $('g-share').textContent = 'Copié !';
      }
    } catch {
      // partage annulé
    }
  });

  if (!supabase) {
    status.textContent = 'Le jeu n’est pas disponible pour le moment.';
  } else {
    call<Today>({ action: 'today' })
      .then(async (t) => {
        today = t;
        $('g-number').textContent = `· n° ${t.number}`;
        // Une partie gardée pour une autre pochette (pochette du jour remplacée) ne compte pas
        const kept = load();
        state = kept && kept.cover === t.cover ? kept : { ...state, cover: t.cover };
        cover.src = t.cover;
        status.hidden = true;
        $('g-board').hidden = false;
        render();
        if (state.done) await finish();
      })
      .catch((err) => {
        status.textContent = err instanceof Error ? err.message : String(err);
      });
  }
</script>

<style is:global>
  /* Global, mais limité au jeu : le script ajoute les essais et les propositions après coup */
  .game .back {
    display: inline-block;
    margin-bottom: 18px;
    font-size: 14px;
    color: var(--color-text-muted);
  }

  .game .intro {
    margin-top: 8px;
    color: var(--color-text-muted);
  }

  .game .status {
    margin-top: 28px;
    color: var(--color-text-muted);
  }

  .game .board {
    display: grid;
    grid-template-columns: minmax(0, 420px) minmax(0, 1fr);
    gap: 40px;
    align-items: start;
    margin-top: 28px;
  }

  .game .board[hidden] {
    display: none;
  }

  .game .cover-frame {
    overflow: hidden;
    aspect-ratio: 1 / 1;
    border-radius: var(--radius-lg);
    background: var(--color-bg-surface);
    box-shadow: 0 18px 50px rgba(20, 26, 46, 0.18);
  }

  .game .cover-frame img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.08); /* cache le bord clair que fait le flou */
    transition: filter 0.6s ease;
  }

  .game .tries {
    display: grid;
    gap: 6px;
    padding: 0;
    list-style: none;
  }

  .game .try {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    padding: 8px 12px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-paper);
    font-size: 15px;
  }

  .game .try span {
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .game .try small {
    margin-left: 6px;
    color: var(--color-text-muted);
  }

  .game .try.is-empty {
    border-style: dashed;
    background: transparent;
    color: var(--color-text-dim);
  }

  .game .try.is-found {
    border-color: #3f9a5b;
  }

  .game .try.is-artist {
    border-color: var(--color-sand);
  }

  .game .hints {
    display: grid;
    gap: 4px;
    margin: 14px 0 0;
    padding: 0;
    list-style: none;
    font-size: 15px;
  }

  .game .guess {
    position: relative;
    margin-top: 18px;
  }

  .game .guess[hidden] {
    display: none;
  }

  .game .guess input {
    width: 100%;
    height: 50px;
    padding: 0 16px;
    border: 1px solid var(--color-border-hover);
    border-radius: var(--radius-full);
    background: var(--color-paper);
    color: var(--color-text);
    font: 500 16px var(--font-sans);
  }

  .game .suggestions {
    position: absolute;
    z-index: 5;
    top: 56px;
    left: 0;
    right: 0;
    max-height: 340px;
    overflow-y: auto;
    margin: 0;
    padding: 6px;
    list-style: none;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-paper);
    box-shadow: 0 14px 40px rgba(20, 26, 46, 0.16);
  }

  .game .suggestions[hidden] {
    display: none;
  }

  .game .suggestions button {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    padding: 8px;
    border: 0;
    border-radius: var(--radius-sm);
    background: none;
    color: var(--color-text);
    text-align: left;
    cursor: pointer;
  }

  .game .suggestions button:hover,
  .game .suggestions button:focus-visible {
    background: var(--color-bg-hover);
  }

  .game .suggestions img {
    width: 40px;
    height: 40px;
    border-radius: 4px;
  }

  .game .suggestions span {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .game .suggestions b,
  .game .suggestions small {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .game .suggestions small {
    color: var(--color-text-muted);
  }

  .game .suggestions .none {
    padding: 10px;
    color: var(--color-text-muted);
  }

  .game .skip {
    margin-top: 10px;
    padding: 6px 0;
    border: 0;
    background: none;
    color: var(--color-text-muted);
    font: 500 14px var(--font-sans);
    text-decoration: underline;
    cursor: pointer;
  }

  .game .end[hidden] {
    display: none;
  }

  .game .end {
    margin-top: 22px;
  }

  .game .verdict {
    font: 900 26px/1.1 var(--font-display);
    font-stretch: 110%;
  }

  .game .answer {
    margin-top: 6px;
    font-size: 17px;
  }

  .game .end-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 18px;
  }

  .game .streak {
    margin-top: 16px;
    font-weight: 600;
  }

  .game .login,
  .game .next {
    margin-top: 12px;
    font-size: 14px;
    color: var(--color-text-muted);
  }

  .game .friends {
    margin-top: 48px;
  }

  .game .friends ul {
    display: grid;
    gap: 6px;
    max-width: 520px;
    margin-top: 14px;
    padding: 0;
    list-style: none;
  }

  .game .friends li {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 14px;
    border-radius: var(--radius-md);
    background: var(--color-paper);
  }

  .game .muted {
    color: var(--color-text-muted);
  }

  @media (max-width: 760px) {
    .game .board {
      grid-template-columns: minmax(0, 1fr);
      gap: 22px;
    }
    .game .cover-frame {
      max-width: 340px;
      width: 100%;
      margin: 0 auto;
    }
  }
</style>
