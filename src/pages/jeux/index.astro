---
// RUBRIQUE JEUX : les jeux du jour (parties gardées sur l'appareil par chaque jeu), puis de quoi creuser :
// tous les artistes, un tirage au hasard, et la page Explorer (curseur d'exploration et Rabbit Hole, src/pages/search.astro)
import Layout from '../../layouts/Layout.astro';

const GAMES = [
  { id: 'pochette', href: '/BARZ-/jeux/pochette', title: 'Pochette floue', text: 'Retrouve l’album derrière la pochette floue, en 6 essais.' },
  { id: 'artiste', href: '/BARZ-/jeux/artiste', title: 'L’artiste mystère', text: 'Devine l’artiste du jour grâce à son genre, son pays, son premier album…' },
];
---

<Layout title="Jeux" description="Les jeux musicaux du jour sur BARZ¡ : Pochette floue et L’artiste mystère.">
  <div class="bz-page">
    <span class="bz-eyebrow">Jeux du jour</span>
    <h1 class="bz-display">Une minute, <em>deux jeux.</em></h1>
    <p class="intro">Les mêmes pour tout le monde, nouveaux chaque jour à minuit.</p>

    <div class="games">
      {GAMES.map((g) => (
        <a class="game-card" href={g.href} data-game={g.id}>
          <span class={`icon icon--${g.id}`} aria-hidden="true">{g.id === 'artiste' ? '?' : ''}</span>
          <span class="body">
            <b>{g.title}</b>
            <span class="text">{g.text}</span>
            <span class="state" data-state>À jouer aujourd’hui</span>
          </span>
          <span class="go" data-go>Jouer →</span>
        </a>
      ))}
    </div>

    <h2 class="bz-h2 dig-title">Pour <em>creuser</em></h2>
    <nav class="dig" aria-label="Pour creuser">
      <a href="/BARZ-/artistes"><b>Tous les artistes</b><span>Par genre, par audience, ceux que tu suis</span></a>
      <a href="/BARZ-/artistes?tri=hasard"><b>Au hasard</b><span>Un tirage dans tout le catalogue</span></a>
      <a href="/BARZ-/search"><b>Explorer</b><span>Le curseur entre tes habitudes et l’inconnu, et le Rabbit Hole</span></a>
    </nav>
  </div>
</Layout>

<script>
  import { dailyGameStatus } from '../../scripts/daily-games';

  document.querySelectorAll<HTMLElement>('[data-game]').forEach((card) => {
    const status = dailyGameStatus(card.dataset.game as 'pochette' | 'artiste');
    if (!status) return;
    card.classList.add('is-done');
    card.querySelector('[data-state]')!.textContent = status;
    card.querySelector('[data-go]')!.textContent = 'Voir →';
  });
</script>

<style>
  .dig-title {
    margin-top: 44px;
  }

  .dig {
    display: grid;
    max-width: 640px;
    border-top: var(--line);
  }

  .dig a {
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding: 16px 30px 16px 2px;
    border-bottom: var(--line);
    color: var(--color-text);
    position: relative;
  }

  .dig a::after {
    content: '→';
    position: absolute;
    right: 4px;
    top: 50%;
    transform: translateY(-50%);
    font: 800 18px/1 var(--font-display);
  }

  .dig a:hover b {
    color: var(--color-accent);
  }

  .dig b {
    font: 800 15px/1.2 var(--font-display);
    text-transform: uppercase;
  }

  .dig span {
    font-size: 14px;
    color: var(--color-text-muted);
  }

  .intro {
    margin-top: 8px;
    color: var(--color-text-muted);
  }

  .games {
    display: grid;
    gap: 14px;
    max-width: 640px;
    margin-top: 28px;
  }

  .game-card {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 20px;
    border: var(--line);
    border-radius: 14px;
    background: var(--color-paper);
    color: var(--color-text);
    box-shadow: var(--shadow-hard);
  }

  .game-card:hover {
    border-color: var(--color-accent-line);
  }

  /* Vignettes dessinées en CSS : une pochette floue, une silhouette mystère */
  .icon {
    flex-shrink: 0;
    width: 64px;
    height: 64px;
    border: var(--line);
    border-radius: 10px;
    overflow: hidden;
  }

  .icon--pochette {
    background:
      radial-gradient(circle at 30% 35%, #ffd54f 0 18%, transparent 42%),
      radial-gradient(circle at 70% 70%, #ff6e6e 0 20%, transparent 48%),
      var(--color-accent);
    box-shadow: inset 0 0 14px rgba(255, 255, 255, 0.5);
  }

  .icon--artiste {
    display: grid;
    place-items: center;
    background: var(--color-ink);
    color: #fff;
    font: 800 34px/1 var(--font-display);
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .body b {
    font: 800 18px/1.05 var(--font-display);
    text-transform: uppercase;
  }

  .text {
    font-size: 14px;
    color: var(--color-text-muted);
  }

  .state {
    margin-top: 4px;
    font: 600 13px/1.2 var(--font-sans);
    color: var(--color-accent);
  }

  .game-card.is-done .state {
    color: #3f9a5b;
  }

  .go {
    margin-left: auto;
    flex-shrink: 0;
    font: 600 14px/1 var(--font-sans);
    color: var(--color-accent);
  }
</style>
