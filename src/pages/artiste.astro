---
// FICHE ARTISTE (?a=slug) : photo, genres, suivre, sorties, featurings, artistes similaires.
// Une seule page pour tout le catalogue : les données sont lues par le navigateur.
// ?nom=Nom : artiste pas encore au catalogue (invité en feat., recherche) : la fonction deezer l'ajoute, puis on affiche sa fiche.
import Layout from '../layouts/Layout.astro';
---

<Layout title="Artiste" description="Fiche artiste : sorties, artistes similaires, suivre.">
  <div class="bz-page">
    <a class="back" href="/BARZ-/artistes">← Tous les artistes</a>
    <p class="bz-empty" id="artist-error" hidden></p>

    <section class="hero" id="artist-hero" hidden>
      <div class="photo" id="a-photo"></div>
      <div class="info">
        <span class="bz-eyebrow" id="a-genres"></span>
        <h1 class="bz-display" id="a-name"></h1>
        <p class="meta" id="a-meta"></p>
        <div class="actions" id="a-actions"></div>
      </div>
    </section>

    <!-- Annonces sans fiche (src/scripts/announcements.ts) ; un membre connecté peut en signaler une, validée par Alban -->
    <section class="block" id="a-announce-block" hidden>
      <div class="bz-section-head">
        <h2 class="bz-h2">Ce qui <em>arrive</em></h2>
        <button type="button" class="bz-link" id="a-announce-open">Signaler une annonce</button>
      </div>
      <div class="bz-tiles bz-rail" id="a-announce"></div>
      <p class="announce-empty" id="a-announce-empty" hidden>Rien d’annoncé pour l’instant. Tu as vu passer une annonce ? Signale-la.</p>
    </section>

    <dialog class="announce-dialog" id="announce-dialog" aria-labelledby="announce-title">
      <form method="dialog" class="announce-box" id="announce-form">
        <h2 class="bz-h2" id="announce-title">Signaler une <em>annonce</em></h2>
        <p class="announce-hint">Un album ou un EP annoncé par l’artiste, pas encore en pré-sortie. On vérifie la source avant de le publier.</p>
        <label class="bz-field"><span>Titre (si connu)</span><input class="bz-input" name="title" maxlength="200" autocomplete="off" /></label>
        <div class="announce-row">
          <label class="bz-field"><span>Type</span><select class="bz-input" name="kind"><option value="album">Album</option><option value="ep">EP</option></select></label>
          <label class="bz-field"><span>Date</span><select class="bz-input" name="precision" id="announce-precision"></select></label>
          <label class="bz-field" id="announce-date-field"><span>Le</span><input class="bz-input" type="date" name="date" /></label>
        </div>
        <label class="bz-field"><span>Lien de l’annonce</span><input class="bz-input" name="source" type="url" required placeholder="https://www.instagram.com/p/…" /></label>
        <label class="bz-field"><span>Un mot (facultatif)</span><input class="bz-input" name="note" maxlength="300" autocomplete="off" /></label>
        <p class="bz-notice" id="announce-message" hidden></p>
        <div class="announce-actions">
          <button type="button" class="bz-btn bz-btn--lime bz-btn--small" id="announce-send">Envoyer</button>
          <button type="submit" class="bz-btn bz-btn--outline bz-btn--small" value="cancel">Annuler</button>
        </div>
      </form>
    </dialog>

    <!-- Toute la discographie (Deezer), rangée par format ; les sorties du catalogue BARZ¡ ouvrent leur fiche -->
    <section class="block" id="a-releases-block" hidden>
      <div class="bz-section-head"><h2 class="bz-h2">Sa <em>discographie</em></h2></div>
      <div class="bz-chips disco-tabs" id="a-disco-tabs" role="tablist" aria-label="Formats" hidden></div>
      <div class="bz-tiles bz-rail" id="a-releases"></div>
      <button type="button" class="bz-btn bz-btn--outline disco-more" id="a-disco-more" hidden></button>
    </section>

    <section class="block" id="a-feats-block" hidden>
      <div class="bz-section-head"><h2 class="bz-h2">Ses <em>featurings</em></h2></div>
      <div class="bz-tiles bz-rail" id="a-feats"></div>
    </section>

    <section class="block" id="a-related-block" hidden>
      <div class="bz-section-head"><h2 class="bz-h2">Dans le même <em>univers</em></h2></div>
      <div class="bz-artists bz-rail bz-rail--compact" id="a-related"></div>
    </section>
  </div>
</Layout>

<script>
  import { formatAudience } from '../lib/audience';
  import { listenMenuHtml } from '../lib/listen';
  import { initListen } from '../scripts/listen';
  import { ARTIST_LITE, BASE, artistCardHtml, authErrorMessage, coverHtml, errorText, escapeHtml, getSession, loginUrl, myFollows, releaseTileHtml, supabase, wireFollowButtons, type ArtistLite } from '../scripts/social';
  import { GENRE_CHIPS } from '../lib/genres';
  import { PRECISIONS, announcementCardHtml, publishedAnnouncements, suggestAnnouncement, type Precision } from '../scripts/announcements';

  const $ = (id: string) => document.getElementById(id)!;
  const fail = (text: string) => {
    $('artist-error').textContent = text;
    $('artist-error').hidden = false;
  };

  // Artiste absent du catalogue : trouvé sur Deezer et ajouté par la fonction deezer, puis adresse ?a=slug
  async function slugFromName(name: string): Promise<string | null> {
    $('artist-error').textContent = `Recherche de ${name}…`;
    $('artist-error').hidden = false;
    const { data, error } = await supabase!.functions.invoke('deezer', { body: { action: 'artist', name } });
    if (error || !data?.slug) {
      const detail = await (error as { context?: Response } | null)?.context?.json?.().catch(() => null);
      fail(detail?.error ?? 'Cet artiste n’est pas (encore) dans le catalogue.');
      return null;
    }
    $('artist-error').hidden = true;
    history.replaceState(null, '', `?a=${encodeURIComponent(data.slug)}`);
    return data.slug as string;
  }

  // Titre réduit pour reconnaître la même sortie chez Deezer et dans le catalogue (même règle que normTitle
  // dans supabase/functions/sync-fresh/apple.ts)
  const normTitle = (title: string) =>
    title
      .toLowerCase()
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .replace(/\s+-\s+(single|ep)$/, '')
      .replace(/[([](feat|ft|with|avec)\b[^)\]]*[)\]]/g, '')
      .replace(/[^a-z0-9]+/g, '');

  type DiscoItem = { title: string; type: string; date: string; html: string };
  const FORMATS = [
    { type: 'album', label: 'Albums' },
    { type: 'ep', label: 'EP' },
    { type: 'single', label: 'Singles' },
    { type: 'compilation', label: 'Compilations' },
    { type: 'live', label: 'Live' },
  ];
  const DISCO_SHOWN = 24;
  const TYPE_NAMES: Record<string, string> = { album: 'Album', ep: 'EP', single: 'Single', compilation: 'Compilation' };

  // Discographie : les sorties du catalogue (avec fiche) et, via la fonction deezer, tout le reste de Deezer
  async function renderDiscography(a: ArtistLite & { deezer_id: number | null }, rel: any[]) {
    // Ancien disque déjà noté par un membre (metadata.archive) : pas de fiche construite, sa page album
    const albumHref = (url: string | null | undefined) => {
      const id = String(url ?? '').match(/album\/(\d+)/)?.[1];
      return id ? `${BASE}album?d=${id}` : null;
    };
    const items: DiscoItem[] = rel.map((r) => {
      let html = releaseTileHtml({ ...r, artist: { name: a.name } }, { badge: r.release_date?.slice(0, 4) });
      const page = r.metadata?.archive && albumHref(r.deezer_url);
      if (page) html = html.replace(/href="[^"]*"/, `href="${page}"`);
      return { title: r.title, type: r.release_type, date: r.release_date, html };
    });
    const known = new Set(rel.map((r) => normTitle(r.title)));
    if (a.deezer_id) {
      const { data } = await supabase!.functions
        .invoke('deezer', { body: { action: 'discography', deezerId: a.deezer_id }, headers: { 'x-region': 'eu-west-3' } })
        .catch(() => ({ data: null }));
      for (const d of (data?.albums ?? []) as { title: string; type: string; date: string; cover: string | null; url: string | null }[]) {
        const key = normTitle(d.title);
        if (known.has(key)) continue; // déjà au catalogue (ou version explicite / censurée déjà vue)
        known.add(key);
        // Pas encore au catalogue : sa page album (titres, extraits, Barz), sinon le disque sur Deezer
        const page = albumHref(d.url);
        items.push({
          ...d,
          html: `<a class="bz-ctile" href="${escapeHtml(page ?? d.url ?? '#')}"${page ? '' : ' target="_blank" rel="noopener"'}>
            ${coverHtml(d.title, d.cover)}
            <span class="bz-ctile-row"><b>${escapeHtml(d.title)}</b><span class="bz-score">${escapeHtml(d.date.slice(0, 4))}</span></span>
            <span class="bz-ctile-sub">${escapeHtml(TYPE_NAMES[d.type] ?? 'Album')}</span>
          </a>`,
        });
      }
    }
    if (!items.length) return;
    items.sort((x, y) => y.date.localeCompare(x.date));
    const formats = FORMATS.map((f) => ({ ...f, items: items.filter((i) => (i.type === 'remix' || i.type === 'soundtrack' ? 'album' : i.type) === f.type) })).filter((f) => f.items.length);
    const tabs = $('a-disco-tabs');
    const grid = $('a-releases');
    const more = $('a-disco-more');
    const show = (type: string) => {
      const f = formats.find((x) => x.type === type)!;
      tabs.querySelectorAll<HTMLButtonElement>('[data-format]').forEach((b) => {
        b.classList.toggle('is-active', b.dataset.format === type);
        b.setAttribute('aria-selected', String(b.dataset.format === type));
      });
      grid.innerHTML = f.items.map((i) => i.html).join('');
      grid.classList.toggle('is-capped', f.items.length > DISCO_SHOWN);
      more.hidden = f.items.length <= DISCO_SHOWN;
      more.textContent = `Voir les ${f.items.length} ${f.label.toLowerCase()}`;
    };
    tabs.innerHTML = formats
      .map((f) => `<button type="button" class="bz-chip" role="tab" data-format="${f.type}" aria-selected="false">${f.label} · ${f.items.length}</button>`)
      .join('');
    tabs.hidden = formats.length < 2;
    tabs.onclick = (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-format]');
      if (button) show(button.dataset.format!);
    };
    more.onclick = () => {
      grid.classList.remove('is-capped');
      more.hidden = true;
    };
    show(formats[0].type);
    $('a-releases-block').hidden = false;
  }

  async function load() {
    const params = new URLSearchParams(location.search);
    if (!supabase) return fail('Artiste introuvable.');
    const name = params.get('nom')?.trim();
    const slug = params.get('a') ?? (name ? await slugFromName(name) : null);
    if (!slug) return name ? undefined : fail('Artiste introuvable.');
    const { data: artist, error } = await supabase.from('artists').select(`${ARTIST_LITE}, deezer_id`).eq('slug', slug).maybeSingle();
    if (error) throw error;
    if (!artist) return fail('Cet artiste n’est pas (encore) dans le catalogue.');
    const a = artist as ArtistLite & { deezer_id: number | null };

    const [releases, feats, related, followers, follows] = await Promise.all([
      supabase.from('releases').select('id, title, slug, cover_url, release_type, release_date, deezer_url, metadata').eq('artist_id', a.id).order('release_date', { ascending: false }).limit(300),
      // Sorties où il est invité (le nom figure dans metadata.featuring)
      supabase.from('releases').select('id, title, slug, cover_url, release_type, release_date, artist:artists!artist_id(name)').filter('metadata->featuring', 'cs', JSON.stringify([a.name])).order('release_date', { ascending: false }).limit(24),
      supabase.from('artist_relations').select(`rank, related:artists!artist_relations_related_id_fkey(${ARTIST_LITE})`).eq('artist_id', a.id).order('rank').limit(12),
      supabase.from('follows').select('*', { count: 'exact', head: true }).eq('artist_id', a.id),
      myFollows().catch(() => [] as ArtistLite[]),
    ]);
    const followed = new Set(follows.map((f) => f.id));
    const isFollowing = followed.has(a.id);

    document.title = `${a.name} | BARZ¡`;
    $('a-photo').innerHTML = a.image_url ? `<img src="${escapeHtml(a.image_url)}" alt="" />` : `<span class="bz-artist-initial">${escapeHtml(a.name[0])}</span>`;
    $('a-name').textContent = a.name;
    $('a-name').style.setProperty('--mot', String(Math.max(6, ...a.name.split(/\s+/).map((w) => w.length))));
    $('a-genres').textContent = GENRE_CHIPS.filter((c) => c.genres.some((g) => a.genres?.includes(g))).map((c) => c.label).join(' · ') || 'Artiste';
    const nbFollowers = followers.count ?? 0;
    $('a-meta').textContent = [formatAudience(a), nbFollowers ? `${nbFollowers} membre${nbFollowers > 1 ? 's' : ''} le suive${nbFollowers > 1 ? 'nt' : ''} sur BARZ¡` : '']
      .filter(Boolean)
      .join(' · ');
    $('a-actions').innerHTML = `<button type="button" class="bz-follow big${isFollowing ? ' is-on' : ''}" data-follow="${escapeHtml(a.id)}" aria-pressed="${isFollowing}">${isFollowing ? 'Suivi' : 'Suivre'}</button>
      ${listenMenuHtml({ artist: a.name, deezerUrl: a.deezer_id ? `https://www.deezer.com/artist/${a.deezer_id}` : null })}`;
    initListen();
    $('artist-hero').hidden = false;

    renderAnnouncements(a).catch((err) => console.warn('Annonces indisponibles :', err));
    renderDiscography(a, (releases.data ?? []) as any[]).catch((err) => console.warn('Discographie indisponible :', err));
    const featRows = (feats.data ?? []) as any[];
    if (featRows.length) {
      $('a-feats').innerHTML = featRows.map((r) => releaseTileHtml(r, { badge: r.release_date?.slice(0, 4) })).join('');
      $('a-feats-block').hidden = false;
    }
    const similar = ((related.data ?? []) as any[]).map((r) => r.related).filter(Boolean) as ArtistLite[];
    if (similar.length) {
      $('a-related').innerHTML = similar.map((s) => artistCardHtml(s, followed.has(s.id))).join('');
      $('a-related-block').hidden = false;
    }
  }

  // Annonces de l'artiste, et formulaire de signalement (connecté)
  async function renderAnnouncements(a: ArtistLite) {
    const list = await publishedAnnouncements(a.id);
    const session = await getSession();
    $('a-announce').innerHTML = list.map((x) => announcementCardHtml(x, { toSource: true })).join('');
    $('a-announce-empty').hidden = list.length > 0 || !session;
    // Sans annonce, le bloc n'apparaît que pour un membre connecté (qui peut en signaler une)
    $('a-announce-block').hidden = !list.length && !session;
    const dialog = $('announce-dialog') as HTMLDialogElement;
    const form = $('announce-form') as HTMLFormElement;
    const precision = $('announce-precision') as HTMLSelectElement;
    const message = $('announce-message');
    precision.innerHTML = PRECISIONS.map(([v, label]) => `<option value="${v}"${v === 'soon' ? ' selected' : ''}>${label}</option>`).join('');
    const syncDate = () => ($('announce-date-field').hidden = precision.value === 'soon');
    precision.onchange = syncDate;
    $('announce-open').onclick = async () => {
      if (!(await getSession())) return void (location.href = loginUrl());
      form.reset();
      precision.value = 'soon';
      syncDate();
      message.hidden = true;
      dialog.showModal();
    };
    ($('announce-send') as HTMLButtonElement).onclick = async () => {
      const data = new FormData(form);
      try {
        await suggestAnnouncement({
          artistId: a.id,
          title: String(data.get('title') ?? ''),
          kind: data.get('kind') === 'ep' ? 'ep' : 'album',
          date: String(data.get('date') ?? ''),
          precision: precision.value as Precision,
          sourceUrl: String(data.get('source') ?? ''),
          note: String(data.get('note') ?? ''),
        });
        message.textContent = 'Merci ! On vérifie la source, puis l’annonce apparaîtra ici et dans À venir.';
        message.className = 'bz-notice bz-notice--ok';
        message.hidden = false;
        setTimeout(() => dialog.close(), 2200);
      } catch (err) {
        message.textContent = /announcements/.test(errorText(err)) ? 'Les annonces ne sont pas encore activées.' : errorText(err);
        message.className = 'bz-notice bz-notice--error';
        message.hidden = false;
      }
    };
  }

  wireFollowButtons(document.querySelector('.bz-page') as HTMLElement);
  load().catch((err) => fail(errorText(err)));
</script>

<style>
  .announce-empty,
  .announce-hint {
    color: var(--color-text-muted);
    font-size: 15px;
  }

  .announce-dialog {
    width: min(560px, calc(100vw - 32px));
    max-height: calc(100dvh - 64px);
    margin: auto;
    padding: 0;
    border: var(--line);
    border-radius: 14px;
    background: var(--color-paper);
    color: var(--color-text);
    box-shadow: var(--shadow-hard);
  }

  .announce-dialog::backdrop {
    background: rgba(10, 10, 10, 0.5);
  }

  .announce-box {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 22px;
  }

  .announce-box .bz-h2,
  .announce-hint {
    margin: 0;
  }

  .announce-row {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
  }

  .announce-row [hidden] {
    display: none;
  }

  .announce-actions {
    display: flex;
    gap: 10px;
  }

  @media (max-width: 520px) {
    .announce-row {
      grid-template-columns: 1fr 1fr;
    }
  }

  .back {
    display: inline-block;
    margin-bottom: 36px;
    font-weight: 600;
    color: var(--color-text-muted) !important;
  }

  .hero {
    display: grid;
    grid-template-columns: 300px minmax(0, 1fr);
    align-items: center;
    gap: 56px;
  }

  /* Le nom suit la largeur de sa colonne (police large) : « Gesaffelstein » tient sur une ligne au lieu d'être coupé ;
     un mot n'est coupé que s'il ne tient vraiment pas */
  .info {
    min-width: 0;
    container-type: inline-size;
    width: 100%;
  }

  #a-name {
    /* --mot : longueur du mot le plus long du nom (posée par le script) ; Unbounded fait ~0,85 em par lettre */
    font-size: clamp(26px, calc(100cqi / (var(--mot, 8) * 0.9)), 96px);
    overflow-wrap: break-word;
  }

  .hero[hidden],
  .block[hidden],
  .bz-empty[hidden] {
    display: none;
  }

  .photo {
    aspect-ratio: 1;
    border-radius: 50%;
    overflow: hidden;
    display: grid;
    place-items: center;
    background: var(--color-bg-hover);
  }

  .photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .meta {
    margin-top: 18px;
    font-size: 17px;
    color: var(--color-text-muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin-top: 30px;
  }

  .actions :global(.big) {
    margin: 0;
    padding: 14px 28px;
    font-size: 16px;
  }

  .actions :global(.bz-btn--outline) {
    padding: 14px 22px;
    font-size: 15px;
  }

  .block {
    margin-top: 80px;
  }

  /* Petits écrans d'ordinateur : photo plus petite pour laisser la place au nom */
  @media (max-width: 1280px) {
    .hero {
      grid-template-columns: 200px minmax(0, 1fr);
      gap: 32px;
    }
  }

  @media (max-width: 900px) {
    .back {
      margin-bottom: 16px;
    }
    .block {
      margin-top: 48px;
    }
    .hero {
      grid-template-columns: minmax(0, 1fr);
      justify-items: center;
      text-align: center;
      gap: 24px;
    }
    .photo {
      width: 200px;
    }
    .actions {
      justify-content: center;
    }
  }

  .disco-tabs {
    margin-bottom: 18px;
  }

  /* Sur ordinateur, 24 disques puis « Voir les N » ; sur mobile, la rangée qui défile montre tout */
  #a-releases.is-capped > :global(:nth-child(n + 25)) {
    display: none;
  }

  .disco-more {
    display: block;
    margin: 24px auto 0;
  }

  @media (max-width: 900px) {
    .disco-tabs {
      flex-wrap: nowrap;
      margin-inline: -16px;
      padding-inline: 16px;
      overflow-x: auto;
      scrollbar-width: none;
    }
    .disco-tabs .bz-chip {
      flex-shrink: 0;
      white-space: nowrap;
    }
    #a-releases.is-capped > :global(:nth-child(n + 25)) {
      display: flex;
    }
    .disco-more {
      display: none !important;
    }
  }
</style>
