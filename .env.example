# BARZ - Environment Variables
# Copy this file to .env and fill in your values

# Supabase (Required)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_PROJECT_ID=your-project-id

# MusicBrainz (Required - User Agent)
MUSICBRAINZ_USER_AGENT=BARZ/1.0 (your-email@example.com)

# Last.fm API (Required for genres/popularity)
LASTFM_API_KEY=your-lastfm-api-key
LASTFM_API_SECRET=your-lastfm-api-secret

# Spotify Web API (Optional - for rich metadata: tracklist, duration, URLs)
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret

# Meilisearch (Optional - for search)
MEILISEARCH_HOST=https://your-meilisearch.cloud
MEILISEARCH_API_KEY=your-meilisearch-api-key
MEILISEARCH_INDEX=releases

# Algolia DocSearch (Alternative to Meilisearch)
ALGOLIA_APP_ID=your-algolia-app-id
ALGOLIA_API_KEY=your-algolia-api-key
ALGOLIA_INDEX_NAME=releases